{%- comment -%} Lustre product card: bordered tile, sale badge, stars, price and a buy button. Multi-variant products link to the product page. {%- endcomment -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}
{%- assign rating = product.metafields.reviews.rating.value.rating | default: 0 -%}
<article class="lx-card">
  {%- if on_sale -%}
    {%- assign off = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
    <span class="lx-card__badge">-{{ off | round }}%</span>
  {%- endif -%}
  <button class="lx-card__wish" type="button" aria-pressed="false" aria-label="{{ wish_label | default: 'Save to wishlist' | escape }}: {{ product.title | escape }}" data-lx-wish="{{ product.url }}" data-title="{{ product.title | escape }}" data-image="{% if product.featured_image contains '/' %}{{ product.featured_image }}{% else %}{{ product.featured_image | image_url: width: 200 }}{% endif %}">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20.5S3.5 15.4 3.5 9.2A4.7 4.7 0 0 1 12 6.6a4.7 4.7 0 0 1 8.5 2.6c0 6.2-8.5 11.3-8.5 11.3z"/></svg>
  </button>
  <a class="lx-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- render 'roarr-lustre-img', src: product.featured_image, alt: product.title, width: 600, lazy: true -%}
  </a>
  <h3 class="lx-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
  <span class="lx-card__stars" role="img" aria-label="{{ rating }} / 5">★★★★★<i style="width: {{ rating | times: 20 }}%">★★★★★</i></span>
  <p class="lx-card__price lx-price">{%- if on_sale -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}<span>{{ product.price | money }}</span></p>
  <div class="lx-card__buy">
    {%- if product.available == false -%}
      <button class="lx-card__btn" type="button" disabled>{% render 'roarr-ui-string', key: 'sold_out' %}</button>
    {%- elsif product.has_only_default_variant == false -%}
      <a class="lx-card__btn" href="{{ product.url }}">{{ options_label | default: 'Options' }}</a>
    {%- else -%}
      {%- form 'product', product -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button class="lx-card__btn" type="submit">{% render 'roarr-ui-string', key: 'add_to_cart' %}</button>
      {%- endform -%}
    {%- endif -%}
  </div>
</article>
