{%- comment -%} Velour product card: tinted portrait tile, second image and slide-in actions on hover, then type, title, stars and price. Multi-variant products open quick view. {%- endcomment -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}
{%- assign rating = product.metafields.reviews.rating.value.rating | default: 0 -%}
{%- assign second = product.second_image -%}
{%- if second == blank and product.images.size > 1 -%}{%- assign second = product.images[1] -%}{%- endif -%}
<article class="vr-card">
  <div class="vr-card__media">
    <a class="vr-card__pics" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- render 'roarr-velour-img', src: product.featured_image, alt: product.title, width: 700, lazy: true, class: 'vr-card__one' -%}
      {%- if second != blank -%}{%- render 'roarr-velour-img', src: second, alt: '', width: 700, lazy: true, class: 'vr-card__two' -%}{%- endif -%}
    </a>
    <div class="vr-card__side">
      <button class="vr-card__icon vr-card__icon--quick" type="button" aria-label="{{ quick_label | default: 'Quick view' | escape }}: {{ product.title | escape }}" data-vr-quick="{{ product.url }}">{%- render 'roarr-velour-icon', name: 'eye', size: 18 -%}</button>
      <button class="vr-card__icon vr-card__icon--wish" type="button" aria-pressed="false" aria-label="{{ wish_label | default: 'Save to wishlist' | escape }}: {{ product.title | escape }}" data-vr-wish="{{ product.url }}" data-title="{{ product.title | escape }}" data-image="{% if product.featured_image contains '/' %}{{ product.featured_image }}{% else %}{{ product.featured_image | image_url: width: 200 }}{% endif %}">{%- render 'roarr-velour-icon', name: 'star', size: 18 -%}</button>
    </div>
    <div class="vr-card__buy">
      {%- if product.available == false -%}
        <button class="vr-card__btn" type="button" disabled>{% render 'roarr-ui-string', key: 'sold_out' %}</button>
      {%- elsif product.has_only_default_variant == false -%}
        <button class="vr-card__btn" type="button" data-vr-quick="{{ product.url }}">{{ quick_add_label | default: 'Quick Add' }}</button>
      {%- else -%}
        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button class="vr-card__btn" type="submit" data-vr-add>{% render 'roarr-ui-string', key: 'add_to_cart' %}</button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
  {%- if product.type != blank -%}<p class="vr-card__type">{{ product.type }}</p>{%- endif -%}
  <h3 class="vr-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
  <span class="vr-stars" role="img" aria-label="{{ rating }} / 5">★★★★★<i style="width: {{ rating | times: 20 }}%">★★★★★</i></span>
  <p class="vr-card__price">
    <span>{{ product.price | money }}</span>
    {%- if on_sale -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
  </p>
</article>
