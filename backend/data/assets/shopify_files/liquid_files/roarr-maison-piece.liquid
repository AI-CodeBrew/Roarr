{%- capture mz_html -%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap">
{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign use_mf = section.settings.use_roarr_metafields -%}
{%- assign piece_eyebrow = section.settings.piece_eyebrow | default: 'The piece' -%}
{%- if use_mf and ht.piece_eyebrow != blank -%}{%- assign piece_eyebrow = ht.piece_eyebrow -%}{%- endif -%}
{%- assign piece_heading = section.settings.piece_heading | default: 'Designed to be lived with' -%}
{%- if use_mf and ht.piece_heading != blank -%}{%- assign piece_heading = ht.piece_heading -%}{%- endif -%}
{%- assign piece_body = section.settings.piece_body | default: 'From the first moment you hold it, the weight, the finish and the proportions tell you it was made with care. It settles easily into your day and only improves with time.' -%}
{%- if use_mf and ht.piece_body != blank -%}{%- assign piece_body = ht.piece_body -%}{%- endif -%}
{%- assign piece_point_1_title = section.settings.piece_point_1_title | default: 'Hand finished' -%}
{%- if use_mf and ht.piece_point_1_title != blank -%}{%- assign piece_point_1_title = ht.piece_point_1_title -%}{%- endif -%}
{%- assign piece_point_1_text = section.settings.piece_point_1_text | default: 'Each piece is inspected and finished by hand before it leaves us.' -%}
{%- if use_mf and ht.piece_point_1_text != blank -%}{%- assign piece_point_1_text = ht.piece_point_1_text -%}{%- endif -%}
{%- assign piece_point_2_title = section.settings.piece_point_2_title | default: 'Considered materials' -%}
{%- if use_mf and ht.piece_point_2_title != blank -%}{%- assign piece_point_2_title = ht.piece_point_2_title -%}{%- endif -%}
{%- assign piece_point_2_text = section.settings.piece_point_2_text | default: 'Chosen for how they feel, how they age and how long they last.' -%}
{%- if use_mf and ht.piece_point_2_text != blank -%}{%- assign piece_point_2_text = ht.piece_point_2_text -%}{%- endif -%}
{%- assign piece_point_3_title = section.settings.piece_point_3_title | default: 'Made to last' -%}
{%- if use_mf and ht.piece_point_3_title != blank -%}{%- assign piece_point_3_title = ht.piece_point_3_title -%}{%- endif -%}
{%- assign piece_point_3_text = section.settings.piece_point_3_text | default: 'Built to be used every day and kept for years, not seasons.' -%}
{%- if use_mf and ht.piece_point_3_text != blank -%}{%- assign piece_point_3_text = ht.piece_point_3_text -%}{%- endif -%}
{%- assign piece_cta = section.settings.piece_cta | default: 'View the piece' -%}
{%- if use_mf and ht.piece_cta != blank -%}{%- assign piece_cta = ht.piece_cta -%}{%- endif -%}
{%- assign maison_piece_image = section.settings.maison_piece_image -%}
{%- if use_mf and hi.maison_piece_image != blank -%}{%- assign maison_piece_image = hi.maison_piece_image -%}{%- endif -%}
{%- assign mz_product = blank -%}
{%- if ht.selected_product != blank -%}{%- assign mz_product = all_products[ht.selected_product] -%}{%- endif -%}
{%- if mz_product == blank and collections.all.products.first != blank -%}{%- assign mz_product = collections.all.products.first -%}{%- endif -%}
{%- assign mz_url = routes.all_products_collection_url | default: '/collections/all' -%}
{%- assign mz_title = section.settings.fallback_title -%}
{%- assign mz_price = section.settings.fallback_price -%}
{%- if mz_product != blank and mz_product.title != blank -%}
  {%- assign mz_url = mz_product.url -%}
  {%- assign mz_title = mz_product.title -%}
  {%- assign mz_price = mz_product.price | money -%}
{%- endif -%}
<section class="mz mz-piece">
  <div class="mz-wrap mz-piece__grid">
    <div class="mz-piece__copy mz-reveal">
      <p class="mz-label"><span class="mz-label__n">03</span>{{ piece_eyebrow | escape }}</p>
      <h2 class="mz-h2">{%- assign mz_words = piece_heading | split: ' ' -%}{%- for w in mz_words -%}{%- if forloop.last -%}<em>{{ w | escape }}</em>{%- else -%}{{ w | escape }} {% endif -%}{%- endfor -%}</h2>
      {%- if piece_body != blank -%}<p class="mz-body">{{ piece_body | escape }}</p>{%- endif -%}
      <div class="mz-piece__buy">
        {%- if mz_title != blank -%}<p class="mz-piece__name">{{ mz_title | escape }}{%- if mz_price != blank -%}<span>{{ mz_price }}</span>{%- endif -%}</p>{%- endif -%}
        {%- if piece_cta != blank -%}<a class="mz-link" href="{{ mz_url }}">{{ piece_cta | escape }}<span class="mz-arrow" aria-hidden="true">&rarr;</span></a>{%- endif -%}
      </div>
    </div>
    <figure class="mz-piece__figure">
      <div class="mz-piece__img mz-media mz-settle">{%- if maison_piece_image != blank -%}{%- if maison_piece_image contains 'http' or maison_piece_image contains '//' -%}<img src="{{ maison_piece_image }}" alt="{{ mz_title | escape }}" loading="lazy" width="1400" height="1750" decoding="async">{%- else -%}<img src="{{ maison_piece_image | image_url: width: 1400 }}" alt="{{ mz_title | escape }}" loading="lazy" width="1400" height="1750" decoding="async">{%- endif -%}{%- endif -%}</div>
    </figure>
    <ol class="mz-piece__points mz-reveal" role="list">
      {%- if piece_point_1_title != blank -%}<li><span class="mz-piece__num" aria-hidden="true">i.</span><h3>{{ piece_point_1_title | escape }}</h3><p>{{ piece_point_1_text | escape }}</p></li>{%- endif -%}
      {%- if piece_point_2_title != blank -%}<li><span class="mz-piece__num" aria-hidden="true">ii.</span><h3>{{ piece_point_2_title | escape }}</h3><p>{{ piece_point_2_text | escape }}</p></li>{%- endif -%}
      {%- if piece_point_3_title != blank -%}<li><span class="mz-piece__num" aria-hidden="true">iii.</span><h3>{{ piece_point_3_title | escape }}</h3><p>{{ piece_point_3_text | escape }}</p></li>{%- endif -%}
    </ol>
  </div>
</section>
<style>
  #shopify-section-{{ section.id }} { width: 100%; max-width: none; }
  :where(.mz) { --mz-ivory: #F5F1EA; --mz-paper: #FBF9F5; --mz-stone: #E9E2D6; --mz-ink: #1D1915; --mz-ink-2: #5E554B; --mz-line: rgb(29 25 21 / .14); --mz-gold: #B39062; --mz-gold-deep: #8F6F43; --mz-gold-text: #6E5530; --mz-on-dark: #F3EDE3; --mz-on-dark-2: #CBC2B4; --mz-gold-light: #D8C29B; --mz-serif: "Instrument Serif", "Cormorant Garamond", "Times New Roman", serif; --mz-sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif; --mz-gutter: clamp(20px, 4vw, 64px); --mz-dir: 1; font-family: var(--mz-sans); font-size: 16px; line-height: 1.65; color: var(--mz-ink); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  .mz *, .mz *::before, .mz *::after { box-sizing: border-box; }
  :where(.mz) :where(h1, h2, h3, p, ul, ol, dl, dd, blockquote, figure) { margin: 0; padding: 0; }
  :where(.mz) :where(ul, ol) { list-style: none; }
  :where(.mz) img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .mz-wrap { width: 100%; max-width: 1440px; margin-inline: auto; padding-inline: var(--mz-gutter); }
  .mz-label { display: flex; align-items: baseline; gap: 14px; font: 500 11.5px/1.4 var(--mz-sans); letter-spacing: .2em; text-transform: uppercase; color: var(--mz-gold-text); }
  .mz-label__n { font-feature-settings: "tnum"; letter-spacing: .08em; color: var(--mz-ink-2); }
  .mz-label__n::after { content: ""; display: inline-block; width: 28px; height: 1px; margin-inline-start: 14px; vertical-align: middle; background: var(--mz-gold); }
  .mz-h2 { font: 400 clamp(40px, 4.8vw, 72px)/1 var(--mz-serif); letter-spacing: -.015em; color: var(--mz-ink); text-wrap: balance; }
  .mz-h2 em, .mz-display em { font-style: italic; color: var(--mz-gold-deep); }
  .mz-body { font-size: 17px; line-height: 1.7; color: var(--mz-ink-2); text-wrap: pretty; }
  .mz-btn { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 54px; padding: 0 34px; border: 1px solid var(--mz-ink); background: var(--mz-ink); color: var(--mz-paper); font: 500 12px/1 var(--mz-sans); letter-spacing: .18em; text-transform: uppercase; text-decoration: none; transition: background .4s ease, color .4s ease, border-color .4s ease; }
  .mz-btn:hover { background: var(--mz-gold-deep); border-color: var(--mz-gold-deep); color: var(--mz-paper); }
  .mz-btn--light { background: var(--mz-paper); border-color: var(--mz-paper); color: var(--mz-ink); }
  .mz-btn--light:hover { background: transparent; border-color: var(--mz-paper); color: var(--mz-paper); }
  .mz-link { position: relative; display: inline-flex; align-items: center; gap: 12px; padding-bottom: 8px; color: var(--mz-ink); font: 500 12px/1 var(--mz-sans); letter-spacing: .18em; text-transform: uppercase; text-decoration: none; }
  .mz-link::after { content: ""; position: absolute; inset: auto 0 0; height: 1px; background: currentColor; transform-origin: right; transition: transform .5s cubic-bezier(.2, .7, .2, 1); }
  .mz-link:hover::after { transform: scaleX(.35); }
  .mz-btn:focus-visible, .mz-link:focus-visible, .mz summary:focus-visible { outline: 2px solid var(--mz-gold-text); outline-offset: 4px; }
  .mz-arrow { display: inline-block; font-family: var(--mz-sans); }
  .mz-media { position: relative; overflow: hidden; background: var(--mz-stone); }
  .mz-media img { transition: transform 1.6s cubic-bezier(.2, .7, .2, 1); }
  .mz-media:hover img { transform: scale(1.03); }
  .mz-fig { display: grid; gap: 16px; }
  .mz-fig figcaption { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 18px; row-gap: 4px; align-items: baseline; }
  .mz-fig__n { grid-row: span 2; font: 500 11px/1.6 var(--mz-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--mz-gold-text); }
  .mz-fig h3 { font: 400 24px/1.15 var(--mz-serif); color: var(--mz-ink); }
  .mz-fig p { font-size: 14.5px; line-height: 1.6; color: var(--mz-ink-2); }
  @keyframes mz-reveal { from { opacity: 0; transform: translateY(32px); } to { opacity: 1; transform: none; } }
  @keyframes mz-settle { from { scale: 1.14; } to { scale: 1; } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .mz-reveal { animation: mz-reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 70%; }
      .mz-settle img { animation: mz-settle linear both; animation-timeline: view(); animation-range: entry 0% cover 55%; }
    }
  }
  @media (max-width: 749px) { .mz-body { font-size: 16px; } }
  @media (prefers-reduced-motion: reduce) { .mz *, .mz *::before, .mz *::after { animation: none !important; transition: none !important; } }

  .mz-piece { background: var(--mz-stone); padding: clamp(88px, 10vw, 160px) 0; }
  .mz-piece__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr); gap: clamp(32px, 4vw, 72px); align-items: center; }
  .mz-piece__copy { display: grid; justify-items: start; gap: 28px; }
  .mz-piece__img { aspect-ratio: 4 / 5; }
  .mz-piece__buy { display: grid; justify-items: start; gap: 18px; width: 100%; padding-top: 26px; border-top: 1px solid var(--mz-line); }
  .mz-piece__name { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 18px; font: 400 26px/1.2 var(--mz-serif); color: var(--mz-ink); }
  .mz-piece__name span { font: 500 12px/1 var(--mz-sans); letter-spacing: .14em; color: var(--mz-ink-2); }
  .mz-piece__points { display: grid; gap: 0; align-self: stretch; align-content: center; }
  .mz-piece__points li { display: grid; gap: 8px; padding: 26px 0; border-top: 1px solid var(--mz-line); }
  .mz-piece__points li:last-child { border-bottom: 1px solid var(--mz-line); }
  .mz-piece__num { font: italic 400 22px/1 var(--mz-serif); color: var(--mz-gold-deep); }
  .mz-piece__points h3 { font: 400 24px/1.15 var(--mz-serif); color: var(--mz-ink); }
  .mz-piece__points p { font-size: 14.5px; line-height: 1.6; color: var(--mz-ink-2); }
  @media (max-width: 1099px) {
    .mz-piece__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .mz-piece__figure { grid-row: span 2; }
  }
  @media (max-width: 749px) { .mz-piece__grid { grid-template-columns: minmax(0, 1fr); } .mz-piece__figure { grid-row: auto; order: -1; } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if mz_html contains 'ا' or mz_html contains 'ل' or mz_html contains 'ي' or mz_html contains 'ة' -%}
<div class="mz-rtl" dir="rtl" style="display: contents">{{ mz_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700&display=swap">
<style>
  .mz-rtl:is(#mz-rtl, *), .mz-rtl:is(#mz-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .mz-rtl:is(#mz-rtl, *) :is(p, li, span, a, summary, dt, dd, figcaption, div) { font-family: "Instrument Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .mz-rtl:is(#mz-rtl, *) :is(h1, h2, h3, blockquote, blockquote p) { font-family: "Instrument Serif", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.4 !important; }
  .mz-rtl:is(#mz-rtl, *) .mz { --mz-dir: -1; }
  .mz-rtl:is(#mz-rtl, *) .mz-arrow { transform: scaleX(-1); }
</style>
{%- else -%}
{{ mz_html }}
{%- endif -%}

{% schema %}
{
  "name": "Maison The Piece",
  "tag": "section",
  "class": "roarr-maison-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_roarr_metafields",
      "label": "Use Roarr generated content",
      "default": true
    },
    {
      "type": "text",
      "id": "piece_eyebrow",
      "label": "Label",
      "default": "The piece"
    },
    {
      "type": "text",
      "id": "piece_heading",
      "label": "Heading (last word is italic)",
      "default": "Designed to be lived with"
    },
    {
      "type": "textarea",
      "id": "piece_body",
      "label": "Text",
      "default": "From the first moment you hold it, the weight, the finish and the proportions tell you it was made with care. It settles easily into your day and only improves with time."
    },
    {
      "type": "text",
      "id": "piece_point_1_title",
      "label": "Detail 1 title",
      "default": "Hand finished"
    },
    {
      "type": "textarea",
      "id": "piece_point_1_text",
      "label": "Detail 1 text",
      "default": "Each piece is inspected and finished by hand before it leaves us."
    },
    {
      "type": "text",
      "id": "piece_point_2_title",
      "label": "Detail 2 title",
      "default": "Considered materials"
    },
    {
      "type": "textarea",
      "id": "piece_point_2_text",
      "label": "Detail 2 text",
      "default": "Chosen for how they feel, how they age and how long they last."
    },
    {
      "type": "text",
      "id": "piece_point_3_title",
      "label": "Detail 3 title",
      "default": "Made to last"
    },
    {
      "type": "text",
      "id": "piece_point_3_text",
      "label": "Detail 3 text",
      "default": "Built to be used every day and kept for years, not seasons."
    },
    {
      "type": "text",
      "id": "piece_cta",
      "label": "Link label",
      "default": "View the piece"
    },
    {
      "type": "image_picker",
      "id": "maison_piece_image",
      "label": "Product image (4:5)"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Product name when no product is found",
      "default": "Signature piece"
    },
    {
      "type": "text",
      "id": "fallback_price",
      "label": "Price when no product is found",
      "default": "$49.00"
    }
  ],
  "presets": [
    {
      "name": "Maison The Piece"
    }
  ]
}
{% endschema %}
