{%- assign section_scheme = section.settings.color_scheme | default: 'scheme-1' -%}
{% assign store_gen = shop.metafields.roarr.store_generation.value %}
{% assign home = store_gen.home_page %}
{% assign ht = home.text %}
{% assign hi = home.images %}
{% assign use_mf = section.settings.use_roarr_metafields %}
{% assign homeData = section.settings.homeData %}
{% if ht == blank and homeData.text != blank %}{% assign ht = homeData.text %}{% endif %}
{% if hi == blank and homeData.images != blank %}{% assign hi = homeData.images %}{% endif %}

{% assign look_1_eyebrow = section.settings.look_1_eyebrow %}
{% if use_mf and ht.look_1_eyebrow != blank %}{% assign look_1_eyebrow = ht.look_1_eyebrow %}{% endif %}
{% assign look_1_title = section.settings.look_1_title %}
{% if use_mf and ht.look_1_title != blank %}{% assign look_1_title = ht.look_1_title %}{% endif %}
{% assign look_1_caption = section.settings.look_1_caption %}
{% if use_mf and ht.look_1_caption != blank %}{% assign look_1_caption = ht.look_1_caption %}{% endif %}
{% assign look_2_eyebrow = section.settings.look_2_eyebrow %}
{% if use_mf and ht.look_2_eyebrow != blank %}{% assign look_2_eyebrow = ht.look_2_eyebrow %}{% endif %}
{% assign look_2_title = section.settings.look_2_title %}
{% if use_mf and ht.look_2_title != blank %}{% assign look_2_title = ht.look_2_title %}{% endif %}
{% assign look_2_caption = section.settings.look_2_caption %}
{% if use_mf and ht.look_2_caption != blank %}{% assign look_2_caption = ht.look_2_caption %}{% endif %}
{% assign look_3_eyebrow = section.settings.look_3_eyebrow %}
{% if use_mf and ht.look_3_eyebrow != blank %}{% assign look_3_eyebrow = ht.look_3_eyebrow %}{% endif %}
{% assign look_3_title = section.settings.look_3_title %}
{% if use_mf and ht.look_3_title != blank %}{% assign look_3_title = ht.look_3_title %}{% endif %}
{% assign look_3_caption = section.settings.look_3_caption %}
{% if use_mf and ht.look_3_caption != blank %}{% assign look_3_caption = ht.look_3_caption %}{% endif %}
{% assign look_image_1 = section.settings.look_image_1 %}
{% if use_mf %}{% if shop.metafields.roarr.look_image_1.value != blank %}{% assign look_image_1 = shop.metafields.roarr.look_image_1.value %}{% elsif hi.look_image_1 != blank %}{% assign look_image_1 = hi.look_image_1 %}{% endif %}{% endif %}
{% assign look_image_2 = section.settings.look_image_2 %}
{% if use_mf %}{% if shop.metafields.roarr.look_image_2.value != blank %}{% assign look_image_2 = shop.metafields.roarr.look_image_2.value %}{% elsif hi.look_image_2 != blank %}{% assign look_image_2 = hi.look_image_2 %}{% endif %}{% endif %}
{% assign look_image_3 = section.settings.look_image_3 %}
{% if use_mf %}{% if shop.metafields.roarr.look_image_3.value != blank %}{% assign look_image_3 = shop.metafields.roarr.look_image_3.value %}{% elsif hi.look_image_3 != blank %}{% assign look_image_3 = hi.look_image_3 %}{% endif %}{% endif %}

{% assign amour_product = blank %}
{% if section.settings.product != blank %}
  {% assign amour_product = section.settings.product %}
{% elsif ht.selected_product != blank %}
  {% assign amour_product = all_products[ht.selected_product] %}
{% endif %}
{% if amour_product == blank and collections.all.products.first != blank %}
  {% assign amour_product = collections.all.products.first %}
{% endif %}
{% assign amour_product_url = routes.all_products_collection_url %}
{% assign amour_product_title = section.settings.fallback_title %}
{% assign amour_product_price = section.settings.fallback_price %}
{% if amour_product != blank and amour_product.title != blank %}
  {% assign amour_product_url = amour_product.url %}
  {% assign amour_product_title = amour_product.title %}
  {% assign amour_product_price = amour_product.price | money %}
{% endif %}


{% if shop.metafields.app.block_control.value %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500&family=Cormorant+Garamond:ital,wght@1,400;1,500&display=swap">
<style>
  #shopify-section-{{ section.id }} { width: 100%; max-width: none; }
  #amour-{{ section.id }} {
  --a-ink: var(--color-foreground, #111111);
  --a-paper: var(--color-background, #ffffff);
  --a-wine: {{ section.settings.accent_color | default: '#6b0808' }};
  --a-on-wine: #ffffff;
  --a-blush: {{ section.settings.blush_color | default: '#ffe3de' }};
  --a-mist: #f2f1ef;
  --a-head: 'Syne', 'Helvetica Neue', Arial, sans-serif;
  --a-body: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  --a-serif: 'Cormorant Garamond', 'Times New Roman', serif;
  font-family: var(--a-body); color: var(--a-ink); background: var(--a-paper);
  }

  #amour-{{ section.id }}, #amour-{{ section.id }} * { box-sizing: border-box; }
  #amour-{{ section.id }} img { display: block; max-width: 100%; }
  #amour-{{ section.id }} .a-wrap { max-width: 1340px; margin: 0 auto; padding: 0 20px; }
  #amour-{{ section.id }} .a-h2 { margin: 0; font-family: var(--a-head); font-weight: 700; text-transform: uppercase; font-size: 40px; line-height: 1.2; letter-spacing: -0.01em; }
  #amour-{{ section.id }} .a-serif { font-family: var(--a-serif); font-style: italic; font-weight: 400; }
  #amour-{{ section.id }} .a-serif span, #amour-{{ section.id }} .a-serif p { font-family: inherit; font-style: inherit; font-weight: inherit; }
  #amour-{{ section.id }} .a-link { display: inline-block; font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; padding: 0 0 4px; }
  #amour-{{ section.id }} .a-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 32px; font-family: var(--a-body); font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none; transition: background .2s, color .2s; }
  #amour-{{ section.id }} .a-btn--light { background: #fff; color: #000; border: 1px solid #fff; }
  #amour-{{ section.id }} .a-btn--light:hover { background: transparent; color: #fff; }
  #amour-{{ section.id }} .a-btn--outline { background: transparent; color: var(--a-ink); border: 1px solid var(--a-ink); }
  #amour-{{ section.id }} .a-btn--outline:hover { background: var(--a-ink); color: var(--a-paper); }
  #amour-{{ section.id }} .a-media { position: relative; overflow: hidden; background: var(--a-mist); }
  #amour-{{ section.id }} .a-media img, #amour-{{ section.id }} .a-media svg { width: 100%; height: 100%; object-fit: cover; }
  #amour-{{ section.id }} .a-ph { width: 100%; height: 100%; fill: rgba(0,0,0,.18); background: var(--a-mist); }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .a-h2 { font-size: 28px; }
  }

  #amour-{{ section.id }} .al { padding: 100px 0 40px; }
  #amour-{{ section.id }} .al__grid { display: grid; grid-template-columns: 3fr 4fr 3fr; gap: 32px 80px; align-items: center; }
  #amour-{{ section.id }} .al__card { position: relative; color: #fff; aspect-ratio: 3 / 4; }
  #amour-{{ section.id }} .al__card .a-media { position: absolute; inset: 0; }
  #amour-{{ section.id }} .al__card .a-media:after { content: ""; position: absolute; inset: 0; background: rgba(0,0,0,.22); }
  #amour-{{ section.id }} .al__copy { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: space-between; text-align: center; padding: 24px; }
  #amour-{{ section.id }} .al__eyebrow { margin: 0; font-family: var(--a-head); font-weight: 600; font-size: 16px; line-height: 1.6; text-transform: uppercase; letter-spacing: .04em; }
  #amour-{{ section.id }} .al__title { margin: 0; font-size: 56px; line-height: 1.15; padding: 0 2px; border-bottom: 1px solid #fff; }
  #amour-{{ section.id }} .al__caption { margin: 0; font-size: 14px; line-height: 1.5; }
  @media (max-width: 989px) {
    #amour-{{ section.id }} .al__grid { gap: 24px; }
    #amour-{{ section.id }} .al__title { font-size: 40px; }
  }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .al { padding: 64px 0 24px; }
    #amour-{{ section.id }} .al__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 8px; margin: 0 -20px; padding: 0 20px; scrollbar-width: none; }
    #amour-{{ section.id }} .al__grid::-webkit-scrollbar { display: none; }
    #amour-{{ section.id }} .al__card, #amour-{{ section.id }} .al__card--tall { flex: 0 0 80%; aspect-ratio: 3 / 4; scroll-snap-align: center; }
  }

</style>
<div id="amour-{{ section.id }}" class="roarr-amour color-{{ section_scheme }}">
<section class="al"><div class="a-wrap"><div class="al__grid">
  {%- for i in (1..3) -%}
    {%- case i -%}
      {%- when 1 -%}{%- assign c_img = look_image_1 -%}{%- assign c_eyebrow = look_1_eyebrow -%}{%- assign c_title = look_1_title -%}{%- assign c_caption = look_1_caption -%}
      {%- when 2 -%}{%- assign c_img = look_image_2 -%}{%- assign c_eyebrow = look_2_eyebrow -%}{%- assign c_title = look_2_title -%}{%- assign c_caption = look_2_caption -%}
      {%- else -%}{%- assign c_img = look_image_3 -%}{%- assign c_eyebrow = look_3_eyebrow -%}{%- assign c_title = look_3_title -%}{%- assign c_caption = look_3_caption -%}
    {%- endcase -%}
    <a class="al__card{% if i == 2 %} al__card--tall{% endif %}" href="{{ amour_product_url }}">
      <div class="a-media">{%- if c_img != blank -%}{%- if c_img contains 'http' or c_img contains '//' -%}<img src="{{ c_img }}" alt="{{ c_title | escape }}" loading="lazy" class="">{%- else -%}<img src="{{ c_img | image_url: width: 1100 }}" alt="{{ c_title | escape }}" loading="lazy" class="">{%- endif -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'a-ph' }}{%- endif -%}</div>
      <div class="al__copy">
        <p class="al__eyebrow">{{ c_eyebrow }}</p>
        {% if c_title != blank %}<h3 class="al__title a-serif">{{ c_title }}</h3>{% endif %}
        <p class="al__caption">{{ c_caption }}</p>
      </div>
    </a>
  {%- endfor -%}
</div></div></section>
</div>
{% endif %}

{% schema %}
{
  "name": "Roarr - Amour Lookbook",
  "tag": "section",
  "class": "roarr-amour-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_roarr_metafields",
      "label": "Use Roarr metafields",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#6b0808"
    },
    {
      "type": "color",
      "id": "blush_color",
      "label": "Soft background color",
      "default": "#ffe3de"
    },
    {
      "type": "image_picker",
      "id": "look_image_1",
      "label": "Card 1 image (3:4)"
    },
    {
      "type": "image_picker",
      "id": "look_image_2",
      "label": "Card 2 image (3:4)"
    },
    {
      "type": "image_picker",
      "id": "look_image_3",
      "label": "Card 3 image (3:4)"
    },
    {
      "type": "text",
      "id": "look_1_eyebrow",
      "label": "Card 1 label",
      "default": "Everyday"
    },
    {
      "type": "text",
      "id": "look_1_title",
      "label": "Card 1 title",
      "default": "Effortless"
    },
    {
      "type": "text",
      "id": "look_1_caption",
      "label": "Card 1 caption",
      "default": "Easy to wear from morning to night"
    },
    {
      "type": "text",
      "id": "look_2_eyebrow",
      "label": "Card 2 label",
      "default": "Signature"
    },
    {
      "type": "text",
      "id": "look_2_title",
      "label": "Card 2 title",
      "default": "Made to shine"
    },
    {
      "type": "text",
      "id": "look_2_caption",
      "label": "Card 2 caption",
      "default": "The piece everyone asks about"
    },
    {
      "type": "text",
      "id": "look_3_eyebrow",
      "label": "Card 3 label",
      "default": "Gifting"
    },
    {
      "type": "text",
      "id": "look_3_title",
      "label": "Card 3 title",
      "default": "With love"
    },
    {
      "type": "text",
      "id": "look_3_caption",
      "label": "Card 3 caption",
      "default": "Wrapped and ready to give"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Product title fallback",
      "default": "Signature piece"
    },
    {
      "type": "text",
      "id": "fallback_price",
      "label": "Product price fallback"
    }
  ],
  "presets": [
    {
      "name": "Roarr - Amour Lookbook"
    }
  ]
}
{% endschema %}
