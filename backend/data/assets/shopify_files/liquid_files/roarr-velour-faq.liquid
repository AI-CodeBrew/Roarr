{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- capture vr_html -%}
{%- if ht.faq_q_1 != blank -%}
<section class="vr-fq">
  <div class="vr-wrap">
    <h2 class="vr-title vr-fq__title">{{ ht.faq_heading }}</h2>
    <div class="vr-fq__list" data-vr-fold>
      {%- for i in (1..4) -%}
        {%- assign q_key = 'faq_q_' | append: i -%}
        {%- assign a_key = 'faq_a_' | append: i -%}
        {%- if ht[q_key] != blank -%}
          <div class="vr-fq__item{% if i == 1 %} is-open{% endif %}" data-vr-fold-item>
            <h3 class="vr-fq__h"><button class="vr-fq__q" type="button" aria-expanded="{% if i == 1 %}true{% else %}false{% endif %}"><span>{{ ht[q_key] }}</span><i aria-hidden="true"></i></button></h3>
            <div class="vr-fq__fold"><div><p class="vr-fq__a">{{ ht[a_key] }}</p></div></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
<style>
  .vr .vr-fq { padding-block: 120px 92px; background: var(--vr-panel); }
  .vr .vr-fq__title { margin-top: 0; text-align: center; }
  .vr .vr-fq__list { width: min(100%, 970px); margin: 20px auto 0; }
  .vr .vr-fq__item { border-bottom: 1px solid var(--vr-line); }
  .vr .vr-fq__item:last-child { border-bottom: 0; }
  .vr .vr-fq__h { font-size: inherit; }
  .vr .vr-fq__q { display: flex; align-items: center; justify-content: space-between; gap: 25px; width: 100%; padding: 29px 0; border: 0; background: none; font-size: 15.36px; line-height: 23px; font-weight: 500; text-align: start; color: var(--vr-ink); cursor: pointer; transition: color .2s ease; }
  .vr .vr-fq__q:hover { color: var(--vr-accent); }
  .vr .vr-fq__q i { position: relative; flex: none; width: 13px; height: 13px; }
  .vr .vr-fq__q i::before, .vr .vr-fq__q i::after { content: ""; position: absolute; inset-inline-start: 0; top: 6px; width: 13px; height: 1.5px; background: currentColor; transition: transform .3s ease; }
  .vr .vr-fq__q i::after { transform: rotate(90deg); }
  .vr .vr-fq__item.is-open .vr-fq__q i::after { transform: none; }
  .vr .vr-fq__fold { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .vr .vr-fq__item.is-open .vr-fq__fold { grid-template-rows: 1fr; }
  .vr .vr-fq__fold > div { min-height: 0; overflow: hidden; }
  .vr .vr-fq__a { padding-block-end: 30px; margin-top: -9px; font-size: 13.44px; line-height: 20px; color: var(--vr-text); }
  @media (max-width: 749px) {
    .vr .vr-fq { padding-block: 60px; }
    .vr .vr-fq__list { margin-top: 26px; }
    .vr .vr-fq__q { padding: 20px 0; }
  }
</style>
{%- endcapture -%}
{%- render 'roarr-velour-wrap', html: vr_html -%}

{% schema %}
{
  "name": "Velour FAQ",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Velour FAQ" }]
}
{% endschema %}
