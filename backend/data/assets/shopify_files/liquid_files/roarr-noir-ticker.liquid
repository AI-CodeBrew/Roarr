{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Manrope:wght@400;500;600&display=swap">
{%- assign m = product.metafields.roarr -%}
{%- assign k1 = m.noir_ticker_1.value | default: m.noir_ticker_1 | default: 'Crafted to last' -%}
{%- assign k2 = m.noir_ticker_2.value | default: m.noir_ticker_2 | default: 'Considered design' -%}
{%- assign k3 = m.noir_ticker_3.value | default: m.noir_ticker_3 | default: 'Gift-ready packaging' -%}
{%- assign k4 = m.noir_ticker_4.value | default: m.noir_ticker_4 | default: 'Free returns' -%}
<section class="nr-ticker">
  <div class="nr-ticker__track">
    {%- for pass in (1..2) -%}
      <ul class="nr-ticker__list" role="list"{% if pass == 2 %} aria-hidden="true"{% endif %}>
        {%- for lap in (1..2) -%}
          <li>{{ k1 }}</li><li class="nr-ticker__star" aria-hidden="true">&#10022;</li>
          <li>{{ k2 }}</li><li class="nr-ticker__star" aria-hidden="true">&#10022;</li>
          <li>{{ k3 }}</li><li class="nr-ticker__star" aria-hidden="true">&#10022;</li>
          <li>{{ k4 }}</li><li class="nr-ticker__star" aria-hidden="true">&#10022;</li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</section>
<style>
  .nr-ticker { --nr-ink: #0D0C0B; --nr-coal: #161412; --nr-line: #2E2A25; --nr-gold: #C9A96E; --nr-gold-soft: #E4D2AA; --nr-ivory: #F2ECE2; --nr-muted: #A79E90; --font-heading-family: "Bodoni Moda", serif; --font-body-family: "Manrope", sans-serif; --font-body-family: "Bodoni Moda", serif; background: var(--nr-ink); border-block: 1px solid var(--nr-line); color: var(--nr-gold-soft); font-family: "Bodoni Moda", serif; overflow: hidden; padding: 18px 0; }
  .nr-ticker *, .nr-ticker *::before, .nr-ticker *::after { box-sizing: border-box; }
  .nr-ticker__track { display: flex; width: max-content; animation: nr-ticker 40s linear infinite; }
  .nr-ticker__list { display: flex; align-items: center; gap: 36px; list-style: none; margin: 0; padding: 0 18px; white-space: nowrap; font-size: clamp(18px, 1.8vw, 24px); font-style: italic; }
  .nr-ticker__list li { font-size: inherit; font-style: inherit; }
  .nr-ticker__list .nr-ticker__star { font-size: 12px; font-style: normal; color: var(--nr-gold); }
  .nr-ticker:hover .nr-ticker__track { animation-play-state: paused; }
  @keyframes nr-ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .nr-ticker__track { animation: none; } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--noir" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "Manrope", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Bodoni Moda", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Noir Ticker",
  "tag": "section",
  "class": "roarr-noir-section",
  "settings": [],
  "presets": [{ "name": "Roarr Noir Ticker" }]
}
{% endschema %}
