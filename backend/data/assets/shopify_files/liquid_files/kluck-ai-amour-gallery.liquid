{%- assign section_scheme = section.settings.color_scheme | default: 'scheme-1' -%}
{% assign store_gen = shop.metafields.kluck_ai.store_generation.value %}
{% assign home = store_gen.home_page %}
{% assign ht = home.text %}
{% assign hi = home.images %}
{% assign use_mf = section.settings.use_kluck_ai_metafields %}
{% assign homeData = section.settings.homeData %}
{% if ht == blank and homeData.text != blank %}{% assign ht = homeData.text %}{% endif %}
{% if hi == blank and homeData.images != blank %}{% assign hi = homeData.images %}{% endif %}

{% assign gallery_heading = section.settings.gallery_heading %}
{% if use_mf and ht.gallery_heading != blank %}{% assign gallery_heading = ht.gallery_heading %}{% endif %}
{% assign gallery_1_label = section.settings.gallery_1_label %}
{% if use_mf and ht.gallery_1_label != blank %}{% assign gallery_1_label = ht.gallery_1_label %}{% endif %}
{% assign gallery_2_label = section.settings.gallery_2_label %}
{% if use_mf and ht.gallery_2_label != blank %}{% assign gallery_2_label = ht.gallery_2_label %}{% endif %}
{% assign gallery_3_label = section.settings.gallery_3_label %}
{% if use_mf and ht.gallery_3_label != blank %}{% assign gallery_3_label = ht.gallery_3_label %}{% endif %}
{% assign gallery_4_label = section.settings.gallery_4_label %}
{% if use_mf and ht.gallery_4_label != blank %}{% assign gallery_4_label = ht.gallery_4_label %}{% endif %}
{% assign gallery_5_label = section.settings.gallery_5_label %}
{% if use_mf and ht.gallery_5_label != blank %}{% assign gallery_5_label = ht.gallery_5_label %}{% endif %}
{% assign gallery_6_label = section.settings.gallery_6_label %}
{% if use_mf and ht.gallery_6_label != blank %}{% assign gallery_6_label = ht.gallery_6_label %}{% endif %}
{% assign product_image_1 = section.settings.product_image_1 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.product_image_1.value != blank %}{% assign product_image_1 = shop.metafields.kluck_ai.product_image_1.value %}{% elsif hi.product_image_1 != blank %}{% assign product_image_1 = hi.product_image_1 %}{% endif %}{% endif %}
{% assign look_image_1 = section.settings.look_image_1 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.look_image_1.value != blank %}{% assign look_image_1 = shop.metafields.kluck_ai.look_image_1.value %}{% elsif hi.look_image_1 != blank %}{% assign look_image_1 = hi.look_image_1 %}{% endif %}{% endif %}
{% assign product_image_2 = section.settings.product_image_2 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.product_image_2.value != blank %}{% assign product_image_2 = shop.metafields.kluck_ai.product_image_2.value %}{% elsif hi.product_image_2 != blank %}{% assign product_image_2 = hi.product_image_2 %}{% endif %}{% endif %}
{% assign look_image_2 = section.settings.look_image_2 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.look_image_2.value != blank %}{% assign look_image_2 = shop.metafields.kluck_ai.look_image_2.value %}{% elsif hi.look_image_2 != blank %}{% assign look_image_2 = hi.look_image_2 %}{% endif %}{% endif %}
{% assign product_image_3 = section.settings.product_image_3 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.product_image_3.value != blank %}{% assign product_image_3 = shop.metafields.kluck_ai.product_image_3.value %}{% elsif hi.product_image_3 != blank %}{% assign product_image_3 = hi.product_image_3 %}{% endif %}{% endif %}
{% assign look_image_3 = section.settings.look_image_3 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.look_image_3.value != blank %}{% assign look_image_3 = shop.metafields.kluck_ai.look_image_3.value %}{% elsif hi.look_image_3 != blank %}{% assign look_image_3 = hi.look_image_3 %}{% endif %}{% endif %}


{% if shop.metafields.app.block_control.value %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500&family=Cormorant+Garamond:ital,wght@1,400;1,500&display=swap">
<style>
  #shopify-section-{{ section.id }} { width: 100%; max-width: none; }
  #amour-{{ section.id }} {
  --a-ink: var(--color-foreground, #111111);
  --a-paper: var(--color-background, #ffffff);
  --a-wine: {{ section.settings.accent_color | default: '#6b0808' }};
  --a-on-wine: #ffffff;
  --a-blush: {{ section.settings.blush_color | default: '#ffe3de' }};
  --a-mist: #f2f1ef;
  --a-head: 'Syne', 'Helvetica Neue', Arial, sans-serif;
  --a-body: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  --a-serif: 'Cormorant Garamond', 'Times New Roman', serif;
  font-family: var(--a-body); color: var(--a-ink); background: var(--a-paper);
  }

  #amour-{{ section.id }}, #amour-{{ section.id }} * { box-sizing: border-box; }
  #amour-{{ section.id }} img { display: block; max-width: 100%; }
  #amour-{{ section.id }} .a-wrap { max-width: 1340px; margin: 0 auto; padding: 0 20px; }
  #amour-{{ section.id }} .a-h2 { margin: 0; font-family: var(--a-head); font-weight: 700; text-transform: uppercase; font-size: 40px; line-height: 1.2; letter-spacing: -0.01em; }
  #amour-{{ section.id }} .a-serif { font-family: var(--a-serif); font-style: italic; font-weight: 400; }
  #amour-{{ section.id }} .a-serif span, #amour-{{ section.id }} .a-serif p { font-family: inherit; font-style: inherit; font-weight: inherit; }
  #amour-{{ section.id }} .a-link { display: inline-block; font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; padding: 0 0 4px; }
  #amour-{{ section.id }} .a-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 32px; font-family: var(--a-body); font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none; transition: background .2s, color .2s; }
  #amour-{{ section.id }} .a-btn--light { background: #fff; color: #000; border: 1px solid #fff; }
  #amour-{{ section.id }} .a-btn--light:hover { background: transparent; color: #fff; }
  #amour-{{ section.id }} .a-btn--outline { background: transparent; color: var(--a-ink); border: 1px solid var(--a-ink); }
  #amour-{{ section.id }} .a-btn--outline:hover { background: var(--a-ink); color: var(--a-paper); }
  #amour-{{ section.id }} .a-media { position: relative; overflow: hidden; background: var(--a-mist); }
  #amour-{{ section.id }} .a-media img, #amour-{{ section.id }} .a-media svg { width: 100%; height: 100%; object-fit: cover; }
  #amour-{{ section.id }} .a-ph { width: 100%; height: 100%; fill: rgba(0,0,0,.18); background: var(--a-mist); }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .a-h2 { font-size: 28px; }
  }

  #amour-{{ section.id }} .ag { padding: 100px 0; }
  #amour-{{ section.id }} .ag__head { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 32px; }
  #amour-{{ section.id }} .ag__nav { display: flex; align-items: center; gap: 14px; font-size: 14px; font-weight: 500; }
  #amour-{{ section.id }} .ag__arrow { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--a-ink); background: none; color: inherit; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: background .2s, color .2s; }
  #amour-{{ section.id }} .ag__arrow:hover { background: var(--a-ink); color: var(--a-paper); }
  #amour-{{ section.id }} .ag__track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }
  #amour-{{ section.id }} .ag__track::-webkit-scrollbar { display: none; }
  #amour-{{ section.id }} .ag__item { flex: 0 0 calc((100% - 48px) / 4); scroll-snap-align: start; display: flex; flex-direction: column; gap: 12px; color: inherit; text-decoration: none; }
  #amour-{{ section.id }} .ag__item .a-media { aspect-ratio: 3 / 4; }
  #amour-{{ section.id }} .ag__item .a-media img { transition: transform .6s ease; }
  #amour-{{ section.id }} .ag__item:hover .a-media img { transform: scale(1.04); }
  #amour-{{ section.id }} .ag__label { font-size: 16px; font-weight: 500; line-height: 1.6; }
  @media (max-width: 989px) { #amour-{{ section.id }} .ag__item { flex-basis: calc((100% - 16px) / 2.3); } }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .ag { padding: 64px 0; }
    #amour-{{ section.id }} .ag__nav { display: none; }
    #amour-{{ section.id }} .ag__track { margin: 0 -20px; padding: 0 20px; gap: 8px; }
    #amour-{{ section.id }} .ag__item { flex-basis: 70%; }
  }

</style>
<div id="amour-{{ section.id }}" class="roarr-amour color-{{ section_scheme }}">
<section class="ag"><div class="a-wrap">
  <div class="ag__head">
    {% if gallery_heading != blank %}<h2 class="a-h2">{{ gallery_heading }}</h2>{% endif %}
    <div class="ag__nav">
      <button type="button" class="ag__arrow" data-amour-prev aria-label="Previous"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M13 7H1M6 2L1 7l5 5" stroke="currentColor" stroke-width="1.4"/></svg></button>
      <button type="button" class="ag__arrow" data-amour-next aria-label="Next"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.4"/></svg></button>
    </div>
  </div>
  <div class="ag__track" data-amour-track>
    {%- for i in (1..6) -%}
      {%- case i -%}
        {%- when 1 -%}{%- assign g_img = product_image_1 -%}{%- assign g_label = gallery_1_label -%}
        {%- when 2 -%}{%- assign g_img = look_image_1 -%}{%- assign g_label = gallery_2_label -%}
        {%- when 3 -%}{%- assign g_img = product_image_2 -%}{%- assign g_label = gallery_3_label -%}
        {%- when 4 -%}{%- assign g_img = look_image_2 -%}{%- assign g_label = gallery_4_label -%}
        {%- when 5 -%}{%- assign g_img = product_image_3 -%}{%- assign g_label = gallery_5_label -%}
        {%- else -%}{%- assign g_img = look_image_3 -%}{%- assign g_label = gallery_6_label -%}
      {%- endcase -%}
      <a class="ag__item" href="{{ amour_product_url }}">
        <div class="a-media">{%- if g_img != blank -%}{%- if g_img contains 'http' or g_img contains '//' -%}<img src="{{ g_img }}" alt="{{ g_label | escape }}" loading="lazy" class="">{%- else -%}<img src="{{ g_img | image_url: width: 800 }}" alt="{{ g_label | escape }}" loading="lazy" class="">{%- endif -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'a-ph' }}{%- endif -%}</div>
        {% if g_label != blank %}<span class="ag__label">{{ g_label }}</span>{% endif %}
      </a>
    {%- endfor -%}
  </div>
</div></section>
</div>
<script>(function(){
  var root = document.getElementById('amour-{{ section.id }}'); if (!root) return;
  var track = root.querySelector('[data-amour-track]'); if (!track) return;
  function step(){ var item = track.querySelector('.ag__item'); return item ? item.getBoundingClientRect().width + 16 : 300; }
  var prev = root.querySelector('[data-amour-prev]'), next = root.querySelector('[data-amour-next]');
  if (prev) prev.addEventListener('click', function(){ track.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function(){ track.scrollBy({ left: step(), behavior: 'smooth' }); });
})();</script>
{% endif %}

{% schema %}
{
  "name": "Roarr - Amour Gallery",
  "tag": "section",
  "class": "roarr-amour-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_kluck_ai_metafields",
      "label": "Use Roarr metafields",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#6b0808"
    },
    {
      "type": "color",
      "id": "blush_color",
      "label": "Soft background color",
      "default": "#ffe3de"
    },
    {
      "type": "image_picker",
      "id": "product_image_1",
      "label": "Photo 1 (3:4)"
    },
    {
      "type": "image_picker",
      "id": "look_image_1",
      "label": "Photo 2 (3:4)"
    },
    {
      "type": "image_picker",
      "id": "product_image_2",
      "label": "Photo 3 (3:4)"
    },
    {
      "type": "image_picker",
      "id": "look_image_2",
      "label": "Photo 4 (3:4)"
    },
    {
      "type": "image_picker",
      "id": "product_image_3",
      "label": "Photo 5 (3:4)"
    },
    {
      "type": "image_picker",
      "id": "look_image_3",
      "label": "Photo 6 (3:4)"
    },
    {
      "type": "text",
      "id": "gallery_heading",
      "label": "Heading",
      "default": "Seen on you"
    },
    {
      "type": "text",
      "id": "gallery_1_label",
      "label": "Photo 1 label",
      "default": "Everyday ease"
    },
    {
      "type": "text",
      "id": "gallery_2_label",
      "label": "Photo 2 label",
      "default": "Gift ready"
    },
    {
      "type": "text",
      "id": "gallery_3_label",
      "label": "Photo 3 label",
      "default": "Made to shine"
    },
    {
      "type": "text",
      "id": "gallery_4_label",
      "label": "Photo 4 label",
      "default": "Little details"
    },
    {
      "type": "text",
      "id": "gallery_5_label",
      "label": "Photo 5 label",
      "default": "Your new favourite"
    },
    {
      "type": "text",
      "id": "gallery_6_label",
      "label": "Photo 6 label",
      "default": "Shop the look"
    }
  ],
  "presets": [
    {
      "name": "Roarr - Amour Gallery"
    }
  ]
}
{% endschema %}
