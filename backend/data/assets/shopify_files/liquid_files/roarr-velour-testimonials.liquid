{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- capture vr_html -%}
<section class="vr-rv" data-vr-rail>
  <div class="vr-wrap">
    <div class="vr-head">
      {%- if ht.testimonials_kicker != blank -%}<p class="vr-kick">{{ ht.testimonials_kicker }}</p>{%- endif -%}
      <h2 class="vr-title">{{ ht.testimonials_heading }}</h2>
    </div>
    <div class="vr-rail__track" data-vr-track data-vr-reveal="right">
      {%- for i in (1..3) -%}
        {%- assign name_key = 'customer_name_' | append: i -%}
        {%- assign review_key = 'customer_review_' | append: i -%}
        {%- assign role_key = 'customer_role_' | append: i -%}
        {%- assign avatar_key = 'customer_avatar_' | append: i -%}
        {%- if ht[review_key] != blank -%}
          <figure class="vr-rv__card">
            <div class="vr-rv__panel">
              <span class="vr-rv__stars" role="img" aria-label="5 / 5">★★★★★</span>
              <blockquote class="vr-rv__quote">{{ ht[review_key] }}</blockquote>
              <figcaption>
                <span class="vr-rv__name">{{ ht[name_key] }}</span>
                {%- if ht[role_key] != blank -%}<span class="vr-rv__role">{{ ht[role_key] }}</span>{%- endif -%}
              </figcaption>
            </div>
            <div class="vr-rv__pic">
              {%- if hi[avatar_key] != blank -%}
                {%- render 'roarr-velour-img', src: hi[avatar_key], alt: ht[name_key], width: 320, lazy: true -%}
              {%- else -%}
                <span class="vr-rv__initial" aria-hidden="true">{{ ht[name_key] | slice: 0 }}</span>
              {%- endif -%}
            </div>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <hr class="vr-rule vr-rv__rule" data-vr-reveal>
  </div>
</section>
<style>
  .vr .vr-rv { padding-block: 120px; background: #fff; }
  .vr .vr-rv .vr-rail__track { --vr-gap: 30px; --vr-col: calc((100% - 60px) / 3); }
  .vr .vr-rv__card { display: grid; grid-template-columns: minmax(0, 1fr) 120px; gap: 5px; min-height: 255px; }
  .vr .vr-rv__panel { display: flex; flex-direction: column; padding: 22px; border-radius: 5px; background: var(--vr-review); }
  .vr .vr-rv__stars { font-size: 14px; line-height: 18px; letter-spacing: 2px; color: var(--vr-ink); }
  .vr .vr-rv__quote { flex: 1; margin-top: 20px; font-size: 14.4px; line-height: 23px; color: var(--vr-text); }
  .vr .vr-rv__name { display: block; margin-top: 18px; font-size: 12px; line-height: 18px; font-weight: 500; color: var(--vr-ink); }
  .vr .vr-rv__role { display: block; font-size: 11.5px; line-height: 17px; color: var(--vr-text); }
  .vr .vr-rv__pic { overflow: hidden; border-radius: 5px; background: var(--vr-review); }
  .vr .vr-rv__pic img { width: 100%; height: 100%; object-fit: cover; }
  .vr .vr-rv__initial { display: grid; place-items: center; height: 100%; font-size: 34px; font-weight: 500; color: var(--vr-muted); }
  .vr .vr-rv__rule { margin-top: 120px; }
  @media (max-width: 1100px) { .vr .vr-rv .vr-rail__track { --vr-col: calc((100% - 30px) / 2); } }
  @media (max-width: 749px) {
    .vr .vr-rv { padding-block: 60px; }
    .vr .vr-rv .vr-rail__track { --vr-col: 100%; --vr-gap: 10px; }
    .vr .vr-rv__card { grid-template-columns: minmax(0, 1fr) 100px; }
    .vr .vr-rv__rule { margin-top: 60px; }
  }
</style>
{%- endcapture -%}
{%- render 'roarr-velour-wrap', html: vr_html -%}

{% schema %}
{
  "name": "Velour Testimonials",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Velour Testimonials" }]
}
{% endschema %}
