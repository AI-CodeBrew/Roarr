{%- assign section_scheme = section.settings.color_scheme | default: 'scheme-1' -%}
{% assign store_gen = shop.metafields.kluck_ai.store_generation.value %}
{% assign home = store_gen.home_page %}
{% assign ht = home.text %}
{% assign hi = home.images %}
{% assign use_mf = section.settings.use_kluck_ai_metafields %}
{% assign homeData = section.settings.homeData %}
{% if ht == blank and homeData.text != blank %}{% assign ht = homeData.text %}{% endif %}
{% if hi == blank and homeData.images != blank %}{% assign hi = homeData.images %}{% endif %}

{% assign split_heading = section.settings.split_heading %}
{% if use_mf and ht.split_heading != blank %}{% assign split_heading = ht.split_heading %}{% endif %}
{% assign split_card_1_label = section.settings.split_card_1_label %}
{% if use_mf and ht.split_card_1_label != blank %}{% assign split_card_1_label = ht.split_card_1_label %}{% endif %}
{% assign split_card_2_label = section.settings.split_card_2_label %}
{% if use_mf and ht.split_card_2_label != blank %}{% assign split_card_2_label = ht.split_card_2_label %}{% endif %}
{% assign split_image = section.settings.split_image %}
{% if use_mf %}{% if shop.metafields.kluck_ai.split_image.value != blank %}{% assign split_image = shop.metafields.kluck_ai.split_image.value %}{% elsif hi.split_image != blank %}{% assign split_image = hi.split_image %}{% endif %}{% endif %}
{% assign product_image_2 = section.settings.product_image_2 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.product_image_2.value != blank %}{% assign product_image_2 = shop.metafields.kluck_ai.product_image_2.value %}{% elsif hi.product_image_2 != blank %}{% assign product_image_2 = hi.product_image_2 %}{% endif %}{% endif %}
{% assign product_image_3 = section.settings.product_image_3 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.product_image_3.value != blank %}{% assign product_image_3 = shop.metafields.kluck_ai.product_image_3.value %}{% elsif hi.product_image_3 != blank %}{% assign product_image_3 = hi.product_image_3 %}{% endif %}{% endif %}

{% assign amour_product = blank %}
{% if section.settings.product != blank %}
  {% assign amour_product = section.settings.product %}
{% elsif ht.selected_product != blank %}
  {% assign amour_product = all_products[ht.selected_product] %}
{% endif %}
{% if amour_product == blank and collections.all.products.first != blank %}
  {% assign amour_product = collections.all.products.first %}
{% endif %}
{% assign amour_product_url = routes.all_products_collection_url %}
{% assign amour_product_title = section.settings.fallback_title %}
{% assign amour_product_price = section.settings.fallback_price %}
{% if amour_product != blank and amour_product.title != blank %}
  {% assign amour_product_url = amour_product.url %}
  {% assign amour_product_title = amour_product.title %}
  {% assign amour_product_price = amour_product.price | money %}
{% endif %}


{% if shop.metafields.app.block_control.value %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500&family=Cormorant+Garamond:ital,wght@1,400;1,500&display=swap">
<style>
  #shopify-section-{{ section.id }} { width: 100%; max-width: none; }
  #amour-{{ section.id }} {
  --a-ink: var(--color-foreground, #111111);
  --a-paper: var(--color-background, #ffffff);
  --a-wine: {{ section.settings.accent_color | default: '#6b0808' }};
  --a-on-wine: #ffffff;
  --a-blush: {{ section.settings.blush_color | default: '#ffe3de' }};
  --a-mist: #f2f1ef;
  --a-head: 'Syne', 'Helvetica Neue', Arial, sans-serif;
  --a-body: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  --a-serif: 'Cormorant Garamond', 'Times New Roman', serif;
  font-family: var(--a-body); color: var(--a-ink); background: var(--a-paper);
  }

  #amour-{{ section.id }}, #amour-{{ section.id }} * { box-sizing: border-box; }
  #amour-{{ section.id }} img { display: block; max-width: 100%; }
  #amour-{{ section.id }} .a-wrap { max-width: 1340px; margin: 0 auto; padding: 0 20px; }
  #amour-{{ section.id }} .a-h2 { margin: 0; font-family: var(--a-head); font-weight: 700; text-transform: uppercase; font-size: 40px; line-height: 1.2; letter-spacing: -0.01em; }
  #amour-{{ section.id }} .a-serif { font-family: var(--a-serif); font-style: italic; font-weight: 400; }
  #amour-{{ section.id }} .a-serif span, #amour-{{ section.id }} .a-serif p { font-family: inherit; font-style: inherit; font-weight: inherit; }
  #amour-{{ section.id }} .a-link { display: inline-block; font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; padding: 0 0 4px; }
  #amour-{{ section.id }} .a-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 32px; font-family: var(--a-body); font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none; transition: background .2s, color .2s; }
  #amour-{{ section.id }} .a-btn--light { background: #fff; color: #000; border: 1px solid #fff; }
  #amour-{{ section.id }} .a-btn--light:hover { background: transparent; color: #fff; }
  #amour-{{ section.id }} .a-btn--outline { background: transparent; color: var(--a-ink); border: 1px solid var(--a-ink); }
  #amour-{{ section.id }} .a-btn--outline:hover { background: var(--a-ink); color: var(--a-paper); }
  #amour-{{ section.id }} .a-media { position: relative; overflow: hidden; background: var(--a-mist); }
  #amour-{{ section.id }} .a-media img, #amour-{{ section.id }} .a-media svg { width: 100%; height: 100%; object-fit: cover; }
  #amour-{{ section.id }} .a-ph { width: 100%; height: 100%; fill: rgba(0,0,0,.18); background: var(--a-mist); }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .a-h2 { font-size: 28px; }
  }

  #amour-{{ section.id }} .asp { padding-top: 40px; }
  #amour-{{ section.id }} .asp__grid { display: grid; grid-template-columns: 1fr 1fr; }
  #amour-{{ section.id }} .asp__main { aspect-ratio: 1 / 1; }
  #amour-{{ section.id }} .asp__side { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 44px; padding: 32px 24px; text-align: center; }
  #amour-{{ section.id }} .asp__carousel { display: flex; align-items: center; justify-content: center; gap: 20px; width: 100%; }
  #amour-{{ section.id }} .asp__viewport { width: min(320px, 62%); overflow: hidden; }
  #amour-{{ section.id }} .asp__track { display: flex; transition: transform .5s ease; }
  #amour-{{ section.id }} .asp__slide { flex: 0 0 100%; display: flex; flex-direction: column; align-items: center; gap: 40px; }
  #amour-{{ section.id }} .asp__slide .a-media { width: 100%; aspect-ratio: 3 / 4; }
  #amour-{{ section.id }} .asp__arrow { flex: 0 0 auto; width: 56px; height: 56px; border-radius: 50%; border: 1.5px solid var(--a-ink); background: none; color: var(--a-ink); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: opacity .2s, background .2s, color .2s; margin-bottom: 68px; }
  #amour-{{ section.id }} .asp__arrow:hover:not([disabled]) { background: var(--a-ink); color: var(--a-paper); }
  #amour-{{ section.id }} .asp__arrow[disabled] { opacity: .35; cursor: default; }
  #amour-{{ section.id }} .asp__dots { display: flex; align-items: center; gap: 12px; }
  #amour-{{ section.id }} .asp__dot { width: 10px; height: 10px; padding: 0; border-radius: 50%; border: 1.5px solid var(--a-ink); background: var(--a-ink); cursor: pointer; transition: all .2s; }
  #amour-{{ section.id }} .asp__dot.is-active { width: 18px; height: 18px; background: transparent; }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .asp { padding-top: 24px; }
    #amour-{{ section.id }} .asp__grid { grid-template-columns: 1fr; }
    #amour-{{ section.id }} .asp__side { padding: 40px 16px 0; gap: 28px; }
    #amour-{{ section.id }} .asp__arrow { width: 44px; height: 44px; margin-bottom: 60px; }
    #amour-{{ section.id }} .asp__viewport { width: 64%; }
    #amour-{{ section.id }} .asp__slide { gap: 28px; }
  }

</style>
<div id="amour-{{ section.id }}" class="roarr-amour color-{{ section_scheme }}">
<section class="asp"><div class="asp__grid">
  <div class="asp__main a-media">{%- if split_image != blank -%}{%- if split_image contains 'http' or split_image contains '//' -%}<img src="{{ split_image }}" alt="{{ split_heading | escape }}" loading="lazy" class="">{%- else -%}<img src="{{ split_image | image_url: width: 1600 }}" alt="{{ split_heading | escape }}" loading="lazy" class="">{%- endif -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'a-ph' }}{%- endif -%}</div>
  <div class="asp__side">
    {% if split_heading != blank %}<h2 class="a-h2">{{ split_heading }}</h2>{% endif %}
    <div class="asp__carousel" data-amour-carousel>
      <button type="button" class="asp__arrow" data-amour-prev aria-label="Previous" disabled><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.6"/></svg></button>
      <div class="asp__viewport">
        <div class="asp__track" data-amour-track>
          <div class="asp__slide">
            <a class="a-media" href="{{ amour_product_url }}">{%- if product_image_2 != blank -%}{%- if product_image_2 contains 'http' or product_image_2 contains '//' -%}<img src="{{ product_image_2 }}" alt="{{ split_card_1_label | escape }}" loading="lazy" class="">{%- else -%}<img src="{{ product_image_2 | image_url: width: 800 }}" alt="{{ split_card_1_label | escape }}" loading="lazy" class="">{%- endif -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'a-ph' }}{%- endif -%}</a>
            {% if split_card_1_label != blank %}<a class="a-link" href="{{ amour_product_url }}">{{ split_card_1_label }}</a>{% endif %}
          </div>
          <div class="asp__slide">
            <a class="a-media" href="{{ amour_product_url }}">{%- if product_image_3 != blank -%}{%- if product_image_3 contains 'http' or product_image_3 contains '//' -%}<img src="{{ product_image_3 }}" alt="{{ split_card_2_label | escape }}" loading="lazy" class="">{%- else -%}<img src="{{ product_image_3 | image_url: width: 800 }}" alt="{{ split_card_2_label | escape }}" loading="lazy" class="">{%- endif -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'a-ph' }}{%- endif -%}</a>
            {% if split_card_2_label != blank %}<a class="a-link" href="{{ amour_product_url }}">{{ split_card_2_label }}</a>{% endif %}
          </div>
        </div>
      </div>
      <button type="button" class="asp__arrow" data-amour-next aria-label="Next"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6"/></svg></button>
    </div>
    <div class="asp__dots" role="tablist">
      <button type="button" class="asp__dot is-active" data-amour-dot="0" aria-label="Slide 1"></button>
      <button type="button" class="asp__dot" data-amour-dot="1" aria-label="Slide 2"></button>
    </div>
  </div>
</div></section>
</div>
<script>(function(){
  var root = document.getElementById('amour-{{ section.id }}'); if (!root) return;
  var track = root.querySelector('[data-amour-track]'); if (!track) return;
  var count = track.children.length, idx = 0;
  var prev = root.querySelector('[data-amour-prev]'), next = root.querySelector('[data-amour-next]');
  var dots = root.querySelectorAll('[data-amour-dot]');
  function go(i){
    idx = Math.max(0, Math.min(count - 1, i));
    track.style.transform = 'translateX(' + (-100 * idx) + '%)';
    prev.disabled = idx === 0; next.disabled = idx === count - 1;
    dots.forEach(function(d, j){ d.classList.toggle('is-active', j === idx); });
  }
  prev.addEventListener('click', function(){ go(idx - 1); });
  next.addEventListener('click', function(){ go(idx + 1); });
  dots.forEach(function(d, j){ d.addEventListener('click', function(){ go(j); }); });
  var x0 = null;
  track.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; }, { passive: true });
  track.addEventListener('touchend', function(e){ if (x0 === null) return; var dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) go(idx + (dx < 0 ? 1 : -1)); x0 = null; });
})();</script>
{% endif %}

{% schema %}
{
  "name": "Roarr - Amour Split",
  "tag": "section",
  "class": "roarr-amour-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_kluck_ai_metafields",
      "label": "Use Roarr metafields",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#6b0808"
    },
    {
      "type": "color",
      "id": "blush_color",
      "label": "Soft background color",
      "default": "#ffe3de"
    },
    {
      "type": "image_picker",
      "id": "split_image",
      "label": "Large image (1:1)"
    },
    {
      "type": "image_picker",
      "id": "product_image_2",
      "label": "Slide 1 image (3:4)"
    },
    {
      "type": "image_picker",
      "id": "product_image_3",
      "label": "Slide 2 image (3:4)"
    },
    {
      "type": "text",
      "id": "split_heading",
      "label": "Heading",
      "default": "Worn your way"
    },
    {
      "type": "text",
      "id": "split_card_1_label",
      "label": "Slide 1 link",
      "default": "View all products"
    },
    {
      "type": "text",
      "id": "split_card_2_label",
      "label": "Slide 2 link",
      "default": "Discover more"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Product title fallback",
      "default": "Signature piece"
    },
    {
      "type": "text",
      "id": "fallback_price",
      "label": "Product price fallback"
    }
  ],
  "presets": [
    {
      "name": "Roarr - Amour Split"
    }
  ]
}
{% endschema %}
