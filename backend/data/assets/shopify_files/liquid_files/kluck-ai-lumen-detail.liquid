{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500&display=swap">
{%- assign m = product.metafields.kluck_ai -%}
{%- assign eyebrow = m.lumen_detail_eyebrow.value | default: m.lumen_detail_eyebrow | default: 'In detail' -%}
{%- assign heading = m.lumen_detail_heading.value | default: m.lumen_detail_heading | default: 'A closer look' -%}
{%- assign text = m.lumen_detail_text.value | default: m.lumen_detail_text | default: 'The shape, the finish, the small details that make a piece worth keeping.' -%}
{%- assign img2 = m.product_image_2.value | default: m.product_image_2 -%}
{%- assign img3 = m.product_image_3.value | default: m.product_image_3 -%}
{%- assign img4 = m.product_image_4.value | default: m.product_image_4 -%}
{%- assign offset = 0 -%}
{%- if product.media.size >= 4 -%}{%- assign offset = 1 -%}{%- endif -%}
<section class="lmk-detail">
  <div class="lmk-detail__inner">
    <div class="lmk-detail__copy">
      <p class="lmk-eyebrow">{{ eyebrow }}</p>
      <h2 class="lmk-detail__title">{{ heading }}</h2>
      <p class="lmk-detail__text">{{ text }}</p>
    </div>
    <div class="lmk-detail__grid">
      {%- if product.media.size >= 2 -%}
        {%- for media in product.media offset: offset limit: 3 -%}
          {%- assign src = media.preview_image | default: media -%}
          <figure class="lmk-detail__item"><img src="{{ src | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy"></figure>
        {%- endfor -%}
      {%- else -%}
        {%- if img2 != blank -%}<figure class="lmk-detail__item"><img src="{{ img2 | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy"></figure>{%- endif -%}
        {%- if img3 != blank -%}<figure class="lmk-detail__item"><img src="{{ img3 | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy"></figure>{%- endif -%}
        {%- if img4 != blank -%}<figure class="lmk-detail__item"><img src="{{ img4 | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy"></figure>{%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  .lmk-detail { --lmk-ivory: #F6F1EA; --lmk-sand: #E6DCCF; --lmk-stone: #D9CFC2; --lmk-brass: #B08D57; --lmk-espresso: #2B2320; --lmk-muted: #6B5F58; background: var(--lmk-ivory); color: var(--lmk-espresso); font-family: "Jost", sans-serif; padding: clamp(40px, 5vw, 72px) 0; }
  .lmk-detail *, .lmk-detail *::before, .lmk-detail *::after { box-sizing: border-box; }
  .lmk-detail__inner { width: min(1180px, calc(100% - 48px)); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); align-items: center; gap: clamp(28px, 5vw, 72px); }
  .lmk-detail__copy { max-width: 360px; }
  .lmk-eyebrow { margin: 0 0 10px; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--lmk-muted); }
  .lmk-detail__title { margin: 0 0 12px; font-family: "Cormorant Garamond", serif; font-size: clamp(26px, 2.6vw, 34px); font-weight: 500; line-height: 1.15; }
  .lmk-detail__text { margin: 0; font-size: 15px; line-height: 1.7; color: var(--lmk-muted); }
  .lmk-detail__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .lmk-detail__item { margin: 0; aspect-ratio: 1; padding: 8px; background: #FFFDF9; border: 1px solid var(--lmk-stone); border-radius: 4px; overflow: hidden; transition: border-color 250ms ease; }
  .lmk-detail__item:hover { border-color: var(--lmk-brass); }
  .lmk-detail__item img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 2px; background: var(--lmk-sand); transition: transform 300ms ease; }
  .lmk-detail__item:hover img { transform: scale(1.03); }
  @media (max-width: 749px) {
    .lmk-detail__inner { grid-template-columns: 1fr; gap: 20px; width: calc(100% - 32px); }
    .lmk-detail__copy { max-width: none; text-align: center; }
    .lmk-detail__grid { gap: 8px; }
    .lmk-detail__item { padding: 5px; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--lumen" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "Jost", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Lumenook In Detail",
  "tag": "section",
  "class": "roarr-lumen-section",
  "settings": [],
  "presets": [{ "name": "Roarr Lumenook In Detail" }]
}
{% endschema %}
