{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Poppins:wght@400;500;600;700&display=swap">
{%- assign flower = section.settings.flower_image -%}
{%- assign p1 = section.settings.text_1 -%}
{%- assign p2 = section.settings.text_2 -%}
{%- assign p3 = section.settings.text_3 -%}
{%- assign p4 = section.settings.text_4 -%}
{%- if section.settings.text_source == 'marquee' -%}
  {%- if product.metafields.roarr.marquee_text_1 != blank -%}{%- assign p1 = product.metafields.roarr.marquee_text_1 -%}{%- endif -%}
  {%- if product.metafields.roarr.marquee_text_2 != blank -%}{%- assign p2 = product.metafields.roarr.marquee_text_2 -%}{%- endif -%}
  {%- if product.metafields.roarr.marquee_text_3 != blank -%}{%- assign p3 = product.metafields.roarr.marquee_text_3 -%}{%- endif -%}
  {%- assign p4 = '' -%}
{%- elsif section.settings.text_source == 'badges' -%}
  {%- if product.metafields.roarr.badge_text_1 != blank -%}{%- assign p1 = product.metafields.roarr.badge_text_1 -%}{%- endif -%}
  {%- if product.metafields.roarr.badge_text_2 != blank -%}{%- assign p2 = product.metafields.roarr.badge_text_2 -%}{%- endif -%}
  {%- if product.metafields.roarr.badge_text_3 != blank -%}{%- assign p3 = product.metafields.roarr.badge_text_3 -%}{%- endif -%}
  {%- if product.metafields.roarr.badge_text_4 != blank -%}{%- assign p4 = product.metafields.roarr.badge_text_4 -%}{%- endif -%}
{%- endif -%}
{%- capture phrases -%}
  {%- if p1 != blank -%}{{ p1 }}|{%- endif -%}
  {%- if p2 != blank -%}{{ p2 }}|{%- endif -%}
  {%- if p3 != blank -%}{{ p3 }}|{%- endif -%}
  {%- if p4 != blank -%}{{ p4 }}|{%- endif -%}
{%- endcapture -%}
{%- assign phrase_list = phrases | split: '|' -%}

<div class="roarr-play-marquee" aria-hidden="true">
  <div class="roarr-play-marquee__track">
    {%- for pass in (1..2) -%}
      <div class="roarr-play-marquee__set">
      {%- for copy in (1..12) -%}
      {%- for phrase in phrase_list -%}
        {%- assign label = phrase | strip -%}
        {%- if label != blank -%}
          <span>{{ label }}<img src="{{ flower }}" alt="" width="22" height="22"></span>
        {%- endif -%}
      {%- endfor -%}
      {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% style %}

  @import url("https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Poppins:wght@400;500;600;700&display=swap");
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    max-width: none !important;
    font-family: Poppins, sans-serif !important;
  }
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} .roarr-play-hero__badge,
  #shopify-section-{{ section.id }} .roarr-play-designed__badge,
  #shopify-section-{{ section.id }} .roarr-play-marquee__track span,
  #shopify-section-{{ section.id }} .roarr-play-story__mix,
  #shopify-section-{{ section.id }} summary {
    font-family: "Caveat Brush", cursive !important;
    font-weight: 400 !important;
    font-style: normal !important;
    text-transform: none !important;
    letter-spacing: normal !important;
  }
  #shopify-section-{{ section.id }} p,
  #shopify-section-{{ section.id }} button,
  #shopify-section-{{ section.id }} b,
  #shopify-section-{{ section.id }} strong,
  #shopify-section-{{ section.id }} .roarr-play-hero__kicker,
  #shopify-section-{{ section.id }} .roarr-play-hero__price,
  #shopify-section-{{ section.id }} .roarr-play-story__pills span,
  #shopify-section-{{ section.id }} .roarr-play-promo__code,
  #shopify-section-{{ section.id }} details p {
    font-family: Poppins, sans-serif !important;
    text-transform: none;
  }
  #shopify-section-{{ section.id }} button {
    text-transform: none !important;
    letter-spacing: normal !important;
    box-shadow: none;
    min-height: 0;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} button:before,
  #shopify-section-{{ section.id }} button:after { content: none !important; display: none !important; }
  #shopify-section-{{ section.id }} { margin: 0; padding: 0; }
  #shopify-section-{{ section.id }} .roarr-play-marquee {
    width: 100%;
    max-width: none;
    background: {{ section.settings.background }};
    overflow: hidden;
    border-top: 1px solid #6F2424;
    border-bottom: 1px solid #6F2424;
    color: #6F2424;
  }
  #shopify-section-{{ section.id }} .roarr-play-marquee__track {
    display: flex;
    width: max-content;
    animation: roarr-play-ticker-{{ section.id }} 40s linear infinite;
  }
  #shopify-section-{{ section.id }} .roarr-play-marquee__set {
    display: flex;
    align-items: center;
    flex: none;
  }
  #shopify-section-{{ section.id }} .roarr-play-marquee__track span {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-family: "Caveat Brush", cursive !important;
    font-size: 28px !important;
    line-height: 1 !important;
    padding: 10px 16px;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .roarr-play-marquee__track img { width: 22px; height: 22px; }
  @keyframes roarr-play-ticker-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
{% endstyle %}
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--play" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: Poppins, "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Caveat Brush", "Lalezar", "Tajawal", cursive !important; line-height: 1.4 !important; font-weight: 400 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Play Marquee",
  "tag": "section",
  "class": "roarr-play-section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#FFC2D4" },
    { "type": "text", "id": "text_1", "label": "Phrase 1", "default": "Sale 50% Off" },
    { "type": "text", "id": "text_2", "label": "Phrase 2", "default": "Giving back 10%" },
    { "type": "text", "id": "text_3", "label": "Phrase 3", "default": "Black Friday" },
    { "type": "text", "id": "text_4", "label": "Phrase 4" },
    { "type": "text", "id": "flower_image", "label": "Separator image" },
    {
      "type": "select",
      "id": "text_source",
      "label": "Phrase source",
      "default": "settings",
      "options": [
        { "value": "settings", "label": "Section text" },
        { "value": "marquee", "label": "Generated ticker" },
        { "value": "badges", "label": "Generated badges" }
      ]
    }
  ],
  "presets": [{ "name": "Roarr Play Marquee" }]
}
{% endschema %}
