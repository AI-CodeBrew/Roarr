{%- capture kl_rtl_html -%}
{%- assign m = product.metafields.kluck_ai -%}
{%- assign kicker = m.four_blocks_heading.value | default: m.four_blocks_heading | default: 'Ingredients' -%}
{%- assign heading = m.four_blocks_subheading.value | default: m.four_blocks_subheading | default: 'Powered by a soft-matte complex' -%}
{%- assign intro = m.ingredients_intro.value | default: m.ingredients_intro -%}
{%- assign n1 = m.four_blocks_block_1_name.value | default: m.four_blocks_block_1_name | default: 'Ceramides' -%}
{%- assign d1 = m.four_blocks_block_1_desc.value | default: m.four_blocks_block_1_desc -%}
{%- assign n2 = m.four_blocks_block_2_name.value | default: m.four_blocks_block_2_name | default: 'Ectoin' -%}
{%- assign d2 = m.four_blocks_block_2_desc.value | default: m.four_blocks_block_2_desc -%}
{%- assign n3 = m.four_blocks_block_3_name.value | default: m.four_blocks_block_3_name | default: 'Prebiotics' -%}
{%- assign d3 = m.four_blocks_block_3_desc.value | default: m.four_blocks_block_3_desc -%}
{%- assign side = m.product_highlight_2.value | default: m.product_highlight_2 -%}
{%- assign bottle = m.feature_image.value | default: m.feature_image -%}
<section class="gl-ing">
  <div class="gl-ing-col">
    <div class="gl-ing-copy">
      <p>{{ kicker }}</p>
      <h2>{{ heading }}</h2>
      {%- if intro != blank -%}<span>{{ intro }}</span>{%- endif -%}
    </div>
    {%- if bottle != blank -%}<img class="gl-ing-photo" src="{{ bottle | image_url: width: 1400 }}" alt="">{%- endif -%}
  </div>
  <div class="gl-ing-col">
    {%- if side != blank -%}<img class="gl-ing-side" src="{{ side | image_url: width: 1200 }}" alt="">{%- endif -%}
    <ul>
      <li>
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <circle cx="48" cy="54" r="26" fill="#e7b7b4"/>
          <circle cx="78" cy="46" r="18" fill="#f3d2cb"/>
          <circle cx="72" cy="78" r="16" fill="#d99596"/>
          <circle cx="38" cy="82" r="10" fill="#f6e4dc"/>
          <circle cx="58" cy="40" r="6" fill="#fff" opacity=".7"/>
        </svg>
        <div><strong>{{ n1 }}</strong>{%- if d1 != blank -%}<span>{{ d1 }}</span>{%- endif -%}</div>
      </li>
      <li>
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <path d="M44 22c10 16 22 34 22 48a22 22 0 1 1-44 0c0-14 12-32 22-48z" fill="#f3ddb0"/>
          <path d="M82 38c7 12 15 24 15 34a15 15 0 1 1-30 0c0-10 8-22 15-34z" fill="#e7c98a"/>
          <ellipse cx="40" cy="58" rx="5" ry="9" fill="#fff" opacity=".65"/>
          <ellipse cx="78" cy="64" rx="3.5" ry="6" fill="#fff" opacity=".55"/>
        </svg>
        <div><strong>{{ n2 }}</strong>{%- if d2 != blank -%}<span>{{ d2 }}</span>{%- endif -%}</div>
      </li>
      <li>
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <path d="M16 46c24-20 64-20 88 2" fill="none" stroke="#e4d3c4" stroke-width="12" stroke-linecap="round"/>
          <path d="M20 66c22-16 58-16 80 4" fill="none" stroke="#f0e4d8" stroke-width="10" stroke-linecap="round"/>
          <path d="M26 86c18-12 50-10 68 6" fill="none" stroke="#cbb5a2" stroke-width="8" stroke-linecap="round"/>
        </svg>
        <div><strong>{{ n3 }}</strong>{%- if d3 != blank -%}<span>{{ d3 }}</span>{%- endif -%}</div>
      </li>
    </ul>
  </div>
</section>
<style>
  .gl-ing { background: #fff; color: #111; font-family: "DM Sans", sans-serif; width: min(1240px, calc(100% - 48px)); margin: 0 auto; padding: 0 0 88px; display: grid; grid-template-columns: 605px minmax(0, 1fr); column-gap: 32px; align-items: start; }
  .gl-ing-col { display: flex; flex-direction: column; min-width: 0; }
  .gl-ing-col:first-child { padding-top: 80px; gap: 100px; }
  .gl-ing-col:last-child { padding-inline-start: 100px; gap: 100px; align-items: flex-end; }
  .gl-ing-copy { max-width: 604px; }
  .gl-ing-copy p { margin: 0 0 12px; letter-spacing: 0.9px; text-transform: uppercase; font-size: 18px; font-weight: 500; line-height: 1.55; }
  .gl-ing h2 { font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: 56px; line-height: 1.21; margin: 0 0 12px; }
  .gl-ing-copy span { display: block; font-size: 20px; line-height: 1.5; color: #111; }
  .gl-ing-photo { width: 605px; max-width: 100%; aspect-ratio: 1210 / 1540; object-fit: cover; display: block; }
  .gl-ing-side { width: 500px; max-width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }
  .gl-ing ul { list-style: none; margin: 0; padding: 0; width: 500px; max-width: 100%; display: flex; flex-direction: column; gap: 28px; }
  .gl-ing li { display: grid; grid-template-columns: 100px 1fr; gap: 24px; align-items: center; }
  .gl-ing svg { width: 100px; height: 100px; }
  .gl-ing strong { display: block; text-transform: uppercase; font-size: 32px; font-weight: 500; line-height: 1.375; margin-bottom: 8px; letter-spacing: 0; }
  .gl-ing li span { display: block; font-size: 16px; line-height: 1.625; color: #111; max-width: 380px; }
  @media (max-width: 1100px) {
    .gl-ing { grid-template-columns: 1fr 1fr; }
    .gl-ing-col:last-child { padding-inline-start: 24px; }
    .gl-ing-photo, .gl-ing-side, .gl-ing ul { width: 100%; }
  }
  @media (max-width: 800px) {
    .gl-ing { grid-template-columns: 1fr; width: calc(100% - 32px); row-gap: 32px; }
    .gl-ing-col:first-child { padding-top: 32px; gap: 32px; }
    .gl-ing-col:last-child { padding-inline-start: 0; gap: 32px; align-items: stretch; }
    .gl-ing h2 { font-size: 42px; }
    .gl-ing strong { font-size: 22px; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--glow" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "DM Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Glow Ingredients",
  "tag": "section",
  "class": "roarr-glow-section",
  "settings": [],
  "presets": [{ "name": "Roarr Glow Ingredients" }]
}
{% endschema %}
