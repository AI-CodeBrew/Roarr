{%- assign section_scheme = section.settings.color_scheme | default: 'scheme-1' -%}
{% assign store_gen = shop.metafields.roarr.store_generation.value %}
{% assign home = store_gen.home_page %}
{% assign ht = home.text %}
{% assign hi = home.images %}
{% assign use_mf = section.settings.use_roarr_metafields %}
{% assign homeData = section.settings.homeData %}
{% if ht == blank and homeData.text != blank %}{% assign ht = homeData.text %}{% endif %}
{% if hi == blank and homeData.images != blank %}{% assign hi = homeData.images %}{% endif %}

{% assign countdown_heading = section.settings.countdown_heading %}
{% if use_mf and ht.countdown_heading != blank %}{% assign countdown_heading = ht.countdown_heading %}{% endif %}
{% assign countdown_subheading = section.settings.countdown_subheading %}
{% if use_mf and ht.countdown_subheading != blank %}{% assign countdown_subheading = ht.countdown_subheading %}{% endif %}
{% assign countdown_cta = section.settings.countdown_cta %}
{% if use_mf and ht.countdown_cta != blank %}{% assign countdown_cta = ht.countdown_cta %}{% endif %}


{% assign amour_product = blank %}
{% if section.settings.product != blank %}
  {% assign amour_product = section.settings.product %}
{% elsif ht.selected_product != blank %}
  {% assign amour_product = all_products[ht.selected_product] %}
{% endif %}
{% if amour_product == blank and collections.all.products.first != blank %}
  {% assign amour_product = collections.all.products.first %}
{% endif %}
{% assign amour_product_url = routes.all_products_collection_url %}
{% assign amour_product_title = section.settings.fallback_title %}
{% assign amour_product_price = section.settings.fallback_price %}
{% if amour_product != blank and amour_product.title != blank %}
  {% assign amour_product_url = amour_product.url %}
  {% assign amour_product_title = amour_product.title %}
  {% assign amour_product_price = amour_product.price | money %}
{% endif %}


{% if shop.metafields.app.block_control.value %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500&family=Cormorant+Garamond:ital,wght@1,400;1,500&display=swap">
<style>
  #shopify-section-{{ section.id }} { width: 100%; max-width: none; }
  #amour-{{ section.id }} {
  --a-ink: var(--color-foreground, #111111);
  --a-paper: var(--color-background, #ffffff);
  --a-wine: {{ section.settings.accent_color | default: '#6b0808' }};
  --a-on-wine: #ffffff;
  --a-blush: {{ section.settings.blush_color | default: '#ffe3de' }};
  --a-mist: #f2f1ef;
  --a-head: 'Syne', 'Helvetica Neue', Arial, sans-serif;
  --a-body: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  --a-serif: 'Cormorant Garamond', 'Times New Roman', serif;
  font-family: var(--a-body); color: var(--a-ink); background: var(--a-paper);
  }

  #amour-{{ section.id }}, #amour-{{ section.id }} * { box-sizing: border-box; }
  #amour-{{ section.id }} img { display: block; max-width: 100%; }
  #amour-{{ section.id }} .a-wrap { max-width: 1340px; margin: 0 auto; padding: 0 20px; }
  #amour-{{ section.id }} .a-h2 { margin: 0; font-family: var(--a-head); font-weight: 700; text-transform: uppercase; font-size: 40px; line-height: 1.2; letter-spacing: -0.01em; }
  #amour-{{ section.id }} .a-serif { font-family: var(--a-serif); font-style: italic; font-weight: 400; }
  #amour-{{ section.id }} .a-serif span, #amour-{{ section.id }} .a-serif p { font-family: inherit; font-style: inherit; font-weight: inherit; }
  #amour-{{ section.id }} .a-link { display: inline-block; font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; padding: 0 0 4px; }
  #amour-{{ section.id }} .a-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 32px; font-family: var(--a-body); font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none; transition: background .2s, color .2s; }
  #amour-{{ section.id }} .a-btn--light { background: #fff; color: #000; border: 1px solid #fff; }
  #amour-{{ section.id }} .a-btn--light:hover { background: transparent; color: #fff; }
  #amour-{{ section.id }} .a-btn--outline { background: transparent; color: var(--a-ink); border: 1px solid var(--a-ink); }
  #amour-{{ section.id }} .a-btn--outline:hover { background: var(--a-ink); color: var(--a-paper); }
  #amour-{{ section.id }} .a-media { position: relative; overflow: hidden; background: var(--a-mist); }
  #amour-{{ section.id }} .a-media img, #amour-{{ section.id }} .a-media svg { width: 100%; height: 100%; object-fit: cover; }
  #amour-{{ section.id }} .a-ph { width: 100%; height: 100%; fill: rgba(0,0,0,.18); background: var(--a-mist); }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .a-h2 { font-size: 28px; }
  }

  #amour-{{ section.id }} .ac { padding: 16px 0; }
  #amour-{{ section.id }} .ac__box { background: var(--a-wine); color: var(--a-on-wine); padding: 40px 52px; display: grid; grid-template-columns: 1.2fr 1fr 1.2fr; grid-template-rows: auto auto; gap: 12px 60px; align-items: center; }
  #amour-{{ section.id }} .ac__heading { grid-column: 1; grid-row: 1; margin: 0; font-size: 56px; line-height: 1.1; text-transform: uppercase; }
  #amour-{{ section.id }} .ac__sub { grid-column: 2; grid-row: 1 / span 2; margin: 0; font-family: var(--a-head); font-weight: 600; font-size: 18px; line-height: 1.55; text-transform: uppercase; max-width: 264px; }
  #amour-{{ section.id }} .ac__timer { grid-column: 3; grid-row: 1 / span 2; display: flex; align-items: center; justify-content: flex-end; gap: 12px; font-size: 64px; line-height: 1; }
  #amour-{{ section.id }} .ac__sep { font-size: 40px; opacity: .8; }
  #amour-{{ section.id }} .ac__cta { grid-column: 1; grid-row: 2; justify-self: start; color: var(--a-on-wine); }
  @media (max-width: 989px) {
    #amour-{{ section.id }} .ac__box { grid-template-columns: 1fr; gap: 20px; padding: 40px 28px; text-align: center; }
    #amour-{{ section.id }} .ac__heading, #amour-{{ section.id }} .ac__sub, #amour-{{ section.id }} .ac__timer, #amour-{{ section.id }} .ac__cta { grid-column: 1; grid-row: auto; justify-self: center; }
    #amour-{{ section.id }} .ac__sub { max-width: none; }
    #amour-{{ section.id }} .ac__timer { justify-content: center; font-size: 48px; }
    #amour-{{ section.id }} .ac__heading { font-size: 40px; }
  }

</style>
<div id="amour-{{ section.id }}" class="roarr-amour color-{{ section_scheme }}">
<section class="ac"><div class="a-wrap"><div class="ac__box">
  {% if countdown_heading != blank %}<h2 class="ac__heading a-serif">{{ countdown_heading }}</h2>{% endif %}
  {% if countdown_subheading != blank %}<p class="ac__sub">{{ countdown_subheading }}</p>{% endif %}
  <div class="ac__timer a-serif" data-amour-timer data-hours="{{ section.settings.countdown_hours | default: 24 }}">
    <span data-d>00</span><span class="ac__sep">:</span><span data-h>00</span><span class="ac__sep">:</span><span data-m>00</span><span class="ac__sep">:</span><span data-s>00</span>
  </div>
  {% if countdown_cta != blank %}<a class="ac__cta a-link" href="{{ amour_product_url }}">{{ countdown_cta }}</a>{% endif %}
</div></div></section>
</div>
<script>(function(){
  var root = document.getElementById('amour-{{ section.id }}'); if (!root) return;
  var t = root.querySelector('[data-amour-timer]'); if (!t) return;
  var hours = parseFloat(t.getAttribute('data-hours')) || 24, span = hours * 3600000, key = 'amour-countdown-{{ section.id }}', end;
  try { end = parseInt(localStorage.getItem(key), 10); } catch (e) {}
  if (!end || end < Date.now()) { end = Date.now() + span; try { localStorage.setItem(key, end); } catch (e) {} }
  function pad(n){ return (n < 10 ? '0' : '') + n; }
  function tick(){
    var left = end - Date.now();
    if (left <= 0) { end = Date.now() + span; try { localStorage.setItem(key, end); } catch (e) {} left = span; }
    var s = Math.floor(left / 1000);
    t.querySelector('[data-d]').textContent = pad(Math.floor(s / 86400));
    t.querySelector('[data-h]').textContent = pad(Math.floor(s % 86400 / 3600));
    t.querySelector('[data-m]').textContent = pad(Math.floor(s % 3600 / 60));
    t.querySelector('[data-s]').textContent = pad(s % 60);
  }
  tick(); setInterval(tick, 1000);
})();</script>
{% endif %}

{% schema %}
{
  "name": "Roarr - Amour Offer",
  "tag": "section",
  "class": "roarr-amour-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_roarr_metafields",
      "label": "Use Roarr metafields",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#6b0808"
    },
    {
      "type": "color",
      "id": "blush_color",
      "label": "Soft background color",
      "default": "#ffe3de"
    },
    {
      "type": "text",
      "id": "countdown_heading",
      "label": "Heading",
      "default": "Limited time only"
    },
    {
      "type": "text",
      "id": "countdown_subheading",
      "label": "Subheading",
      "default": "Order today and enjoy fast, tracked delivery"
    },
    {
      "type": "text",
      "id": "countdown_cta",
      "label": "Link label",
      "default": "Claim the offer"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Product title fallback",
      "default": "Signature piece"
    },
    {
      "type": "text",
      "id": "fallback_price",
      "label": "Product price fallback"
    },
    {
      "type": "range",
      "id": "countdown_hours",
      "label": "Countdown length (hours)",
      "min": 1,
      "max": 72,
      "step": 1,
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Roarr - Amour Offer"
    }
  ]
}
{% endschema %}
