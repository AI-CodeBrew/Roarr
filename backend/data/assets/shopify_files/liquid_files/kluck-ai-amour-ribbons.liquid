{% schema %}
{
  "name": "Kluck AI - Amour Ribbons",
  "tag": "section",
  "class": "kluck-amour-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_kluck_ai_metafields",
      "label": "Use Kluck AI metafields",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#6b0808"
    },
    {
      "type": "color",
      "id": "blush_color",
      "label": "Soft background color",
      "default": "#ffe3de"
    },
    {
      "type": "text",
      "id": "ribbon_1",
      "label": "Phrase 1",
      "default": "Free shipping"
    },
    {
      "type": "text",
      "id": "ribbon_2",
      "label": "Phrase 2",
      "default": "Easy returns"
    },
    {
      "type": "text",
      "id": "ribbon_3",
      "label": "Phrase 3",
      "default": "Secure checkout"
    },
    {
      "type": "text",
      "id": "ribbon_4",
      "label": "Phrase 4",
      "default": "Gift ready"
    }
  ],
  "presets": [
    {
      "name": "Kluck AI - Amour Ribbons"
    }
  ]
}
{% endschema %}
