  <div class="ar__band ar__band--b a-serif"><div class="a-marquee"><div class="a-marquee__track"><div class="a-marquee__group">{% if ribbon_3 != blank %}<span class="a-marquee__item">{{ ribbon_3 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_4 != blank %}<span class="a-marquee__item">{{ ribbon_4 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_1 != blank %}<span class="a-marquee__item">{{ ribbon_1 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_2 != blank %}<span class="a-marquee__item">{{ ribbon_2 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_3 != blank %}<span class="a-marquee__item">{{ ribbon_3 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_4 != blank %}<span class="a-marquee__item">{{ ribbon_4 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_1 != blank %}<span class="a-marquee__item">{{ ribbon_1 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_2 != blank %}<span class="a-marquee__item">{{ ribbon_2 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_3 != blank %}<span class="a-marquee__item">{{ ribbon_3 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_4 != blank %}<span class="a-marquee__item">{{ ribbon_4 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_1 != blank %}<span class="a-marquee__item">{{ ribbon_1 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if ribbon_2 != blank %}<span class="a-marquee__item">{{ ribbon_2 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}</div><div class="a-marquee__group" aria-hidden="true">{% if ribbon_3 != blank %}<span class="a-marquee__item">{{ ribbon_3 }}</span><span class="