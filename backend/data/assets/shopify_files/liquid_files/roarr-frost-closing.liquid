{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
{%- assign m = product.metafields.roarr -%}
{%- assign heading = m.frost_closing_heading.value | default: m.frost_closing_heading | default: 'Ready when you are' -%}
{%- assign text = m.frost_closing_text.value | default: m.frost_closing_text | default: 'Order today and it is on its way within 1 to 2 working days, with free returns.' -%}
{%- assign img = m.product_impact_image.value | default: m.product_impact_image -%}
{%- if img == blank and product.media.size > 0 -%}
  {%- assign last_media = product.media | last -%}
  {%- assign img = last_media.preview_image | default: last_media -%}
{%- endif -%}
{%- assign variant = product.selected_or_first_available_variant -%}
<section class="fr-closing">
  <div class="fr-wrap">
    <div class="fr-closing__panel">
      {%- if img != blank -%}<img class="fr-closing__bg" src="{{ img | image_url: width: 2000 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
      <div class="fr-closing__copy">
        <h2 class="fr-display"><span class="fr-grad">{{ heading }}</span></h2>
        <p class="fr-lead">{{ text }}</p>
        <div class="fr-closing__buy">
          <strong class="fr-closing__price">{{ product.price | money }}</strong>
          {%- if product.variants.size > 1 -%}
            <a class="fr-btn" href="#fr-hero">{% render 'roarr-ui-string', key: 'add_to_cart' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          {%- else -%}
            {%- form 'product', product, class: 'fr-closing__form' -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
              <button class="fr-btn" type="submit"{% if variant.available == false %} disabled{% endif %}>{%- if variant.available != false -%}{% render 'roarr-ui-string', key: 'add_to_cart' %}{%- else -%}{% render 'roarr-ui-string', key: 'sold_out' %}{%- endif -%} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
            {%- endform -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .fr-closing { --fr-white: #FFFFFF; --fr-mist: #F3F6FA; --fr-ice: #E7EEFB; --fr-line: #E2E7EF; --fr-ink: #0B1324; --fr-muted: #586377; --fr-blue: #2F5BFF; --fr-blue-dark: #1C3CD6; --fr-blue-soft: #E8EEFF; --fr-night: #0A0F1E; --font-heading-family: "Plus Jakarta Sans", sans-serif; --font-body-family: "Plus Jakarta Sans", sans-serif; background: var(--fr-white); color: var(--fr-ink); font-family: "Plus Jakarta Sans", sans-serif; padding: 0 0 clamp(48px, 6vw, 96px); }
  .fr-closing *, .fr-closing *::before, .fr-closing *::after { box-sizing: border-box; }
  .fr-wrap { width: min(1240px, calc(100% - 48px)); margin: 0 auto; }
  .fr-intro { max-width: 760px; margin-bottom: clamp(36px, 5vw, 64px); }
  .fr-intro--center { margin-inline: auto; text-align: center; }
  .fr-intro--center .fr-label { justify-content: center; }
  .fr-label { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .01em; color: var(--fr-blue); }
  .fr-label b { display: inline-grid; place-items: center; min-width: 32px; height: 22px; padding: 0 8px; border-radius: 999px; background: var(--fr-blue-soft); color: var(--fr-blue); font-size: 11px; font-weight: 800; letter-spacing: .04em; }
  .fr-display { margin: 16px 0 0; font-weight: 800; font-size: clamp(38px, 5.4vw, 76px); line-height: 1; letter-spacing: -0.045em; color: var(--fr-ink); text-wrap: balance; }
  .fr-display .fr-grad, .fr-hero__title .fr-grad { font-size: inherit; font-weight: inherit; line-height: inherit; letter-spacing: inherit; background: linear-gradient(100deg, var(--fr-ink) 0%, var(--fr-ink) 30%, var(--fr-blue) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .fr-lead { margin: 18px 0 0; font-size: clamp(16px, 1.3vw, 18px); line-height: 1.6; color: var(--fr-muted); }
  @media (max-width: 749px) { .fr-wrap { width: calc(100% - 32px); } }
  .fr-closing__panel { position: relative; overflow: hidden; display: flex; justify-content: center; min-height: clamp(580px, 62vw, 820px); padding: clamp(48px, 7vw, 104px) 24px; border-radius: 40px; background: var(--fr-ice); }
  .fr-closing__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center bottom; display: block; }
  .fr-closing__panel::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(255 255 255 / .94) 0%, rgb(255 255 255 / .7) 32%, rgb(255 255 255 / 0) 58%); pointer-events: none; }
  .fr-closing__copy { position: relative; display: grid; justify-items: center; align-content: start; max-width: 760px; text-align: center; }
  .fr-closing .fr-display { margin: 0; font-size: clamp(40px, 6vw, 88px); }
  .fr-closing__buy { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 18px; margin-top: 28px; }
  .fr-closing__price { font-size: 28px; font-weight: 800; letter-spacing: -0.03em; }
  .fr-closing__form { display: flex; }
  .fr-closing .fr-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 58px; padding: 0 34px; border: 0; border-radius: 999px; background: linear-gradient(180deg, #4D74FF 0%, var(--fr-blue) 55%, var(--fr-blue-dark) 100%); color: #FFFFFF; font: 700 15px "Plus Jakarta Sans", sans-serif; text-decoration: none; cursor: pointer; box-shadow: inset 0 1px 0 rgb(255 255 255 / .3), 0 14px 30px rgb(47 91 255 / .32); transition: transform 200ms ease, box-shadow 200ms ease, filter 200ms ease; }
  .fr-closing .fr-btn:hover { transform: translateY(-1px); filter: brightness(1.06); box-shadow: inset 0 1px 0 rgb(255 255 255 / .3), 0 18px 36px rgb(47 91 255 / .38); }
  .fr-closing .fr-btn[disabled] { opacity: .5; cursor: not-allowed; transform: none; }
  @media (max-width: 599px) {
    .fr-closing__panel { border-radius: 28px; min-height: 620px; }
    .fr-closing__buy, .fr-closing__form, .fr-closing .fr-btn { width: 100%; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--frost" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, dt, dd, blockquote, div) { font-family: "Plus Jakarta Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Plus Jakarta Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Frost Closing",
  "tag": "section",
  "class": "roarr-frost-section",
  "settings": [],
  "presets": [{ "name": "Roarr Frost Closing" }]
}
{% endschema %}
