{%- capture kl_rtl_html -%}
{%- assign m = product.metafields.kluck_ai -%}
{%- assign s1 = m.bento_stat_1.value | default: m.bento_stat_1 | default: '100%' -%}
{%- assign d1 = m.bento_stat_description_1.value | default: m.bento_stat_description_1 | default: 'showed visibly improved hydration' -%}
{%- assign s2 = m.bento_stat_2.value | default: m.bento_stat_2 | default: '95%' -%}
{%- assign d2 = m.bento_stat_description_2.value | default: m.bento_stat_description_2 | default: 'agree skin looks more nourished' -%}
{%- assign s3 = m.stats_section_point_1_heading.value | default: m.stats_section_point_1_heading | default: '97%' -%}
{%- assign d3 = m.stats_section_point_1_desc.value | default: m.stats_section_point_1_desc | default: 'agree skin feels smoother and softer' -%}
<section class="gl-stats">
  <div><strong>{{ s1 }}</strong><p>{{ d1 }}</p></div>
  <div><strong>{{ s2 }}</strong><p>{{ d2 }}</p></div>
  <div><strong>{{ s3 }}</strong><p>{{ d3 }}</p></div>
</section>
<style>
  .gl-stats { background: #D6E6C6; color: #222; font-family: "DM Sans", sans-serif; display: grid; grid-template-columns: repeat(3, 1fr); }
  .gl-stats div { padding: 48px 24px; text-align: center; }
  .gl-stats strong { display: block; font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: 72px; line-height: 1; }
  .gl-stats p { margin: 8px auto 0; max-width: 220px; font-size: 14px; line-height: 1.45; }
  @media (max-width: 800px) { .gl-stats { grid-template-columns: 1fr; } .gl-stats strong { font-size: 56px; } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--glow" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "DM Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Glow Results",
  "tag": "section",
  "class": "roarr-glow-section",
  "settings": [],
  "presets": [{ "name": "Roarr Glow Results" }]
}
{% endschema %}
