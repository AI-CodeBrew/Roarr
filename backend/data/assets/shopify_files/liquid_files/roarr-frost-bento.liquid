{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
{%- assign m = product.metafields.roarr -%}
{%- assign eyebrow = m.frost_bento_eyebrow.value | default: m.frost_bento_eyebrow | default: 'Highlights' -%}
{%- assign heading = m.frost_bento_heading.value | default: m.frost_bento_heading | default: 'Small details, big difference' -%}
{%- assign big_title = m.frost_bento_big_title.value | default: m.frost_bento_big_title | default: 'Made for every day' -%}
{%- assign big_text = m.frost_bento_big_text.value | default: m.frost_bento_big_text | default: 'Designed around the way you actually live, so it simply works.' -%}
{%- assign stat = m.frost_stat_value.value | default: m.frost_stat_value | default: '2 yr' -%}
{%- assign stat_label = m.frost_stat_label.value | default: m.frost_stat_label | default: 'Warranty on every order' -%}
{%- assign k1 = m.frost_tile_1_title.value | default: m.frost_tile_1_title | default: 'Thoughtful design' -%}
{%- assign k1t = m.frost_tile_1_text.value | default: m.frost_tile_1_text | default: 'Every detail is there for a reason, nothing extra.' -%}
{%- assign k2 = m.frost_tile_2_title.value | default: m.frost_tile_2_title | default: 'Built to last' -%}
{%- assign k2t = m.frost_tile_2_text.value | default: m.frost_tile_2_text | default: 'Quality materials that keep their look over time.' -%}
{%- assign img = m.feature_image.value | default: m.feature_image -%}
{%- if img == blank and product.media.size > 0 -%}
  {%- assign img = product.media.first.preview_image | default: product.media.first -%}
{%- endif -%}
<section class="fr-bento">
  <div class="fr-wrap">
    <header class="fr-intro fr-intro--center">
      <p class="fr-label"><b>01</b>{{ eyebrow }}</p>
      <h2 class="fr-display"><span class="fr-grad">{{ heading }}</span></h2>
    </header>
    <div class="fr-bento__grid">
      <div class="fr-bento__big">
        {%- if img != blank -%}<img src="{{ img | image_url: width: 1400 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
        <div class="fr-bento__glass"><h3>{{ big_title }}</h3><p>{{ big_text }}</p></div>
      </div>
      <div class="fr-bento__stat">
        <svg class="fr-bento__rings" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="92" fill="none" stroke="#FFFFFF" stroke-opacity=".14" stroke-width="1.5"/>
          <circle cx="100" cy="100" r="72" fill="none" stroke="#FFFFFF" stroke-opacity=".14" stroke-width="1.5"/>
          <circle cx="100" cy="100" r="52" fill="none" stroke="#FFFFFF" stroke-opacity=".14" stroke-width="1.5"/>
          <circle cx="100" cy="100" r="92" fill="none" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round" stroke-dasharray="470 578" transform="rotate(-90 100 100)"/>
          <circle cx="100" cy="8" r="7" fill="#FFFFFF"/>
        </svg>
        <strong>{{ stat }}</strong>
        <p>{{ stat_label }}</p>
      </div>
      <div class="fr-bento__tile"><span class="fr-bento__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 3v3M17.5 4.5h3"/></svg></span><h3>{{ k1 }}</h3><p>{{ k1t }}</p></div>
      <div class="fr-bento__tile"><span class="fr-bento__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19c3-4 6-6 9-7"/></svg></span><h3>{{ k2 }}</h3><p>{{ k2t }}</p></div>
    </div>
  </div>
</section>
<style>
  .fr-bento { --fr-white: #FFFFFF; --fr-mist: #F3F6FA; --fr-ice: #E7EEFB; --fr-line: #E2E7EF; --fr-ink: #0B1324; --fr-muted: #586377; --fr-blue: #2F5BFF; --fr-blue-dark: #1C3CD6; --fr-blue-soft: #E8EEFF; --fr-night: #0A0F1E; --font-heading-family: "Plus Jakarta Sans", sans-serif; --font-body-family: "Plus Jakarta Sans", sans-serif; background: var(--fr-white); color: var(--fr-ink); font-family: "Plus Jakarta Sans", sans-serif; padding: clamp(64px, 9vw, 128px) 0; }
  .fr-bento *, .fr-bento *::before, .fr-bento *::after { box-sizing: border-box; }
  .fr-wrap { width: min(1240px, calc(100% - 48px)); margin: 0 auto; }
  .fr-intro { max-width: 760px; margin-bottom: clamp(36px, 5vw, 64px); }
  .fr-intro--center { margin-inline: auto; text-align: center; }
  .fr-intro--center .fr-label { justify-content: center; }
  .fr-label { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .01em; color: var(--fr-blue); }
  .fr-label b { display: inline-grid; place-items: center; min-width: 32px; height: 22px; padding: 0 8px; border-radius: 999px; background: var(--fr-blue-soft); color: var(--fr-blue); font-size: 11px; font-weight: 800; letter-spacing: .04em; }
  .fr-display { margin: 16px 0 0; font-weight: 800; font-size: clamp(38px, 5.4vw, 76px); line-height: 1; letter-spacing: -0.045em; color: var(--fr-ink); text-wrap: balance; }
  .fr-display .fr-grad, .fr-hero__title .fr-grad { font-size: inherit; font-weight: inherit; line-height: inherit; letter-spacing: inherit; background: linear-gradient(100deg, var(--fr-ink) 0%, var(--fr-ink) 30%, var(--fr-blue) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .fr-lead { margin: 18px 0 0; font-size: clamp(16px, 1.3vw, 18px); line-height: 1.6; color: var(--fr-muted); }
  @media (max-width: 749px) { .fr-wrap { width: calc(100% - 32px); } }
  .fr-bento__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(260px, auto)); gap: 16px; }
  .fr-bento__big { position: relative; grid-column: 1 / 3; grid-row: 1 / 3; min-height: 560px; border-radius: 32px; overflow: hidden; background: var(--fr-ice); }
  .fr-bento__big img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 900ms cubic-bezier(.2, .8, .2, 1); }
  .fr-bento__big:hover img { transform: scale(1.03); }
  .fr-bento__glass { position: absolute; inset-inline: 18px; bottom: 18px; padding: 22px 24px; border: 1px solid rgb(255 255 255 / .8); border-radius: 22px; background: rgb(255 255 255 / .74); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: 0 16px 40px rgb(11 19 36 / .10); }
  .fr-bento__glass h3 { margin: 0 0 6px; font-size: 22px; font-weight: 800; letter-spacing: -0.025em; }
  .fr-bento__glass p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--fr-muted); }
  .fr-bento__stat { position: relative; overflow: hidden; grid-column: 3 / 5; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; padding: 32px; border-radius: 32px; color: #FFFFFF; background: radial-gradient(120% 140% at 100% 0%, #7390FF 0%, var(--fr-blue) 45%, var(--fr-blue-dark) 100%); box-shadow: 0 24px 60px rgb(47 91 255 / .28); }
  .fr-bento__rings { position: absolute; top: -40px; right: -40px; width: 280px; height: 280px; }
  .fr-bento__stat strong { position: relative; font-size: clamp(64px, 7vw, 104px); font-weight: 800; line-height: .9; letter-spacing: -0.05em; }
  .fr-bento__stat p { position: relative; margin: 0; max-width: 300px; font-size: 17px; font-weight: 600; color: rgb(255 255 255 / .9); }
  .fr-bento__tile { display: flex; flex-direction: column; gap: 8px; padding: 28px; border: 1px solid var(--fr-line); border-radius: 32px; background: linear-gradient(180deg, #FFFFFF 0%, var(--fr-mist) 100%); transition: transform 250ms ease, box-shadow 250ms ease; }
  .fr-bento__tile:hover { transform: translateY(-3px); box-shadow: 0 20px 44px rgb(11 19 36 / .08); }
  .fr-bento__tile .fr-bento__icon { width: 52px; height: 52px; display: grid; place-items: center; margin-bottom: auto; border-radius: 16px; background: var(--fr-blue-soft); color: var(--fr-blue); }
  .fr-bento__tile h3 { margin: 24px 0 0; font-size: 20px; font-weight: 800; letter-spacing: -0.025em; }
  .fr-bento__tile p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--fr-muted); }
  @media (max-width: 989px) {
    .fr-bento__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; }
    .fr-bento__big { grid-column: 1 / -1; grid-row: auto; min-height: 0; aspect-ratio: 4 / 5; }
    .fr-bento__stat { grid-column: 1 / -1; min-height: 240px; }
    .fr-bento__tile { min-height: 240px; }
  }
  @media (max-width: 599px) {
    .fr-bento__grid { grid-template-columns: 1fr; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--frost" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, dt, dd, blockquote, div) { font-family: "Plus Jakarta Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Plus Jakarta Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Frost Highlights",
  "tag": "section",
  "class": "roarr-frost-section",
  "settings": [],
  "presets": [{ "name": "Roarr Frost Highlights" }]
}
{% endschema %}
