{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Jost:wght@400;500&display=swap">
{%- assign store_gen = shop.metafields.kluck_ai.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign m1 = ht.marquee_text_1 | default: 'Free delivery over $75' -%}
{%- assign m2 = ht.marquee_text_2 | default: 'Easy 14-day returns' -%}
{%- assign m3 = ht.marquee_text_3 | default: 'Packed with care' -%}
{%- capture items -%}<li>{{ m1 }}</li><li>{{ m2 }}</li><li>{{ m3 }}</li><li>{{ m1 }}</li><li>{{ m2 }}</li><li>{{ m3 }}</li>{%- endcapture -%}
<div class="lmk-mq" role="region" aria-label="Announcements">
  <div class="lmk-mq__track">
    <ul class="lmk-mq__list">{{ items }}</ul>
    <ul class="lmk-mq__list" aria-hidden="true">{{ items }}</ul>
  </div>
</div>
<style>
  .lmk-mq { overflow: hidden; background: #B08D57; color: #1C1917; font-family: "Jost", sans-serif; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; line-height: 1; }
  .lmk-mq__track { display: flex; width: max-content; animation: lmk-mq 36s linear infinite; }
  .lmk-mq:hover .lmk-mq__track { animation-play-state: paused; }
  .lmk-mq__list { display: flex; flex: none; gap: 64px; margin: 0; padding: 12px 32px; list-style: none; }
  .lmk-mq__list li { white-space: nowrap; display: flex; align-items: center; gap: 64px; }
  .lmk-mq__list li::after { content: ""; width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: .5; }
  @keyframes lmk-mq { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .lmk-mq__track { animation: none; width: auto; justify-content: center; } .lmk-mq__list[aria-hidden="true"] { display: none; } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--lumen" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "Jost", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Lumenook Announcement",
  "tag": "section",
  "class": "roarr-lumen-section",
  "settings": [],
  "presets": [
    {
      "name": "Roarr Lumenook Announcement"
    }
  ]
}
{% endschema %}
