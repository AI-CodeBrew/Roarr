{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign url = routes.all_products_collection_url | default: '/collections/all' -%}
{%- capture vr_html -%}
<section class="vr-hero" data-vr-slides aria-roledescription="carousel">
  {%- for i in (1..3) -%}
    {%- assign kicker_key = 'hero_kicker_' | append: i -%}
    {%- assign heading_key = 'banner_heading_' | append: i -%}
    {%- assign text_key = 'banner_text_' | append: i -%}
    {%- assign image_key = 'banner_image_' | append: i -%}
    {%- if ht[heading_key] != blank -%}
      <div class="vr-hero__slide vr-hero__slide--{{ i }}{% if i == 1 %} is-first{% endif %}" data-vr-slide>
        <div class="vr-hero__media">{%- render 'roarr-velour-img', src: hi[image_key], alt: ht[heading_key], width: 2000 -%}</div>
        <div class="vr-hero__copy">
          {%- if ht[kicker_key] != blank -%}<p class="vr-hero__kick">{{ ht[kicker_key] }}</p>{%- endif -%}
          <h2 class="vr-hero__title">{{ ht[heading_key] }}</h2>
          {%- if ht[text_key] != blank -%}<p class="vr-hero__text">{{ ht[text_key] }}</p>{%- endif -%}
          <a class="vr-btn vr-btn--light vr-hero__cta" href="{{ url }}">{% render 'roarr-ui-string', key: 'shop_now' %}<span class="vr-tilt">{%- render 'roarr-velour-icon', name: 'arrow', size: 16 -%}</span></a>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
  <div class="vr-dots vr-hero__dots">
    {%- for i in (1..3) -%}
      {%- assign heading_key = 'banner_heading_' | append: i -%}
      {%- if ht[heading_key] != blank -%}<button type="button" data-vr-dot aria-label="Slide {{ i }}">{{ i }}</button>{%- endif -%}
    {%- endfor -%}
  </div>
</section>
<style>
  @keyframes vr-hero-settle { from { transform: scale(1.25); } to { transform: scale(1); } }
  .vr .vr-hero { position: relative; display: grid; aspect-ratio: 1440 / 758; min-height: 520px; width: 100%; overflow: hidden; background: #3a2c24; color: #fff; }
  .vr .vr-hero__slide { position: relative; grid-area: 1 / 1; display: flex; align-items: flex-end; opacity: 0; visibility: hidden; transition: opacity .6s cubic-bezier(.87, .03, .41, .9), visibility .6s; }
  .vr .vr-hero__slide.is-on { opacity: 1; visibility: visible; z-index: 1; }
  .vr .vr-hero__media { position: absolute; inset: 0; overflow: hidden; }
  .vr .vr-hero__media img { width: 100%; height: 100%; object-fit: cover; transform: scale(1); transition: transform 0s linear .6s; }
  .vr .vr-hero__slide.is-on .vr-hero__media img { transform: scale(1.1); transition: transform 5s linear; }
  .vr .vr-hero__slide.is-first.is-on .vr-hero__media img { transform: scale(1); animation: vr-hero-settle 1.5s ease-out; }
  .vr .vr-hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(28 20 16 / .42), rgb(28 20 16 / 0) 58%); }
  .vr[dir="rtl"] .vr-hero__media::after { transform: scaleX(-1); }
  .vr .vr-hero__copy { position: relative; z-index: 1; width: min(100%, 640px); padding-inline-start: 72px; padding-block-end: 90px; }
  .vr .vr-hero__kick { font-size: 15.36px; line-height: 23px; font-weight: 500; text-transform: uppercase; color: #fff; }
  .vr .vr-hero__title { margin-top: 18px; font-size: 36px; line-height: 54px; font-weight: 500 !important; color: #fff; }
  .vr .vr-hero__text { margin-top: 18px; max-width: 500px; font-size: 14.4px; line-height: 22px; color: #fff; }
  .vr .vr-hero__cta { margin-top: 30px; }
  .vr .vr-hero__slide:not(.is-on) :is(.vr-hero__kick, .vr-hero__title, .vr-hero__text, .vr-hero__cta) { opacity: 0; }
  .vr .vr-hero__slide.is-on :is(.vr-hero__kick, .vr-hero__title, .vr-hero__text, .vr-hero__cta) { animation: vr-up 1s linear both; }
  .vr .vr-hero__slide--1.is-on .vr-hero__kick { animation-name: vr-left; }
  .vr .vr-hero__slide--1.is-on .vr-hero__title { animation-name: vr-right; }
  .vr .vr-hero__slide--2.is-on .vr-hero__kick { animation-name: vr-down; }
  .vr .vr-hero__slide--2.is-on .vr-hero__title { animation-name: vr-left; }
  .vr .vr-hero__slide--3.is-on .vr-hero__kick { animation-name: vr-right; }
  .vr .vr-hero__slide--3.is-on .vr-hero__title { animation-name: vr-down; }
  .vr .vr-hero__dots { position: absolute; bottom: 24px; inset-inline-start: 72px; z-index: 3; color: #fff; }
  @media (max-width: 1024px) {
    .vr .vr-hero { aspect-ratio: auto; min-height: 440px; }
    .vr .vr-hero__copy { padding-inline-start: 40px; }
    .vr .vr-hero__dots { inset-inline-start: 40px; }
    .vr .vr-hero__title { font-size: 30px; line-height: 44px; }
  }
  @media (max-width: 749px) {
    .vr .vr-hero { min-height: 320px; }
    .vr .vr-hero__media img { object-position: 68% center; }
    .vr .vr-hero__media::after { background: linear-gradient(90deg, rgb(28 20 16 / .62), rgb(28 20 16 / .18)); }
    .vr .vr-hero__copy { padding: 22px 15px 42px; }
    .vr .vr-hero__kick { font-size: 13px; line-height: 20px; }
    .vr .vr-hero__title { margin-top: 8px; font-size: 21px; line-height: 31px; }
    .vr .vr-hero__text { margin-top: 8px; font-size: 13px; line-height: 19px; }
    .vr .vr-hero__cta { margin-top: 14px; }
    .vr .vr-hero__dots { inset-inline-start: 15px; bottom: 14px; }
  }
</style>
{%- endcapture -%}
{%- render 'roarr-velour-wrap', html: vr_html -%}

{% schema %}
{
  "name": "Velour Slideshow",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Velour Slideshow" }]
}
{% endschema %}
