{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- capture lx_html -%}
<section class="lx-section lx-ab">
  <div class="lx-wrap lx-ab__grid">
    <div class="lx-ab__art">
      <div class="lx-ab__one">{%- render 'roarr-lustre-img', src: hi.about_image_1, alt: ht.about_heading, width: 900, lazy: true -%}</div>
      <div class="lx-ab__two">{%- render 'roarr-lustre-img', src: hi.about_image_2, alt: '', width: 700, lazy: true -%}</div>
    </div>
    <div class="lx-ab__copy">
      {%- if ht.about_kicker != blank -%}<p class="lx-ab__kicker">{{ ht.about_kicker }}</p>{%- endif -%}
      <h2 class="lx-ab__title">{{ ht.about_heading }}</h2>
      <p class="lx-ab__text">{{ ht.about_text }}</p>
      <a class="lx-btn" href="{{ ht.about_url | default: '/pages/about' }}">{{ ht.label_read_more | default: 'Read more' }}</a>
    </div>
  </div>
</section>
<style>
  .lx .lx-ab { padding-block: 80px 45px; }
  .lx .lx-ab__grid { display: grid; grid-template-columns: minmax(0, 650fr) minmax(0, 580fr); align-items: center; gap: 70px; }
  .lx .lx-ab__art { position: relative; aspect-ratio: 580 / 555; margin-inline-start: 70px; max-width: 580px; width: calc(100% - 70px); }
  .lx .lx-ab__one { position: absolute; top: 0; inset-inline-start: 0; width: 68.5%; height: 80.4%; background: var(--lx-soft); overflow: hidden; }
  .lx .lx-ab__two { position: absolute; bottom: 0; inset-inline-end: 0; width: 51.2%; height: 62.4%; background: var(--lx-soft); overflow: hidden; }
  .lx .lx-ab__art img { width: 100%; height: 100%; object-fit: cover; }
  .lx .lx-ab__kicker { font-size: 14px; font-weight: 500; text-transform: uppercase; color: var(--lx-accent); }
  .lx .lx-ab__title { max-width: 500px; margin-top: 12px; font-size: 32px; line-height: 44px; color: var(--lx-ink); }
  .lx .lx-ab__text { max-width: 500px; margin-top: 24px; font-size: 14.5px; line-height: 24px; color: var(--lx-muted); }
  .lx .lx-ab__copy .lx-btn { margin-top: 36px; }
  @media (max-width: 989px) {
    .lx .lx-ab__grid { grid-template-columns: 1fr; gap: 32px; }
    .lx .lx-ab__art { margin-inline: auto; width: 100%; }
    .lx .lx-ab__title { font-size: 26px; line-height: 36px; }
    .lx .lx-ab { padding-block: 44px 28px; }
  }
</style>
{%- endcapture -%}
{%- render 'roarr-lustre-wrap', html: lx_html -%}

{% schema %}
{
  "name": "Lustre About",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Lustre About" }]
}
{% endschema %}
