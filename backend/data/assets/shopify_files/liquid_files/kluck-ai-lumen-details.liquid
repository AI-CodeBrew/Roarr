{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500&display=swap">
{%- assign m = product.metafields.kluck_ai -%}
{%- assign heading = m.lumen_details_heading.value | default: m.lumen_details_heading | default: 'The details' -%}
{%- assign d1 = m.lumen_detail_1_title.value | default: m.lumen_detail_1_title | default: 'Considered form' -%}
{%- assign d1t = m.lumen_detail_1_text.value | default: m.lumen_detail_1_text | default: 'Every line is there for a reason, so it looks calm from every angle.' -%}
{%- assign d2 = m.lumen_detail_2_title.value | default: m.lumen_detail_2_title | default: 'Quality materials' -%}
{%- assign d2t = m.lumen_detail_2_text.value | default: m.lumen_detail_2_text | default: 'Finishes chosen to feel good in the hand and to age well.' -%}
{%- assign d3 = m.lumen_detail_3_title.value | default: m.lumen_detail_3_title | default: 'Made for every day' -%}
{%- assign d3t = m.lumen_detail_3_text.value | default: m.lumen_detail_3_text | default: 'Simple to use, easy to care for, and built to stay in your routine.' -%}
{%- assign i1 = m.product_highlight_1.value | default: m.product_highlight_1 -%}
{%- assign i2 = m.product_highlight_2.value | default: m.product_highlight_2 -%}
{%- assign i3 = m.product_highlight_3.value | default: m.product_highlight_3 -%}
{%- if i1 == blank and product.media.size > 0 -%}{%- assign i1 = product.media[0].preview_image | default: product.media[0] -%}{%- endif -%}
{%- if i2 == blank and product.media.size > 1 -%}{%- assign i2 = product.media[1].preview_image | default: product.media[1] -%}{%- endif -%}
{%- if i3 == blank and product.media.size > 2 -%}{%- assign i3 = product.media[2].preview_image | default: product.media[2] -%}{%- endif -%}
<section class="lmk-details">
  <div class="lmk-details__inner">
    <h2 class="lmk-details__heading">{{ heading }}</h2>
    <div class="lmk-details__row">
      <div class="lmk-details__media">{%- if i1 != blank -%}<img src="{{ i1 | image_url: width: 1400 }}" alt="{{ d1 | escape }}" loading="lazy">{%- endif -%}</div>
      <div class="lmk-details__text"><h3>{{ d1 }}</h3><p>{{ d1t }}</p></div>
    </div>
    <div class="lmk-details__row lmk-details__row--reverse">
      <div class="lmk-details__media">{%- if i2 != blank -%}<img src="{{ i2 | image_url: width: 1400 }}" alt="{{ d2 | escape }}" loading="lazy">{%- endif -%}</div>
      <div class="lmk-details__text"><h3>{{ d2 }}</h3><p>{{ d2t }}</p></div>
    </div>
    <div class="lmk-details__row">
      <div class="lmk-details__media">{%- if i3 != blank -%}<img src="{{ i3 | image_url: width: 1400 }}" alt="{{ d3 | escape }}" loading="lazy">{%- endif -%}</div>
      <div class="lmk-details__text"><h3>{{ d3 }}</h3><p>{{ d3t }}</p></div>
    </div>
  </div>
</section>
<style>
  .lmk-details { --lmk-ivory: #F6F1EA; --lmk-sand: #E6DCCF; --lmk-espresso: #2B2320; --lmk-muted: #6B5F58; background: var(--lmk-ivory); color: var(--lmk-espresso); font-family: "Jost", sans-serif; padding: clamp(64px, 9vw, 128px) 0 clamp(24px, 3vw, 32px); }
  .lmk-details *, .lmk-details *::before, .lmk-details *::after { box-sizing: border-box; }
  .lmk-details__inner { width: min(1320px, calc(100% - 48px)); margin: 0 auto; }
  .lmk-details__heading { margin: 0 0 clamp(24px, 3vw, 40px); font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: clamp(28px, 3vw, 38px); line-height: 1.15; }
  .lmk-details__row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2.5vw, 32px); align-items: center; margin-bottom: clamp(40px, 6vw, 96px); }
  .lmk-details__row--reverse .lmk-details__media { order: 2; }
  .lmk-details__media { aspect-ratio: 4 / 5; overflow: hidden; background: var(--lmk-sand); }
  .lmk-details__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lmk-details__text { max-width: 480px; padding-inline: clamp(0px, 3vw, 48px); }
  .lmk-details__text h3 { margin: 0 0 12px; font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: 28px; line-height: 1.2; }
  .lmk-details__text p { margin: 0; font-size: 16px; line-height: 1.65; color: var(--lmk-muted); }
  @media (max-width: 749px) {
    .lmk-details__inner { width: calc(100% - 32px); }
    .lmk-details__row { grid-template-columns: 1fr; }
    .lmk-details__row--reverse .lmk-details__media { order: 0; }
    .lmk-details__text { padding-inline: 0; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--lumen" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "Jost", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Lumenook Details",
  "tag": "section",
  "class": "roarr-lumen-section",
  "settings": [],
  "presets": [{ "name": "Roarr Lumenook Details" }]
}
{% endschema %}
