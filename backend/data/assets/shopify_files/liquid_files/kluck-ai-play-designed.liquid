{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Poppins:wght@400;500;600;700&display=swap">
{%- assign q1 = section.settings.q1 -%}
{%- assign a1 = section.settings.a1 -%}
{%- assign q2 = section.settings.q2 -%}
{%- assign a2 = section.settings.a2 -%}
{%- assign q3 = section.settings.q3 -%}
{%- assign a3 = section.settings.a3 -%}
{%- if product.metafields.kluck_ai.product_question_1 != blank -%}
  {%- assign q1 = product.metafields.kluck_ai.product_question_1 -%}
{%- endif -%}
{%- if product.metafields.kluck_ai.product_question_1_answer != blank -%}
  {%- assign a1 = product.metafields.kluck_ai.product_question_1_answer -%}
{%- endif -%}
{%- if product.metafields.kluck_ai.product_question_2 != blank -%}
  {%- assign q2 = product.metafields.kluck_ai.product_question_2 -%}
{%- endif -%}
{%- if product.metafields.kluck_ai.product_question_2_answer != blank -%}
  {%- assign a2 = product.metafields.kluck_ai.product_question_2_answer -%}
{%- endif -%}
{%- if product.metafields.kluck_ai.product_question_3 != blank -%}
  {%- assign q3 = product.metafields.kluck_ai.product_question_3 -%}
{%- endif -%}
{%- if product.metafields.kluck_ai.product_question_3_answer != blank -%}
  {%- assign a3 = product.metafields.kluck_ai.product_question_3_answer -%}
{%- endif -%}

<section class="kluck-play-designed">
  <div class="kluck-play-designed__wrap">
    <h2>{{ section.settings.heading }}</h2>
    <div class="kluck-play-designed__grid">
      <div class="kluck-play-designed__arch">
        <span class="kluck-play-designed__badge">100%<br>Recycled</span>
        {%- assign designed = product.metafields.kluck_ai.problem_solving_image.value -%}
        {%- if designed != blank -%}
          <img src="{{ designed | image_url: width: 1000 }}" alt="" width="966" height="1072">
        {%- else -%}
          <img src="{{ section.settings.image }}" alt="" width="966" height="1072">
        {%- endif -%}
      </div>
      <div>
        <details>
          <summary>{{ q1 }}</summary>
          <p>{{ a1 }}</p>
        </details>
        <details open>
          <summary>{{ q2 }}</summary>
          <p>{{ a2 }}</p>
        </details>
        <details>
          <summary>{{ q3 }}</summary>
          <p>{{ a3 }}</p>
        </details>
      </div>
    </div>
  </div>
</section>

{% style %}

  @import url("https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Poppins:wght@400;500;600;700&display=swap");
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    max-width: none !important;
    font-family: Poppins, sans-serif !important;
  }
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} .kluck-play-hero__badge,
  #shopify-section-{{ section.id }} .kluck-play-designed__badge,
  #shopify-section-{{ section.id }} .kluck-play-marquee__track span,
  #shopify-section-{{ section.id }} .kluck-play-story__mix,
  #shopify-section-{{ section.id }} summary {
    font-family: "Caveat Brush", cursive !important;
    font-weight: 400 !important;
    font-style: normal !important;
    text-transform: none !important;
    letter-spacing: normal !important;
  }
  #shopify-section-{{ section.id }} p,
  #shopify-section-{{ section.id }} button,
  #shopify-section-{{ section.id }} b,
  #shopify-section-{{ section.id }} strong,
  #shopify-section-{{ section.id }} .kluck-play-hero__kicker,
  #shopify-section-{{ section.id }} .kluck-play-hero__price,
  #shopify-section-{{ section.id }} .kluck-play-story__pills span,
  #shopify-section-{{ section.id }} .kluck-play-promo__code,
  #shopify-section-{{ section.id }} details p {
    font-family: Poppins, sans-serif !important;
    text-transform: none;
  }
  #shopify-section-{{ section.id }} button {
    text-transform: none !important;
    letter-spacing: normal !important;
    box-shadow: none;
    min-height: 0;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} button:before,
  #shopify-section-{{ section.id }} button:after { content: none !important; display: none !important; }
  #shopify-section-{{ section.id }} { margin: 0; padding: 0; background: #FFF1C0; }
  #shopify-section-{{ section.id }} .kluck-play-designed {
    color: #6F2424;
    font-family: Poppins, sans-serif !important;
    padding: 64px 0 72px;
  }
  #shopify-section-{{ section.id }} .kluck-play-designed__wrap {
    width: min(1100px, calc(100% - 48px));
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} h2 {
    font-family: "Caveat Brush", cursive !important;
    font-weight: 400 !important;
    font-size: 56px !important;
    line-height: 1 !important;
    text-align: center;
    margin: 0 0 28px;
    color: #6F2424;
  }
  #shopify-section-{{ section.id }} .kluck-play-designed__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .kluck-play-designed__arch { position: relative; }
  #shopify-section-{{ section.id }} .kluck-play-designed__arch img { width: 100%; height: auto; display: block; }
  #shopify-section-{{ section.id }} .kluck-play-designed__badge {
    position: absolute;
    top: 18px;
    inset-inline-start: 6px;
    width: 150px;
    height: 150px;
    display: grid;
    place-items: center;
    text-align: center;
    color: #fff;
    background: url("{{ section.settings.badge_image }}") center / cover no-repeat;
    font-family: "Caveat Brush", cursive !important;
    font-size: 30px !important;
    line-height: 0.95 !important;
    transform: rotate(-15deg);
  }
  #shopify-section-{{ section.id }} details {
    background: #fff;
    border: 1px solid #6F2424;
    border-radius: 20px;
    margin: 0 0 16px;
    padding: 6px 20px;
  }
  #shopify-section-{{ section.id }} summary {
    cursor: pointer;
    font-family: "Caveat Brush", cursive !important;
    font-weight: 400 !important;
    font-size: 32px !important;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
  }
  #shopify-section-{{ section.id }} summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} summary:after { content: "⌄"; font-family: Poppins, sans-serif !important; font-size: 18px !important; }
  #shopify-section-{{ section.id }} details[open] summary { border-bottom: 1px solid #6F2424; }
  #shopify-section-{{ section.id }} details[open] summary:after { content: "⌃"; }
  #shopify-section-{{ section.id }} details p { margin: 14px 0; color: rgba(111, 36, 36, 0.8); font-size: 15px !important; line-height: 1.6 !important; }
  @media (max-width: 800px) {
    #shopify-section-{{ section.id }} .kluck-play-designed__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} h2 { font-size: 42px !important; }
  }
{% endstyle %}
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--play" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: Poppins, "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Caveat Brush", "Lalezar", "Tajawal", cursive !important; line-height: 1.4 !important; font-weight: 400 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Kluck Play Designed",
  "tag": "section",
  "class": "kluck-play-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thoughtfully Designed" },
    { "type": "text", "id": "image", "label": "Image", "default": "https://cdn.shopify.com/s/files/1/0446/8228/1123/files/iwt-2c.png?v=1726197375" },
    { "type": "text", "id": "badge_image", "label": "Badge image", "default": "https://cdn.shopify.com/s/files/1/0446/8228/1123/files/sale-badge.png?v=1726541080" },
    { "type": "text", "id": "q1", "label": "Question 1", "default": "Description" },
    { "type": "textarea", "id": "a1", "label": "Answer 1", "default": "A wooden set for counting, color sorting, and rolling play." },
    { "type": "text", "id": "q2", "label": "Question 2", "default": "Details" },
    { "type": "textarea", "id": "a2", "label": "Answer 2", "default": "Your little one can count, sort, and roll. Solid wood, rounded edges, and water-based color. Wipe clean with a damp cloth." },
    { "type": "text", "id": "q3", "label": "Question 3", "default": "Shipping & Return" },
    { "type": "textarea", "id": "a3", "label": "Answer 3", "default": "Free shipping. 90-day returns on unused toys in the original box." }
  ],
  "presets": [{ "name": "Kluck Play Designed" }]
}
{% endschema %}
