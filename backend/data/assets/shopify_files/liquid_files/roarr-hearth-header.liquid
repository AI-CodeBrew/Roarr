    .hh .hh-dock > *:first-child { border-inline-start: 0; }
    .hh .hh-dock span { font-size: 11px; color: var(--hh-text); }
  }
  @media (max-width: 749px) {
    .hh .hh-search { padding-block: 20px 28px; }
