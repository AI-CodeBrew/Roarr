{%- capture kl_rtl_html -%}
{%- assign m = product.metafields.kluck_ai -%}
{%- assign kicker = m.circular_features_heading.value | default: m.circular_features_heading | default: 'why is it special?' -%}
{%- assign n1 = m.circular_feature_1_name.value | default: m.circular_feature_1_name | default: 'Brighten' -%}
{%- assign d1 = m.circular_feature_1_desc.value | default: m.circular_feature_1_desc -%}
{%- assign n2 = m.circular_feature_2_name.value | default: m.circular_feature_2_name | default: 'Restore' -%}
{%- assign d2 = m.circular_feature_2_desc.value | default: m.circular_feature_2_desc -%}
{%- assign n3 = m.circular_feature_3_name.value | default: m.circular_feature_3_name | default: 'Hydrate' -%}
{%- assign d3 = m.circular_feature_3_desc.value | default: m.circular_feature_3_desc -%}
{%- assign n4 = m.circular_feature_4_name.value | default: m.circular_feature_4_name | default: 'Smooth' -%}
{%- assign d4 = m.circular_feature_4_desc.value | default: m.circular_feature_4_desc -%}
{%- assign n5 = m.circular_feature_5_name.value | default: m.circular_feature_5_name | default: 'Last' -%}
{%- assign d5 = m.circular_feature_5_desc.value | default: m.circular_feature_5_desc -%}
{%- assign photo = m.product_highlight_1.value | default: m.product_highlight_1 -%}
{%- assign tab1 = m.product_question_1.value | default: m.product_question_1 | default: 'Product detail' -%}
{%- assign tab2 = m.product_question_2.value | default: m.product_question_2 | default: 'Shipping and return' -%}
{%- assign ship_h = m.ship_heading.value | default: m.ship_heading | default: 'Shipping' -%}
{%- assign s1 = m.ship_body_1.value | default: m.ship_body_1 -%}
{%- assign s2 = m.ship_body_2.value | default: m.ship_body_2 -%}
{%- assign s3 = m.ship_body_3.value | default: m.ship_body_3 -%}
{%- assign ret_h = m.returns_heading.value | default: m.returns_heading | default: 'Free returns' -%}
{%- assign ret = m.returns_body.value | default: m.returns_body | default: m.product_question_2_answer.value | default: m.product_question_2_answer -%}
<section class="gl-detail">
  <div class="gl-tabs" role="tablist">
    <button type="button" class="is-on" data-gl-tab="detail">{{ tab1 }}</button>
    <button type="button" data-gl-tab="ship">{{ tab2 }}</button>
  </div>
  <div class="gl-panel" data-gl-panel="detail">
    <div class="gl-why">
      <div>
        <p class="gl-kicker">{{ kicker }}</p>
        <h2>{{ n1 }}</h2>
        {%- if d1 != blank -%}<p class="gl-lead">{{ d1 }}</p>{%- endif -%}
        <details>
          <summary>{{ n2 }}</summary>
          {%- if d2 != blank -%}<p>{{ d2 }}</p>{%- endif -%}
        </details>
        <details>
          <summary>{{ n3 }}</summary>
          {%- if d3 != blank -%}<p>{{ d3 }}</p>{%- endif -%}
        </details>
        <details>
          <summary>{{ n4 }}</summary>
          {%- if d4 != blank -%}<p>{{ d4 }}</p>{%- endif -%}
        </details>
        <details>
          <summary>{{ n5 }}</summary>
          {%- if d5 != blank -%}<p>{{ d5 }}</p>{%- endif -%}
        </details>
      </div>
      {%- if photo != blank -%}<img src="{{ photo | image_url: width: 1400 }}" alt="">{%- endif -%}
    </div>
  </div>
  <div class="gl-panel gl-ship" data-gl-panel="ship" hidden>
    <div>
      <h2>{{ ship_h }}</h2>
      {%- if s1 != blank -%}<p>{{ s1 }}</p>{%- endif -%}
      {%- if s2 != blank -%}<p>{{ s2 }}</p>{%- endif -%}
      {%- if s3 != blank -%}<p>{{ s3 }}</p>{%- endif -%}
    </div>
    <div>
      <h2>{{ ret_h }}</h2>
      {%- if ret != blank -%}<p>{{ ret }}</p>{%- endif -%}
    </div>
  </div>
</section>
<style>
  .gl-detail { background: #fff; color: #222; font-family: "DM Sans", sans-serif; }
  .gl-panel[hidden] { display: none !important; }
  .gl-tabs { display: flex; justify-content: center; gap: 48px; padding: 28px 16px 8px; }
  .gl-tabs button { border: 0; background: transparent; cursor: pointer; font: 500 16px "DM Sans", sans-serif; color: #222; padding: 0 0 6px; }
  .gl-tabs button.is-on { box-shadow: inset 0 -1px 0 #222; }
  .gl-why { width: min(1100px, calc(100% - 48px)); margin: 0 auto; padding: 36px 0 72px; display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: center; }
  .gl-kicker { margin: 0 0 12px; letter-spacing: 0.18em; text-transform: uppercase; font-size: 12px; font-weight: 600; }
  .gl-why h2 { font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: 64px; line-height: 0.95; margin: 0 0 16px; }
  .gl-lead { margin: 0 0 20px; font-size: 15px; line-height: 1.6; color: #3a3a3a; max-width: 420px; }
  .gl-why details { border-top: 1px solid #e4e0db; }
  .gl-why summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 16px 0; letter-spacing: 0.12em; text-transform: uppercase; font-size: 14px; font-weight: 600; outline: none; }
  .gl-why summary::-webkit-details-marker { display: none; }
  .gl-why summary::marker { content: none; }
  .gl-why summary:after { content: ""; width: 8px; height: 8px; border-right: 1.5px solid #222; border-bottom: 1.5px solid #222; transform: rotate(45deg); flex: none; }
  .gl-why details[open] summary:after { transform: rotate(-135deg); margin-top: 4px; }
  .gl-why details p { margin: 0 0 16px; font-size: 14px; line-height: 1.6; color: #3a3a3a; }
  .gl-why img { width: 100%; height: auto; object-fit: cover; display: block; }
  .gl-ship { width: min(980px, calc(100% - 80px)); margin: 0 auto; padding: 56px 0 88px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 72px; text-align: start; }
  .gl-ship h2 { font-family: "DM Sans", sans-serif; font-weight: 700; font-size: 22px; letter-spacing: 0.02em; text-transform: uppercase; margin: 0 0 14px; }
  .gl-ship p { margin: 0 0 16px; font-size: 15px; line-height: 1.55; color: #222; }
  @media (max-width: 800px) {
    .gl-why { grid-template-columns: 1fr; width: calc(100% - 32px); }
    .gl-why h2 { font-size: 48px; }
    .gl-ship { grid-template-columns: 1fr; width: calc(100% - 32px); row-gap: 32px; }
  }
</style>
<script>
  (function () {
    document.querySelectorAll(".gl-detail").forEach(function (root) {
      var tabs = root.querySelectorAll("[data-gl-tab]");
      var panels = root.querySelectorAll("[data-gl-panel]");
      tabs.forEach(function (tab) {
        tab.addEventListener("click", function (event) {
          event.stopPropagation();
          var name = tab.getAttribute("data-gl-tab");
          tabs.forEach(function (item) { item.classList.toggle("is-on", item === tab); });
          panels.forEach(function (panel) {
            panel.hidden = panel.getAttribute("data-gl-panel") !== name;
          });
        });
      });
    });
  })();
</script>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--glow" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "DM Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Kluck Glow Detail",
  "tag": "section",
  "class": "kluck-glow-section",
  "settings": [],
  "presets": [{ "name": "Kluck Glow Detail" }]
}
{% endschema %}
