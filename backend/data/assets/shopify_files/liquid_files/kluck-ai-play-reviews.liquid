{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Poppins:wght@400;600;700&display=swap">

<section class="roarr-play-reviews">
  <div class="roarr-play-reviews__wrap">
    <h2>{{ section.settings.heading }}</h2>
    <div class="roarr-play-reviews__cards">
      {%- for i in (1..4) -%}
        {%- capture title_key -%}title_{{ i }}{%- endcapture -%}
        {%- capture body_key -%}body_{{ i }}{%- endcapture -%}
        {%- capture name_key -%}name_{{ i }}{%- endcapture -%}
        {%- capture mf_title -%}review_title_{{ i }}{%- endcapture -%}
        {%- capture mf_body -%}review_body_{{ i }}{%- endcapture -%}
        {%- capture mf_name -%}review_name_{{ i }}{%- endcapture -%}
        {%- assign card_title = section.settings[title_key] -%}
        {%- assign card_body = section.settings[body_key] -%}
        {%- assign card_name = section.settings[name_key] -%}
        {%- if product.metafields.kluck_ai[mf_title] != blank -%}{%- assign card_title = product.metafields.kluck_ai[mf_title] -%}{%- endif -%}
        {%- if product.metafields.kluck_ai[mf_body] != blank -%}{%- assign card_body = product.metafields.kluck_ai[mf_body] -%}{%- endif -%}
        {%- if product.metafields.kluck_ai[mf_name] != blank -%}{%- assign card_name = product.metafields.kluck_ai[mf_name] -%}{%- endif -%}
        <article>
          <div class="roarr-play-reviews__stars">★★★★★</div>
          <h3>{{ card_title }}</h3>
          <p>{{ card_body }}</p>
          <b>{{ card_name }}</b>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}

  @import url("https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Poppins:wght@400;500;600;700&display=swap");
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    max-width: none !important;
    font-family: Poppins, sans-serif !important;
  }
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} .roarr-play-hero__badge,
  #shopify-section-{{ section.id }} .roarr-play-designed__badge,
  #shopify-section-{{ section.id }} .roarr-play-marquee__track span,
  #shopify-section-{{ section.id }} .roarr-play-story__mix,
  #shopify-section-{{ section.id }} summary {
    font-family: "Caveat Brush", cursive !important;
    font-weight: 400 !important;
    font-style: normal !important;
    text-transform: none !important;
    letter-spacing: normal !important;
  }
  #shopify-section-{{ section.id }} p,
  #shopify-section-{{ section.id }} button,
  #shopify-section-{{ section.id }} b,
  #shopify-section-{{ section.id }} strong,
  #shopify-section-{{ section.id }} .roarr-play-hero__kicker,
  #shopify-section-{{ section.id }} .roarr-play-hero__price,
  #shopify-section-{{ section.id }} .roarr-play-story__pills span,
  #shopify-section-{{ section.id }} .roarr-play-promo__code,
  #shopify-section-{{ section.id }} details p {
    font-family: Poppins, sans-serif !important;
    text-transform: none;
  }
  #shopify-section-{{ section.id }} button {
    text-transform: none !important;
    letter-spacing: normal !important;
    box-shadow: none;
    min-height: 0;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} button:before,
  #shopify-section-{{ section.id }} button:after { content: none !important; display: none !important; }
  #shopify-section-{{ section.id }} { margin: 0; padding: 0; }
  #shopify-section-{{ section.id }} .roarr-play-reviews {
    background: #FFFCF5 url("{{ section.settings.background_image }}") center top / cover no-repeat;
    color: #6F2424;
    font-family: Poppins, sans-serif !important;
    padding: 100px 0 70px;
  }
  #shopify-section-{{ section.id }} .roarr-play-reviews__wrap {
    width: min(1100px, calc(100% - 48px));
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} h2 {
    text-align: center;
    font-family: "Caveat Brush", cursive !important;
    font-weight: 400 !important;
    font-size: 56px !important;
    line-height: 1 !important;
    margin: 0;
    color: #6F2424;
  }
  #shopify-section-{{ section.id }} .roarr-play-reviews__cards {
    display: flex;
    gap: 16px;
    margin-top: 28px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} article {
    flex: 0 0 260px;
    background: #fff;
    border: 1px solid #6F2424;
    border-radius: 20px;
    padding: 28px 22px 22px;
    text-align: start;
  }
  #shopify-section-{{ section.id }} .roarr-play-reviews__stars { color: #E0A106; letter-spacing: 2px !important; font-size: 14px !important; }
  #shopify-section-{{ section.id }} h3 {
    font-family: "Caveat Brush", cursive !important;
    font-weight: 400 !important;
    font-size: 28px !important;
    margin: 8px 0;
    color: #6F2424;
  }
  #shopify-section-{{ section.id }} p { margin: 0 0 18px; font-size: 14px !important; line-height: 1.5 !important; }
  #shopify-section-{{ section.id }} b { font-size: 13px !important; letter-spacing: 0.04em !important; }
  @media (max-width: 800px) {
    #shopify-section-{{ section.id }} h2 { font-size: 42px !important; }
    #shopify-section-{{ section.id }} .roarr-play-reviews__cards { overflow-x: auto; }
  }
{% endstyle %}
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--play" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: Poppins, "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Caveat Brush", "Lalezar", "Tajawal", cursive !important; line-height: 1.4 !important; font-weight: 400 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Play Reviews",
  "tag": "section",
  "class": "roarr-play-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lovely Customers" },
    { "type": "text", "id": "background_image", "label": "Background", "default": "https://cdn.shopify.com/s/files/1/0446/8228/1123/files/testi-bg.png?v=1726201762" },
    { "type": "text", "id": "title_1", "label": "Title 1", "default": "Enter Your Text" },
    { "type": "textarea", "id": "body_1", "label": "Body 1", "default": "Enter customer review over here" },
    { "type": "text", "id": "name_1", "label": "Name 1", "default": "Reviewer Name" },
    { "type": "text", "id": "title_2", "label": "Title 2", "default": "Enter Your Text" },
    { "type": "textarea", "id": "body_2", "label": "Body 2", "default": "Enter customer review over here" },
    { "type": "text", "id": "name_2", "label": "Name 2", "default": "Reviewer Name" },
    { "type": "text", "id": "title_3", "label": "Title 3", "default": "Enter Your Text" },
    { "type": "textarea", "id": "body_3", "label": "Body 3", "default": "Enter customer review over here" },
    { "type": "text", "id": "name_3", "label": "Name 3", "default": "Reviewer Name" },
    { "type": "text", "id": "title_4", "label": "Title 4", "default": "Enter Your Text" },
    { "type": "textarea", "id": "body_4", "label": "Body 4", "default": "Enter customer review over here" },
    { "type": "text", "id": "name_4", "label": "Name 4", "default": "Reviewer Name" }
  ],
  "presets": [{ "name": "Roarr Play Reviews" }]
}
{% endschema %}
