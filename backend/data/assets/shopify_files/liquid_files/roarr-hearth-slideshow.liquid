{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign url = routes.all_products_collection_url | default: '/collections/all' -%}
{%- capture hh_html -%}
<section class="hh-hero" data-hh-slides="7000" aria-roledescription="carousel">
  {%- for i in (1..3) -%}
    {%- assign kicker_key = 'hero_kicker_' | append: i -%}
    {%- assign heading_key = 'banner_heading_' | append: i -%}
    {%- assign text_key = 'banner_text_' | append: i -%}
    {%- assign image_key = 'banner_image_' | append: i -%}
    {%- if ht[heading_key] != blank -%}
      <div class="hh-hero__slide hh-hero__slide--{{ i }}{% if i == 1 %} is-first{% endif %}" data-hh-slide>
        <div class="hh-hero__media">{%- render 'roarr-hearth-img', src: hi[image_key], alt: ht[heading_key], width: 2000 -%}</div>
        <div class="hh-hero__copy">
          {%- if ht[kicker_key] != blank -%}<p class="hh-hero__kick">{{ ht[kicker_key] }}</p>{%- endif -%}
          <h2 class="hh-hero__title">{{ ht[heading_key] }}</h2>
          {%- if ht[text_key] != blank -%}<p class="hh-hero__text">{{ ht[text_key] }}</p>{%- endif -%}
          <a class="hh-btn hh-btn--light hh-hero__cta" href="{{ url }}">{% render 'roarr-ui-string', key: 'shop_now' %}<span class="hh-tilt">{%- render 'roarr-hearth-icon', name: 'arrow', size: 14 -%}</span></a>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
  <div class="hh-dots hh-hero__dots">
    {%- for i in (1..3) -%}
      {%- assign heading_key = 'banner_heading_' | append: i -%}
      {%- if ht[heading_key] != blank -%}<button type="button" data-hh-dot aria-label="Slide {{ i }}">{{ i }}</button>{%- endif -%}
    {%- endfor -%}
  </div>
</section>
<style>
  @keyframes hh-hero-settle { from { transform: scale(1.25); } to { transform: scale(1); } }
  .hh .hh-hero { position: relative; display: grid; aspect-ratio: 1440 / 758; min-height: 520px; width: 100%; overflow: hidden; background: #2b211b; color: #fff; }
  .hh .hh-hero__slide { position: relative; grid-area: 1 / 1; display: flex; align-items: flex-end; opacity: 0; visibility: hidden; transition: opacity .6s cubic-bezier(.87, .03, .41, .9), visibility .6s; }
  .hh .hh-hero__slide.is-on { opacity: 1; visibility: visible; z-index: 1; }
  .hh .hh-hero__media { position: absolute; inset: 0; overflow: hidden; }
  .hh .hh-hero__media img { width: 100%; height: 100%; object-fit: cover; transform: scale(1); transition: transform 0s linear .6s; }
  .hh .hh-hero__slide.is-on .hh-hero__media img { transform: scale(1.1); transition: transform 5s linear; }
  .hh .hh-hero__slide.is-first.is-on .hh-hero__media img { transform: scale(1); animation: hh-hero-settle 1.5s ease-out; }
  .hh .hh-hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(20 14 10 / .3), rgb(20 14 10 / 0) 50%); }
  .hh[dir="rtl"] .hh-hero__media::after { transform: scaleX(-1); }
  .hh .hh-hero__copy { position: relative; z-index: 1; width: min(100%, 590px); padding-inline-start: 72px; padding-block-end: 91px; }
  .hh .hh-hero__kick { font-size: 15px; line-height: 21px; font-weight: 500; text-transform: uppercase; color: #fff; }
  .hh .hh-hero__title { margin-top: 15px; font-size: 36px; line-height: 54px; font-weight: 500 !important; color: #fff; }
  .hh .hh-hero__text { margin-top: 15px; font-size: 15px; line-height: 22.5px; color: #fff; }
  .hh .hh-hero__cta { margin-top: 30px; }
  .hh .hh-hero__cta span:first-child { font-size: inherit; }
  .hh .hh-hero__slide:not(.is-on) :is(.hh-hero__kick, .hh-hero__title, .hh-hero__text, .hh-hero__cta) { opacity: 0; }
  .hh .hh-hero__slide.is-on :is(.hh-hero__kick, .hh-hero__title, .hh-hero__text, .hh-hero__cta) { animation: hh-up 1s ease both; }
  .hh .hh-hero__slide--1.is-on .hh-hero__kick, .hh .hh-hero__slide--3.is-on .hh-hero__kick { animation-name: hh-left; }
  .hh .hh-hero__slide--1.is-on .hh-hero__title, .hh .hh-hero__slide--3.is-on .hh-hero__title { animation-name: hh-right; }
  .hh .hh-hero__slide--2.is-on .hh-hero__kick { animation-name: hh-down; }
  .hh .hh-hero__slide--2.is-on .hh-hero__title { animation-name: hh-left; }
  .hh .hh-hero__dots { position: absolute; bottom: 24px; inset-inline-start: 72px; z-index: 3; color: #fff; }
  @media (max-width: 1024px) {
    .hh .hh-hero { aspect-ratio: auto; min-height: 440px; }
    .hh .hh-hero__copy { padding-inline-start: 40px; }
    .hh .hh-hero__dots { inset-inline-start: 40px; }
    .hh .hh-hero__title { font-size: 30px; line-height: 44px; }
  }
  @media (max-width: 749px) {
    .hh .hh-hero { min-height: 250px; }
    .hh .hh-hero__slide { align-items: flex-start; }
    .hh .hh-hero__media::after { background: linear-gradient(90deg, rgb(20 14 10 / .55), rgb(20 14 10 / .1)); }
    .hh .hh-hero__copy { width: min(100%, 325px); padding: 20px 16px; }
    .hh .hh-hero__kick { font-size: 12px; line-height: 16.8px; }
    .hh .hh-hero__title { margin-top: 10px; font-size: 20px; line-height: 30px; }
    .hh .hh-hero__text { margin-top: 10px; font-size: 11px; line-height: 16.5px; }
    .hh .hh-hero__cta { margin-top: 20px; }
    .hh .hh-hero__dots { display: none; }
  }
</style>
{%- endcapture -%}
{%- render 'roarr-hearth-wrap', html: hh_html -%}

{% schema %}
{
  "name": "Hearth Slideshow",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Hearth Slideshow" }]
}
{% endschema %}
