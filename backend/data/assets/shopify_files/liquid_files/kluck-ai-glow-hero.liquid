{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=DM+Sans:wght@400;500;600&display=swap">
{%- assign m = product.metafields.kluck_ai -%}
{%- assign subtitle = m.product_subtitle.value | default: m.product_subtitle -%}
{%- assign img1 = m.product_image_1.value | default: m.product_image_1 -%}
{%- assign img2 = m.product_image_2.value | default: m.product_image_2 -%}
{%- assign img3 = m.product_image_3.value | default: m.product_image_3 -%}
{%- assign img4 = m.product_image_4.value | default: m.product_image_4 -%}
{%- assign img5 = m.product_image_5.value | default: m.product_image_5 -%}
{%- assign b1 = m.badge_text_1.value | default: m.badge_text_1 | default: 'Always Clean' -%}
{%- assign b2 = m.badge_text_2.value | default: m.badge_text_2 | default: 'Always Gentle' -%}
{%- assign b3 = m.badge_text_3.value | default: m.badge_text_3 | default: 'Clinically tested' -%}
{%- assign delivery = m.delivery_line.value | default: m.delivery_line | default: 'Estimated delivery: 5 to 8 days' -%}
{%- assign shipping = m.shipping_line.value | default: m.shipping_line | default: 'Free shipping and returns on orders over $75' -%}
<section class="gl-hero">
  <div class="gl-grid">
    <div class="gl-media">
      <div class="gl-gallery">
        {%- if product.media.size > 0 -%}
          {%- assign main = product.media.first.preview_image | default: product.media.first -%}
          <img id="gl-hero-main" src="{{ main | image_url: width: 1400 }}" alt="{{ product.title | escape }}">
        {%- elsif img1 != blank -%}
          <img id="gl-hero-main" src="{{ img1 | image_url: width: 1400 }}" alt="{{ product.title | escape }}">
        {%- endif -%}
      </div>
      <div class="gl-thumbs">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media limit: 5 -%}
            {%- assign src = media.preview_image | default: media -%}
            <button type="button" class="gl-thumb{% if forloop.first %} is-on{% endif %}" data-src="{{ src | image_url: width: 1400 }}" aria-label="Show image {{ forloop.index }}"><img src="{{ src | image_url: width: 200 }}" alt=""></button>
          {%- endfor -%}
        {%- else -%}
          {%- if img1 != blank -%}<button type="button" class="gl-thumb is-on" data-src="{{ img1 | image_url: width: 1400 }}" aria-label="Show image 1"><img src="{{ img1 | image_url: width: 200 }}" alt=""></button>{%- endif -%}
          {%- if img2 != blank -%}<button type="button" class="gl-thumb" data-src="{{ img2 | image_url: width: 1400 }}" aria-label="Show image 2"><img src="{{ img2 | image_url: width: 200 }}" alt=""></button>{%- endif -%}
          {%- if img3 != blank -%}<button type="button" class="gl-thumb" data-src="{{ img3 | image_url: width: 1400 }}" aria-label="Show image 3"><img src="{{ img3 | image_url: width: 200 }}" alt=""></button>{%- endif -%}
          {%- if img4 != blank -%}<button type="button" class="gl-thumb" data-src="{{ img4 | image_url: width: 1400 }}" aria-label="Show image 4"><img src="{{ img4 | image_url: width: 200 }}" alt=""></button>{%- endif -%}
          {%- if img5 != blank -%}<button type="button" class="gl-thumb" data-src="{{ img5 | image_url: width: 1400 }}" aria-label="Show image 5"><img src="{{ img5 | image_url: width: 200 }}" alt=""></button>{%- endif -%}
        {%- endif -%}
      </div>
    </div>
    <div class="gl-buy">
      <h1>{{ product.title }}</h1>
      <div class="gl-price">
        <strong>{{ product.price | money }}</strong>
        {%- if product.compare_at_price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
      </div>
      {%- if subtitle != blank -%}<p class="gl-sub">{{ subtitle }}</p>{%- endif -%}
      <ul class="gl-checks">
        <li>{{ b1 }}</li>
        <li>{{ b2 }}</li>
        <li>{{ b3 }}</li>
      </ul>
      <div class="roarr-bundle-slot">
        {%- for block in section.blocks -%}
          {% render block %}
        {%- endfor -%}
      </div>
      {%- form 'product', product -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <div class="gl-qty">
        <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
        <input type="hidden" name="quantity" value="1" data-qty-input>
        <b data-qty>1</b>
        <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
      </div>
      <button class="gl-atc" type="submit">{% render 'roarr-ui-string', key: 'add_to_cart' %}</button>
      {%- endform -%}
      <ul class="gl-notes">
        <li>{{ delivery }}</li>
        <li>{{ shipping }}</li>
      </ul>
    </div>
  </div>
</section>
<style>
  .gl-hero { background: #fff; color: #222; font-family: "DM Sans", sans-serif; padding: 36px 0 12px; }
  .gl-grid { width: min(1180px, calc(100% - 48px)); margin: 0 auto; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: start; }
  .gl-grid > * { min-width: 0; }
  .gl-gallery { background: #f3f1ee; }
  .gl-gallery img { width: 100%; height: auto; max-height: 640px; object-fit: contain; display: block; }
  .gl-thumbs { display: flex; gap: 10px; margin-top: 12px; }
  .gl-thumb { flex: 0 0 72px; width: 72px; padding: 0; border: 1px solid transparent; background: #f3f1ee; cursor: pointer; line-height: 0; }
  .gl-thumb.is-on { border-color: #222; }
  .gl-thumb img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
  .gl-hero h1 { font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: 52px; line-height: 1.05; margin: 0 0 12px; }
  .gl-price { display: flex; gap: 12px; align-items: baseline; margin: 0 0 14px; }
  .gl-price strong { font-size: 18px; font-weight: 600; }
  .gl-price s { color: #8a8178; font-size: 15px; }
  .gl-sub { margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: #3a3a3a; max-width: 460px; }
  .roarr-bundle-slot { width: 100%; max-width: 460px; margin: 0 0 16px; }
  .gl-checks { list-style: none; margin: 0 0 18px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .gl-checks li { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .gl-checks li:before { content: "✓"; width: 16px; height: 16px; border-radius: 50%; background: #5E8934; color: #fff; display: grid; place-items: center; font-size: 10px; flex: none; }
  .gl-qty { display: inline-flex; border: 1px solid #222; margin-bottom: 12px; }
  .gl-qty button, .gl-qty b { width: 44px; height: 44px; display: grid; place-items: center; }
  .gl-qty button { border: 0; background: transparent; cursor: pointer; font: inherit; }
  .gl-atc { display: block; width: 100%; max-width: 460px; height: 48px; border: 0; background: #3f3f3f; color: #fff; font: 600 13px "DM Sans", sans-serif; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer; }
  .gl-notes { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
  .gl-notes li { display: block; }
  @media (max-width: 800px) {
    .gl-grid { grid-template-columns: 1fr; gap: 24px; width: calc(100% - 32px); }
    .gl-hero h1 { font-size: 40px; }
  }
</style>
<script>
  (function () {
    var main = document.getElementById("gl-hero-main");
    document.querySelectorAll(".gl-thumb").forEach(function (button) {
      button.addEventListener("click", function (event) {
        event.stopPropagation();
        if (main && button.dataset.src) main.src = button.dataset.src;
        document.querySelectorAll(".gl-thumb").forEach(function (item) { item.classList.remove("is-on"); });
        button.classList.add("is-on");
      });
    });
    document.querySelectorAll(".gl-hero .gl-qty").forEach(function (qty) {
      var label = qty.querySelector("[data-qty]");
      var input = qty.querySelector("[data-qty-input]");
      function setQty(next) {
        var value = Math.max(1, next);
        if (label) label.textContent = String(value);
        if (input) input.value = String(value);
      }
      var minus = qty.querySelector("[data-qty-minus]");
      var plus = qty.querySelector("[data-qty-plus]");
      if (minus) minus.addEventListener("click", function (event) { event.stopPropagation(); setQty((parseInt(label && label.textContent, 10) || 1) - 1); });
      if (plus) plus.addEventListener("click", function (event) { event.stopPropagation(); setQty((parseInt(label && label.textContent, 10) || 1) + 1); });
    });
  })();
</script>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--glow" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "DM Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Glow Hero",
  "tag": "section",
  "class": "roarr-glow-section",
  "settings": [],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Roarr Glow Hero" }]
}
{% endschema %}
