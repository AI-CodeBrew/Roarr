{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Poppins:wght@400;500;600;700&display=swap">
{%- assign pill_1 = section.settings.pill_1 -%}
{%- assign pill_2 = section.settings.pill_2 -%}
{%- assign pill_3 = section.settings.pill_3 -%}
{%- if product.metafields.kluck_ai.pill_1 != blank -%}{%- assign pill_1 = product.metafields.kluck_ai.pill_1 -%}{%- endif -%}
{%- if product.metafields.kluck_ai.pill_2 != blank -%}{%- assign pill_2 = product.metafields.kluck_ai.pill_2 -%}{%- endif -%}
{%- if product.metafields.kluck_ai.pill_3 != blank -%}{%- assign pill_3 = product.metafields.kluck_ai.pill_3 -%}{%- endif -%}

<section class="kluck-play-story">
  <div class="kluck-play-story__mix">
    We built
    {%- assign story_1 = product.metafields.kluck_ai.product_highlight_1.value -%}
    {% if story_1 != blank %}<img src="{{ story_1 | image_url: width: 400 }}" alt="">{% else %}<img src="{{ section.settings.image_1 }}" alt="">{% endif %}
    a toy they reach for
    {%- assign story_2 = product.metafields.kluck_ai.product_highlight_2.value -%}
    {% if story_2 != blank %}<img src="{{ story_2 | image_url: width: 400 }}" alt="">{% else %}<img src="{{ section.settings.image_2 }}" alt="">{% endif %}
    <br>
    {%- assign story_3 = product.metafields.kluck_ai.product_highlight_3.value -%}
    {% if story_3 != blank %}<img src="{{ story_3 | image_url: width: 400 }}" alt="">{% else %}<img src="{{ section.settings.image_3 }}" alt="">{% endif %}
    with details that stay
    {%- assign story_4 = product.metafields.kluck_ai.product_highlight_4.value -%}
    {% if story_4 != blank %}<img src="{{ story_4 | image_url: width: 400 }}" alt="">{% else %}<img src="{{ section.settings.image_4 }}" alt="">{% endif %}
    easy to see
  </div>
  <div class="kluck-play-story__pills">
    <span><i>✓</i> {{ pill_1 }}</span>
    <span><i>✓</i> {{ pill_2 }}</span>
    <span><i>✓</i> {{ pill_3 }}</span>
  </div>
</section>

{% style %}

  @import url("https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Poppins:wght@400;500;600;700&display=swap");
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    max-width: none !important;
    font-family: Poppins, sans-serif !important;
  }
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} .kluck-play-hero__badge,
  #shopify-section-{{ section.id }} .kluck-play-designed__badge,
  #shopify-section-{{ section.id }} .kluck-play-marquee__track span,
  #shopify-section-{{ section.id }} .kluck-play-story__mix,
  #shopify-section-{{ section.id }} summary {
    font-family: "Caveat Brush", cursive !important;
    font-weight: 400 !important;
    font-style: normal !important;
    text-transform: none !important;
    letter-spacing: normal !important;
  }
  #shopify-section-{{ section.id }} p,
  #shopify-section-{{ section.id }} button,
  #shopify-section-{{ section.id }} b,
  #shopify-section-{{ section.id }} strong,
  #shopify-section-{{ section.id }} .kluck-play-hero__kicker,
  #shopify-section-{{ section.id }} .kluck-play-hero__price,
  #shopify-section-{{ section.id }} .kluck-play-story__pills span,
  #shopify-section-{{ section.id }} .kluck-play-promo__code,
  #shopify-section-{{ section.id }} details p {
    font-family: Poppins, sans-serif !important;
    text-transform: none;
  }
  #shopify-section-{{ section.id }} button {
    text-transform: none !important;
    letter-spacing: normal !important;
    box-shadow: none;
    min-height: 0;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} button:before,
  #shopify-section-{{ section.id }} button:after { content: none !important; display: none !important; }
  #shopify-section-{{ section.id }} { margin: 0; padding: 0; background: #FFFCF5; }
  #shopify-section-{{ section.id }} .kluck-play-story {
    color: #6F2424;
    font-family: Poppins, sans-serif !important;
    padding: 56px 0 28px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .kluck-play-story__mix,
  #shopify-section-{{ section.id }} .kluck-play-story__pills {
    width: min(1100px, calc(100% - 48px));
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .kluck-play-story__mix {
    font-family: "Caveat Brush", cursive !important;
    font-size: 48px !important;
    line-height: 1.35 !important;
  }
  #shopify-section-{{ section.id }} .kluck-play-story__mix img {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    display: inline-block;
    vertical-align: middle;
    margin: 0 8px;
  }
  #shopify-section-{{ section.id }} .kluck-play-story__pills {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  #shopify-section-{{ section.id }} .kluck-play-story__pills span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1px solid #6F2424;
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 15px !important;
    font-weight: 600 !important;
  }
  #shopify-section-{{ section.id }} .kluck-play-story__pills i {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #FFD74F;
    color: #6F2424;
    display: grid;
    place-items: center;
    font-style: normal;
    font-size: 13px !important;
  }
  @media (max-width: 800px) {
    #shopify-section-{{ section.id }} .kluck-play-story__mix { font-size: 32px !important; }
  }
{% endstyle %}
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--play" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: Poppins, "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Caveat Brush", "Lalezar", "Tajawal", cursive !important; line-height: 1.4 !important; font-weight: 400 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Kluck Play Story",
  "tag": "section",
  "class": "kluck-play-section",
  "settings": [
    { "type": "text", "id": "image_1", "label": "Photo 1", "default": "https://cdn.shopify.com/s/files/1/0446/8228/1123/files/img-highlight-1_bf88d73e-47ac-4511-b9b4-94fca069ec43.png?v=1726197308" },
    { "type": "text", "id": "image_2", "label": "Photo 2", "default": "https://cdn.shopify.com/s/files/1/0446/8228/1123/files/img-highlight-2.png?v=1726197308" },
    { "type": "text", "id": "image_3", "label": "Photo 3", "default": "https://cdn.shopify.com/s/files/1/0446/8228/1123/files/img-highlight-3.png?v=1726197308" },
    { "type": "text", "id": "image_4", "label": "Photo 4", "default": "https://cdn.shopify.com/s/files/1/0446/8228/1123/files/img-highlight-4.png?v=1726197308" },
    { "type": "text", "id": "pill_1", "label": "Pill 1", "default": "10% Giving back" },
    { "type": "text", "id": "pill_2", "label": "Pill 2", "default": "Free Shipping over $100 order" },
    { "type": "text", "id": "pill_3", "label": "Pill 3", "default": "90 Days free return" }
  ],
  "presets": [{ "name": "Kluck Play Story" }]
}
{% endschema %}
