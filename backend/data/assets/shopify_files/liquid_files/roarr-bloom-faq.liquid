{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap">
{%- assign m = product.metafields.roarr -%}
{%- assign heading = m.bloom_faq_heading.value | default: m.bloom_faq_heading | default: 'Your Questions, [Answered]' -%}
{%- assign heading_h = heading | escape | replace: '[', '<span class="bl-ac">' | replace: ']', '</span>' -%}
{%- assign q1 = m.bloom_faq_q_1.value | default: m.bloom_faq_q_1 -%}
{%- assign q2 = m.bloom_faq_q_2.value | default: m.bloom_faq_q_2 -%}
{%- assign q3 = m.bloom_faq_q_3.value | default: m.bloom_faq_q_3 -%}
{%- assign q4 = m.bloom_faq_q_4.value | default: m.bloom_faq_q_4 -%}
{%- assign q5 = m.bloom_faq_q_5.value | default: m.bloom_faq_q_5 -%}
{%- assign a1 = m.bloom_faq_a_1.value | default: m.bloom_faq_a_1 -%}
{%- assign a2 = m.bloom_faq_a_2.value | default: m.bloom_faq_a_2 -%}
{%- assign a3 = m.bloom_faq_a_3.value | default: m.bloom_faq_a_3 -%}
{%- assign a4 = m.bloom_faq_a_4.value | default: m.bloom_faq_a_4 -%}
{%- assign a5 = m.bloom_faq_a_5.value | default: m.bloom_faq_a_5 -%}
{%- assign c_head = m.bloom_community_heading.value | default: m.bloom_community_heading -%}
{%- assign c_btn1 = m.bloom_community_btn_1.value | default: m.bloom_community_btn_1 | default: 'Join FB Group' -%}
{%- assign c_btn2 = m.bloom_community_btn_2.value | default: m.bloom_community_btn_2 | default: 'Any Question' -%}
{%- assign c_fb = m.bloom_fb_url.value | default: m.bloom_fb_url -%}
{%- assign c_wa = m.bloom_wa_url.value | default: m.bloom_wa_url -%}
{%- assign c_img = m.bloom_community_image.value | default: m.bloom_community_image -%}
{%- if c_img == blank -%}{%- assign c_img = m.product_highlight_3.value | default: m.product_highlight_3 -%}{%- endif -%}
{%- assign c_wa_link = c_wa -%}
{%- if c_wa_link == blank -%}{%- assign c_wa_link = routes.root_url | default: '/' | append: 'pages/contact' -%}{%- endif -%}
{%- if q1 != blank -%}
<section class="bloom bl-faq" id="bl-faq">
  <div class="bl-wrap bl-faq__grid">
    <div class="bl-faq__main">
      {%- if heading != blank -%}<h2 class="bl-faq__h bl-serif" data-bl-reveal>{{ heading_h }}</h2>{%- endif -%}
      <div class="bl-faq__list">
        {%- if q1 != blank and a1 != blank -%}
          <details class="bl-faq__item" name="bl-faq">
            <summary><span>{{ q1 }}</span><span class="bl-faq__ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></span></summary>
            <div class="bl-faq__a"><p>{{ a1 }}</p></div>
          </details>
        {%- endif -%}
        {%- if q2 != blank and a2 != blank -%}
          <details class="bl-faq__item" name="bl-faq">
            <summary><span>{{ q2 }}</span><span class="bl-faq__ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></span></summary>
            <div class="bl-faq__a"><p>{{ a2 }}</p></div>
          </details>
        {%- endif -%}
        {%- if q3 != blank and a3 != blank -%}
          <details class="bl-faq__item" name="bl-faq">
            <summary><span>{{ q3 }}</span><span class="bl-faq__ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></span></summary>
            <div class="bl-faq__a"><p>{{ a3 }}</p></div>
          </details>
        {%- endif -%}
        {%- if q4 != blank and a4 != blank -%}
          <details class="bl-faq__item" name="bl-faq">
            <summary><span>{{ q4 }}</span><span class="bl-faq__ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></span></summary>
            <div class="bl-faq__a"><p>{{ a4 }}</p></div>
          </details>
        {%- endif -%}
        {%- if q5 != blank and a5 != blank -%}
          <details class="bl-faq__item" name="bl-faq">
            <summary><span>{{ q5 }}</span><span class="bl-faq__ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></span></summary>
            <div class="bl-faq__a"><p>{{ a5 }}</p></div>
          </details>
        {%- endif -%}
      </div>
    </div>
    {%- if c_head != blank -%}
    <aside class="bl-comm" data-bl-reveal>
      {%- if c_img != blank -%}<img class="bl-comm__img" src="{{ c_img | image_url: width: 1000 }}" alt="" loading="lazy">{%- endif -%}
      <div class="bl-comm__shade" aria-hidden="true"></div>
      <div class="bl-comm__body">
        <h3 class="bl-comm__h bl-serif">{{ c_head }}</h3>
        <div class="bl-comm__btns">
          {%- if c_fb != blank -%}<a class="bl-btn bl-comm__btn" href="{{ c_fb }}" target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.5-3h-3V8.7c0-.9.3-1.5 1.6-1.5h1.5V4.5c-.3 0-1.2-.1-2.2-.1-2.3 0-3.9 1.4-3.9 4v2.1H7.5v3H10V21h3.5z"/></svg><span>{{ c_btn1 }}</span></a>{%- endif -%}
          <a class="bl-comm__btn bl-comm__btn--light" href="{{ c_wa_link }}"{% if c_wa != blank %} target="_blank" rel="noopener"{% endif %}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.2-4.2A8 8 0 1112 20a8 8 0 01-3.8-1L4 20z"/><path d="M9 8.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-.8.8c-.8-.4-1.5-1.1-1.9-1.9l.8-.8-1-2L9 8.5z"/></svg><span>{{ c_btn2 }}</span></a>
        </div>
      </div>
    </aside>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
<style>
  .bloom { --bl-plum: #4A0E2B; --bl-ink: #3D1229; --bl-rose: #E5518E; --bl-rose-d: #B3235F; --bl-blush: #FDEBF5; --bl-pink: #FFDDEB; --bl-pink-2: #FFE9F2; --bl-peach: #FFE8E3; --bl-coral: #E8695C; --bl-cream: #FFF6E8; --bl-grad: linear-gradient(90deg, #E8695C 0%, #E5518E 100%); --bl-star: #F59E0B; --bl-muted: #6F5A67; --bl-line: #F1D5E1; --bl-serif: "Playfair Display", Georgia, serif; --bl-sans: "Open Sans", system-ui, sans-serif; --bl-pop: "Poppins", "Open Sans", sans-serif; --font-heading-family: "Playfair Display", serif; --font-body-family: "Open Sans", sans-serif; position: relative; font-family: var(--bl-sans); -webkit-font-smoothing: antialiased; }
  :where(.bloom) { background: #fff; color: var(--bl-plum); }
  .bloom *, .bloom *::before, .bloom *::after { box-sizing: border-box; }
  :where(.bloom) :is(p, li, a, span, strong, em, b, s, small, label, summary, td, th, button, figcaption, cite) { font-size: inherit; line-height: inherit; color: inherit; letter-spacing: inherit; }
  .bloom, .bloom :is(p, li, a, span, label, button, input, select, option, summary, td, th, small, strong, em, b, s, div, figcaption, cite) { font-family: var(--bl-sans) !important; }
  .bloom :is(h1, h2, h3, h4, .bl-serif, .bl-serif *, .bl-h *) { font-family: var(--bl-serif) !important; }
  .bloom .bl-pop, .bloom .bl-pop :is(p, li, a, span, label, button, input, select, strong, small, b, s, div, h3, h4) { font-family: var(--bl-pop) !important; }
  :where(.bloom) :is(h1, h2, h3, h4, p, ul, ol, figure, blockquote) { margin: 0; padding: 0; }
  :where(.bloom) :is(ul, ol) { list-style: none; }
  :where(.bloom) img { display: block; max-width: 100%; }
  :where(.bloom) button { font: inherit; }
  :where(.bloom) .bl-wrap { width: min(1280px, calc(100% - 64px)); margin-inline: auto; }
  :where(.bloom) .bl-h { font-weight: 600; line-height: 1.22; letter-spacing: 0; text-wrap: balance; text-align: center; color: var(--bl-plum); font-size: clamp(28px, 3.4vw, 40px); }
  :where(.bloom) .bl-ac { color: var(--bl-rose); }
  :where(.bloom) .bl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 0 28px; border: 1px solid #E5518E; border-radius: 8px; background: var(--bl-grad); color: #fff; font-size: 14px; font-weight: 600; line-height: 1.2; text-decoration: none; cursor: pointer; box-shadow: 0 8px 20px -10px rgb(229 81 142 / .7); transition: transform .25s ease, box-shadow .25s ease, filter .25s ease; }
  :where(.bloom) .bl-btn:hover { transform: translateY(-1px); filter: brightness(1.05); box-shadow: 0 12px 24px -10px rgb(229 81 142 / .8); }
  :where(.bloom) .bl-btn[disabled] { opacity: .5; cursor: not-allowed; transform: none; }
  .bloom [hidden] { display: none !important; }
  :where(.bloom) .bl-fade { -webkit-mask-image: radial-gradient(closest-side, #000 68%, transparent 100%); mask-image: radial-gradient(closest-side, #000 68%, transparent 100%); }
  :where(.bloom) .bl-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  :where(.bloom) .bl-stars { color: var(--bl-star); letter-spacing: 1px; }
  @keyframes bl-rise { from { opacity: 0; transform: translate3d(0, 24px, 0); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .bloom [data-bl-reveal] { animation: bl-rise linear both; animation-timeline: view(); animation-range: entry 0% entry 70%; }
    }
  }
  @media (max-width: 749px) { :where(.bloom) .bl-wrap { width: calc(100% - 32px); } }

  .bl-faq { background: var(--bl-blush); padding: clamp(40px, 5vw, 72px) 0; interpolate-size: allow-keywords; }
  .bl-faq__grid { display: grid; grid-template-columns: minmax(0, 1.42fr) minmax(0, 1fr); gap: clamp(20px, 2.6vw, 36px); align-items: stretch; }
  .bl-faq__grid:not(:has(.bl-comm)) { grid-template-columns: minmax(0, 1fr); max-width: 820px; }
  .bl-faq__h { margin-bottom: clamp(16px, 2vw, 26px); font-size: clamp(26px, 3vw, 32px); font-weight: 600; line-height: 1.25; color: var(--bl-plum); }
  .bl-faq__item { border-bottom: 1px solid #E6BFD2; }
  .bl-faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 66px; padding: 12px 0; list-style: none; cursor: pointer; font-size: clamp(16px, 1.7vw, 18px); font-weight: 500; line-height: 1.4; color: #6B1D45; }
  .bl-faq__item summary::-webkit-details-marker { display: none; }
  .bl-faq__ic { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid #5A2A41; border-radius: 50%; color: #5A2A41; transition: transform .35s ease, background .25s ease, color .25s ease; }
  .bl-faq__item[open] .bl-faq__ic { transform: rotate(180deg); background: #5A2A41; color: #fff; }
  .bl-faq__item::details-content { block-size: 0; overflow: clip; transition: block-size .35s ease, content-visibility .35s allow-discrete; }
  .bl-faq__item[open]::details-content { block-size: auto; }
  .bl-faq__a { padding: 0 52px 18px 0; font-size: 15px; line-height: 1.7; color: #5A3B4B; }
  .bl-comm { position: relative; display: flex; align-items: flex-end; min-height: 420px; border-radius: 16px; overflow: hidden; background: #C0457F; color: #fff; }
  .bl-comm__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .bl-comm__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(142 31 90 / 0) 25%, rgb(142 31 90 / .72) 70%, rgb(120 22 74 / .92) 100%); }
  .bl-comm__body { position: relative; display: grid; gap: 18px; padding: clamp(18px, 2.4vw, 26px); width: 100%; }
  .bl-comm__h { font-size: clamp(22px, 2.4vw, 28px); font-weight: 600; line-height: 1.25; color: #fff; text-shadow: 0 2px 12px rgb(80 10 50 / .35); }
  .bl-comm__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .bl-comm__btn { min-height: 44px; padding: 0 20px; font-size: 13.5px; }
  .bl-comm__btn--light { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: 8px; background: #fff; color: #3B1228; font-weight: 600; line-height: 1.2; text-decoration: none; transition: transform .25s ease; }
  .bl-comm__btn--light:hover { transform: translateY(-1px); }
  @media (max-width: 989px) { .bl-faq__grid { grid-template-columns: minmax(0, 1fr); } .bl-comm { min-height: 360px; } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--bloom" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div, cite) { font-family: "Open Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Playfair Display", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) .bl-flip { transform: scaleX(-1); }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Bloom FAQ and community",
  "tag": "section",
  "class": "roarr-bloom-section",
  "settings": [],
  "presets": [{ "name": "Roarr Bloom FAQ and community" }]
}
{% endschema %}
