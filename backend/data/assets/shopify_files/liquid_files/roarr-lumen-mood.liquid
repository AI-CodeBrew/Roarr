{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500&display=swap">
{%- assign m = product.metafields.roarr -%}
{%- assign eyebrow = m.lumen_mood_eyebrow.value | default: m.lumen_mood_eyebrow | default: shop.name -%}
{%- assign heading = m.lumen_mood_heading.value | default: m.lumen_mood_heading | default: 'Made to be lived with' -%}
{%- assign text = m.lumen_mood_text.value | default: m.lumen_mood_text | default: 'Chosen for how it feels every day, not just how it photographs. A piece that earns its place and stays there.' -%}
{%- assign cta = m.lumen_mood_cta.value | default: m.lumen_mood_cta | default: 'Explore the collection' -%}
{%- assign mood_img = m.product_impact_image.value | default: m.product_impact_image -%}
{%- if mood_img == blank and product.media.size > 0 -%}
  {%- assign last_media = product.media | last -%}
  {%- assign mood_img = last_media.preview_image | default: last_media -%}
{%- endif -%}
<section class="lmk-mood">
  <div class="lmk-mood__media">
    {%- if mood_img != blank -%}<img class="lmk-mood__image" src="{{ mood_img | image_url: width: 1600 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
  </div>
  <div class="lmk-mood__panel">
    <div class="lmk-mood__inner">
      {%- if eyebrow != blank -%}<p class="lmk-mood__eyebrow">{{ eyebrow }}</p>{%- endif -%}
      <h2 class="lmk-mood__heading">{{ heading }}</h2>
      <p class="lmk-mood__text">{{ text }}</p>
      <a class="lmk-mood__cta" href="{{ routes.all_products_collection_url | default: '/collections/all' }}">{{ cta }}<span class="lmk-mood__arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>
<style>
  .lmk-mood { --lmk-sand: #E6DCCF; --lmk-brass: #B08D57; --lmk-night: #1C1917; --lmk-ivory-on-dark: #EFE6DA; display: grid; grid-template-columns: 1fr 1fr; min-height: clamp(440px, 58vh, 600px); background: var(--lmk-night); font-family: "Jost", sans-serif; }
  .lmk-mood *, .lmk-mood *::before, .lmk-mood *::after { box-sizing: border-box; }
  .lmk-mood__media { position: relative; overflow: hidden; background: var(--lmk-sand); }
  .lmk-mood__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .lmk-mood__panel { display: flex; align-items: center; padding: clamp(32px, 5vw, 64px); color: var(--lmk-ivory-on-dark); }
  .lmk-mood__inner { max-width: 460px; display: grid; gap: 16px; }
  .lmk-mood__eyebrow { margin: 0; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--lmk-brass); }
  .lmk-mood__heading { margin: 0; font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: clamp(30px, 3.4vw, 42px); line-height: 1.15; color: var(--lmk-ivory-on-dark); }
  .lmk-mood__text { margin: 0; font-size: 15px; line-height: 1.65; color: var(--lmk-ivory-on-dark); opacity: .85; }
  .lmk-mood__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; width: fit-content; color: var(--lmk-ivory-on-dark); text-decoration: none; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; border-bottom: 1px solid rgb(239 230 218 / .4); padding-bottom: 4px; transition: border-color 200ms ease, color 200ms ease; }
  .lmk-mood__cta:hover { border-color: var(--lmk-brass); color: var(--lmk-brass); }
  .lmk-mood__arrow { transition: transform 200ms ease; }
  .lmk-mood__cta:hover .lmk-mood__arrow { transform: translateX(4px); }
  @media (max-width: 749px) {
    .lmk-mood { grid-template-columns: 1fr; min-height: 0; }
    .lmk-mood__media { aspect-ratio: 4 / 5; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--lumen" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "Jost", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) .lmk-mood__arrow { display: inline-block; transform: scaleX(-1); }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Lumenook Mood",
  "tag": "section",
  "class": "roarr-lumen-section",
  "settings": [],
  "presets": [{ "name": "Roarr Lumenook Mood" }]
}
{% endschema %}
