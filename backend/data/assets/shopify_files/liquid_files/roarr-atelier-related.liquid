      if (prev) prev.disabled = pos <= 2;
      if (next) next.disabled = pos >= max - 2;
      if (bar) bar.style.transform = "scaleX(" + Math.max(0.12, Math.min(1, (pos + track.clientWidth) / track.scrollWidth)).toFixed(3) + ")";
    }
    function step(sign) {
      var card = track.querySelector(".at-card");
      var by = card ? card.getBoundingClientRect().width + 20 : track.clientWidth * 0.8;
      track.scrollBy({ left: sign * dir * by, behavior: reduce ? "auto" : "smooth" });
    }
    if (prev) prev.addEventListener("click", function () { step(-1); });
    if (next) next.addEventListener("click", function () { step(1); });
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();
    /* Quick add through the shared cart API; falls back to a normal form post. */
    root.querySelectorAll(".at-qa").forEach(function (form) {
      if (form.tagName !== "FORM") return;
      form.addEventListener("submit", function (event) {
        var api = window.AtelierCart;
        var button = form.querySelector(".at-qa__btn");
        var buy = document.querySelector("[data-at-buy]");
        var request = api && api.add(form, [button], { added: buy ? buy.dataset.txtAdded : "Added", view: buy ? buy.dataset.txtView : "View bag", checkout: buy ? buy.dataset.txtCheckout : "Checkout" });
        if (!request) return;
        event.preventDefault();
        request.catch(function (err) {
          if (err && err.user) { if (api.toast) api.toast({ product_title: err.message }, { added: "", view: "", checkout: "" }); }
          else form.submit();
        });
      });
    });
  })();
</script>
{%- endif -%}
{%- endcapture -%}
