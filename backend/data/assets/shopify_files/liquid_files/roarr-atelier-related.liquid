{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">
<script>document.documentElement.classList.add("at-js");setTimeout(function(){if(!window.__atMotion)document.documentElement.classList.add("at-reveal-all")},3500);</script>
{%- assign m = product.metafields.roarr -%}
{%- assign eyebrow = m.atelier_related_eyebrow.value | default: m.atelier_related_eyebrow | default: 'Continue exploring' -%}
{%- assign heading = m.atelier_related_heading.value | default: m.atelier_related_heading | default: 'You may also like' -%}
{%- assign pool = nil -%}
{%- for c in product.collections -%}
  {%- if pool == nil and c.handle != 'all' and c.handle != 'frontpage' and c.products_count > 1 -%}{%- assign pool = c -%}{%- endif -%}
{%- endfor -%}
{%- if pool == nil -%}{%- assign pool = collections['all'] -%}{%- endif -%}
{%- assign shown = 0 -%}
{%- capture add_text -%}{%- render 'roarr-ui-string', key: 'add_to_cart' -%}{%- endcapture -%}
{%- capture sold_text -%}{%- render 'roarr-ui-string', key: 'sold_out' -%}{%- endcapture -%}
{%- capture cards -%}
  {%- for card in pool.products limit: 10 -%}
    {%- if card.id != product.id and shown < 8 -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- assign card_variant = card.selected_or_first_available_variant -%}
      {%- assign img_1 = card.featured_media.preview_image | default: card.featured_media -%}
      {%- assign img_2 = nil -%}
      {%- if card.media.size > 1 -%}{%- assign img_2 = card.media[1].preview_image | default: card.media[1] -%}{%- endif -%}
      <li class="at-card">
        <a class="at-card__media" href="{{ card.url }}" aria-label="{{ card.title | escape }}">
          {%- if img_1 != blank -%}<img src="{{ img_1 | image_url: width: 720 }}" srcset="{{ img_1 | image_url: width: 400 }} 400w, {{ img_1 | image_url: width: 720 }} 720w, {{ img_1 | image_url: width: 1000 }} 1000w" sizes="(min-width: 960px) 24vw, 70vw" alt="{{ img_1.alt | default: card.title | escape }}" width="720" height="880" loading="lazy" decoding="async">{%- endif -%}
          {%- if img_2 != blank -%}<img class="at-card__alt" src="{{ img_2 | image_url: width: 720 }}" alt="" width="720" height="880" loading="lazy" decoding="async">{%- endif -%}
        </a>
        <div class="at-card__body">
          <h3 class="at-card__title"><a href="{{ card.url }}">{{ card.title }}</a></h3>
          <p class="at-card__price">{{ card.price | money }}{%- if card.compare_at_price > card.price -%} <s>{{ card.compare_at_price | money }}</s>{%- endif -%}</p>
        </div>
        {%- form 'product', card, class: 'at-qa' -%}
          {%- if card.variants.size > 1 -%}
            <select class="at-qa__select" name="id" aria-label="{{ card.options | join: ' / ' | escape }}">
              {%- for v in card.variants -%}
                <option value="{{ v.id }}"{% if v.id == card_variant.id %} selected{% endif %}{% if v.available == false %} disabled{% endif %}>{{ v.title }}</option>
              {%- endfor -%}
            </select>
          {%- else -%}
            <input type="hidden" name="id" value="{{ card_variant.id }}">
          {%- endif -%}
          <button class="at-qa__btn" type="submit"{% if card.available == false %} disabled{% endif %}><span class="at-btn__label">{%- if card.available == false -%}{{ sold_text | strip }}{%- else -%}{{ add_text | strip }}{%- endif -%}</span></button>
        {%- endform -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
<section class="at at--paper at-rel" id="at-related" data-at-rel>
  <div class="at-wrap">
    <header class="at-rel__head">
      <div>
        <p class="at-eyebrow" data-at-reveal="up">{{ eyebrow }}</p>
        <h2 class="at-h at-rel__title" data-at-split data-at-reveal="split">{{ heading }}</h2>
      </div>
      <div class="at-rel__nav">
        <button type="button" data-at-rel-prev aria-label="Previous"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" data-at-rel-next aria-label="Next"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
    </header>
  </div>
  <ul class="at-rel__track" role="list" data-at-rel-track data-at-reveal="up" style="--d:.1s">{{ cards }}</ul>
  <div class="at-wrap"><div class="at-rel__bar" aria-hidden="true"><i data-at-rel-bar></i></div></div>
</section>
<style>
