{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
{%- assign m = product.metafields.roarr -%}
{%- assign heading = m.frost_promise_heading.value | default: m.frost_promise_heading | default: 'Try it. Love it. Or send it back.' -%}
{%- assign p1 = m.frost_promise_1_title.value | default: m.frost_promise_1_title | default: 'Fast delivery' -%}
{%- assign p1t = m.frost_promise_1_text.value | default: m.frost_promise_1_text | default: 'Ships within 1 to 2 working days.' -%}
{%- assign p2 = m.frost_promise_2_title.value | default: m.frost_promise_2_title | default: 'Easy returns' -%}
{%- assign p2t = m.frost_promise_2_text.value | default: m.frost_promise_2_text | default: 'Not right? Send it back within 30 days.' -%}
{%- assign p3 = m.frost_promise_3_title.value | default: m.frost_promise_3_title | default: 'Real support' -%}
{%- assign p3t = m.frost_promise_3_text.value | default: m.frost_promise_3_text | default: 'Questions before or after you buy? Just ask.' -%}
<section class="fr-promise">
  <div class="fr-wrap">
    <div class="fr-promise__band">
      <h2 class="fr-promise__heading">{{ heading }}</h2>
      <ul class="fr-promise__list" role="list">
        <li><span class="fr-promise__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg></span><div><h3>{{ p1 }}</h3><p>{{ p1t }}</p></div></li>
        <li><span class="fr-promise__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 010 12h-3"/></svg></span><div><h3>{{ p2 }}</h3><p>{{ p2t }}</p></div></li>
        <li><span class="fr-promise__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span><div><h3>{{ p3 }}</h3><p>{{ p3t }}</p></div></li>
      </ul>
    </div>
  </div>
</section>
<style>
  .fr-promise { --fr-white: #FFFFFF; --fr-mist: #F3F6FA; --fr-ice: #E7EEFB; --fr-line: #E2E7EF; --fr-ink: #0B1324; --fr-muted: #586377; --fr-blue: #2F5BFF; --fr-blue-dark: #1C3CD6; --fr-blue-soft: #E8EEFF; --fr-night: #0A0F1E; --font-heading-family: "Plus Jakarta Sans", sans-serif; --font-body-family: "Plus Jakarta Sans", sans-serif; background: var(--fr-white); color: var(--fr-ink); font-family: "Plus Jakarta Sans", sans-serif; padding: 0 0 clamp(64px, 9vw, 128px); }
  .fr-promise *, .fr-promise *::before, .fr-promise *::after { box-sizing: border-box; }
  .fr-wrap { width: min(1240px, calc(100% - 48px)); margin: 0 auto; }
  .fr-intro { max-width: 760px; margin-bottom: clamp(36px, 5vw, 64px); }
  .fr-intro--center { margin-inline: auto; text-align: center; }
  .fr-intro--center .fr-label { justify-content: center; }
  .fr-label { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .01em; color: var(--fr-blue); }
  .fr-label b { display: inline-grid; place-items: center; min-width: 32px; height: 22px; padding: 0 8px; border-radius: 999px; background: var(--fr-blue-soft); color: var(--fr-blue); font-size: 11px; font-weight: 800; letter-spacing: .04em; }
  .fr-display { margin: 16px 0 0; font-weight: 800; font-size: clamp(38px, 5.4vw, 76px); line-height: 1; letter-spacing: -0.045em; color: var(--fr-ink); text-wrap: balance; }
  .fr-display .fr-grad, .fr-hero__title .fr-grad { font-size: inherit; font-weight: inherit; line-height: inherit; letter-spacing: inherit; background: linear-gradient(100deg, var(--fr-ink) 0%, var(--fr-ink) 30%, var(--fr-blue) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .fr-lead { margin: 18px 0 0; font-size: clamp(16px, 1.3vw, 18px); line-height: 1.6; color: var(--fr-muted); }
  @media (max-width: 749px) { .fr-wrap { width: calc(100% - 32px); } }
  .fr-promise__band { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 80px); align-items: center; padding: clamp(36px, 5.5vw, 72px); border-radius: 36px; color: #FFFFFF; background: radial-gradient(90% 140% at 0% 0%, #6F8CFF 0%, var(--fr-blue) 42%, var(--fr-blue-dark) 100%); box-shadow: 0 30px 80px rgb(47 91 255 / .28); }
  .fr-promise__band::before, .fr-promise__band::after { content: ""; position: absolute; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / .14); pointer-events: none; }
  .fr-promise__band::before { width: 520px; height: 520px; right: -160px; top: -220px; }
  .fr-promise__band::after { width: 340px; height: 340px; right: -70px; top: -130px; }
  .fr-promise__heading { position: relative; margin: 0; font-weight: 800; font-size: clamp(32px, 4vw, 56px); line-height: 1.02; letter-spacing: -0.04em; color: #FFFFFF; text-wrap: balance; }
  .fr-promise__list { position: relative; display: grid; list-style: none; margin: 0; padding: 0; }
  .fr-promise__list li { display: flex; gap: 16px; align-items: center; padding: 20px 0; border-bottom: 1px solid rgb(255 255 255 / .2); }
  .fr-promise__list li:first-child { padding-top: 0; }
  .fr-promise__list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .fr-promise__list .fr-promise__icon { flex: none; width: 50px; height: 50px; display: grid; place-items: center; border-radius: 16px; background: rgb(255 255 255 / .16); border: 1px solid rgb(255 255 255 / .22); }
  .fr-promise__list h3 { margin: 0 0 2px; font-size: 18px; font-weight: 800; color: #FFFFFF; }
  .fr-promise__list p { margin: 0; font-size: 15px; line-height: 1.5; color: rgb(255 255 255 / .85); }
  @media (max-width: 849px) {
    .fr-promise__band { grid-template-columns: 1fr; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--frost" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, dt, dd, blockquote, div) { font-family: "Plus Jakarta Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Plus Jakarta Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}

{% schema %}
{
  "name": "Roarr Frost Promise",
  "tag": "section",
  "class": "roarr-frost-section",
  "settings": [],
  "presets": [{ "name": "Roarr Frost Promise" }]
}
{% endschema %}
