{%- capture mz_html -%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap">
{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign use_mf = section.settings.use_roarr_metafields -%}
{%- assign hero_eyebrow = section.settings.hero_eyebrow | default: 'The signature edition' -%}
{%- if use_mf and ht.hero_eyebrow != blank -%}{%- assign hero_eyebrow = ht.hero_eyebrow -%}{%- endif -%}
{%- assign hero_heading = section.settings.hero_heading | default: 'Made to be kept forever' -%}
{%- if use_mf and ht.hero_heading != blank -%}{%- assign hero_heading = ht.hero_heading -%}{%- endif -%}
{%- assign hero_subheading = section.settings.hero_subheading | default: 'A considered piece, finished by hand and designed to grow more beautiful with every day you live with it.' -%}
{%- if use_mf and ht.hero_subheading != blank -%}{%- assign hero_subheading = ht.hero_subheading -%}{%- endif -%}
{%- assign hero_cta = section.settings.hero_cta | default: 'Discover the piece' -%}
{%- if use_mf and ht.hero_cta != blank -%}{%- assign hero_cta = ht.hero_cta -%}{%- endif -%}
{%- assign maison_hero_image = section.settings.maison_hero_image -%}
{%- if use_mf and hi.maison_hero_image != blank -%}{%- assign maison_hero_image = hi.maison_hero_image -%}{%- endif -%}
{%- assign mz_product = blank -%}
{%- if ht.selected_product != blank -%}{%- assign mz_product = all_products[ht.selected_product] -%}{%- endif -%}
{%- if mz_product == blank and collections.all.products.first != blank -%}{%- assign mz_product = collections.all.products.first -%}{%- endif -%}
{%- assign mz_url = routes.all_products_collection_url | default: '/collections/all' -%}
{%- assign mz_title = section.settings.fallback_title -%}
{%- assign mz_price = section.settings.fallback_price -%}
{%- if mz_product != blank and mz_product.title != blank -%}
  {%- assign mz_url = mz_product.url -%}
  {%- assign mz_title = mz_product.title -%}
  {%- assign mz_price = mz_product.price | money -%}
{%- endif -%}
<section class="mz mz-hero" aria-labelledby="mz-hero-{{ section.id }}">
  <div class="mz-hero__media">{%- if maison_hero_image != blank -%}{%- if maison_hero_image contains 'http' or maison_hero_image contains '//' -%}<img src="{{ maison_hero_image }}" alt="{{ hero_heading | escape }}" fetchpriority="high" width="2400" height="1350" decoding="async">{%- else -%}<img src="{{ maison_hero_image | image_url: width: 2400 }}" alt="{{ hero_heading | escape }}" fetchpriority="high" width="2400" height="1350" decoding="async">{%- endif -%}{%- endif -%}</div>
  <div class="mz-hero__plate">
    {%- if hero_eyebrow != blank -%}<p class="mz-label mz-rise" style="--d: .1s"><span class="mz-label__n">N&deg; 01</span>{{ hero_eyebrow | escape }}</p>{%- endif -%}
    <h1 class="mz-hero__h mz-display mz-rise" style="--d: .2s" id="mz-hero-{{ section.id }}">{%- assign mz_words = hero_heading | split: ' ' -%}{%- for w in mz_words -%}{%- if forloop.last -%}<em>{{ w | escape }}</em>{%- else -%}{{ w | escape }} {% endif -%}{%- endfor -%}</h1>
    <div class="mz-hero__row mz-rise" style="--d: .35s">
      {%- if hero_subheading != blank -%}<p class="mz-hero__sub">{{ hero_subheading | escape }}</p>{%- endif -%}
      <div class="mz-hero__buy">
        {%- if hero_cta != blank -%}<a class="mz-btn" href="{{ mz_url }}">{{ hero_cta | escape }}<span class="mz-arrow" aria-hidden="true">&rarr;</span></a>{%- endif -%}
        {%- if mz_title != blank -%}<p class="mz-hero__meta"><span>{{ mz_title | escape }}</span>{%- if mz_price != blank -%}<span>{{ mz_price }}</span>{%- endif -%}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>
  #shopify-section-{{ section.id }} { width: 100%; max-width: none; }
  :where(.mz) { --mz-ivory: #F5F1EA; --mz-paper: #FBF9F5; --mz-stone: #E9E2D6; --mz-ink: #1D1915; --mz-ink-2: #5E554B; --mz-line: rgb(29 25 21 / .14); --mz-gold: #B39062; --mz-gold-deep: #8F6F43; --mz-gold-text: #6E5530; --mz-on-dark: #F3EDE3; --mz-on-dark-2: #CBC2B4; --mz-gold-light: #D8C29B; --mz-serif: "Instrument Serif", "Cormorant Garamond", "Times New Roman", serif; --mz-sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif; --mz-gutter: clamp(20px, 4vw, 64px); --mz-dir: 1; font-family: var(--mz-sans); font-size: 16px; line-height: 1.65; color: var(--mz-ink); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  .mz *, .mz *::before, .mz *::after { box-sizing: border-box; }
  :where(.mz) :where(h1, h2, h3, p, ul, ol, dl, dd, blockquote, figure) { margin: 0; padding: 0; }
  :where(.mz) :where(ul, ol) { list-style: none; }
  :where(.mz) img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .mz-wrap { width: 100%; max-width: 1440px; margin-inline: auto; padding-inline: var(--mz-gutter); }
  .mz-label { display: flex; align-items: baseline; gap: 14px; font: 500 11.5px/1.4 var(--mz-sans); letter-spacing: .2em; text-transform: uppercase; color: var(--mz-gold-text); }
  .mz-label__n { font-feature-settings: "tnum"; letter-spacing: .08em; color: var(--mz-ink-2); }
  .mz-label__n::after { content: ""; display: inline-block; width: 28px; height: 1px; margin-inline-start: 14px; vertical-align: middle; background: var(--mz-gold); }
  .mz-h2 { font: 400 clamp(40px, 4.8vw, 72px)/1 var(--mz-serif); letter-spacing: -.015em; color: var(--mz-ink); text-wrap: balance; }
  .mz-h2 em, .mz-display em { font-style: italic; color: var(--mz-gold-deep); }
  .mz-body { font-size: 17px; line-height: 1.7; color: var(--mz-ink-2); text-wrap: pretty; }
  .mz-btn { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 54px; padding: 0 34px; border: 1px solid var(--mz-ink); background: var(--mz-ink); color: var(--mz-paper); font: 500 12px/1 var(--mz-sans); letter-spacing: .18em; text-transform: uppercase; text-decoration: none; transition: background .4s ease, color .4s ease, border-color .4s ease; }
  .mz-btn:hover { background: var(--mz-gold-deep); border-color: var(--mz-gold-deep); color: var(--mz-paper); }
  .mz-btn--light { background: var(--mz-paper); border-color: var(--mz-paper); color: var(--mz-ink); }
  .mz-btn--light:hover { background: transparent; border-color: var(--mz-paper); color: var(--mz-paper); }
  .mz-link { position: relative; display: inline-flex; align-items: center; gap: 12px; padding-bottom: 8px; color: var(--mz-ink); font: 500 12px/1 var(--mz-sans); letter-spacing: .18em; text-transform: uppercase; text-decoration: none; }
  .mz-link::after { content: ""; position: absolute; inset: auto 0 0; height: 1px; background: currentColor; transform-origin: right; transition: transform .5s cubic-bezier(.2, .7, .2, 1); }
  .mz-link:hover::after { transform: scaleX(.35); }
  .mz-btn:focus-visible, .mz-link:focus-visible, .mz summary:focus-visible { outline: 2px solid var(--mz-gold-text); outline-offset: 4px; }
  .mz-arrow { display: inline-block; font-family: var(--mz-sans); }
  .mz-media { position: relative; overflow: hidden; background: var(--mz-stone); }
  .mz-media img { transition: transform 1.6s cubic-bezier(.2, .7, .2, 1); }
  .mz-media:hover img { transform: scale(1.03); }
  .mz-fig { display: grid; gap: 16px; }
  .mz-fig figcaption { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 18px; row-gap: 4px; align-items: baseline; }
  .mz-fig__n { grid-row: span 2; font: 500 11px/1.6 var(--mz-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--mz-gold-text); }
  .mz-fig h3 { font: 400 24px/1.15 var(--mz-serif); color: var(--mz-ink); }
  .mz-fig p { font-size: 14.5px; line-height: 1.6; color: var(--mz-ink-2); }
  @keyframes mz-reveal { from { opacity: 0; transform: translateY(32px); } to { opacity: 1; transform: none; } }
  @keyframes mz-settle { from { scale: 1.14; } to { scale: 1; } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .mz-reveal { animation: mz-reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 70%; }
      .mz-settle img { animation: mz-settle linear both; animation-timeline: view(); animation-range: entry 0% cover 55%; }
    }
  }
  @media (max-width: 749px) { .mz-body { font-size: 16px; } }
  @media (prefers-reduced-motion: reduce) { .mz *, .mz *::before, .mz *::after { animation: none !important; transition: none !important; } }

  .mz-hero { position: relative; background: var(--mz-ivory); }
  .mz-hero__media { position: relative; height: clamp(600px, 88svh, 940px); background: var(--mz-stone); }
  .mz-hero__media img { object-position: 62% 50%; }
  .mz-hero__plate { position: absolute; inset-block-end: 0; inset-inline-start: 0; width: min(820px, 62%); display: grid; gap: 26px; padding: clamp(36px, 4vw, 56px) var(--mz-gutter) 0; background: var(--mz-ivory); }
  .mz-hero__h { font: 400 clamp(56px, 7.6vw, 132px)/.94 var(--mz-serif); letter-spacing: -.025em; color: var(--mz-ink); text-wrap: balance; }
  .mz-hero__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 32px; padding-top: 4px; }
  .mz-hero__sub { max-width: 26em; font-size: 16.5px; line-height: 1.65; color: var(--mz-ink-2); }
  .mz-hero__buy { display: grid; justify-items: start; gap: 14px; }
  .mz-hero__meta { display: flex; gap: 14px; font: 500 11.5px/1.4 var(--mz-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--mz-ink-2); }
  .mz-hero__meta span + span::before { content: ""; display: inline-block; width: 4px; height: 4px; margin-inline-end: 14px; vertical-align: middle; border-radius: 50%; background: var(--mz-gold); }
  .mz-rise { animation: mz-rise 1.1s cubic-bezier(.2, .7, .2, 1) both; animation-delay: var(--d, 0s); }
  @keyframes mz-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (max-width: 1099px) { .mz-hero__plate { width: min(720px, 78%); } .mz-hero__row { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 749px) {
    .mz-hero__media { height: auto; aspect-ratio: 4 / 5; }
    .mz-hero__plate { position: relative; width: calc(100% - 20px); margin-top: -72px; padding-top: 28px; }
    .mz-hero .mz-btn { width: 100%; }
    .mz-hero__buy { justify-items: stretch; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if mz_html contains 'ا' or mz_html contains 'ل' or mz_html contains 'ي' or mz_html contains 'ة' -%}
<div class="mz-rtl" dir="rtl" style="display: contents">{{ mz_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700&display=swap">
<style>
  .mz-rtl:is(#mz-rtl, *), .mz-rtl:is(#mz-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .mz-rtl:is(#mz-rtl, *) :is(p, li, span, a, summary, dt, dd, figcaption, div) { font-family: "Instrument Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .mz-rtl:is(#mz-rtl, *) :is(h1, h2, h3, blockquote, blockquote p) { font-family: "Instrument Serif", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.4 !important; }
  .mz-rtl:is(#mz-rtl, *) .mz { --mz-dir: -1; }
  .mz-rtl:is(#mz-rtl, *) .mz-arrow { transform: scaleX(-1); }
</style>
{%- else -%}
{{ mz_html }}
{%- endif -%}

{% schema %}
{
  "name": "Maison Hero",
  "tag": "section",
  "class": "roarr-maison-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_roarr_metafields",
      "label": "Use Roarr generated content",
      "default": true
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Label",
      "default": "The signature edition"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading (last word is italic)",
      "default": "Made to be kept forever"
    },
    {
      "type": "textarea",
      "id": "hero_subheading",
      "label": "Text",
      "default": "A considered piece, finished by hand and designed to grow more beautiful with every day you live with it."
    },
    {
      "type": "text",
      "id": "hero_cta",
      "label": "Button label",
      "default": "Discover the piece"
    },
    {
      "type": "image_picker",
      "id": "maison_hero_image",
      "label": "Campaign image (16:9)"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Product name when no product is found",
      "default": "Signature piece"
    },
    {
      "type": "text",
      "id": "fallback_price",
      "label": "Price when no product is found",
      "default": "$49.00"
    }
  ],
  "presets": [
    {
      "name": "Maison Hero"
    }
  ]
}
{% endschema %}
