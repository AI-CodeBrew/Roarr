# Supabase Postgres + Auth
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Bunny Storage / CDN (product + generated images)
BUNNY_STORAGE_ZONE=
BUNNY_ACCESS_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_HOSTNAME=YOUR_PULLZONE.b-cdn.net

# Shopify app (same app as the frontend)
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_SECRET=
SHOPIFY_APP_EMBED_EXTENSION_ID=
SHOPIFY_APP_EMBED_HANDLE=
SHOPIFY_TEST_MODE=true

# Local URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001
WEBHOOK_ENDPOINT_URL=http://localhost:5001
HOST=0.0.0.0
PORT=5001
FLASK_ENV=development
ENVIRONMENT=development


OPENAI_API_KEY=
GEMINI_API_KEY=

