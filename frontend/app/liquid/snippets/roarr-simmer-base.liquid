          [[-1, "sm-qv__prev", ICON_BACK, "Previous image"], [1, "sm-qv__next", ICON_NEXT, "Next image"]].forEach(function (part) {
            var nav = make("button", "sm-round " + part[1]);
            nav.type = "button"; nav.innerHTML = part[2]; nav.setAttribute("aria-label", part[3]);
            nav.addEventListener("click", function () { shot = (shot + part[0] + images.length) % images.length; pic.src = images[shot]; });
            media.appendChild(nav);
          });
        }

        var info = make("div", "sm-qv__info");
        info.appendChild(make("h2", "sm-qv__title", product.title));
        var review = make("p", "sm-qv__review");
        var stars = make("span", "sm-stars");
        stars.style.setProperty("--sm-rate", (Number(trigger.dataset.rating) || 0) * 20 + "%");
        review.appendChild(stars);
        review.appendChild(make("span", "", "(" + (trigger.dataset.count || 0) + ")"));
        info.appendChild(review);

        var prices = make("p", "sm-qv__price"), was = make("s"), bar = make("i"), now = make("b"), off = make("em");
        [was, bar, now, off].forEach(function (el) { prices.appendChild(el); });
        info.appendChild(prices);

        var facts = make("dl", "sm-qv__facts"), skuRow = make("div"), skuValue = make("dd");
        skuRow.appendChild(make("dt", "", labels.smLabelSku));
        skuRow.appendChild(skuValue);
        facts.appendChild(skuRow);
        if (product.type) {
          var typeRow = make("div");
          typeRow.appendChild(make("dt", "", labels.smLabelCategory));
          typeRow.appendChild(make("dd", "", product.type));
          facts.appendChild(typeRow);
        }
        info.appendChild(facts);

        var variants = product.variants || [];
        var chosen = variants.filter(function (v) { return v.available; })[0] || variants[0];
        var add = make("button", "sm-btn sm-qv__add");
        add.type = "button";
        function paint() {
          add.disabled = !chosen || !chosen.available;
          add.textContent = add.disabled ? labels.smLabelSoldOut : labels.smLabelAdd;
          buyNow.disabled = add.disabled;
          if (!chosen) return;
          now.textContent = money(chosen.price);
          var sale = chosen.compare_at_price > chosen.price;
          was.hidden = bar.hidden = off.hidden = !sale;
          if (sale) {
            was.textContent = money(chosen.compare_at_price);
            off.textContent = "-" + Math.round((1 - chosen.price / chosen.compare_at_price) * 100) + "%";
          }
          skuRow.hidden = !chosen.sku;
          skuValue.textContent = chosen.sku || "";
        }
        if (variants.length > 1) {
          var pills = make("div", "sm-pills sm-qv__options");
          variants.forEach(function (variant) {
            var pill = make("button", "sm-pill", variant.title);
            pill.type = "button";
            pill.disabled = !variant.available;
            pill.setAttribute("aria-pressed", variant === chosen ? "true" : "false");
            pill.addEventListener("click", function () {
              chosen = variant;
              $$("button", pills).forEach(function (b) { b.setAttribute("aria-pressed", b === pill ? "true" : "false"); });
              paint();
            });
            pills.appendChild(pill);
          });
          info.appendChild(pills);
        }

        info.appendChild(make("p", "sm-qv__label", labels.smLabelQty));
        var row = make("div", "sm-qv__buy"), stepper = make("div", "sm-stepper");
        var less = make("button", "", "−"), qty = make("input"), more = make("button", "", "+");
        less.type = more.type = "button";
        less.setAttribute("aria-label", "Decrease quantity");
        more.setAttribute("aria-label", "Increase quantity");
        qty.type = "number"; qty.min = "1"; qty.value = "1"; qty.setAttribute("aria-label", labels.smLabelQty);
        less.addEventListener("click", function () { qty.value = Math.max(1, (Number(qty.value) || 1) - 1); });
        more.addEventListener("click", function () { qty.value = (Number(qty.value) || 1) + 1; });
        [less, qty, more].forEach(function (el) { stepper.appendChild(el); });
        row.appendChild(stepper);
        add.addEventListener("click", function () { if (chosen) addToCart(chosen.id, Number(qty.value) || 1, add); });
        row.appendChild(add);
        info.appendChild(row);
        var buyNow = make("button", "sm-btn sm-qv__now", labels.smLabelBuy);
        buyNow.type = "button";
        buyNow.addEventListener("click", function () { if (chosen) sm.api.buy(chosen.id, Number(qty.value) || 1); });
        info.appendChild(buyNow);
        paint();

        var box = make("div", "sm-qv"); box.appendChild(media); box.appendChild(info);
        body.appendChild(box);
        open(d);
      }).catch(function () { window.location.href = url; });
    }

    /* Story video */
    function embedUrl(url) {
      var yt = /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{6,})/.exec(url);
      if (yt) return "https://www.youtube-nocookie.com/embed/" + yt[1] + "?autoplay=1";
      var vimeo = /vimeo\.com\/(?:video\/)?(\d+)/.exec(url);
      if (vimeo) return "https://player.vimeo.com/video/" + vimeo[1] + "?autoplay=1";
      return null;
    }
    function openVideo(url) {
      var d = dialog("video");
      if (!d) return;
      var box = $("[data-sm-video-box]", d), embed = embedUrl(url), media;
      box.textContent = "";
      if (embed) { media = make("iframe"); media.src = embed; media.title = "Video"; media.allow = "autoplay; fullscreen; picture-in-picture"; }
      else { media = make("video"); media.src = url; media.controls = true; media.autoplay = true; }
      box.appendChild(media);
      if (!d.dataset.smWired) { d.dataset.smWired = "1"; d.addEventListener("close", function () { box.textContent = ""; }); }
      open(d);
    }

    /* Shared clicks */
    document.addEventListener("click", function (event) {
      var t = event.target;
      if (!t.closest) return;

      if (t.tagName === "DIALOG" && t.open) { close(t); return; }

      var closer = t.closest("[data-sm-close]");
      if (closer) { close(closer.closest("dialog")); return; }

      var opener = t.closest("[data-sm-open]");
      if (opener) {
        event.preventDefault();
        var name = opener.getAttribute("data-sm-open");
        if (name === "cart") openCart().catch(function () { window.location.href = opener.getAttribute("href") || root() + "cart"; });
        else { if (name === "wishlist") paintWishes(); open(dialog(name)); }
        return;
      }

      var heart = t.closest("[data-sm-wish]");
      if (heart) {
        var url = heart.dataset.smWish, list = wishes();
        if (list.some(function (i) { return i.url === url; })) list = list.filter(function (i) { return i.url !== url; });
        else list.push({ url: url, title: heart.dataset.title, image: heart.dataset.image });
        write("localStorage", WISH, JSON.stringify(list));
        paintWishes();
        return;
      }

      var quick = t.closest("[data-sm-quick]");
      if (quick) { event.preventDefault(); openQuick(quick); return; }

      var adder = t.closest("[data-sm-add]");
      if (adder && adder.form) {
        event.preventDefault();
        var id = adder.form.querySelector('[name="id"]');
        var qty = adder.form.querySelector('[name="quantity"]');
        if (id) addToCart(id.value, qty ? Number(qty.value) || 1 : 1, adder);
        return;
      }

      var line = t.closest("[data-sm-line]");
      if (line) {
        sm.api.change(Number(line.getAttribute("data-sm-line")), Number(line.getAttribute("data-sm-qty"))).then(paintCart).catch(function (err) { toast(err.message); });
        return;
      }

      var zoom = t.closest("[data-sm-zoom]");
      if (zoom) { if (openZoom(zoom)) event.preventDefault(); return; }

      var play = t.closest("[data-sm-play]");
      if (play) {
        var tile = play.closest("[data-sm-video-tile]"), film = tile && $("video", tile);
        if (film) {
          event.preventDefault();
          tile.classList.add("is-playing");
          film.controls = true;
          film.muted = false;
          var started = film.play();
          if (started && started.catch) started.catch(function () {});
        }
        return;
      }

      var video = t.closest("[data-sm-video]");
      if (video) { event.preventDefault(); openVideo(video.getAttribute("data-sm-video")); return; }

      var pin = t.closest("[data-sm-pin]");
      var openPins = $$(".sm-pin.is-open");
      if (pin) {
        var spot = pin.closest(".sm-pin"), was = spot.classList.contains("is-open");
        openPins.forEach(function (p) { p.classList.remove("is-open"); });
        spot.classList.toggle("is-open", !was);
        pin.setAttribute("aria-expanded", was ? "false" : "true");
      } else if (!t.closest(".sm-pin__card")) {
        openPins.forEach(function (p) { p.classList.remove("is-open"); });
      }
    });

    function init() {
      initReveals();
      initLazy();
      $$("[data-sm-slides]").forEach(function (el) { if (first(el, "smReady")) initSlides(el); });
      $$("[data-sm-rail]").forEach(function (el) { if (first(el, "smReady")) initRail(el); });
      $$("[data-sm-showcase]").forEach(function (el) { if (first(el, "smReady")) initShowcase(el); });
      $$("[data-sm-fold]").forEach(function (el) { if (first(el, "smReady")) initFold(el); });
      $$("[data-sm-clock]").forEach(function (el) { if (first(el, "smReady")) initClock(el); });
      $$("[data-sm-header]").forEach(function (el) { if (first(el, "smReady")) { initHeader(el); initHeaderTools(el); } });
      $$("[data-sm-picks]").forEach(function (el) { if (first(el, "smReady")) initPicks(el); });
      $$("[data-sm-top]").forEach(function (el) { if (first(el, "smReady")) initTop(el); });
      $$('[data-sm-dialog="popup"]').forEach(function (el) { if (first(el, "smReady")) initPopup(el); });
      paintWishes();
    }

    var sm = window.__sm = { init: init, api: api, money: money, toast: toast, open: open, close: close, dialog: dialog, initRail: initRail };
    window.addEventListener("storage", paintWishes);
    document.addEventListener("shopify:section:load", init);
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init); else init();
  })();
</script>
