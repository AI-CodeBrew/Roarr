{% comment %} Section: Custom Detail Columns with Roarr Metafield Support {% endcomment %}

{%- style -%} 
.section-{{ section.id }}-padding { 
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; 
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; 
  width: 100vw;
  max-width: 100vw; 
  margin-left: calc(50% - 50vw); 
  margin-right: calc(50% - 50vw);
  overflow-x: clip;

  /* ---- Scheme Mapping ---- */
  --text-opacity: {{ section.settings.text_opacity | divided_by: 100.0 }};
  --ch-surface:          var(--color-background, #ffffff);
  --ch-surface-gradient: var(--gradient-background, var(--color-background-gradient, var(--color-background, #ffffff)));
  --ch-text:             var(--color-text, var(--color-body, var(--color-foreground-solid, #111111)));
  --ch-heading:          var(--color-heading, var(--color-headings, var(--color-headline, var(--ch-text))));
  --ch-text-muted:       color-mix(in srgb, var(--ch-text) calc(100% * var(--text-opacity)), transparent);
}

@media screen and (min-width: 990px) { 
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px; 
    padding-bottom: {{ section.settings.padding_bottom }}px; 
  } 
}

.dc-wrapper { font-family: var(--font-body-family), sans-serif; color: var(--ch-text); background: var(--ch-surface-gradient); } 
.dc-wrapper * { box-sizing: border-box; }

.dc-header { text-align: center; margin-bottom: 50px; padding: 0 20px; }
.dc-preheading { font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ch-text-muted); margin: 0 0 16px 0; } 
.dc-heading {
  font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }}, sans-serif !important;
  font-style: {{ settings.type_heading_font.style }}; 
  font-weight: {{ settings.type_heading_font.weight | default: 'normal' }}; 
  font-size: clamp(1.4rem, 2.5vw, 1.8rem); 
  letter-spacing: 0.15em; 
  text-transform: uppercase;
  color: var(--ch-heading); 
  margin: 0; 
}

.dc-grid { 
  display: grid; 
  grid-template-columns: repeat({{ section.blocks.size | default: 3 }}, 1fr);
  gap: 30px; 
  max-width: var(--page-width, 1400px); 
  margin: 0 auto;
  padding: 0 40px; 
}

.dc-item { display: flex; flex-direction: column; gap: 24px; }

.dc-image-wrap { 
  width: 100%; 
  aspect-ratio: {{ section.settings.image_ratio }};
  background: color-mix(in srgb, var(--ch-text) 4%, transparent); 
  overflow: hidden; 
} 
.dc-image-wrap img, .dc-image-wrap svg { width: 100%; height: 100%; object-fit: cover; display: block; } 
.dc-image-wrap svg { fill: color-mix(in srgb, var(--ch-text) 20%, transparent); }

.dc-text { font-size: 0.95rem; line-height: 1.6; text-align: center; color: var(--ch-text); margin: 0; }

@media screen and (max-width: 749px) { 
  .dc-header { margin-bottom: 35px; } 
  .dc-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 0 20px; gap: 20px; } 
  .dc-grid::-webkit-scrollbar { display: none; } 
  .dc-item { flex: 0 0 calc(100% - 40px); scroll-snap-align: center; } 
} 
{%- endstyle -%}

<section class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="dc-wrapper">
    
    {%- if section.settings.heading != blank or section.settings.pre_heading != blank -%}
      <div class="dc-header">
        {%- if section.settings.pre_heading != blank -%}
          <p class="dc-preheading">{{ section.settings.pre_heading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dc-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="dc-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          # Default block settings
          assign display_text = block.settings.text
          assign display_image = block.settings.image
          
          # Metafield Logic — generated text + happy customer images from roarr
          if section.settings.use_metafields and product and product.metafields.roarr
            assign idx = forloop.index
            
            # Construct Metafield Keys
            assign text_key = 'impactfull_poetic_product_detail_' | append: idx
            assign image_key = 'happy_customer_image_' | append: idx
            
            assign mf_text = product.metafields.roarr[text_key]
            assign mf_text_resolved = mf_text.value | default: mf_text
            if mf_text_resolved != blank
              assign display_text = mf_text_resolved
            endif
            
            assign mf_img = product.metafields.roarr[image_key]
            if mf_img
              assign mf_img_resolved = mf_img.value | default: mf_img
              if mf_img_resolved != blank
                assign display_image = mf_img_resolved
              endif
            endif
          endif
        -%}

        <div class="dc-item" {{ block.shopify_attributes }}>
          <div class="dc-image-wrap">
            {%- assign img_src = display_image | image_url: width: 800 -%}
            {%- if img_src != blank -%}
              <img src="{{ img_src }}" class="placeholder-svg" loading="lazy" alt="{{ display_text | strip_html }}">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if display_text != blank -%}
            <div class="dc-text">{{ display_text | metafield_tag }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

