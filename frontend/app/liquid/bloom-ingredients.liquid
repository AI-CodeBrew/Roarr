{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap">
{%- assign m = product.metafields.roarr -%}
{%- assign heading = m.bloom_ing_heading.value | default: m.bloom_ing_heading | default: 'What is [inside]' -%}
{%- assign heading_h = heading | escape | replace: '[', '<span class="bl-ac">' | replace: ']', '</span>' -%}
{%- assign sub = m.bloom_ing_text.value | default: m.bloom_ing_text -%}
{%- assign n1 = m.bloom_ing_1_name.value | default: m.bloom_ing_1_name -%}
{%- assign n2 = m.bloom_ing_2_name.value | default: m.bloom_ing_2_name -%}
{%- assign n3 = m.bloom_ing_3_name.value | default: m.bloom_ing_3_name -%}
{%- assign n4 = m.bloom_ing_4_name.value | default: m.bloom_ing_4_name -%}
{%- assign x1 = m.bloom_ing_1_text.value | default: m.bloom_ing_1_text -%}
{%- assign x2 = m.bloom_ing_2_text.value | default: m.bloom_ing_2_text -%}
{%- assign x3 = m.bloom_ing_3_text.value | default: m.bloom_ing_3_text -%}
{%- assign x4 = m.bloom_ing_4_text.value | default: m.bloom_ing_4_text -%}
{%- if n1 != blank -%}
<section class="bloom bl-ing" id="bl-ingredients">
  <span class="bl-ing__glow bl-ing__glow--a" aria-hidden="true"></span>
  <span class="bl-ing__glow bl-ing__glow--b" aria-hidden="true"></span>
  <div class="bl-wrap">
    <div class="bl-ing__head" data-bl-reveal>
      <h2 class="bl-h bl-ing__h">{{ heading_h }}</h2>
      {%- if sub != blank -%}<p class="bl-ing__sub">{{ sub }}</p>{%- endif -%}
    </div>
    <ul class="bl-ing__grid" role="list">
      {%- if n1 != blank -%}
      <li class="bl-ing__card" data-bl-reveal style="--d:0.0s">
        <span class="bl-ing__orb"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 01-12 0c0-4.5 6-11 6-11z"/></svg></span>
        <span class="bl-ing__no">01</span>
        <h3 class="bl-ing__name bl-serif">{{ n1 }}</h3>
        {%- if x1 != blank -%}<p class="bl-ing__x">{{ x1 }}</p>{%- endif -%}
      </li>
      {%- endif -%}
      {%- if n2 != blank -%}
      <li class="bl-ing__card" data-bl-reveal style="--d:0.08s">
        <span class="bl-ing__orb"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19C5 10 10 5 20 4c0 10-5 15-14 15z"/><path d="M5 19c3-5 6-8 11-11"/></svg></span>
        <span class="bl-ing__no">02</span>
        <h3 class="bl-ing__name bl-serif">{{ n2 }}</h3>
        {%- if x2 != blank -%}<p class="bl-ing__x">{{ x2 }}</p>{%- endif -%}
      </li>
      {%- endif -%}
      {%- if n3 != blank -%}
      <li class="bl-ing__card" data-bl-reveal style="--d:0.16s">
        <span class="bl-ing__orb"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/><path d="M19 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2z"/></svg></span>
        <span class="bl-ing__no">03</span>
        <h3 class="bl-ing__name bl-serif">{{ n3 }}</h3>
        {%- if x3 != blank -%}<p class="bl-ing__x">{{ x3 }}</p>{%- endif -%}
      </li>
      {%- endif -%}
      {%- if n4 != blank -%}
      <li class="bl-ing__card" data-bl-reveal style="--d:0.24s">
        <span class="bl-ing__orb"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
        <span class="bl-ing__no">04</span>
        <h3 class="bl-ing__name bl-serif">{{ n4 }}</h3>
        {%- if x4 != blank -%}<p class="bl-ing__x">{{ x4 }}</p>{%- endif -%}
      </li>
      {%- endif -%}
    </ul>
  </div>
</section>
{%- endif -%}
<style>
  .bloom { --bl-plum: #4A0E2B; --bl-ink: #3D1229; --bl-rose: #E5518E; --bl-rose-d: #B3235F; --bl-blush: #FDEBF5; --bl-pink: #FFDDEB; --bl-pink-2: #FFE9F2; --bl-peach: #FFE8E3; --bl-coral: #E8695C; --bl-cream: #FFF6E8; --bl-grad: linear-gradient(90deg, #E8695C 0%, #E5518E 100%); --bl-star: #F59E0B; --bl-muted: #6F5A67; --bl-line: #F1D5E1; --bl-serif: "Playfair Display", Georgia, serif; --bl-sans: "Open Sans", system-ui, sans-serif; --bl-pop: "Poppins", "Open Sans", sans-serif; --font-heading-family: "Playfair Display", serif; --font-body-family: "Open Sans", sans-serif; position: relative; font-family: var(--bl-sans); -webkit-font-smoothing: antialiased; }
  :where(.bloom) { background: #fff; color: var(--bl-plum); }
  .bloom *, .bloom *::before, .bloom *::after { box-sizing: border-box; }
  :where(.bloom) :is(p, li, a, span, strong, em, b, s, small, label, summary, td, th, button, figcaption, cite) { font-size: inherit; line-height: inherit; color: inherit; letter-spacing: inherit; }
  .bloom, .bloom :is(p, li, a, span, label, button, input, select, option, summary, td, th, small, strong, em, b, s, div, figcaption, cite) { font-family: var(--bl-sans) !important; }
  .bloom :is(h1, h2, h3, h4, .bl-serif, .bl-serif *, .bl-h *) { font-family: var(--bl-serif) !important; }
  .bloom .bl-pop, .bloom .bl-pop :is(p, li, a, span, label, button, input, select, strong, small, b, s, div, h3, h4) { font-family: var(--bl-pop) !important; }
  :where(.bloom) :is(h1, h2, h3, h4, p, ul, ol, figure, blockquote) { margin: 0; padding: 0; }
  :where(.bloom) :is(ul, ol) { list-style: none; }
  :where(.bloom) img { display: block; max-width: 100%; }
  :where(.bloom) button { font: inherit; }
  :where(.bloom) .bl-wrap { width: min(1280px, calc(100% - 64px)); margin-inline: auto; }
  :where(.bloom) .bl-h { font-weight: 600; line-height: 1.22; letter-spacing: 0; text-wrap: balance; text-align: center; color: var(--bl-plum); font-size: clamp(28px, 3.4vw, 40px); }
  :where(.bloom) .bl-ac { color: var(--bl-rose); }
  :where(.bloom) .bl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 0 28px; border: 1px solid #E5518E; border-radius: 8px; background: var(--bl-grad); color: #fff; font-size: 14px; font-weight: 600; line-height: 1.2; text-decoration: none; cursor: pointer; box-shadow: 0 8px 20px -10px rgb(229 81 142 / .7); transition: transform .25s ease, box-shadow .25s ease, filter .25s ease; }
  :where(.bloom) .bl-btn:hover { transform: translateY(-1px); filter: brightness(1.05); box-shadow: 0 12px 24px -10px rgb(229 81 142 / .8); }
  :where(.bloom) .bl-btn[disabled] { opacity: .5; cursor: not-allowed; transform: none; }
  .bloom [hidden] { display: none !important; }
  :where(.bloom) .bl-fade { -webkit-mask-image: radial-gradient(closest-side, #000 68%, transparent 100%); mask-image: radial-gradient(closest-side, #000 68%, transparent 100%); }
  :where(.bloom) .bl-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  :where(.bloom) .bl-stars { color: var(--bl-star); letter-spacing: 1px; }
  @keyframes bl-rise { from { opacity: 0; transform: translate3d(0, 24px, 0); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .bloom [data-bl-reveal] { animation: bl-rise linear both; animation-timeline: view(); animation-range: entry 0% entry 70%; }
    }
  }
  @media (max-width: 749px) { :where(.bloom) .bl-wrap { width: calc(100% - 32px); } }

  .bl-ing { position: relative; overflow: hidden; background: radial-gradient(120% 140% at 50% 0%, #5E1C40 0%, #3D1229 55%, #2A0B1C 100%); color: #FCEAF2; padding: clamp(52px, 6.5vw, 96px) 0; isolation: isolate; }
  .bl-ing__glow { position: absolute; z-index: -1; width: 520px; aspect-ratio: 1; border-radius: 50%; filter: blur(60px); opacity: .5; pointer-events: none; }
  .bl-ing__glow--a { top: -220px; inset-inline-start: -160px; background: #E5518E; }
  .bl-ing__glow--b { bottom: -260px; inset-inline-end: -180px; background: #B86BE0; opacity: .32; }
  @media (prefers-reduced-motion: no-preference) {
    .bl-ing__glow { animation: bl-drift 16s ease-in-out infinite alternate; }
    .bl-ing__glow--b { animation-duration: 20s; }
  }
  @keyframes bl-drift { to { transform: translate3d(60px, 40px, 0) scale(1.12); } }
  .bl-ing__head { display: grid; justify-items: center; gap: 12px; max-width: 640px; margin: 0 auto clamp(30px, 4vw, 52px); text-align: center; }
  .bloom .bl-ing__h { color: #fff; }
  .bloom .bl-ing__h .bl-ac { color: #FF9CC4; font-style: italic; }
  .bl-ing__sub { font-size: 15.5px; line-height: 1.65; color: #E9C4D6; }
  .bl-ing__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: clamp(14px, 1.8vw, 22px); }
  .bl-ing__card { position: relative; display: grid; align-content: start; gap: 10px; padding: 30px 24px 28px; border: 1px solid rgb(255 255 255 / .12); border-radius: 22px; background: linear-gradient(160deg, rgb(255 255 255 / .09), rgb(255 255 255 / .02)); backdrop-filter: blur(6px); transition: transform .4s ease, border-color .4s ease, background .4s ease; }
  .bl-ing__card:hover { transform: translateY(-6px); border-color: rgb(255 156 196 / .55); background: linear-gradient(160deg, rgb(255 156 196 / .16), rgb(255 255 255 / .03)); }
  .bl-ing__orb { position: relative; display: grid; place-items: center; width: 64px; height: 64px; margin-bottom: 8px; border-radius: 50%; color: #fff; background: radial-gradient(circle at 30% 25%, #FF9CC4, #E5518E 55%, #9E2A64); box-shadow: 0 0 0 6px rgb(229 81 142 / .16), 0 14px 30px -10px rgb(229 81 142 / .8); }
  .bl-ing__no { position: absolute; top: 24px; inset-inline-end: 24px; font-size: 12px; font-weight: 600; letter-spacing: .18em; color: rgb(255 255 255 / .38); }
  .bloom .bl-ing__name { font-size: 22px; font-weight: 600; line-height: 1.2; color: #fff; }
  .bl-ing__x { font-size: 14px; line-height: 1.65; color: #E9C4D6; }
  @media (max-width: 749px) { .bl-ing__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .bl-ing__card { padding: 22px 16px; } .bloom .bl-ing__name { font-size: 18px; } }
  @media (max-width: 459px) { .bl-ing__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--bloom" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div, cite) { font-family: "Open Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Playfair Display", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) .bl-flip { transform: scaleX(-1); }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
