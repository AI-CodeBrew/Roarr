{% comment %}
  Feature Card Slider
  - Desktop: Variable Width, Adjustable Padding, Smooth Infinite Loop.
  - Mobile: Full Width (100%), Standard Padding.
  - Colors/Fonts: Section settings and color schemes.
{% endcomment %}

{%- assign section_scheme = section.settings.color_scheme | default: 'scheme-1' -%}

{% render 'snippets/theme-fonts', settings: settings %}

<link rel="stylesheet" href="{{ 'pf-color-schemes.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'pf-feature-banner.css' | asset_url }}" media="all">

<style>
  #fc-{{ section.id }} {
    /* FONTS (from theme settings) */
    --font-h: {{ settings.type_heading_font | font_family: 'sans-serif' }};
    --font-b: {{ settings.type_body_font | font_family: 'sans-serif' }};
    --font-sub: {{ settings.type_subheading_font | font_family: 'sans-serif' }};
    --font-accent: {{ settings.type_accent_font | font_family: 'sans-serif' }};

    /* SIZING */
    --h-main-size: {{ section.settings.main_h_size }}px;
    --h-size-d: {{ section.settings.h_size_d }}px;
    --h-size-m: {{ section.settings.h_size_m }}px;
    --p-size-d: {{ section.settings.p_size_d }}px;
    --p-size-m: {{ section.settings.p_size_m }}px;
    --card-width-d: {{ section.settings.card_width_d }}%;
    --card-radius: {{ section.settings.card_radius }}px;
    --slide-gap: {{ section.settings.slide_gap }}px;
    --slide-height: {{ section.settings.desktop_height }}px;
    --track-offset: {{ section.settings.track_offset }}px;
    --container-pl: {{ section.settings.container_pl }}px;
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
  }
</style>

<div id="fc-{{ section.id }}" class="color-{{ section_scheme }}">
  <div class="fc-section">
    <div class="fc-container">

      <div class="fc-header">
        <h2 class="fc-heading">{{ section.settings.title }}</h2>
        <div class="fc-nav-btns">
          <button class="fc-arrow prev" aria-label="Previous"><svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg></button>
          <button class="fc-arrow next" aria-label="Next"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
      </div>

      <div class="fc-track"
           id="track-{{ section.id }}"
           data-slide-gap="{{ section.settings.slide_gap }}"
           data-blocks-size="{{ section.blocks.size }}">
        {% assign slide_groups = "1,2,3" | split: "," %}
        {% for group in slide_groups %}
          {% for block in section.blocks %}
            {%- assign card_scheme = block.settings.color_scheme | default: 'scheme-2' -%}
            <div class="fc-card layout-{{ block.settings.layout_d }} color-{{ card_scheme }}"
                 data-index="{{ forloop.index0 }}"
                 data-group="{{ group }}"
                 {{ block.shopify_attributes }}>

              <div class="fc-content-wrap fc-align-{{ block.settings.text_align }}">
                {% if block.settings.eyebrow != blank %}
                  <span class="fc-eyebrow">{{ block.settings.eyebrow }}</span>
                {% endif %}
                <h3>{{ block.settings.title }}</h3>
                {% if block.settings.text != blank %}
                  <p>{{ block.settings.text }}</p>
                {% endif %}
                {% if block.settings.btn_link != blank %}
                  <a href="{{ block.settings.btn_link }}" class="fc-btn">
                    {{ block.settings.btn_label }}
                  </a>
                {% endif %}
              </div>

              <div class="fc-img-wrap">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 1000 }}" class="fc-img" alt="{{ block.settings.title | escape }}" loading="lazy">
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'fc-img' }}
                {% endif %}
              </div>

            </div>
          {% endfor %}
        {% endfor %}
      </div>

      <div class="fc-dots-container">
        {% for block in section.blocks %}
          <div class="fc-dot {% if forloop.first %}active{% endif %}" data-idx="{{ forloop.index0 }}"></div>
        {% endfor %}
      </div>

    </div>
  </div>
</div>

<script src="{{ 'pf-feature-banner.js' | asset_url }}" defer></script>
