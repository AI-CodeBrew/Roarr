{% comment %}
  Infinite Marquee Banner
  - Horizontal strip; text + images; CSS infinite loop.
  - Optional Roarr metafields; layout/CSS in marquee-scrolling-banner.css.
{% endcomment %}

{%- assign store_gen = shop.metafields.kluck_ai.store_generation.value -%}
{%- assign section_scheme = section.settings.color_scheme | default: 'scheme-1' -%}
{%- assign use_kluck_ai = section.settings.use_kluck_ai_metafields | default: true -%}
{%- assign font_family = section.settings.font_family | default: 'heading' -%}

{% if shop.metafields.app.block_control.value %}
{% render 'snippets/theme-fonts', settings: settings %}

<link rel="stylesheet" href="{{ 'pf-color-schemes.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'marquee-scrolling-banner.css' | asset_url }}" media="all">

{% style %}
  #mq-{{ section.id }} {
    --font-h: {{ settings.type_heading_font | font_family: 'sans-serif' }};
    --font-b: {{ settings.type_body_font | font_family: 'sans-serif' }};
    --font-a: {{ settings.type_accent_font | default: settings.type_heading_font | font_family: 'sans-serif' }};
    --font-weight: {{ section.settings.font_weight | default: 400 }};
    --font-size-d: {{ section.settings.font_size_d | default: 32 }}px;
    --img-height-d: {{ section.settings.img_height_d | default: 60 }}px;
    --gap-d: {{ section.settings.gap_d | default: 50 }}px;
    --speed-d: {{ section.settings.speed_d | default: 20 }}s;
    --padding-d: {{ section.settings.padding_d | default: 30 }}px;
    --font-size-m: {{ section.settings.font_size_m | default: 24 }}px;
    --img-height-m: {{ section.settings.img_height_m | default: 40 }}px;
    --gap-m: {{ section.settings.gap_m | default: 30 }}px;
    --speed-m: {{ section.settings.speed_m | default: 15 }}s;
    --padding-m: {{ section.settings.padding_m | default: 20 }}px;
    --border-width: 1px;
    --border-top-display: {% if section.settings.show_border_top %}block{% else %}none{% endif %};
    --border-bottom-display: {% if section.settings.show_border_bottom %}block{% else %}none{% endif %};
    --img-radius: {{ section.settings.img_radius | default: 100 }}px;
  }
{% endstyle %}

<div id="mq-{{ section.id }}"
     class="color-{{ section_scheme }} mq-font-{{ font_family }}{% if section.settings.direction == 'right' %} mq-dir-right{% endif %}">
  <div class="mq-section{% if section.settings.pause_hover %} mq-pause-hover{% endif %}">
    <div class="mq-track-homepage">

      {% for i in (1..10) %}
        <div class="mq-group">
          {% assign text_index = 0 %}
          {% assign img_index = 0 %}

          {%- for block in section.blocks -%}

            {% assign final_text = blank %}
            {% assign final_image = blank %}
            {% assign render_item = false %}

            {% case block.type %}
              {% when 'text' %}
                {% assign text_index = text_index | plus: 1 %}
                {% assign final_text = block.settings.text %}

                {% if use_kluck_ai and store_gen != blank and store_gen.home_page != blank %}
                  {% assign hp_text = store_gen.home_page.text %}
                  {% if hp_text != blank %}
                    {% if text_index == 1 and hp_text.marquee_text_1 != blank %}
                      {% assign final_text = hp_text.marquee_text_1 %}
                    {% elsif text_index == 2 and hp_text.marquee_text_2 != blank %}
                      {% assign final_text = hp_text.marquee_text_2 %}
                    {% elsif text_index == 3 and hp_text.marquee_text_3 != blank %}
                      {% assign final_text = hp_text.marquee_text_3 %}
                    {% endif %}
                  {% endif %}
                {% endif %}

                {% if final_text != blank %}
                  {% assign render_item = true %}
                {% endif %}

              {% when 'image' %}
                {% assign img_index = img_index | plus: 1 %}
                {% assign kluck_img = blank %}

                {% if use_kluck_ai %}
                  {% if img_index == 1 %}
                    {% assign kluck_img = shop.metafields.kluck_ai.banner_image.value %}
                  {% elsif img_index == 2 %}
                    {% assign kluck_img = shop.metafields.kluck_ai.feature_image.value %}
                  {% elsif img_index == 3 %}
                    {% assign kluck_img = shop.metafields.kluck_ai.creative_image.value %}
                  {% endif %}
                {% endif %}

                {% if block.settings.image != blank %}
                  {% assign final_image = block.settings.image %}
                {% elsif kluck_img != blank %}
                  {% assign final_image = kluck_img %}
                {% endif %}

                {% assign render_item = true %}
            {% endcase %}

            {% if render_item %}
              <div class="mq-item" {{ block.shopify_attributes }}>
                {% if block.type == 'text' %}
                  <span class="mq-text">{{ final_text }}</span>
                {% elsif block.type == 'image' %}
                  <div class="mq-img-wrap">
                    {% if final_image != blank %}
                      {{ final_image | image_url: width: 400 | image_tag: 'mq-img', 'lazy' }}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'mq-img' }}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endif %}

          {%- endfor -%}
        </div>
      {% endfor %}

    </div>
  </div>
</div>
{% endif %}
