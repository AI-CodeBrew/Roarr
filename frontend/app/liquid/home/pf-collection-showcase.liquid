{% comment %}
  Collection Card Slider (Kluck AI - Collections)
  - Desktop: Variable width, adjustable padding, smooth infinite loop.
  - Mobile: Full width, dots overlay; layout/CSS in pf-collection-showcase.css.
  - Kluck preview: top_product_punchline_n, top_product_punchline_n_description, product_impact_image_n
{% endcomment %}

{%- assign store_gen = shop.metafields.kluck_ai.store_generation.value -%}
{%- assign section_scheme = section.settings.color_scheme | default: 'scheme-1' -%}
{%- assign use_kluck_ai = section.settings.use_kluck_ai_metafields | default: true -%}

{% if shop.metafields.app.block_control.value %}
{% render 'snippets/theme-fonts', settings: settings %}

<link rel="stylesheet" href="{{ 'pf-color-schemes.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'pf-collection-showcase.css' | asset_url }}" media="all">

{% style %}
  #fc-{{ section.id }} {
    --font-b: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-h: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-sub: {{ settings.type_subheading_font.family | default: settings.type_heading_font.family }}, sans-serif;
    --font-accent: {{ settings.type_accent_font.family | default: settings.type_body_font.family }}, sans-serif;
    --h-main-size: {{ section.settings.main_h_size | default: 42 }}px;
    --h-size-d: {{ section.settings.h_size_d | default: 48 }}px;
    --h-size-m: {{ section.settings.h_size_m | default: 32 }}px;
    --p-size-d: {{ section.settings.p_size_d | default: 16 }}px;
    --p-size-m: {{ section.settings.p_size_m | default: 14 }}px;
    --card-width-d: {{ section.settings.card_width_d | default: 85 }}%;
    --card-radius: {{ section.settings.card_radius | default: 20 }}px;
    --slide-gap: {{ section.settings.slide_gap | default: 20 }}px;
    --slide-height: {{ section.settings.desktop_height | default: 550 }}px;
    --track-offset: {{ section.settings.track_offset | default: 48 }}px;
    --container-pl: {{ section.settings.container_pl | default: 20 }}px;
    --pt: {{ section.settings.padding_top | default: 60 }}px;
    --pb: {{ section.settings.padding_bottom | default: 60 }}px;
  }
{% endstyle %}

<div id="fc-{{ section.id }}"
     class="color-{{ section_scheme }}"
     data-slide-gap="{{ section.settings.slide_gap | default: 20 }}"
     data-mobile-slide-gap="15"
     data-total-slides="{{ section.blocks.size }}">
  <div class="fc-section">
    <div class="fc-container">

      <div class="fc-header">
        <h2 class="fc-heading">{{ section.settings.title }}</h2>
        <div class="fc-nav-btns">
          <button type="button" class="fc-arrow prev" aria-label="Previous"><svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg></button>
          <button type="button" class="fc-arrow next" aria-label="Next"><svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
      </div>

      <div class="fc-track" id="track-{{ section.id }}">
        {% assign slide_groups = "1,2,3" | split: "," %}
        {% for group in slide_groups %}
          {% for block in section.blocks %}
            {% assign collection = collections[block.settings.collection] %}
            {% assign fallback_title = block.settings.title | default: collection.title | default: 'Collection Name' %}
            {% assign fallback_text = block.settings.text | default: collection.description | strip_html | truncatewords: 20 %}
            {% assign fallback_link = block.settings.btn_link | default: collection.url | default: '#' %}

            {% assign kluck_featured_product_headline = '' %}
            {% assign kluck_featured_product_subheadline = '' %}
            {% assign kluck_feature_image = '' %}

            {% if use_kluck_ai and store_gen != blank %}
              {% case forloop.index %}
                {% when 1 %}
                  {% assign kluck_featured_product_headline = store_gen.home_page.text.featured_product_headline_1 %}
                  {% assign kluck_featured_product_subheadline = store_gen.home_page.text.featured_product_subheadline_1 %}
                  {% assign kluck_feature_image = shop.metafields.kluck_ai.feature_image_1.value %}
                {% when 2 %}
                  {% assign kluck_featured_product_headline = store_gen.home_page.text.featured_product_headline_2 %}
                  {% assign kluck_featured_product_subheadline = store_gen.home_page.text.featured_product_subheadline_2 %}
                  {% assign kluck_feature_image = shop.metafields.kluck_ai.feature_image_2.value %}
                {% when 3 %}
                  {% assign kluck_featured_product_headline = store_gen.home_page.text.featured_product_headline_3 %}
                  {% assign kluck_featured_product_subheadline = store_gen.home_page.text.featured_product_subheadline_3 %}
                  {% assign kluck_feature_image = shop.metafields.kluck_ai.feature_image_3.value %}
              {% endcase %}
            {% endif %}

            {% assign final_title = fallback_title %}
            {% if use_kluck_ai and kluck_featured_product_headline != blank %}
              {% assign final_title = kluck_featured_product_headline %}
            {% endif %}

            {% assign final_text = fallback_text %}
            {% if use_kluck_ai and kluck_featured_product_subheadline != blank %}
              {% assign final_text = kluck_featured_product_subheadline %}
            {% endif %}

            {% assign fallback_image = block.settings.image %}
            {% if fallback_image == blank and collection != blank %}
              {% if collection.image != blank %}
                {% assign fallback_image = collection.image %}
              {% elsif collection.products.first != blank %}
                {% assign fallback_image = collection.products.first.featured_image %}
              {% endif %}
            {% endif %}

            {% assign final_image = fallback_image %}
            {% if block.settings.image != blank %}
              {% assign final_image = block.settings.image %}
            {% elsif use_kluck_ai and kluck_feature_image != blank %}
              {% assign final_image = kluck_feature_image %}
            {% endif %}

            <div class="fc-card layout-{{ block.settings.layout_d | default: 'column' }} color-{{ block.settings.color_scheme | default: 'scheme-2' }}"
                 data-index="{{ forloop.index0 }}"
                 data-group="{{ group }}"
                 {{ block.shopify_attributes }}>

              <div class="fc-content-wrap fc-align-{{ block.settings.text_align | default: 'center' }}">
                {% if block.settings.eyebrow != blank %}
                  <span class="fc-eyebrow">{{ block.settings.eyebrow }}</span>
                {% endif %}

                <h3>{{ final_title }}</h3>

                {% if final_text != blank %}
                  <p>{{ final_text }}</p>
                {% endif %}

                {% if fallback_link != blank %}
                  <a href="{{ fallback_link }}" class="fc-btn">
                    {{ block.settings.btn_label | default: 'Shop Now' }}
                  </a>
                {% endif %}
              </div>

              <div class="fc-img-wrap">
                {% if final_image != blank %}
                  <img src="{{ final_image | image_url: width: 1000 }}" loading="lazy" class="fc-img" alt="{{ final_title | escape }}">
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'fc-img' }}
                {% endif %}
              </div>

            </div>
          {% endfor %}
        {% endfor %}
      </div>

      <div class="fc-dots-container">
        {% for block in section.blocks %}
          <div class="fc-dot{% if forloop.first %} active{% endif %}" data-idx="{{ forloop.index0 }}"></div>
        {% endfor %}
      </div>

    </div>
  </div>
</div>

<script src="{{ 'pf-collection-showcase.js' | asset_url }}" defer></script>
{% endif %}
