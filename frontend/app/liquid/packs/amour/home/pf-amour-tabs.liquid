{%- assign section_scheme = section.settings.color_scheme | default: 'scheme-1' -%}
{% assign store_gen = shop.metafields.kluck_ai.store_generation.value %}
{% assign home = store_gen.home_page %}
{% assign ht = home.text %}
{% assign hi = home.images %}
{% assign use_mf = section.settings.use_kluck_ai_metafields %}
{% assign homeData = section.settings.homeData %}
{% if ht == blank and homeData.text != blank %}{% assign ht = homeData.text %}{% endif %}
{% if hi == blank and homeData.images != blank %}{% assign hi = homeData.images %}{% endif %}

{% assign tabs_heading = section.settings.tabs_heading %}
{% if use_mf and ht.tabs_heading != blank %}{% assign tabs_heading = ht.tabs_heading %}{% endif %}
{% assign tab_1_title = section.settings.tab_1_title %}
{% if use_mf and ht.tab_1_title != blank %}{% assign tab_1_title = ht.tab_1_title %}{% endif %}
{% assign tab_1_text = section.settings.tab_1_text %}
{% if use_mf and ht.tab_1_text != blank %}{% assign tab_1_text = ht.tab_1_text %}{% endif %}
{% assign tab_2_title = section.settings.tab_2_title %}
{% if use_mf and ht.tab_2_title != blank %}{% assign tab_2_title = ht.tab_2_title %}{% endif %}
{% assign tab_2_text = section.settings.tab_2_text %}
{% if use_mf and ht.tab_2_text != blank %}{% assign tab_2_text = ht.tab_2_text %}{% endif %}
{% assign tab_3_title = section.settings.tab_3_title %}
{% if use_mf and ht.tab_3_title != blank %}{% assign tab_3_title = ht.tab_3_title %}{% endif %}
{% assign tab_3_text = section.settings.tab_3_text %}
{% if use_mf and ht.tab_3_text != blank %}{% assign tab_3_text = ht.tab_3_text %}{% endif %}
{% assign look_image_3 = section.settings.look_image_3 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.look_image_3.value != blank %}{% assign look_image_3 = shop.metafields.kluck_ai.look_image_3.value %}{% elsif hi.look_image_3 != blank %}{% assign look_image_3 = hi.look_image_3 %}{% endif %}{% endif %}
{% assign product_image_1 = section.settings.product_image_1 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.product_image_1.value != blank %}{% assign product_image_1 = shop.metafields.kluck_ai.product_image_1.value %}{% elsif hi.product_image_1 != blank %}{% assign product_image_1 = hi.product_image_1 %}{% endif %}{% endif %}
{% assign look_image_1 = section.settings.look_image_1 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.look_image_1.value != blank %}{% assign look_image_1 = shop.metafields.kluck_ai.look_image_1.value %}{% elsif hi.look_image_1 != blank %}{% assign look_image_1 = hi.look_image_1 %}{% endif %}{% endif %}


{% if shop.metafields.app.block_control.value %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500&family=Cormorant+Garamond:ital,wght@1,400;1,500&display=swap">
<style>
  #shopify-section-{{ section.id }} { width: 100%; max-width: none; }
  #amour-{{ section.id }} {
  --a-ink: var(--color-foreground, #111111);
  --a-paper: var(--color-background, #ffffff);
  --a-wine: {{ section.settings.accent_color | default: '#6b0808' }};
  --a-on-wine: #ffffff;
  --a-blush: {{ section.settings.blush_color | default: '#ffe3de' }};
  --a-mist: #f2f1ef;
  --a-head: 'Syne', 'Helvetica Neue', Arial, sans-serif;
  --a-body: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  --a-serif: 'Cormorant Garamond', 'Times New Roman', serif;
  font-family: var(--a-body); color: var(--a-ink); background: var(--a-paper);
  }

  #amour-{{ section.id }}, #amour-{{ section.id }} * { box-sizing: border-box; }
  #amour-{{ section.id }} img { display: block; max-width: 100%; }
  #amour-{{ section.id }} .a-wrap { max-width: 1340px; margin: 0 auto; padding: 0 20px; }
  #amour-{{ section.id }} .a-h2 { margin: 0; font-family: var(--a-head); font-weight: 700; text-transform: uppercase; font-size: 40px; line-height: 1.2; letter-spacing: -0.01em; }
  #amour-{{ section.id }} .a-serif { font-family: var(--a-serif); font-style: italic; font-weight: 400; }
  #amour-{{ section.id }} .a-serif span, #amour-{{ section.id }} .a-serif p { font-family: inherit; font-style: inherit; font-weight: inherit; }
  #amour-{{ section.id }} .a-link { display: inline-block; font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; padding: 0 0 4px; }
  #amour-{{ section.id }} .a-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 32px; font-family: var(--a-body); font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none; transition: background .2s, color .2s; }
  #amour-{{ section.id }} .a-btn--light { background: #fff; color: #000; border: 1px solid #fff; }
  #amour-{{ section.id }} .a-btn--light:hover { background: transparent; color: #fff; }
  #amour-{{ section.id }} .a-btn--outline { background: transparent; color: var(--a-ink); border: 1px solid var(--a-ink); }
  #amour-{{ section.id }} .a-btn--outline:hover { background: var(--a-ink); color: var(--a-paper); }
  #amour-{{ section.id }} .a-media { position: relative; overflow: hidden; background: var(--a-mist); }
  #amour-{{ section.id }} .a-media img, #amour-{{ section.id }} .a-media svg { width: 100%; height: 100%; object-fit: cover; }
  #amour-{{ section.id }} .a-ph { width: 100%; height: 100%; fill: rgba(0,0,0,.18); background: var(--a-mist); }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .a-h2 { font-size: 28px; }
  }

  #amour-{{ section.id }} .atb { padding: 100px 0; background: var(--a-blush); }
  #amour-{{ section.id }} .atb__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px 80px; align-items: center; }
  #amour-{{ section.id }} .atb__rows { margin-top: 40px; border-bottom: 1px solid color-mix(in srgb, var(--a-ink) 18%, transparent); }
  #amour-{{ section.id }} .atb__row { border-top: 1px solid color-mix(in srgb, var(--a-ink) 18%, transparent); }
  #amour-{{ section.id }} .atb__btn { width: 100%; display: flex; align-items: center; gap: 20px; padding: 18px 0; background: none; border: 0; color: inherit; cursor: pointer; text-align: left; font: inherit; }
  #amour-{{ section.id }} .atb__num { font-size: 15px; font-weight: 500; min-width: 32px; }
  #amour-{{ section.id }} .atb__title { flex: 1; font-size: 48px; line-height: 1.3; }
  #amour-{{ section.id }} .atb__arrow { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; border: 1px solid currentColor; display: inline-flex; align-items: center; justify-content: center; transition: transform .3s, background .3s, color .3s; }
  #amour-{{ section.id }} .atb__row.is-active .atb__arrow { transform: rotate(-45deg); background: var(--a-ink); color: var(--a-blush); }
  #amour-{{ section.id }} .atb__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; }
  #amour-{{ section.id }} .atb__row.is-active .atb__panel { grid-template-rows: 1fr; }
  #amour-{{ section.id }} .atb__panel > div { overflow: hidden; }
  #amour-{{ section.id }} .atb__panel p { margin: 0 0 20px 52px; font-size: 16px; line-height: 1.6; max-width: 480px; }
  #amour-{{ section.id }} .atb__images { position: relative; aspect-ratio: 3 / 4; max-height: 760px; }
  #amour-{{ section.id }} .atb__image { position: absolute; inset: 0; opacity: 0; transition: opacity .45s ease; }
  #amour-{{ section.id }} .atb__image.is-active { opacity: 1; }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .atb { padding: 64px 0; }
    #amour-{{ section.id }} .atb__grid { grid-template-columns: 1fr; }
    #amour-{{ section.id }} .atb__images { order: -1; }
    #amour-{{ section.id }} .atb__title { font-size: 34px; }
    #amour-{{ section.id }} .atb__panel p { margin-left: 0; }
  }

</style>
<div id="amour-{{ section.id }}" class="kluck-amour color-{{ section_scheme }}">
<section class="atb"><div class="a-wrap"><div class="atb__grid">
  <div>
    {% if tabs_heading != blank %}<h2 class="a-h2">{{ tabs_heading }}</h2>{% endif %}
    <div class="atb__rows">
      {%- for i in (1..3) -%}
        {%- case i -%}
          {%- when 1 -%}{%- assign t_title = tab_1_title -%}{%- assign t_text = tab_1_text -%}
          {%- when 2 -%}{%- assign t_title = tab_2_title -%}{%- assign t_text = tab_2_text -%}
          {%- else -%}{%- assign t_title = tab_3_title -%}{%- assign t_text = tab_3_text -%}
        {%- endcase -%}
        <div class="atb__row{% if i == 1 %} is-active{% endif %}" data-amour-tab="{{ i }}">
          <button type="button" class="atb__btn" aria-expanded="{% if i == 1 %}true{% else %}false{% endif %}">
            <span class="atb__num">0{{ i }}.</span>
            <span class="atb__title a-serif">{{ t_title }}</span>
            <span class="atb__arrow" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.4"/></svg></span>
          </button>
          <div class="atb__panel"><div><p>{{ t_text }}</p></div></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
  <div class="atb__images">
    <div class="atb__image a-media is-active" data-amour-tab-image="1">{%- if look_image_3 != blank -%}{%- if look_image_3 contains 'http' or look_image_3 contains '//' -%}<img src="{{ look_image_3 }}" alt="{{ tab_1_title | escape }}" loading="eager" class="">{%- else -%}<img src="{{ look_image_3 | image_url: width: 1200 }}" alt="{{ tab_1_title | escape }}" loading="eager" class="">{%- endif -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'a-ph' }}{%- endif -%}</div>
    <div class="atb__image a-media" data-amour-tab-image="2">{%- if product_image_1 != blank -%}{%- if product_image_1 contains 'http' or product_image_1 contains '//' -%}<img src="{{ product_image_1 }}" alt="{{ tab_2_title | escape }}" loading="eager" class="">{%- else -%}<img src="{{ product_image_1 | image_url: width: 1200 }}" alt="{{ tab_2_title | escape }}" loading="eager" class="">{%- endif -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'a-ph' }}{%- endif -%}</div>
    <div class="atb__image a-media" data-amour-tab-image="3">{%- if look_image_1 != blank -%}{%- if look_image_1 contains 'http' or look_image_1 contains '//' -%}<img src="{{ look_image_1 }}" alt="{{ tab_3_title | escape }}" loading="eager" class="">{%- else -%}<img src="{{ look_image_1 | image_url: width: 1200 }}" alt="{{ tab_3_title | escape }}" loading="eager" class="">{%- endif -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'a-ph' }}{%- endif -%}</div>
  </div>
</div></div></section>
</div>
<script>(function(){
  var root = document.getElementById('amour-{{ section.id }}'); if (!root) return;
  var rows = root.querySelectorAll('[data-amour-tab]');
  function show(n){
    rows.forEach(function(r){
      var on = r.getAttribute('data-amour-tab') === n;
      r.classList.toggle('is-active', on);
      var b = r.querySelector('button'); if (b) b.setAttribute('aria-expanded', on ? 'true' : 'false');
    });
    root.querySelectorAll('[data-amour-tab-image]').forEach(function(i){
      i.classList.toggle('is-active', i.getAttribute('data-amour-tab-image') === n);
    });
  }
  rows.forEach(function(r){
    var n = r.getAttribute('data-amour-tab');
    r.addEventListener('mouseenter', function(){ show(n); });
    r.querySelector('button').addEventListener('click', function(){ show(n); });
  });
})();</script>
{% endif %}
