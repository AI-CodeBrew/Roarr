{%- assign section_scheme = section.settings.color_scheme | default: 'scheme-1' -%}
{% assign store_gen = shop.metafields.kluck_ai.store_generation.value %}
{% assign home = store_gen.home_page %}
{% assign ht = home.text %}
{% assign hi = home.images %}
{% assign use_mf = section.settings.use_kluck_ai_metafields %}
{% assign homeData = section.settings.homeData %}
{% if ht == blank and homeData.text != blank %}{% assign ht = homeData.text %}{% endif %}
{% if hi == blank and homeData.images != blank %}{% assign hi = homeData.images %}{% endif %}

{% assign banner_heading = section.settings.banner_heading %}
{% if use_mf and ht.banner_heading != blank %}{% assign banner_heading = ht.banner_heading %}{% endif %}
{% assign banner_cta = section.settings.banner_cta %}
{% if use_mf and ht.banner_cta != blank %}{% assign banner_cta = ht.banner_cta %}{% endif %}
{% assign banner_marquee_1 = section.settings.banner_marquee_1 %}
{% if use_mf and ht.banner_marquee_1 != blank %}{% assign banner_marquee_1 = ht.banner_marquee_1 %}{% endif %}
{% assign banner_marquee_2 = section.settings.banner_marquee_2 %}
{% if use_mf and ht.banner_marquee_2 != blank %}{% assign banner_marquee_2 = ht.banner_marquee_2 %}{% endif %}
{% assign banner_image_2 = section.settings.banner_image_2 %}
{% if use_mf %}{% if shop.metafields.kluck_ai.banner_image_2.value != blank %}{% assign banner_image_2 = shop.metafields.kluck_ai.banner_image_2.value %}{% elsif hi.banner_image_2 != blank %}{% assign banner_image_2 = hi.banner_image_2 %}{% endif %}{% endif %}

{% assign amour_product = blank %}
{% if section.settings.product != blank %}
  {% assign amour_product = section.settings.product %}
{% elsif ht.selected_product != blank %}
  {% assign amour_product = all_products[ht.selected_product] %}
{% endif %}
{% if amour_product == blank and collections.all.products.first != blank %}
  {% assign amour_product = collections.all.products.first %}
{% endif %}
{% assign amour_product_url = routes.all_products_collection_url %}
{% assign amour_product_title = section.settings.fallback_title %}
{% assign amour_product_price = section.settings.fallback_price %}
{% if amour_product != blank and amour_product.title != blank %}
  {% assign amour_product_url = amour_product.url %}
  {% assign amour_product_title = amour_product.title %}
  {% assign amour_product_price = amour_product.price | money %}
{% endif %}


{% if shop.metafields.app.block_control.value %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500&family=Cormorant+Garamond:ital,wght@1,400;1,500&display=swap">
<style>
  #shopify-section-{{ section.id }} { width: 100%; max-width: none; }
  #amour-{{ section.id }} {
  --a-ink: var(--color-foreground, #111111);
  --a-paper: var(--color-background, #ffffff);
  --a-wine: {{ section.settings.accent_color | default: '#6b0808' }};
  --a-on-wine: #ffffff;
  --a-blush: {{ section.settings.blush_color | default: '#ffe3de' }};
  --a-mist: #f2f1ef;
  --a-head: 'Syne', 'Helvetica Neue', Arial, sans-serif;
  --a-body: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  --a-serif: 'Cormorant Garamond', 'Times New Roman', serif;
  font-family: var(--a-body); color: var(--a-ink); background: var(--a-paper);
  }

  #amour-{{ section.id }}, #amour-{{ section.id }} * { box-sizing: border-box; }
  #amour-{{ section.id }} img { display: block; max-width: 100%; }
  #amour-{{ section.id }} .a-wrap { max-width: 1340px; margin: 0 auto; padding: 0 20px; }
  #amour-{{ section.id }} .a-h2 { margin: 0; font-family: var(--a-head); font-weight: 700; text-transform: uppercase; font-size: 40px; line-height: 1.2; letter-spacing: -0.01em; }
  #amour-{{ section.id }} .a-serif { font-family: var(--a-serif); font-style: italic; font-weight: 400; }
  #amour-{{ section.id }} .a-serif span, #amour-{{ section.id }} .a-serif p { font-family: inherit; font-style: inherit; font-weight: inherit; }
  #amour-{{ section.id }} .a-link { display: inline-block; font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; padding: 0 0 4px; }
  #amour-{{ section.id }} .a-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 32px; font-family: var(--a-body); font-size: 15px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none; transition: background .2s, color .2s; }
  #amour-{{ section.id }} .a-btn--light { background: #fff; color: #000; border: 1px solid #fff; }
  #amour-{{ section.id }} .a-btn--light:hover { background: transparent; color: #fff; }
  #amour-{{ section.id }} .a-btn--outline { background: transparent; color: var(--a-ink); border: 1px solid var(--a-ink); }
  #amour-{{ section.id }} .a-btn--outline:hover { background: var(--a-ink); color: var(--a-paper); }
  #amour-{{ section.id }} .a-media { position: relative; overflow: hidden; background: var(--a-mist); }
  #amour-{{ section.id }} .a-media img, #amour-{{ section.id }} .a-media svg { width: 100%; height: 100%; object-fit: cover; }
  #amour-{{ section.id }} .a-ph { width: 100%; height: 100%; fill: rgba(0,0,0,.18); background: var(--a-mist); }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .a-h2 { font-size: 28px; }
  }

  #amour-{{ section.id }} .a-marquee { overflow: hidden; width: 100%; }
  #amour-{{ section.id }} .a-marquee__track { display: flex; width: max-content; animation: amour-marquee-{{ section.id }} 32s linear infinite; }
  #amour-{{ section.id }} .a-marquee--reverse .a-marquee__track { animation-direction: reverse; }
  #amour-{{ section.id }} .a-marquee__group { display: flex; align-items: center; flex: 0 0 auto; }
  #amour-{{ section.id }} .a-marquee__item { display: inline-flex; align-items: center; white-space: nowrap; }
  #amour-{{ section.id }} .a-marquee__line { display: inline-block; width: 64px; height: 1px; background: currentColor; margin: 0 40px; opacity: .8; }
  @keyframes amour-marquee-{{ section.id }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { #amour-{{ section.id }} .a-marquee__track { animation: none; } }

  #amour-{{ section.id }} .ab { position: relative; min-height: 574px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; overflow: hidden; background: var(--a-wine); }
  #amour-{{ section.id }} .ab__bg { position: absolute; inset: 0; }
  #amour-{{ section.id }} .ab__bg img, #amour-{{ section.id }} .ab__bg svg { width: 100%; height: 100%; object-fit: cover; }
  #amour-{{ section.id }} .ab__bg:after { content: ""; position: absolute; inset: 0; background: rgba(0,0,0,.38); }
  #amour-{{ section.id }} .ab__content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 24px; max-width: 783px; padding: 150px 20px 90px; text-align: center; }
  #amour-{{ section.id }} .ab__heading { margin: 0; font-family: var(--a-head); font-weight: 700; font-size: 48px; line-height: 1.16; text-transform: uppercase; }
  #amour-{{ section.id }} .ab__marquee { position: absolute; left: 0; right: 0; top: 36px; z-index: 1; font-size: 48px; line-height: 1.15; }
  @media (max-width: 767px) {
    #amour-{{ section.id }} .ab { min-height: 480px; }
    #amour-{{ section.id }} .ab__heading { font-size: 32px; }
    #amour-{{ section.id }} .ab__marquee { font-size: 32px; top: 24px; }
    #amour-{{ section.id }} .ab__content { padding: 110px 20px 64px; }
  }

</style>
<div id="amour-{{ section.id }}" class="roarr-amour color-{{ section_scheme }}">
<section class="ab">
  <div class="ab__bg">{%- if banner_image_2 != blank -%}{%- if banner_image_2 contains 'http' or banner_image_2 contains '//' -%}<img src="{{ banner_image_2 }}" alt="{{ banner_heading | escape }}" loading="eager" class="">{%- else -%}<img src="{{ banner_image_2 | image_url: width: 2400 }}" alt="{{ banner_heading | escape }}" loading="eager" class="">{%- endif -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'a-ph' }}{%- endif -%}</div>
  <div class="ab__content">
    {% if banner_heading != blank %}<h2 class="ab__heading">{{ banner_heading }}</h2>{% endif %}
    {% if banner_cta != blank %}<a class="a-btn a-btn--light" href="{{ amour_product_url }}">{{ banner_cta }}</a>{% endif %}
  </div>
  <div class="ab__marquee a-serif"><div class="a-marquee"><div class="a-marquee__track"><div class="a-marquee__group">{% if banner_marquee_1 != blank %}<span class="a-marquee__item">{{ banner_marquee_1 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if banner_marquee_2 != blank %}<span class="a-marquee__item">{{ banner_marquee_2 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if banner_marquee_1 != blank %}<span class="a-marquee__item">{{ banner_marquee_1 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if banner_marquee_2 != blank %}<span class="a-marquee__item">{{ banner_marquee_2 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if banner_marquee_1 != blank %}<span class="a-marquee__item">{{ banner_marquee_1 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if banner_marquee_2 != blank %}<span class="a-marquee__item">{{ banner_marquee_2 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}</div><div class="a-marquee__group" aria-hidden="true">{% if banner_marquee_1 != blank %}<span class="a-marquee__item">{{ banner_marquee_1 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if banner_marquee_2 != blank %}<span class="a-marquee__item">{{ banner_marquee_2 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if banner_marquee_1 != blank %}<span class="a-marquee__item">{{ banner_marquee_1 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if banner_marquee_2 != blank %}<span class="a-marquee__item">{{ banner_marquee_2 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if banner_marquee_1 != blank %}<span class="a-marquee__item">{{ banner_marquee_1 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}{% if banner_marquee_2 != blank %}<span class="a-marquee__item">{{ banner_marquee_2 }}</span><span class="a-marquee__line" aria-hidden="true"></span>{% endif %}</div></div></div></div>
</section>
</div>
{% endif %}
