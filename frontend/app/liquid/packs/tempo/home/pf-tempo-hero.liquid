{%- assign hero_video_label = section.settings.hero_video_label | default: 'View Video' -%}
{%- if use_mf and ht.hero_video_label != blank -%}{%- assign hero_video_label = ht.hero_video_label -%}{%- endif -%}
{%- assign hero_video_url = section.settings.hero_video_url -%}
{%- assign tempo_hero_1 = section.settings.tempo_hero_1 -%}
{%- if use_mf and hi.tempo_hero_1 != blank -%}{%- assign tempo_hero_1 = hi.tempo_hero_1 -%}{%- endif -%}
{%- assign tempo_hero_2 = section.settings.tempo_hero_2 -%}
{%- if use_mf and hi.tempo_hero_2 != blank -%}{%- assign tempo_hero_2 = hi.tempo_hero_2 -%}{%- endif -%}
{%- assign tempo_hero_3 = section.settings.tempo_hero_3 -%}
{%- if use_mf and hi.tempo_hero_3 != blank -%}{%- assign tempo_hero_3 = hi.tempo_hero_3 -%}{%- endif -%}
{%- assign tp_product = blank -%}
{%- if ht.selected_product != blank -%}{%- assign tp_product = all_products[ht.selected_product] -%}{%- endif -%}
{%- if tp_product == blank and collections.all.products.first != blank -%}{%- assign tp_product = collections.all.products.first -%}{%- endif -%}
