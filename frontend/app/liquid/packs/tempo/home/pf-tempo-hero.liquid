{%- assign hero_heading_1 = section.settings.hero_heading_1 | default: 'Minimal Watch' -%}
{%- if use_mf and ht.hero_heading_1 != blank -%}{%- assign hero_heading_1 = ht.hero_heading_1 -%}{%- endif -%}
{%- assign hero_text_1 = section.settings.hero_text_1 | default: 'Thoughtful design and dependable performance, built to fit into the way you already live.' -%}
{%- if use_mf and ht.hero_text_1 != blank -%}{%- assign hero_text_1 = ht.hero_text_1 -%}{%- endif -%}
{%- assign hero_kicker_2 = section.settings.hero_kicker_2 | default: '#Everyday ready' -%}
{%- if use_mf and ht.hero_kicker_2 != blank -%}{%- assign hero_kicker_2 = ht.hero_kicker_2 -%}{%- endif -%}
{%- assign hero_heading_2 = section.settings.hero_heading_2 | default: 'Power That Lasts' -%}
{%- if use_mf and ht.hero_heading_2 != blank -%}{%- assign hero_heading_2 = ht.hero_heading_2 -%}{%- endif -%}
{%- assign hero_text_2 = section.settings.hero_text_2 | default: 'From the first use to the hundredth, it feels just as good as the day it arrived.' -%}
{%- if use_mf and ht.hero_text_2 != blank -%}{%- assign hero_text_2 = ht.hero_text_2 -%}{%- endif -%}
{%- assign hero_kicker_3 = section.settings.hero_kicker_3 | default: '#Made to impress' -%}
{%- if use_mf and ht.hero_kicker_3 != blank -%}{%- assign hero_kicker_3 = ht.hero_kicker_3 -%}{%- endif -%}
{%- assign hero_heading_3 = section.settings.hero_heading_3 | default: 'Details You Notice' -%}
{%- if use_mf and ht.hero_heading_3 != blank -%}{%- assign hero_heading_3 = ht.hero_heading_3 -%}{%- endif -%}
{%- assign hero_text_3 = section.settings.hero_text_3 | default: 'Clean lines, honest materials and finishing that shows how much care went into it.' -%}
{%- if use_mf and ht.hero_text_3 != blank -%}{%- assign hero_text_3 = ht.hero_text_3 -%}{%- endif -%}
{%- assign hero_cta = section.settings.hero_cta | default: 'Explore More' -%}
