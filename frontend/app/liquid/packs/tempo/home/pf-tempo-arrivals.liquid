{%- capture tp_html -%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600&display=swap">
{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign use_mf = section.settings.use_roarr_metafields -%}
{%- assign arrivals_heading = section.settings.arrivals_heading | default: 'New Arrivals' -%}
{%- if use_mf and ht.arrivals_heading != blank -%}{%- assign arrivals_heading = ht.arrivals_heading -%}{%- endif -%}
{%- assign arrivals_text = section.settings.arrivals_text | default: 'Fresh from the workshop and ready to ship, meet the newest addition to the range.' -%}
{%- if use_mf and ht.arrivals_text != blank -%}{%- assign arrivals_text = ht.arrivals_text -%}{%- endif -%}
{%- assign featured_label = section.settings.featured_label | default: 'Featured product' -%}
{%- if use_mf and ht.featured_label != blank -%}{%- assign featured_label = ht.featured_label -%}{%- endif -%}
{%- assign featured_heading = section.settings.featured_heading | default: 'Made For Everyday Life' -%}
{%- if use_mf and ht.featured_heading != blank -%}{%- assign featured_heading = ht.featured_heading -%}{%- endif -%}
{%- assign featured_text = section.settings.featured_text | default: 'A focused design that does its job well. Choose it once and enjoy it every day, with the details that matter built in from the start.' -%}
{%- if use_mf and ht.featured_text != blank -%}{%- assign featured_text = ht.featured_text -%}{%- endif -%}
{%- assign featured_cta = section.settings.featured_cta | default: 'Buy Now' -%}
{%- if use_mf and ht.featured_cta != blank -%}{%- assign featured_cta = ht.featured_cta -%}{%- endif -%}
{%- assign tempo_product_image = section.settings.tempo_product_image -%}
{%- if use_mf and hi.tempo_product_image != blank -%}{%- assign tempo_product_image = hi.tempo_product_image -%}{%- endif -%}
{%- assign tp_product = blank -%}
{%- if ht.selected_product != blank -%}{%- assign tp_product = all_products[ht.selected_product] -%}{%- endif -%}
{%- if tp_product == blank and collections.all.products.first != blank -%}{%- assign tp_product = collections.all.products.first -%}{%- endif -%}
{%- assign tp_url = routes.all_products_collection_url | default: '/collections/all' -%}
{%- assign tp_title = section.settings.fallback_title -%}
{%- assign tp_price = section.settings.fallback_price -%}
{%- assign tp_compare = section.settings.fallback_compare -%}
{%- if tp_product != blank and tp_product.title != blank -%}
  {%- assign tp_url = tp_product.url -%}
  {%- assign tp_title = tp_product.title -%}
  {%- assign tp_price = tp_product.price | money -%}
  {%- assign tp_compare = blank -%}
  {%- if tp_product.compare_at_price > tp_product.price -%}{%- assign tp_compare = tp_product.compare_at_price | money -%}{%- endif -%}
{%- endif -%}
<section class="tp tp-arrivals">
  <div class="tp-wrap">
    <header class="tp-arrivals__head tp-reveal">
      <h2 class="tp-arrivals__title">{{ arrivals_heading | escape }}</h2>
      {%- if arrivals_text != blank -%}<p>{{ arrivals_text | escape }}</p>{%- endif -%}
    </header>
    <div class="tp-arrivals__grid">
      <div class="tp-arrivals__media tp-reveal">{%- if tempo_product_image != blank -%}{%- if tempo_product_image contains 'http' or tempo_product_image contains '//' -%}<img class="tp-cut" src="{{ tempo_product_image }}" alt="{{ tp_title | escape }}" loading="lazy" width="1000" height="1000" decoding="async">{%- else -%}<img class="tp-cut" src="{{ tempo_product_image | image_url: width: 1000 }}" alt="{{ tp_title | escape }}" loading="lazy" width="1000" height="1000" decoding="async">{%- endif -%}{%- endif -%}</div>
      <div class="tp-arrivals__copy tp-reveal">
        {%- if featured_label != blank -%}<p class="tp-label">{{ featured_label | escape }}</p>{%- endif -%}
        <h3 class="tp-h2">{{ featured_heading | escape }}</h3>
        <span class="tp-rule" aria-hidden="true"></span>
        {%- if featured_text != blank -%}<p class="tp-arrivals__text">{{ featured_text | escape }}</p>{%- endif -%}
        {%- if tp_price != blank -%}<p class="tp-arrivals__price"><span class="tp-arrivals__name">{{ tp_title | escape }}</span><strong>{{ tp_price }}</strong>{%- if tp_compare != blank -%}<s>{{ tp_compare }}</s>{%- endif -%}</p>{%- endif -%}
        {%- if featured_cta != blank -%}<a class="tp-btn" href="{{ tp_url }}">{{ featured_cta | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>
  #shopify-section-{{ section.id }} { width: 100%; max-width: none; }
  :where(.tp) { --tp-peach: #FAF1ED; --tp-navy: #06264B; --tp-navy-deep: #05264D; --tp-orange: #FC6539; --tp-orange-text: #CF4318; --tp-ink: #222222; --tp-grey: #F1F1F1; --tp-grey-2: #EEEEEE; --tp-line: #EAEAEA; --tp-blob: #FBC3B3; --tp-serif: "Playfair Display", Georgia, "Times New Roman", serif; --tp-sans: "Poppins", "Helvetica Neue", Arial, sans-serif; --tp-pad: clamp(20px, 7.32vw, 100px); font-family: var(--tp-sans); font-size: 16px; line-height: 1.7; color: var(--tp-navy); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  .tp *, .tp *::before, .tp *::after { box-sizing: border-box; }
  :where(.tp) :where(h1, h2, h3, p, ul, ol, dl, dd, figure) { margin: 0; padding: 0; }
  :where(.tp) :where(ul, ol) { list-style: none; }
  :where(.tp) img { display: block; max-width: 100%; }
  .tp-wrap { width: 100%; max-width: 1366px; margin-inline: auto; padding-inline: var(--tp-pad); }
  .tp-sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .tp-label { font: 400 18px/1.4 var(--tp-sans); text-transform: uppercase; color: var(--tp-orange-text); }
  .tp-h2 { font: 700 clamp(32px, 3.7vw, 50px)/1.2 var(--tp-serif); color: var(--tp-navy); text-wrap: balance; }
  .tp-sechead { display: grid; justify-items: center; gap: 12px; margin-bottom: clamp(36px, 5vw, 64px); text-align: center; }
  .tp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 62px; padding: 0 40px; border: 0; border-radius: 999px; background: var(--tp-navy); color: var(--tp-orange); font: 500 18px/1 var(--tp-sans); text-decoration: none; cursor: pointer; transition: background .3s ease, color .3s ease, transform .3s ease, box-shadow .3s ease; }
  .tp-btn:hover { background: var(--tp-orange); color: var(--tp-navy); transform: translateY(-2px); box-shadow: 0 12px 26px rgb(252 101 57 / .32); }
  .tp-btn:focus-visible, .tp a:focus-visible, .tp button:focus-visible, .tp input:focus-visible { outline: 3px solid var(--tp-orange); outline-offset: 3px; }
  .tp-ico { flex: none; }
  .tp-cut { mix-blend-mode: multiply; }
  .tp-rule { display: block; width: 70px; height: 4px; background: var(--tp-orange); }
  @keyframes tp-reveal { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tp-reveal { animation: tp-reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 60%; }
    }
  }
  @media (prefers-reduced-motion: reduce) { .tp *, .tp *::before, .tp *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
  .tp-arrivals { padding-block: clamp(56px, 7.3vw, 100px); background: #fff; }
  .tp-arrivals__head { display: grid; justify-items: center; gap: 12px; margin-bottom: clamp(24px, 3vw, 40px); text-align: center; }
  .tp-arrivals__title { font: 400 32px/1.3 var(--tp-sans); color: var(--tp-ink); }
  .tp-arrivals__head p { max-width: 31em; font-size: 14px; line-height: 1.7; color: #555; }
  .tp-arrivals__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 5vw, 80px); }
  .tp-arrivals__media { display: grid; justify-items: center; }
  .tp-arrivals__media img { width: min(100%, 520px); height: auto; aspect-ratio: 1 / 1; object-fit: contain; }
  .tp-arrivals__copy { display: grid; justify-items: start; gap: 18px; }
  .tp-arrivals__copy .tp-h2 { font-size: clamp(30px, 3.4vw, 46px); line-height: 1.3; }
  .tp-arrivals__text { max-width: 31em; font-size: 18px; line-height: 1.65; color: var(--tp-navy); }
  .tp-arrivals__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .tp-arrivals__name { font-size: 15px; color: #555; }
  .tp-arrivals__price strong { font: 600 26px/1 var(--tp-sans); color: var(--tp-navy); }
  .tp-arrivals__price s { font-size: 16px; color: #666; }
  .tp-arrivals__copy .tp-btn { margin-top: 8px; }
  @media (max-width: 899px) { .tp-arrivals__grid { grid-template-columns: minmax(0, 1fr); } .tp-arrivals__media img { width: min(100%, 380px); } }
  @media (max-width: 559px) { .tp-arrivals__copy .tp-btn { width: 100%; } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if tp_html contains 'ا' or tp_html contains 'ل' or tp_html contains 'ي' or tp_html contains 'ة' -%}
<div class="tp-rtl" dir="rtl" style="display: contents">{{ tp_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap">
<style>
  .tp-rtl:is(#tp-rtl, *), .tp-rtl:is(#tp-rtl, *) * { letter-spacing: 0 !important; }
  .tp-rtl:is(#tp-rtl, *) :is(h1, h2, h3, p, li, span, a, button, strong, label, input, div) { font-family: "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .tp-rtl:is(#tp-rtl, *) :is(h1, h2, h3) { line-height: 1.35 !important; }
  .tp-rtl:is(#tp-rtl, *) .tp-btn svg { transform: scaleX(-1); }
</style>
{%- else -%}
{{ tp_html }}
{%- endif -%}

{% schema %}
{
  "name": "Tempo New Arrivals",
  "tag": "section",
  "class": "roarr-tempo-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_roarr_metafields",
      "label": "Use Roarr generated content",
      "default": true
    },
    {
      "type": "text",
      "id": "arrivals_heading",
      "label": "Section heading",
      "default": "New Arrivals"
    },
    {
      "type": "textarea",
      "id": "arrivals_text",
      "label": "Section text",
      "default": "Fresh from the workshop and ready to ship, meet the newest addition to the range."
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Label",
      "default": "Featured product"
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Heading",
      "default": "Made For Everyday Life"
    },
    {
      "type": "textarea",
      "id": "featured_text",
      "label": "Text",
      "default": "A focused design that does its job well. Choose it once and enjoy it every day, with the details that matter built in from the start."
    },
    {
      "type": "text",
      "id": "featured_cta",
      "label": "Button label",
      "default": "Buy Now"
    },
    {
      "type": "image_picker",
      "id": "tempo_product_image",
      "label": "Product image (1:1, white background)"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Product name when no product is found",
      "default": "Your product"
    },
    {
      "type": "text",
      "id": "fallback_price",
      "label": "Price when no product is found",
      "default": "$49.00"
    },
    {
      "type": "text",
      "id": "fallback_compare",
      "label": "Compare-at price when no product is found"
    }
  ],
  "presets": [
    {
      "name": "Tempo New Arrivals"
    }
  ]
}
{% endschema %}
