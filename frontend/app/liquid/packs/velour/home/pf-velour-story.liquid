{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign video = section.settings.video_url | default: homeData.demo_video_url -%}
{%- capture vr_html -%}
<section class="vr-sy">
  <div class="vr-wrap">
    <div class="vr-sy__box" data-vr-slides data-vr-reveal>
      <div class="vr-sy__stack">
        {%- for i in (1..3) -%}
          {%- assign heading_key = 'story_heading_' | append: i -%}
          {%- assign text_key = 'story_text_' | append: i -%}
          {%- assign image_key = 'story_image_' | append: i -%}
          {%- if ht[heading_key] != blank -%}
            <div class="vr-sy__slide" data-vr-slide>
              <div class="vr-sy__copy">
                {%- if ht.story_kicker != blank -%}<p class="vr-kick">{{ ht.story_kicker }}</p>{%- endif -%}
                <h2 class="vr-sy__title">{{ ht[heading_key] }}</h2>
                {%- if ht[text_key] != blank -%}<p class="vr-sy__text">{{ ht[text_key] }}</p>{%- endif -%}
                {%- if video != blank -%}
                  <a class="vr-btn vr-btn--dark vr-sy__cta" href="{{ video }}" data-vr-video="{{ video }}">{%- render 'snippets/roarr-velour-icon', name: 'play', size: 20 -%}{{ ht.label_play_video | default: 'Play Video' }}</a>
                {%- else -%}
                  <a class="vr-btn vr-btn--dark vr-sy__cta" href="{{ routes.all_products_collection_url | default: '/collections/all' }}">{% render 'snippets/roarr-ui-string', key: 'shop_now' %}<span class="vr-tilt">{%- render 'snippets/roarr-velour-icon', name: 'arrow', size: 16 -%}</span></a>
                {%- endif -%}
              </div>
              <div class="vr-sy__media">{%- render 'snippets/roarr-velour-img', src: hi[image_key], alt: ht[heading_key], width: 1500, lazy: true -%}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="vr-dots vr-sy__dots">
        {%- for i in (1..3) -%}
          {%- assign heading_key = 'story_heading_' | append: i -%}
          {%- if ht[heading_key] != blank -%}<button type="button" data-vr-dot aria-label="Slide {{ i }}">{{ i }}</button>{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <hr class="vr-rule vr-sy__rule" data-vr-reveal>
  </div>
  {%- if video != blank -%}
    <dialog class="vr-modal vr-sy__video" data-vr-dialog="video" aria-label="{{ ht.label_play_video | default: 'Play Video' | escape }}">
      <button class="vr-x vr-corner" type="button" aria-label="Close" data-vr-close>{%- render 'snippets/roarr-velour-icon', name: 'close', size: 18 -%}</button>
      <div class="vr-sy__frame" data-vr-video-box></div>
    </dialog>
  {%- endif -%}
</section>
<style>
  .vr .vr-sy { padding-block-end: 120px; background: #fff; }
  .vr .vr-sy__box { position: relative; padding: 80px 63px; border-radius: 5px; background: var(--vr-panel); }
  .vr .vr-sy__stack { display: grid; }
  .vr .vr-sy__slide { grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0, 480fr) minmax(0, 736fr); gap: 58px; opacity: 0; visibility: hidden; transform: translateY(14px); transition: opacity .9s ease, transform .9s ease, visibility .9s; }
  .vr .vr-sy__slide.is-on { opacity: 1; visibility: visible; transform: none; }
  .vr .vr-sy__copy { padding-inline-start: 10px; }
  .vr .vr-sy__title { margin-top: 14px; font-size: 28.8px; line-height: 43.2px; font-weight: 500 !important; color: var(--vr-ink); }
  .vr .vr-sy__text { margin-top: 14px; font-size: 14.7px; line-height: 23px; color: var(--vr-text); }
  .vr .vr-sy__cta { margin-top: 30px; }
  .vr .vr-sy__media { aspect-ratio: 736 / 484; overflow: hidden; border-radius: 5px; background: var(--vr-tile); }
  .vr .vr-sy__media img { width: 100%; height: 100%; object-fit: cover; }
  .vr .vr-sy__dots { position: absolute; bottom: 80px; inset-inline-start: 73px; color: var(--vr-ink); }
  .vr .vr-sy__rule { margin-top: 120px; }
  .vr .vr-sy__video { width: min(1000px, calc(100% - 32px)); border-radius: 10px; overflow: hidden; background: #000; }
  .vr .vr-sy__frame { aspect-ratio: 16 / 9; }
  .vr .vr-sy__frame :is(iframe, video) { display: block; width: 100%; height: 100%; border: 0; }
  @media (max-width: 1024px) {
    .vr .vr-sy__box { padding: 40px 30px 70px; }
    .vr .vr-sy__slide { grid-template-columns: 1fr; gap: 30px; }
    .vr .vr-sy__copy { padding-inline-start: 0; }
    .vr .vr-sy__dots { bottom: 30px; inset-inline-start: 30px; }
  }
  @media (max-width: 749px) {
    .vr .vr-sy { padding-block-end: 60px; }
    .vr .vr-sy__box { padding: 26px 18px 60px; }
    .vr .vr-sy__title { font-size: 22px; line-height: 33px; }
    .vr .vr-sy__dots { inset-inline-start: 18px; bottom: 24px; }
    .vr .vr-sy__rule { margin-top: 60px; }
  }
</style>
{%- endcapture -%}
{%- render 'snippets/roarr-velour-wrap', html: vr_html -%}

{% schema %}
{
  "name": "Velour Story",
  "tag": "section",
  "settings": [
    { "type": "video_url", "id": "video_url", "label": "Video link", "accept": ["youtube", "vimeo"], "info": "Adds a Play Video button. Without a video the button links to your products." }
  ],
  "presets": [{ "name": "Velour Story" }]
}
{% endschema %}
