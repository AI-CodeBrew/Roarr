{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- capture logos -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.logo != blank -%}
      <div class="vr-br__item" {{ block.shopify_attributes }}>{%- render 'snippets/roarr-velour-img', src: block.settings.logo, alt: block.settings.name, width: 400, lazy: true -%}</div>
    {%- endif -%}
  {%- endfor -%}
  {%- for i in (1..6) -%}
    {%- assign logo_key = 'brand_logo_' | append: i -%}
    {%- if hi[logo_key] != blank -%}
      <div class="vr-br__item">{%- render 'snippets/roarr-velour-img', src: hi[logo_key], alt: '', width: 400, lazy: true -%}</div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture vr_html -%}
{%- if logos != blank -%}
<section class="vr-br" data-vr-rail data-vr-auto>
  <div class="vr-wrap" data-vr-reveal>
    <div class="vr-rail__track" data-vr-track>{{ logos }}</div>
  </div>
</section>
{%- endif -%}
<style>
  .vr .vr-br { padding-block: 120px; background: #fff; }
  .vr .vr-br .vr-rail__track { --vr-gap: 30px; --vr-col: calc((100% - 120px) / 5); align-items: center; }
  .vr .vr-br__item { display: grid; place-items: center; }
  .vr .vr-br__item img { max-height: 42px; width: auto; max-width: 100%; object-fit: contain; }
  .vr .vr-br__item:hover img { animation: vr-nudge 1.2s linear; }
  @media (max-width: 989px) { .vr .vr-br .vr-rail__track { --vr-col: calc((100% - 60px) / 3); } }
  @media (max-width: 749px) {
    .vr .vr-br { padding-block: 44px; }
    .vr .vr-br .vr-rail__track { --vr-col: calc((100% - 30px) / 2); }
  }
</style>
{%- endcapture -%}
{%- render 'snippets/roarr-velour-wrap', html: vr_html -%}

{% schema %}
{
  "name": "Velour Brands",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Brand name" }
      ]
    }
  ],
  "presets": [{ "name": "Velour Brands" }]
}
{% endschema %}
