{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign banner = collection.image | default: hi.collection_banner -%}
{%- assign categories = homeData.demo_collection_list | default: collections -%}
{%- comment -%} One set of filter controls, shown in the sidebar on wide screens and in a drawer on small ones. {%- endcomment -%}
{%- capture filter_groups -%}
  {%- for filter in collection.filters -%}
    <details class="sm-cl__group" open>
      <summary><span>{%- render 'snippets/roarr-simmer-icon', name: 'chevron', size: 14, stroke: 1.6 -%}{{ filter.label }}</span><a class="sm-cl__reset" href="{{ filter.url_to_remove | default: collection.url }}">{{ ht.label_reset | default: 'Reset' }}</a></summary>
      {%- if filter.type == 'price_range' -%}
        {%- assign range_max = filter.range_max | divided_by: 100 -%}
        <div class="sm-cl__price" data-sm-price data-max="{{ range_max }}">
          <div class="sm-cl__slider">
            <i class="sm-cl__fill" data-sm-fill></i>
            <input type="range" min="0" max="{{ range_max }}" step="1" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% else %}0{% endif %}" aria-label="{{ ht.label_from | default: 'From' }}" data-sm-range="min">
            <input type="range" min="0" max="{{ range_max }}" step="1" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% else %}{{ range_max }}{% endif %}" aria-label="{{ ht.label_to | default: 'To' }}" data-sm-range="max">
          </div>
          <div class="sm-cl__ticks" aria-hidden="true">
            <span>0</span><span>{{ range_max | divided_by: 4 }}</span><span>{{ range_max | divided_by: 2 }}</span><span>{{ range_max | times: 3 | divided_by: 4 }}</span><span>{{ range_max }}</span>
          </div>
          <div class="sm-cl__prices">
            <input type="number" min="0" step="any" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}" placeholder="0" aria-label="{{ ht.label_from | default: 'From' }}" data-sm-autosubmit data-sm-number="min">
            <span aria-hidden="true">&mdash;</span>
            <input type="number" min="0" step="any" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}" placeholder="{{ range_max }}" aria-label="{{ ht.label_to | default: 'To' }}" data-sm-autosubmit data-sm-number="max">
          </div>
        </div>
      {%- elsif filter.presentation == 'swatch' -%}
        <ul class="sm-cl__swatches">
          {%- for value in filter.values -%}
            <li><label class="sm-cl__swatch" title="{{ value.label | escape }}">
              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %} data-sm-autosubmit aria-label="{{ value.label | escape }}">
              <span style="background: {{ value.swatch.color | default: '#cccccc' }}"></span>
            </label></li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <ul class="sm-cl__checks">
          {%- for value in filter.values -%}
            <li><label>
              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %} data-sm-autosubmit>
              <span>{{ value.label }}</span><small>({{ value.count }})</small>
            </label></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </details>
  {%- endfor -%}
{%- endcapture -%}
{%- capture sm_html -%}
{%- paginate collection.products by section.settings.per_page -%}
<div class="sm-banner">
  {%- render 'snippets/roarr-simmer-img', src: banner, alt: '', width: 2000 -%}
  <div>
    <h1>{{ collection.title }}</h1>
    <p class="sm-crumbs"><a href="{{ routes.root_url | default: '/' }}">{{ ht.label_home | default: 'Home' }}</a><i aria-hidden="true"></i><span>{{ collection.title }}</span></p>
  </div>
</div>
<section class="sm-cl" data-sm-collection>
  <div class="sm-wrap sm-cl__layout">
    <aside class="sm-cl__side">
      {%- if categories.size > 0 -%}
        <h2 class="sm-cl__heading">{%- render 'snippets/roarr-simmer-icon', name: 'lines', size: 18, stroke: 1.8 -%}{{ ht.label_categories | default: 'Categories' }}</h2>
        <ul class="sm-cl__cats" data-sm-cats>
          {%- for category in categories limit: 24 -%}
            <li{% if forloop.index > 5 %} hidden{% endif %}><a href="{{ category.url }}">{{ category.title }}</a></li>
          {%- endfor -%}
          {%- if categories.size > 5 -%}<li><button type="button" data-sm-cats-more>{{ ht.label_see_more | default: 'See More' }} +</button></li>{%- endif -%}
        </ul>
      {%- endif -%}
      <h2 class="sm-cl__heading sm-cl__heading--filter">{%- render 'snippets/roarr-simmer-icon', name: 'filter', size: 18, stroke: 1.8 -%}{{ ht.label_filter_by | default: 'Filter By' }}</h2>
      <a class="sm-btn sm-btn--dark sm-cl__clear" href="{{ collection.url }}">{%- render 'snippets/roarr-simmer-icon', name: 'trash', size: 16 -%}{{ ht.label_clear_all | default: 'Clear All' }}</a>
      <form class="sm-cl__form" method="get" action="{{ collection.url }}" data-sm-filter-form="side">
        <input type="hidden" name="sort_by" value="{{ collection.sort_by }}" data-sm-sort-field>
        {{ filter_groups }}
      </form>
    </aside>

    <div class="sm-cl__main">
      <button class="sm-cl__filter" type="button" data-sm-open="filters">{%- render 'snippets/roarr-simmer-icon', name: 'filter', size: 22 -%}{{ ht.label_filter | default: 'Filter' }}{%- render 'snippets/roarr-simmer-icon', name: 'chevron', size: 14, stroke: 2 -%}</button>
      <div class="sm-cl__bar">
        <label class="sm-cl__sort"><span>{{ ht.label_sort | default: 'Sort by' }}</span>
          <select aria-label="{{ ht.label_sort | default: 'Sort by' | escape }}" data-sm-sort>
            {%- for option in collection.sort_options -%}<option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>{%- endfor -%}
          </select>
        </label>
        <div class="sm-cl__views">
          <button type="button" class="is-on" aria-label="Three columns" aria-pressed="true" data-sm-view="three">{%- render 'snippets/roarr-simmer-icon', name: 'grid3', size: 20, stroke: 1.2 -%}</button>
          <button type="button" aria-label="Two columns" aria-pressed="false" data-sm-view="two">{%- render 'snippets/roarr-simmer-icon', name: 'grid', size: 20, stroke: 1.2 -%}</button>
          <button type="button" aria-label="List" aria-pressed="false" data-sm-view="list">{%- render 'snippets/roarr-simmer-icon', name: 'list', size: 20, stroke: 1.2 -%}</button>
        </div>
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="sm-cl__grid" data-sm-grid>
          {%- for product in collection.products -%}
            {%- render 'snippets/roarr-simmer-card', product: product, quick_add_label: ht.label_quick_add -%}
          {%- endfor -%}
        </div>
        <div class="sm-cl__more" data-sm-more-box>
          <p class="sm-cl__count">{{ ht.label_showing | default: 'Showing' }} <b data-sm-count>{{ collection.products.size }}</b> {{ ht.label_of | default: 'of' }} <b>{{ collection.products_count }}</b> {{ ht.label_products | default: 'products' }}</p>
          <span class="sm-cl__meter"><i data-sm-meter data-total="{{ collection.products_count }}" style="width: {{ collection.products.size | times: 100 | divided_by: collection.products_count }}%"></i></span>
          {%- if paginate.next -%}<a class="sm-btn sm-btn--dark" href="{{ paginate.next.url }}" data-sm-more>{{ ht.label_load_more | default: 'Load More Items' }}</a>{%- endif -%}
        </div>
      {%- else -%}
        <p class="sm-cl__none">{{ ht.label_no_products | default: 'No products match these filters.' }} <a class="sm-go" href="{{ collection.url }}">{{ ht.label_clear_all | default: 'Clear All' }}</a></p>
      {%- endif -%}
    </div>
  </div>

  {%- if collection.all_tags.size > 0 or collection.description != blank -%}
    <div class="sm-cl__notes">
      <div class="sm-wrap">
        {%- if collection.all_tags.size > 0 -%}
          <p class="sm-cl__tagshead">{%- render 'snippets/roarr-simmer-icon', name: 'tag', size: 14 -%}{{ ht.label_tags | default: 'Tags' }}</p>
          <ul class="sm-cl__tags">{%- for tag in collection.all_tags limit: 12 -%}<li><a href="{{ collection.url }}/{{ tag | handle }}">{{ tag }}</a></li>{%- endfor -%}</ul>
        {%- endif -%}
        {%- if collection.description != blank -%}
          <h2 class="sm-cl__about">{{ collection.title }}</h2>
          <div class="sm-cl__desc" data-sm-clamp>{{ collection.description }}</div>
          <button class="sm-cl__see" type="button" data-sm-clamp-toggle>{{ ht.label_see_more | default: 'See More' }}</button>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <dialog class="sm-canvas sm-canvas--start sm-cl__panel" data-sm-dialog="filters" aria-label="{{ ht.label_filter | default: 'Filter' | escape }}">
    <div class="sm-panel-head"><h2>{{ ht.label_filter | default: 'Filter' }}</h2><button class="sm-x" type="button" aria-label="Close" data-sm-close>{%- render 'snippets/roarr-simmer-icon', name: 'close', size: 18 -%}</button></div>
    <form class="sm-cl__form" method="get" action="{{ collection.url }}" data-sm-filter-form="drawer">
      <input type="hidden" name="sort_by" value="{{ collection.sort_by }}" data-sm-sort-field>
      <a class="sm-btn sm-btn--dark sm-cl__clear" href="{{ collection.url }}">{%- render 'snippets/roarr-simmer-icon', name: 'trash', size: 16 -%}{{ ht.label_clear_all | default: 'Clear All' }}</a>
      {{ filter_groups }}
    </form>
  </dialog>
</section>
{%- endpaginate -%}
<style>
  .sm .sm-cl { padding-block-start: 70px; background: #fff; }
  .sm .sm-cl__layout { display: grid; grid-template-columns: 270px minmax(0, 1fr); column-gap: 60px; align-items: start; }
  .sm .sm-cl__side { padding-block-start: 10px; }
  .sm .sm-cl__heading { display: flex; align-items: center; gap: 8px; font-size: 19.2px; line-height: 28.8px; font-weight: 800 !important; text-transform: uppercase; color: var(--sm-ink); }
  .sm .sm-cl__cats { display: grid; gap: 2px; margin-top: 25px; }
  .sm .sm-cl__cats :is(a, button) { display: block; width: 100%; height: 44px; padding: 0 30px; border: 0; border-radius: 5px; background: #efefef; font-size: 13.44px; line-height: 44px; font-weight: 500; text-align: start; color: var(--sm-text); cursor: pointer; transition: all .2s ease; }
  .sm .sm-cl__cats :is(a, button):hover { background: var(--sm-accent); color: #fff; }
  .sm .sm-cl__heading--filter { margin-top: 35px; padding-block-end: 26px; border-bottom: 1px solid var(--sm-line); }
  .sm .sm-cl__clear { width: 100%; height: 54px; margin-top: 25px; }
  .sm .sm-cl__form { margin: 20px 0 0; }
  .sm .sm-cl__group { padding-block: 26px; border-top: 1px solid var(--sm-line); }
  .sm .sm-cl__group summary { display: flex; align-items: center; justify-content: space-between; gap: 10px; list-style: none; cursor: pointer; }
  .sm .sm-cl__group summary::-webkit-details-marker { display: none; }
  .sm .sm-cl__group summary > span { display: inline-flex; align-items: center; gap: 12px; font-size: 14px; line-height: 21px; font-weight: 800; text-transform: uppercase; color: var(--sm-ink); }
  .sm .sm-cl__group summary svg { transform: rotate(180deg); transition: transform .25s ease; }
  .sm .sm-cl__group:not([open]) summary svg { transform: none; }
  .sm .sm-cl__reset { font-size: 10px; line-height: 15px; font-weight: 600; text-transform: uppercase; color: #bcbcbc; transition: color .2s ease; }
  .sm .sm-cl__reset:hover { color: var(--sm-accent); }
  .sm .sm-cl__checks { display: grid; gap: 5px; margin-top: 16px; }
  .sm .sm-cl__checks label { display: grid; grid-template-columns: 18px minmax(0, 1fr) auto; align-items: center; gap: 15px; padding-inline-end: 10px; font-size: 13.44px; line-height: 20px; color: var(--sm-text); cursor: pointer; }
  .sm .sm-cl__checks input { width: 18px; height: 18px; margin: 0; accent-color: var(--sm-ink); }
  .sm .sm-cl__checks small { font-size: 11px; line-height: 16.5px; color: var(--sm-ink); }
  .sm .sm-cl__price { margin-top: 18px; }
  .sm .sm-cl__slider { position: relative; height: 22px; }
  .sm .sm-cl__slider::before { content: ""; position: absolute; inset-inline: 0; top: 8px; height: 6px; border-radius: 6px; background: #e4e4e4; }
  .sm .sm-cl__fill { position: absolute; top: 8px; height: 6px; background: var(--sm-ink); }
  .sm .sm-cl__slider input { position: absolute; inset: 0; width: 100%; height: 22px; margin: 0; background: none; pointer-events: none; appearance: none; -webkit-appearance: none; }
  .sm .sm-cl__slider input::-webkit-slider-thumb { width: 22px; height: 22px; border: 2px solid var(--sm-ink); border-radius: 50%; background: #fff; pointer-events: auto; cursor: pointer; appearance: none; -webkit-appearance: none; }
  .sm .sm-cl__slider input::-moz-range-thumb { width: 18px; height: 18px; border: 2px solid var(--sm-ink); border-radius: 50%; background: #fff; pointer-events: auto; cursor: pointer; }
  .sm .sm-cl__ticks { display: flex; justify-content: space-between; margin-top: 6px; font-size: 10px; line-height: 15px; font-weight: 600; color: #909090; }
  .sm .sm-cl__prices { display: grid; grid-template-columns: minmax(0, 1fr) 12px minmax(0, 1fr); align-items: center; gap: 5px; margin-top: 25px; font-size: 13.44px; color: #000; }
  .sm .sm-cl__prices input { width: 100%; height: 38px; min-width: 0; padding-inline: 8px; border: 1px solid #cfcfcf; border-radius: 5px; background: #fff; font-size: 11px; font-weight: 600; text-align: center; color: #162950; appearance: textfield; -moz-appearance: textfield; }
  .sm .sm-cl__prices input::-webkit-outer-spin-button, .sm .sm-cl__prices input::-webkit-inner-spin-button { appearance: none; margin: 0; }
  .sm .sm-cl__swatches { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 18px; }
  .sm .sm-cl__swatch { position: relative; display: block; width: 26px; height: 26px; cursor: pointer; }
  .sm .sm-cl__swatch input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .sm .sm-cl__swatch span { display: block; width: 100%; height: 100%; border-radius: 50%; box-shadow: 0 0 0 1px var(--sm-line); }
  .sm .sm-cl__swatch input:checked + span { box-shadow: 0 0 0 2px #fff, 0 0 0 3px var(--sm-ink); }
  .sm .sm-cl__swatch input:focus-visible + span { outline: 2px solid var(--sm-ink); outline-offset: 3px; }
  .sm .sm-cl__filter { display: none; align-items: center; gap: 12px; padding: 0; border: 0; background: none; font-size: 19.2px; line-height: 28px; font-weight: 800; text-transform: uppercase; color: var(--sm-ink); cursor: pointer; }
  .sm .sm-cl__bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 30px; }
  .sm .sm-cl__sort { display: inline-flex; align-items: center; gap: 8px; font-size: 13.44px; color: var(--sm-ink); }
  .sm .sm-cl__sort select { field-sizing: content; max-width: 190px; padding: 6px 2px; border: 0; background: transparent; color: var(--sm-ink); font-size: 13.44px; font-weight: 700; cursor: pointer; }
  .sm .sm-cl__views { display: flex; gap: 10px; }
  .sm .sm-cl__views button { width: 42px; height: 42px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 5px; background: #efefef; color: var(--sm-text); cursor: pointer; transition: background-color .2s ease, color .2s ease; }
  .sm .sm-cl__views button.is-on { background: #000; color: #fff; }
  .sm .sm-cl__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; }
  .sm .sm-cl__grid.is-two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sm .sm-cl__grid.is-list { grid-template-columns: 1fr; }
  .sm .sm-cl__grid.is-list .sm-card { display: grid; grid-template-columns: 300px minmax(0, 1fr); column-gap: 30px; align-content: start; }
  .sm .sm-cl__grid.is-list .sm-card__media { grid-row: 1 / span 5; }
  .sm .sm-cl__grid.is-list .sm-card__type { margin-top: 0; }
  .sm .sm-cl__grid.is-list .sm-card__title { font-size: 17px; line-height: 26px; }
  .sm .sm-cl__more { display: grid; justify-items: center; gap: 12px; margin-top: 50px; }
  .sm .sm-cl__count { font-size: 12.5px; color: var(--sm-text); }
  .sm .sm-cl__count b { font-weight: 600; color: var(--sm-ink); }
  .sm .sm-cl__meter { display: block; width: 250px; height: 4px; border-radius: 4px; background: #e8e8e8; overflow: hidden; }
  .sm .sm-cl__meter i { display: block; height: 100%; background: var(--sm-accent); transition: width .4s ease; }
  .sm .sm-cl__more .sm-btn { margin-top: 12px; }
  .sm .sm-cl__none { padding: 50px 0; font-size: 14px; color: var(--sm-text); }
  .sm .sm-cl__notes { margin-top: 90px; padding-block: 80px; background: #efefef; }
  .sm .sm-cl__tagshead { display: flex; align-items: center; gap: 8px; font-size: 13.44px; font-weight: 700; text-transform: uppercase; color: var(--sm-ink); }
  .sm .sm-cl__tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .sm .sm-cl__tags a { display: inline-grid; place-items: center; min-width: 78px; height: 38px; padding-inline: 16px; border-radius: 3px; background: #fff; font-size: 12px; color: var(--sm-ink); }
  .sm .sm-cl__tags a:hover { background: var(--sm-accent); color: #fff; }
  .sm .sm-cl__about { margin-top: 44px; font-size: 19.2px; line-height: 28px; font-weight: 800 !important; text-transform: uppercase; }
  .sm .sm-cl__desc { position: relative; max-height: 92px; margin-top: 12px; overflow: hidden; font-size: 13.44px; line-height: 20px; color: var(--sm-text); }
  .sm .sm-cl__desc::after { content: ""; position: absolute; inset-inline: 0; bottom: 0; height: 40px; background: linear-gradient(transparent, #efefef); }
  .sm .sm-cl__desc.is-open { max-height: none; }
  .sm .sm-cl__desc.is-open::after { display: none; }
  .sm .sm-cl__see { display: block; margin: 16px auto 0; padding: 0; border: 0; background: none; font-size: 11.5px; font-weight: 500; text-transform: uppercase; color: var(--sm-ink); cursor: pointer; }
  .sm .sm-cl__panel .sm-cl__form { flex: 1; margin: 0; padding: 4px 24px 24px; overflow: auto; }
  .sm .sm-cl__panel .sm-cl__clear { margin: 16px 0; }
  @media (max-width: 991px) {
    .sm .sm-cl { padding-block-start: 40px; }
    .sm .sm-cl__layout { grid-template-columns: minmax(0, 1fr); }
    .sm .sm-cl__side { display: none; }
    .sm .sm-cl__filter { display: inline-flex; margin-bottom: 24px; }
    .sm .sm-cl__views button[data-sm-view="three"] { display: none; }
    .sm .sm-cl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 15px; }
    .sm .sm-cl__notes { margin-top: 60px; padding-block: 50px; }
  }
  @media (max-width: 749px) {
    .sm .sm-cl__grid.is-list .sm-card { grid-template-columns: 130px minmax(0, 1fr); column-gap: 14px; }
    .sm .sm-cl__grid.is-list .sm-card__title { font-size: 14px; line-height: 20px; }
  }
</style>
<script>
  (function () {
    document.querySelectorAll("[data-sm-collection]:not([data-ready])").forEach(function (root) {
      root.dataset.ready = "1";
      var grid = root.querySelector("[data-sm-grid]");
      var wide = window.matchMedia("(min-width: 992px)");
      function activeForm() { return root.querySelector('[data-sm-filter-form="' + (wide.matches ? "side" : "drawer") + '"]'); }
      function submit(form) {
        // Empty price boxes would add blank filters to the URL.
        var prices = form.querySelectorAll('input[type="number"]');
        prices.forEach(function (i) { i.disabled = !i.value; });
        form.requestSubmit();
        prices.forEach(function (i) { i.disabled = false; });
      }
      root.querySelectorAll("[data-sm-autosubmit]").forEach(function (el) {
        el.addEventListener("change", function () { submit(el.form); });
      });
      var sort = root.querySelector("[data-sm-sort]");
      if (sort) sort.addEventListener("change", function () {
        var form = activeForm();
        form.querySelector("[data-sm-sort-field]").value = sort.value;
        submit(form);
      });
      // The price slider follows the number boxes, and the other way round.
      root.querySelectorAll("[data-sm-price]").forEach(function (box) {
        var low = box.querySelector('[data-sm-range="min"]'), high = box.querySelector('[data-sm-range="max"]');
        var lowField = box.querySelector('[data-sm-number="min"]'), highField = box.querySelector('[data-sm-number="max"]');
        var fill = box.querySelector("[data-sm-fill]"), max = Number(box.dataset.max) || 1;
        function paint() {
          var a = Math.min(Number(low.value), Number(high.value)), b = Math.max(Number(low.value), Number(high.value));
          fill.style.insetInlineStart = (a * 100) / max + "%";
          fill.style.width = ((b - a) * 100) / max + "%";
        }
        [low, high].forEach(function (range) {
          range.addEventListener("input", paint);
          range.addEventListener("change", function () {
            var a = Math.min(Number(low.value), Number(high.value)), b = Math.max(Number(low.value), Number(high.value));
            lowField.value = a > 0 ? a : "";
            highField.value = b < max ? b : "";
            submit(lowField.form);
          });
        });
        paint();
      });
      var catsMore = root.querySelector("[data-sm-cats-more]");
      if (catsMore) catsMore.addEventListener("click", function () {
        root.querySelectorAll("[data-sm-cats] li[hidden]").forEach(function (li) { li.hidden = false; });
        catsMore.parentElement.hidden = true;
      });
      root.querySelectorAll("[data-sm-view]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          root.querySelectorAll("[data-sm-view]").forEach(function (b) { var on = b === btn; b.classList.toggle("is-on", on); b.setAttribute("aria-pressed", on ? "true" : "false"); });
          if (!grid) return;
          grid.classList.toggle("is-two", btn.dataset.smView === "two");
          grid.classList.toggle("is-list", btn.dataset.smView === "list");
        });
      });
