{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- assign store_name = ht.store_name | default: shop.name -%}
{%- assign menu_handle = section.settings.menu | default: 'main-menu' -%}
{%- assign nav = linklists[menu_handle].links -%}
{%- if nav == blank -%}{%- assign nav = homeData.demo_nav -%}{%- endif -%}
{%- assign label_search = ht.label_search | default: 'Search' -%}
{%- assign label_account = ht.label_account | default: 'Account' -%}
{%- assign label_wishlist = ht.label_wishlist | default: 'Wishlist' -%}
{%- assign label_cart = ht.label_cart | default: 'Cart' -%}
{%- assign label_placeholder = ht.label_search_placeholder | default: 'Enter Your Keywords' -%}
{%- assign shop_products = homeData.demo_products | default: collections.all.products -%}
{%- assign featured = shop_products | first -%}
{%- assign shop_categories = homeData.demo_collection_list | default: collections -%}
{%- assign search_url = routes.search_url | default: '/search' -%}
{%- capture trending -%}
  {%- assign seen = '' -%}
  {%- for item in shop_products limit: 12 -%}
    {%- if item.type != blank -%}
      {%- unless seen contains item.type -%}
        <li><a href="{{ search_url }}?q={{ item.type | url_encode }}&type=product">{{ item.type }}</a></li>
        {%- assign seen = seen | append: item.type | append: '|' -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign strip_categories = homeData.demo_category_strip | default: shop_categories -%}
{%- capture cats -%}
  {%- for category in strip_categories limit: 16 -%}
    {%- if category.handle != 'frontpage' and category.handle != 'all' -%}
      <a class="sm-hd__cat" href="{{ category.url }}">
        <span class="sm-hd__caticon" aria-hidden="true">
          {%- if category.icon != blank -%}{{ category.icon }}{%- elsif category.featured_image != blank -%}{%- render 'snippets/roarr-simmer-img', src: category.featured_image, alt: '', width: 80, lazy: true -%}{%- else -%}{%- render 'snippets/roarr-simmer-icon', name: 'box', size: 20 -%}{%- endif -%}
        </span>
        <span>{{ category.title }}</span>
      </a>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture sm_html -%}
{%- if section.settings.show_ticker != false and ht.ticker_text_1 != blank -%}
  {%- capture ticker_items -%}{%- for i in (1..3) -%}{%- assign ticker_key = 'ticker_text_' | append: i -%}{%- if ht[ticker_key] != blank -%}<li>{{ ht[ticker_key] }}</li>{%- endif -%}{%- endfor -%}{%- endcapture -%}
  <div class="sm-tk" role="region" aria-label="{{ ht.label_announcements | default: 'Announcements' | escape }}">
    <div class="sm-tk__track">
      <ul class="sm-tk__list">{{ ticker_items }}{{ ticker_items }}</ul>
      <ul class="sm-tk__list" aria-hidden="true">{{ ticker_items }}{{ ticker_items }}</ul>
    </div>
  </div>
{%- endif -%}
<div class="sm-hd-slot">
  <header class="sm-hd" data-sm-header>
    <div class="sm-hd__veil" aria-hidden="true"></div>
    <div class="sm-hd__main">
      <div class="sm-hd__start">
        <button class="sm-hd__cats" type="button" aria-label="{{ ht.label_categories | default: 'Categories' | escape }}" aria-expanded="false" data-sm-cats><i aria-hidden="true"></i></button>
        <button class="sm-hd__tool sm-hd__burger" type="button" aria-label="{{ ht.label_menu | default: 'Menu' | escape }}" data-sm-open="menu">{%- render 'snippets/roarr-simmer-icon', name: 'menu', size: 24, stroke: 1.8 -%}</button>
        <form class="sm-hd__search" action="{{ search_url }}" method="get" role="search" data-sm-search>
          <button class="sm-hd__searchgo" type="submit" aria-label="{{ label_search | escape }}">{%- render 'snippets/roarr-simmer-icon', name: 'search', size: 22, stroke: 2 -%}</button>
          <input class="sm-hd__searchfield" type="search" name="q" placeholder="{{ label_placeholder | escape }}" aria-label="{{ label_search | escape }}" autocomplete="off" data-sm-search-input>
          <input type="hidden" name="type" value="product">
        </form>
      </div>

      <a class="sm-hd__brand sm-logo" href="{{ routes.root_url | default: '/' }}">
        {%- if shop.brand.logo != blank -%}
          <img src="{{ shop.brand.logo | image_url: width: 320 }}" alt="{{ store_name | escape }}" width="{{ shop.brand.logo.width }}" height="{{ shop.brand.logo.height }}">
        {%- else -%}
          {{ store_name }}
        {%- endif -%}
      </a>

      <div class="sm-hd__end">
        <button class="sm-hd__cats sm-hd__cats--end" type="button" aria-label="{{ ht.label_categories | default: 'Categories' | escape }}" aria-expanded="false" data-sm-cats><i aria-hidden="true"></i></button>
        <a class="sm-hd__tool sm-hd__tool--account" href="{{ routes.account_url | default: '/account' }}" aria-label="{{ label_account | escape }}">{%- render 'snippets/roarr-simmer-icon', name: 'user', size: 20 -%}</a>
        <a class="sm-hd__tool" href="{{ routes.cart_url | default: '/cart' }}" aria-label="{{ label_cart | escape }}" data-sm-open="cart"><i class="sm-hd__ico">{%- render 'snippets/roarr-simmer-icon', name: 'bag', size: 20 -%}<b data-sm-cart-count>{{ cart.item_count | default: 0 }}</b></i></a>
      </div>

      <div class="sm-hd__row">
        <nav class="sm-hd__nav" aria-label="Main">
          <ul>
            {%- for link in nav -%}
              {%- assign has_cols = false -%}
              {%- for child in link.links -%}{%- if child.links != blank -%}{%- assign has_cols = true -%}{%- endif -%}{%- endfor -%}
              <li class="sm-hd__item{% if link.links != blank and has_cols == false %} sm-hd__item--drop{% endif %}{% if has_cols %} sm-hd__item--mega{% endif %}">
                <a class="sm-hd__link{% if link.active or link.current %} is-on{% endif %}" href="{{ link.url }}"><span data-text="{{ link.title | escape }}">{{ link.title }}</span>{%- if link.links != blank -%}{%- render 'snippets/roarr-simmer-icon', name: 'chevron', size: 12, stroke: 2 -%}{%- endif -%}</a>
                {%- if link.links != blank -%}
                  {%- if has_cols -%}
                    <div class="sm-hd__mega">
                      {%- capture lead -%}{%- for child in link.links -%}{%- if child.links == blank -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endif -%}{%- endfor -%}{%- endcapture -%}
                      {%- if lead != blank -%}<ul class="sm-hd__lead">{{ lead }}</ul>{%- endif -%}
                      {%- for child in link.links -%}
                        {%- if child.links != blank -%}
                          <div class="sm-hd__col">
                            <a class="sm-hd__colhead" href="{{ child.url }}">{{ child.title }}</a>
                            <ul>{%- for grand in child.links -%}<li><a href="{{ grand.url }}">{{ grand.title }}</a></li>{%- endfor -%}</ul>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if lead == blank and featured != blank -%}
                        <div class="sm-hd__col sm-hd__feat">
                          <p class="sm-hd__colhead">{{ ht.label_featured | default: 'Featured Product' }}</p>
                          <a class="sm-hd__featpic" href="{{ featured.url }}" tabindex="-1" aria-hidden="true">{%- render 'snippets/roarr-simmer-img', src: featured.featured_image, alt: featured.title, width: 400, lazy: true -%}</a>
                          <a class="sm-hd__feattitle" href="{{ featured.url }}">{{ featured.title }}</a>
                          <p class="sm-hd__featprice">{{ featured.price | money }}</p>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- else -%}
                    <ul class="sm-hd__drop">{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}</ul>
                  {%- endif -%}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
        {%- if cats != blank -%}
          <div class="sm-hd__catbar" data-sm-catbar data-sm-rail>
            <button class="sm-hd__catnav" type="button" aria-label="Previous categories" data-sm-prev>{%- render 'snippets/roarr-simmer-icon', name: 'prev', size: 18, stroke: 1.4 -%}</button>
            <div class="sm-hd__cattrack" data-sm-track>{{ cats }}</div>
            <button class="sm-hd__catnav" type="button" aria-label="Next categories" data-sm-next>{%- render 'snippets/roarr-simmer-icon', name: 'next', size: 18, stroke: 1.4 -%}</button>
          </div>
        {%- endif -%}
      </div>

      <div class="sm-hd__trend" data-sm-trend>
        <div class="sm-hd__results" data-sm-results hidden></div>
        {%- if trending != blank -%}
          <p class="sm-hd__trendhead">{{ ht.label_trending | default: 'Search Trending' }} :</p>
          <ul class="sm-hd__tags">{{ trending }}</ul>
        {%- endif -%}
      </div>
    </div>
  </header>
</div>

<nav class="sm-dock" aria-label="Shortcuts">
  <a href="{{ routes.root_url | default: '/' }}">{%- render 'snippets/roarr-simmer-icon', name: 'home', size: 24 -%}<span>{{ ht.label_home | default: 'Home' }}</span></a>
  <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">{%- render 'snippets/roarr-simmer-icon', name: 'grid', size: 24 -%}<span>{{ ht.label_shopping | default: 'Shopping' }}</span></a>
  <a href="{{ routes.account_url | default: '/account' }}">{%- render 'snippets/roarr-simmer-icon', name: 'user', size: 24 -%}<span>{{ label_account }}</span></a>
</nav>

<dialog class="sm-canvas sm-canvas--start" data-sm-dialog="menu" aria-label="Menu">
  <div class="sm-panel-head"><h2>{{ ht.label_menu | default: 'Menu' }}</h2><button class="sm-x" type="button" aria-label="Close" data-sm-close>{%- render 'snippets/roarr-simmer-icon', name: 'close', size: 18 -%}</button></div>
  <ul class="sm-mnav">
    {%- for link in nav -%}
      <li>
        {%- if link.links != blank -%}
          <details>
            <summary>{{ link.title }}{%- render 'snippets/roarr-simmer-icon', name: 'plus', size: 16 -%}</summary>
            <ul>
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}">{{ child.title }}</a>
                  {%- if child.links != blank -%}<ul>{%- for grand in child.links -%}<li><a href="{{ grand.url }}">{{ grand.title }}</a></li>{%- endfor -%}</ul>{%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </details>
        {%- else -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</dialog>

<dialog class="sm-canvas sm-cart" data-sm-dialog="cart" aria-label="{{ label_cart | escape }}" data-sm-label-items="{{ ht.label_items | default: 'items' | escape }}">
  <div class="sm-panel-head">
    <h2>{{ label_cart }}<span class="sm-cart__bubble" data-sm-cart-bubble>0 {{ ht.label_items | default: 'items' }}</span></h2>
    <button class="sm-x" type="button" aria-label="Close" data-sm-close>{%- render 'snippets/roarr-simmer-icon', name: 'close', size: 18 -%}</button>
  </div>
  <div class="sm-list" data-sm-cart-list></div>
  <div class="sm-cart__empty" data-sm-cart-empty hidden>
    <svg class="sm-cart__art" width="210" height="180" viewBox="0 0 210 180" fill="none" stroke="#1c1c1c" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <ellipse cx="105" cy="152" rx="66" ry="7" fill="#eeeeee" stroke="none"/>
      <path d="M52 72h106v62a16 16 0 0 1-16 16H68a16 16 0 0 1-16-16z" fill="#f2f2f2"/>
      <path d="M46 72h118"/>
      <path d="M52 86H36a6 6 0 0 1 0-12h16M158 86h16a6 6 0 0 0 0-12h-16"/>
      <path d="M74 72c0-12 14-18 31-18s31 6 31 18" fill="#ffffff"/>
      <circle cx="105" cy="50" r="4" fill="#1c1c1c"/>
      <path d="M86 108c3 3 7 3 10 0M114 108c3 3 7 3 10 0"/>
      <path d="M100 124c3 2 7 2 10 0"/>
      <path d="M84 36c-4-6 4-8 0-14M105 30c-4-6 4-8 0-14M126 36c-4-6 4-8 0-14" stroke="#b5b5b5"/>
    </svg>
    <p>{{ ht.label_cart_empty | default: 'Your cart is currently empty.' }}</p>
    <ul>{%- for category in shop_categories limit: 5 -%}<li><a href="{{ category.url }}">{{ category.title }}</a></li>{%- endfor -%}</ul>
  </div>
  <div class="sm-panel-foot" data-sm-cart-foot hidden>
    <p class="sm-sub"><span>{{ ht.label_subtotal | default: 'Subtotal' }}</span><span data-sm-cart-total></span></p>
    <a class="sm-btn sm-btn--dark" href="{{ routes.root_url | default: '/' }}checkout">{{ ht.label_checkout | default: 'Checkout' }}</a>
    <a class="sm-btn sm-btn--line" href="{{ routes.cart_url | default: '/cart' }}">{{ ht.label_view_cart | default: 'View Cart' }}</a>
  </div>
</dialog>

<dialog class="sm-canvas" data-sm-dialog="wishlist" aria-label="{{ label_wishlist | escape }}">
  <div class="sm-panel-head"><h2>{{ label_wishlist }}</h2><button class="sm-x" type="button" aria-label="Close" data-sm-close>{%- render 'snippets/roarr-simmer-icon', name: 'close', size: 18 -%}</button></div>
  <div class="sm-list" data-sm-wish-list></div>
  <p class="sm-none" data-sm-wish-empty>{{ ht.label_wishlist_empty | default: 'No saved products yet.' }}</p>
</dialog>

<dialog class="sm-modal sm-modal--qv" data-sm-dialog="quick" aria-label="{{ ht.label_quick_view | default: 'Quick view' | escape }}" data-sm-label-add="{{ ht.label_add_to_bag | default: 'Add To Bag' | escape }}" data-sm-label-sold-out="{% render 'snippets/roarr-ui-string', key: 'sold_out' %}" data-sm-label-buy="{{ ht.label_buy_now | default: 'Buy It Now' | escape }}" data-sm-label-qty="{{ ht.label_quantity | default: 'Quantity' | escape }}:" data-sm-label-sku="SKU:" data-sm-label-category="{{ ht.label_category | default: 'Category' | escape }}:">
  <button class="sm-x sm-corner" type="button" aria-label="Close" data-sm-close>{%- render 'snippets/roarr-simmer-icon', name: 'close', size: 18 -%}</button>
  <div data-sm-quick-body></div>
</dialog>

<style>
  /* Moving ticker above the header: three short lines, looping left, paused on hover. */
  .sm .sm-tk { position: relative; z-index: 61; overflow: hidden; background: var(--sm-accent); color: var(--sm-ink); }
  .sm .sm-tk__track { display: flex; width: max-content; animation: sm-tk 36s linear infinite; }
  .sm[dir="rtl"] .sm-tk__track { animation-name: sm-tk-rtl; }
  .sm .sm-tk:hover .sm-tk__track { animation-play-state: paused; }
  .sm .sm-tk__list { display: flex; flex: none; gap: 64px; margin: 0; padding: 12px 32px; list-style: none; }
  .sm .sm-tk__list li { display: flex; align-items: center; gap: 64px; font-size: 12px; line-height: 1; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
  .sm .sm-tk__list li::after { content: ""; width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: .5; }
  @keyframes sm-tk { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes sm-tk-rtl { from { transform: translateX(0); } to { transform: translateX(50%); } }
  @media (prefers-reduced-motion: reduce) { .sm .sm-tk__track { animation: none; width: auto; justify-content: center; } .sm .sm-tk__list[aria-hidden="true"] { display: none; } }
  .sm .sm-hd-slot { height: 180px; }
  .sm .sm-hd { position: relative; z-index: 60; color: var(--sm-ink); background: #fff; }
  .sm .sm-hd__veil { position: fixed; inset: 0; z-index: -1; pointer-events: none; -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); opacity: 0; visibility: hidden; transition: opacity .3s linear, visibility .3s linear; }
  .sm .sm-hd:has(.sm-hd__item--mega:hover) .sm-hd__veil, .sm .sm-hd:has(.sm-hd__item--mega:focus-within) .sm-hd__veil, .sm .sm-hd.is-searching .sm-hd__veil { opacity: 1; visibility: visible; }
  .sm .sm-hd__main { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); grid-template-areas: "start brand end" "row row row"; align-items: center; padding-inline: 15px; background: #fff; }
  .sm .sm-hd__start { grid-area: start; display: flex; align-items: center; min-width: 0; height: 110px; }
  .sm .sm-hd__brand { grid-area: brand; display: block; font-size: 42px; line-height: 34px; font-weight: 400; color: var(--sm-ink); white-space: nowrap; }
  .sm .sm-hd__brand img { max-height: 46px; width: auto; }
  .sm .sm-hd__end { grid-area: end; display: flex; align-items: center; justify-content: flex-end; gap: 19.2px; min-width: 0; }
  .sm .sm-hd__row { grid-area: row; position: relative; margin-inline: -15px; border-top: 1px solid #eaeaea; }

  .sm .sm-hd__cats { position: relative; flex: none; width: 50px; height: 50px; margin-inline-end: 28.8px; padding: 0; border: 0; border-radius: 9999px; background: #f2f2f2; color: var(--sm-ink); cursor: pointer; }
  .sm .sm-hd__cats i, .sm .sm-hd__cats::before, .sm .sm-hd__cats::after { position: absolute; top: 50%; left: 50%; width: 16px; height: 2px; border-radius: 20px; background: currentColor; transform: translate(-50%, -50%); }
  .sm .sm-hd__cats i { transition: opacity 0s .3s; }
  .sm .sm-hd__cats::before, .sm .sm-hd__cats::after { content: ""; transition: transform .3s, top .3s .3s; }
  .sm .sm-hd__cats::before { top: calc(50% - 5px); }
  .sm .sm-hd__cats::after { top: calc(50% + 5px); }
  .sm .sm-hd__cats[aria-expanded="true"] i { opacity: 0; transition-delay: 0s; }
  .sm .sm-hd__cats[aria-expanded="true"]::before, .sm .sm-hd__cats[aria-expanded="true"]::after { top: 50%; transition: top .3s, transform .3s .3s; }
  .sm .sm-hd__cats[aria-expanded="true"]::before { transform: translate(-50%, -50%) rotate(45deg); }
  .sm .sm-hd__cats[aria-expanded="true"]::after { transform: translate(-50%, -50%) rotate(-45deg); }
  .sm .sm-hd__cats--end { display: none; }

  .sm .sm-hd__search { position: relative; width: 200px; max-width: 100%; margin: 0; }
  .sm .sm-hd__searchfield { display: block; width: 100%; height: 50px; padding: 13px 15px 13px 35px; border: 0; background: transparent; color: var(--sm-ink); font-size: 13.33px; line-height: 16px; outline: none; -webkit-appearance: none; appearance: none; }
  .sm[dir="rtl"] .sm-hd__searchfield { padding: 13px 35px 13px 15px; }
  .sm .sm-hd__searchfield::placeholder { color: var(--sm-text); font-size: 12px; text-transform: capitalize; opacity: 1; }
  .sm .sm-hd__searchfield::-webkit-search-cancel-button { display: none; }
  .sm .sm-hd__searchgo { position: absolute; top: 0; inset-inline-start: 0; z-index: 1; display: flex; align-items: center; height: 50px; padding: 0; border: 0; background: none; color: var(--sm-ink); cursor: pointer; transition: color .2s ease; }
  .sm .sm-hd__searchgo:hover { color: var(--sm-accent); }

  .sm .sm-hd__tool { position: relative; display: inline-flex; align-items: center; justify-content: center; padding: 0; border: 0; background: none; color: var(--sm-ink); line-height: 1; cursor: pointer; transition: color .2s ease; }
  .sm .sm-hd__tool:hover { color: var(--sm-accent); }
  .sm .sm-hd__ico { position: relative; display: inline-grid; font-style: normal; }
  .sm .sm-hd__ico b { position: absolute; top: -7px; inset-inline-end: -8px; z-index: 1; min-width: 16px; height: 16px; display: grid; place-items: center; padding-inline: 3px; border-radius: 999px; background: var(--sm-ink); color: #fff; font-size: 10px; font-weight: 500; line-height: 1; }
  .sm .sm-hd__burger { display: none; }

  .sm .sm-hd__nav > ul { display: flex; justify-content: center; flex-wrap: nowrap; gap: 4px; }
  .sm .sm-hd__item { position: static; }
  .sm .sm-hd__item--drop { position: relative; }
  .sm .sm-hd__link { position: relative; display: flex; align-items: center; padding: 23px 22px; font-size: 15.36px; line-height: 23.04px; color: var(--sm-ink); text-transform: capitalize; transition: color .15s linear; }
  .sm .sm-hd__link > span { position: relative; display: inline-grid; }
  /* Keeps the width of the medium weight, so the row never shifts. */
  .sm .sm-hd__link > span::before { content: attr(data-text); height: 0; overflow: hidden; visibility: hidden; font-weight: 500; }
  .sm .sm-hd__link > span::after { content: ""; position: absolute; inset-inline-end: 0; bottom: -1px; width: 0; height: 1px; background: currentColor; transition: all .3s linear; }
  .sm .sm-hd__link.is-on > span::after, .sm .sm-hd__item:hover .sm-hd__link > span::after { inset-inline: 0 auto; width: 100%; }
  .sm .sm-hd__link svg { position: absolute; top: calc(50% - 5px); inset-inline-end: 3px; transition: transform .3s ease; }
  .sm .sm-hd__item:hover .sm-hd__link svg, .sm .sm-hd__item:focus-within .sm-hd__link svg { transform: rotate(180deg); }
  .sm .sm-hd__mega, .sm .sm-hd__drop { position: absolute; top: 100%; z-index: 5; background: #fff; opacity: 0; visibility: hidden; transform: translateY(20px); transition: opacity .3s ease-in-out, transform .3s ease-in-out, visibility .3s ease-in-out; }
  .sm .sm-hd__mega { inset-inline: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 275px)); gap: 49px; padding: 30px 40px 40px 55px; border-top: 1px solid #efefef; box-shadow: 0 10px 10px rgb(0 0 0 / .05); }
  .sm .sm-hd__mega:has(.sm-hd__lead) { grid-template-columns: minmax(0, 275px) repeat(3, minmax(0, 241px)); }
  .sm .sm-hd__mega > *, .sm .sm-hd__drop > li { transform: translateY(40px); transition: transform .8s ease; }
  .sm .sm-hd__item:hover :is(.sm-hd__mega > *, .sm-hd__drop > li), .sm .sm-hd__item:focus-within :is(.sm-hd__mega > *, .sm-hd__drop > li) { transform: none; }
  .sm .sm-hd__drop { inset-inline-start: 0; width: 270px; padding: 30px 0 44px; border-radius: 0 0 10px 10px; box-shadow: 0 10px 10px rgb(0 0 0 / .05); }
  .sm .sm-hd__item:hover :is(.sm-hd__mega, .sm-hd__drop), .sm .sm-hd__item:focus-within :is(.sm-hd__mega, .sm-hd__drop) { opacity: 1; visibility: visible; transform: none; }
  .sm .sm-hd__drop a { display: block; padding: 7px 40px; font-size: 13.44px; color: var(--sm-text); }
  .sm .sm-hd__drop a:hover, .sm .sm-hd__mega a:hover { color: var(--sm-accent); }
  .sm .sm-hd__lead li { margin-bottom: 24px; }
  .sm .sm-hd__lead a, .sm .sm-hd__colhead { font-size: 15.36px; font-weight: 500; line-height: 24px; color: var(--sm-ink); }
  .sm .sm-hd__colhead { display: block; margin-bottom: 22px; }
  .sm .sm-hd__featpic { display: block; width: 186px; aspect-ratio: 186 / 240; overflow: hidden; background: var(--sm-tile); }
  .sm .sm-hd__featpic img { width: 100%; height: 100%; object-fit: cover; }
  .sm .sm-hd__feattitle { display: block; margin-top: 28px; font-size: 13.44px; line-height: 20px; font-weight: 500; color: var(--sm-ink); }
  .sm .sm-hd__featprice { margin-top: 14px; font-size: 15.36px; line-height: 23px; font-weight: 700; color: var(--sm-ink); }
  .sm .sm-hd__col li { margin-bottom: 14px; font-size: 13.44px; line-height: 20px; color: var(--sm-text); }

  .sm .sm-hd__catbar { position: absolute; inset: 0; z-index: 2; display: grid; grid-template-columns: 30px minmax(0, 1fr) 30px; align-items: center; gap: 15px; padding-inline: 5px; background: #fff; opacity: 0; visibility: hidden; transform: translateY(20px); transition: .3s linear; }
  .sm .sm-hd.is-cats .sm-hd__catbar { opacity: 1; visibility: visible; transform: none; }
  .sm .sm-hd__cattrack { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 210px) / 8); justify-content: safe center; column-gap: 30px; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x mandatory; }
  .sm .sm-hd__cattrack::-webkit-scrollbar { display: none; }
  .sm .sm-hd__cat { display: flex; align-items: center; justify-content: center; gap: 10px; min-width: 0; padding-block: 23px; font-size: 13.44px; line-height: 20px; color: var(--sm-ink); white-space: nowrap; scroll-snap-align: start; }
  .sm .sm-hd__cat:hover { color: var(--sm-accent); }
  .sm .sm-hd__cat > span:last-child { overflow: hidden; text-overflow: ellipsis; }
  .sm .sm-hd__caticon { flex: none; display: grid; place-items: center; width: 20px; height: 20px; overflow: hidden; border-radius: 50%; }
  .sm .sm-hd__caticon img, .sm .sm-hd__caticon svg { width: 20px; height: 20px; object-fit: cover; }
  .sm .sm-hd__catnav { display: grid; place-items: center; width: 30px; height: 30px; padding: 0; border: 0; background: none; color: var(--sm-ink); cursor: pointer; }
  .sm .sm-hd__catnav[disabled] { color: #c9c9c9; cursor: default; }

  .sm .sm-hd__trend { position: absolute; top: 111px; inset-inline: 0; z-index: 4; padding: 40px 35px 40px; background: #fff; border-top: 1px solid #eaeaea; opacity: 0; visibility: hidden; transform: translateY(20px); transition: opacity .3s linear, transform .3s linear, visibility .3s linear; }
  .sm .sm-hd.is-searching .sm-hd__trend { opacity: 1; visibility: visible; transform: none; }
  .sm .sm-hd__trendhead { font-size: 15.36px; line-height: 23px; font-weight: 700; text-transform: uppercase; color: var(--sm-ink); }
  .sm .sm-hd__tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
  .sm .sm-hd__tags a { display: grid; place-items: center; height: 34px; padding-inline: 20px; border-radius: 34px; background: #f2f2f2; font-size: 12px; font-weight: 500; color: var(--sm-ink); transition: all .2s ease; }
  .sm .sm-hd__tags a:hover { background: var(--sm-accent); color: #fff; }
  .sm .sm-hd__results { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-bottom: 30px; }
  .sm .sm-hd__result { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 14px; align-items: center; color: var(--sm-ink); }
  .sm .sm-hd__result img { width: 64px; height: 82px; object-fit: cover; background: var(--sm-tile); }
  .sm .sm-hd__result b { display: block; font-size: 13.44px; line-height: 20px; font-weight: 500; }
  .sm .sm-hd__result span { display: block; margin-top: 4px; font-size: 13.44px; color: var(--sm-text); }
  .sm .sm-hd__result:hover b { color: var(--sm-accent); }

  @keyframes sm-hd-in { from { transform: translateY(-100%); } to { transform: none; } }
  .sm .sm-hd.is-stuck { position: fixed; top: 0; inset-inline: 0; box-shadow: 8px 10px 20px rgb(0 0 0 / .06); animation: sm-hd-in .3s linear both; }
  .sm .sm-hd.is-stuck .sm-hd__main { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); grid-template-areas: "brand row end"; }
  .sm .sm-hd.is-stuck .sm-hd__start, .sm .sm-hd.is-stuck .sm-hd__trend { display: none; }
  .sm .sm-hd.is-stuck .sm-hd__brand { justify-self: start; }
  .sm .sm-hd.is-stuck .sm-hd__row { margin: 0; border: 0; }
  .sm .sm-hd.is-stuck .sm-hd__catbar { display: none; }
  .sm .sm-hd.is-stuck .sm-hd__link { padding-block: 18px; }
  .sm .sm-hd.is-stuck .sm-hd__mega { position: fixed; top: 59px; }

  .sm .sm-dock { display: none; }
  .sm .sm-mnav { flex: 1; overflow: auto; padding: 8px 24px 24px; }
  .sm .sm-mnav > li { border-bottom: 1px solid var(--sm-line); }
  .sm .sm-mnav > li > a, .sm .sm-mnav summary { display: flex; align-items: center; justify-content: space-between; padding-block: 15px; font-size: 15.36px; font-weight: 500; color: var(--sm-ink); list-style: none; cursor: pointer; }
  .sm .sm-mnav summary::-webkit-details-marker { display: none; }
  .sm .sm-mnav details[open] summary svg { transform: rotate(45deg); }
  .sm .sm-mnav summary svg { transition: transform .25s ease; }
  .sm .sm-mnav details ul { padding: 0 0 14px 14px; }
  .sm .sm-mnav details a { display: block; padding-block: 7px; font-size: 14px; color: var(--sm-text); }
  .sm .sm-mnav details ul ul { padding-bottom: 4px; }

  .sm .sm-cart .sm-panel-head h2 { display: flex; align-items: center; gap: 20px; font-size: 15.36px; font-weight: 800 !important; text-transform: uppercase; }
  .sm .sm-cart__bubble { position: relative; padding: 4px 8px; border-radius: 5px; background: var(--sm-ink); color: #fff; font-size: 11px; line-height: 16px; font-weight: 500; text-transform: none; white-space: nowrap; }
  .sm .sm-cart__bubble::before { content: ""; position: absolute; top: 50%; inset-inline-end: 100%; border: 5px solid transparent; border-inline-end-color: var(--sm-ink); transform: translateY(-50%); }
  .sm .sm-cart__empty { flex: 1; overflow: auto; padding: 50px 80px 30px; text-align: center; }
  .sm .sm-cart__empty[hidden] { display: none; }
  .sm .sm-cart__art { display: block; margin: 0 auto 28px; max-width: 100%; }
  .sm .sm-cart__empty p { font-size: 13.44px; line-height: 20px; color: var(--sm-text); }
  .sm .sm-cart__empty ul { display: grid; gap: 10px; margin-top: 40px; }
  .sm .sm-cart__empty a { display: grid; place-items: center; height: 60px; border-radius: 50px; background: #f5f5f5; font-size: 13.44px; font-weight: 500; color: var(--sm-ink); transition: all .2s ease; }
  .sm .sm-cart__empty a:hover { background: var(--sm-accent); color: #fff; }

  @media (max-width: 1440px) { .sm .sm-hd__mega { gap: 30px; } }
  @media (max-width: 1199px) {
    .sm .sm-hd-slot { height: 111px; }
    .sm .sm-hd__main, .sm .sm-hd.is-stuck .sm-hd__main { grid-template-areas: "start brand end"; }
    .sm .sm-hd__row { display: none; }
    .sm .sm-hd__start > .sm-hd__cats { display: none; }
    .sm .sm-hd__cats--end { display: block; margin: 0 9px 0 0; }
    .sm[dir="rtl"] .sm-hd__cats--end { margin: 0 0 0 9px; }
    .sm .sm-hd__burger { display: inline-flex; margin-inline-end: 20px; }
    .sm .sm-hd__search { width: 160px; }
    .sm .sm-hd.is-stuck .sm-hd__start { display: flex; }
    .sm .sm-hd.is-stuck .sm-hd__brand { justify-self: center; }
    .sm .sm-hd.is-cats .sm-hd__row { display: block; position: absolute; inset-inline: 0; top: 100%; height: 69px; margin: 0; background: #fff; border-bottom: 1px solid #eaeaea; }
    .sm .sm-hd.is-cats .sm-hd__nav { display: none; }
    .sm .sm-hd__catbar { top: 0; }
  }
  @media (max-width: 1024px) {
    .sm .sm-dock { position: fixed; inset-inline: 0; bottom: 0; z-index: 55; display: grid; grid-template-columns: repeat(3, 1fr); background: #fff; border-top: 1px solid var(--sm-line); }
    .sm .sm-dock > * { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; height: 56px; padding: 0; border: 0; border-inline-start: 1px solid var(--sm-line); background: none; color: var(--sm-ink); font-size: 11px; line-height: 1; cursor: pointer; }
    .sm .sm-dock > *:first-child { border-inline-start: 0; }
    .sm .sm-dock span { font-size: 11px; color: var(--sm-text); }
  }
  @media (max-width: 767px) {
    .sm .sm-hd-slot { height: 60px; }
    .sm .sm-hd__start { height: 60px; }
    .sm .sm-hd__burger { margin-inline-end: 14px; }
    .sm .sm-hd__search { width: 22px; height: 50px; }
    .sm .sm-hd__searchfield { position: absolute; inset-inline-start: 0; top: 0; width: 22px; padding: 0; opacity: 0; cursor: pointer; }
    .sm .sm-hd.is-searching .sm-hd__searchfield { position: fixed; inset-inline: 15px; top: 70px; z-index: 6; width: auto; height: 46px; padding-inline: 18px; border: 1px solid #ececec; border-radius: 50px; background: #fff; opacity: 1; cursor: text; font-size: 16px; }
    .sm .sm-hd__trend { top: 60px; padding: 76px 15px 28px; }
    .sm .sm-hd__results { grid-template-columns: 1fr; gap: 12px; }
    .sm .sm-hd__brand { font-size: 32px; line-height: 30px; }
    .sm .sm-hd__brand img { max-height: 34px; }
    .sm .sm-hd__cats--end { width: 30px; height: 30px; margin-inline-end: 6px; background: transparent; }
    .sm .sm-hd__tool--account, .sm .sm-hd__tool--wish { display: none; }
    .sm .sm-hd.is-cats .sm-hd__row { height: 60px; }
    .sm .sm-hd__catbar { padding-inline: 0; gap: 4px; }
    .sm .sm-hd__cattrack { grid-auto-columns: calc((100% - 15px) / 2); column-gap: 15px; justify-content: start; }
    .sm .sm-hd__cat { padding-block: 18px; justify-content: flex-start; }
    .sm .sm-cart__empty { padding-inline: 40px; }
  }
</style>
{%- endcapture -%}
