{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- assign source = section.settings.collection | default: collections.all -%}
{%- assign products = homeData.demo_products | default: source.products -%}
{%- capture sm_html -%}
{%- if products != blank -%}
<section class="sm-new" data-sm-rail>
  <div class="sm-fluid" data-sm-reveal>
    <div class="sm-new__head">
      <div>
        {%- if ht.arrivals_kicker != blank -%}<p class="sm-kick">{{ ht.arrivals_kicker }}</p>{%- endif -%}
        <h2 class="sm-title">{{ ht.arrivals_heading }}</h2>
      </div>
      <div class="sm-arrows">
        <button type="button" aria-label="Previous products" data-sm-prev>{%- render 'snippets/roarr-simmer-icon', name: 'prev', size: 18, stroke: 1.8 -%}</button>
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" aria-label="{{ ht.label_view_all | default: 'View all' | escape }}">{%- render 'snippets/roarr-simmer-icon', name: 'grid', size: 16, stroke: 1.4 -%}</a>
        <button type="button" aria-label="Next products" data-sm-next>{%- render 'snippets/roarr-simmer-icon', name: 'next', size: 18, stroke: 1.8 -%}</button>
      </div>
    </div>
    <div class="sm-rail__track" data-sm-track>
      {%- for product in products limit: 3 -%}
        {%- render 'snippets/roarr-simmer-card', product: product, quick_add_label: ht.label_quick_add -%}
      {%- endfor -%}
    </div>
    <div class="sm-dots sm-new__dots" data-sm-rail-dots></div>
  </div>
</section>
{%- endif -%}
<style>
  .sm .sm-new { padding-block-end: 120px; background: #fff; }
  .sm .sm-new__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 55px; }
  .sm .sm-new .sm-arrows { margin-bottom: 10px; }
  .sm .sm-new .sm-arrows button[disabled] { opacity: .6; color: var(--sm-ink); }
  .sm .sm-new .sm-rail__track { --sm-col: calc((100% - 20px) / 3); }
  /* Three products share the row at the demo's card height; pictures sit whole on the tinted tile. */
  .sm .sm-new .sm-rail__track { container-type: inline-size; }
  .sm .sm-new .sm-card__media { aspect-ratio: auto; height: clamp(250px, calc((100vw - 70px) / 5 * 1.29), 420px); height: clamp(250px, calc((100cqw - 40px) / 5 * 1.29), 420px); }
  .sm .sm-new .sm-card__pics img { object-fit: contain; mix-blend-mode: multiply; }
  .sm .sm-new__dots { display: none; color: var(--sm-ink); }
  @media (max-width: 1199px) {
    .sm .sm-new { padding-block-end: 100px; }
    .sm .sm-new .sm-card__media { height: clamp(250px, calc((100vw - 60px) / 4 * 1.29), 420px); height: clamp(250px, calc((100cqw - 30px) / 4 * 1.29), 420px); }
  }
  @media (max-width: 991px) {
    .sm .sm-new { padding-block-end: 80px; }
    .sm .sm-new__head { margin-bottom: 30px; }
    .sm .sm-new .sm-rail__track { --sm-col: calc((100% - 10px) / 2); }
    .sm .sm-new .sm-card__media { height: auto; aspect-ratio: 345 / 445; }
    .sm .sm-new__dots { display: flex; margin-top: 22px; }
  }
  @media (max-width: 767px) {
    .sm .sm-new { padding-block-end: 60px; }
    .sm .sm-new .sm-arrows { display: none; }
  }
</style>
{%- endcapture -%}
{%- render 'snippets/roarr-simmer-wrap', html: sm_html -%}

{% schema %}
{
  "name": "Simmer New Arrivals",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (defaults to all products)" }
  ],
  "presets": [{ "name": "Simmer New Arrivals" }]
}
{% endschema %}
