{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Jost:wght@400;500&display=swap">
{%- assign store_gen = shop.metafields.roarr.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign brand = section.settings.brand | default: shop.name -%}
{%- assign heading = ht.banner_heading_1 | default: section.settings.heading | default: 'Pieces for a calmer everyday' -%}
{%- assign text = ht.banner_eyebrow_1 | default: section.settings.text | default: 'Thoughtfully chosen objects that bring focus, comfort and style to your space.' -%}
{%- assign cta = ht.hero_cta | default: section.settings.cta | default: 'Explore the collection' -%}
{%- assign banner = shop.metafields.roarr.banner_image.value -%}
{%- if banner == blank -%}{%- assign banner = hi.banner_image_1 | default: hi.banner_image | default: section.settings.image -%}{%- endif -%}
<section class="lmk-hh">
  <div class="lmk-hh__media">
    {%- if banner != blank -%}
      {%- if banner contains 'http' or banner contains '//' -%}
        <img src="{{ banner }}" alt="{{ heading | escape }}">
      {%- else -%}
        <img src="{{ banner | image_url: width: 2400 }}" alt="{{ heading | escape }}">
      {%- endif -%}
    {%- endif -%}
    <div class="lmk-hh__shade"></div>
  </div>
  <div class="lmk-hh__content">
    <div class="lmk-hh__inner">
      {%- if brand != blank -%}<p class="lmk-hh__brand">{{ brand }}</p><span class="lmk-hh__rule" aria-hidden="true"></span>{%- endif -%}
      <h1 class="lmk-hh__heading">{{ heading }}</h1>
      <p class="lmk-hh__text">{{ text }}</p>
      <a class="lmk-hh__cta" href="{{ routes.all_products_collection_url | default: '/collections/all' }}">{{ cta }}<span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>
<style>
  .lmk-hh { --lmk-ivory: #F6F1EA; --lmk-night: #1C1917; position: relative; min-height: clamp(520px, 86vh, 860px); display: grid; align-items: center; overflow: hidden; background: #2B2320; color: var(--lmk-ivory); font-family: "Jost", sans-serif; }
  .lmk-hh *, .lmk-hh *::before, .lmk-hh *::after { box-sizing: border-box; }
  .lmk-hh__media { position: absolute; inset: 0; }
  .lmk-hh__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lmk-hh__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(28 25 23 / .55) 0%, rgb(28 25 23 / .25) 45%, rgb(28 25 23 / 0) 75%); }
  .lmk-hh__content { position: relative; z-index: 1; width: min(1320px, calc(100% - 48px)); margin: 0 auto; padding: clamp(48px, 8vw, 96px) 0; }
  .lmk-hh__inner { max-width: 560px; display: grid; justify-items: start; gap: 18px; }
  .lmk-hh__brand { margin: 0; font-family: "Cormorant Garamond", serif; font-size: 16px; letter-spacing: .42em; text-transform: uppercase; }
  .lmk-hh__rule { display: block; width: 40px; height: 1px; background: currentColor; opacity: .8; }
  .lmk-hh__heading { margin: 0; font-family: "Cormorant Garamond", serif; font-weight: 400; font-size: clamp(40px, 5vw, 68px); line-height: 1.08; letter-spacing: -0.01em; color: var(--lmk-ivory); }
  .lmk-hh__text { margin: 0; max-width: 460px; font-size: 16px; line-height: 1.65; color: var(--lmk-ivory); opacity: .92; }
  .lmk-hh__cta { display: inline-flex; align-items: center; gap: 12px; margin-top: 8px; padding: 14px 24px; border: 1px solid rgb(246 241 234 / .7); border-radius: 6px; color: var(--lmk-ivory); text-decoration: none; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; transition: background 250ms ease, color 250ms ease; }
  .lmk-hh__cta:hover { background: var(--lmk-ivory); color: var(--lmk-night); }
  @media (max-width: 749px) {
    .lmk-hh { align-items: end; }
    .lmk-hh__shade { background: linear-gradient(180deg, rgb(28 25 23 / .05) 0%, rgb(28 25 23 / .7) 100%); }
    .lmk-hh__content { width: calc(100% - 32px); }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--lumen" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "Jost", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) .lmk-hh__shade { transform: scaleX(-1); }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
