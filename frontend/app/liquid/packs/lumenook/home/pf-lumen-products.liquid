{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Jost:wght@400;500&display=swap">
{%- assign store_gen = shop.metafields.kluck_ai.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign heading = section.settings.heading | default: 'The edit' -%}
{%- assign link_label = section.settings.link_label | default: 'View all' -%}
{%- assign picks = '' -%}
{%- for i in (1..3) -%}
  {%- assign key = 'selected_product_' | append: i -%}
  {%- assign h = ht[key] -%}
  {%- if h != blank -%}{%- assign picks = picks | append: h | append: ',' -%}{%- endif -%}
{%- endfor -%}
{%- assign handles = picks | split: ',' -%}
<section class="lmk-pl">
  <div class="lmk-pl__inner">
    <div class="lmk-pl__head">
      <h2 class="lmk-pl__heading">{{ heading }}</h2>
      <a class="lmk-pl__all" href="{{ routes.all_products_collection_url | default: '/collections/all' }}">{{ link_label }}</a>
    </div>
    <ul class="lmk-pl__grid" role="list">
      {%- assign shown = 0 -%}
      {%- for handle in handles -%}
        {%- assign product = all_products[handle] -%}
        {%- if product != blank and product.title != blank -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign tag_key = 'featured_product_subheadline_' | append: shown -%}
          <li class="lmk-pl__card">
            <a class="lmk-pl__link" href="{{ product.url }}">
              <div class="lmk-pl__media">
                {%- assign card_img = product.featured_image -%}
                {%- if card_img != blank -%}{%- if card_img contains 'http' or card_img contains '//' -%}<img src="{{ card_img }}" alt="{{ product.title | escape }}" loading="lazy">{%- else -%}<img src="{{ card_img | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}{%- endif -%}
              </div>
              {%- if product.type != blank -%}<p class="lmk-pl__type">{{ product.type }}</p>{%- endif -%}
              <h3 class="lmk-pl__title">{{ product.title }}</h3>
            </a>
            {%- if ht[tag_key] != blank -%}<p class="lmk-pl__tag">{{ ht[tag_key] }}</p>{%- endif -%}
            <p class="lmk-pl__price">{{ product.price | money }}{%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}</p>
            <div class="lmk-pl__buy">
              <div>
                
                <button class="lmk-pl__add" type="button"{% if product.available == false %} disabled{% endif %}>{%- if product.available == false -%}{% render 'snippets/kluck-ui-string', key: 'sold_out' %}{%- else -%}{% render 'snippets/kluck-ui-string', key: 'add_to_cart' %}{%- endif -%}</button>
              </div>
              <a class="lmk-pl__view" href="{{ product.url }}">{% render 'snippets/kluck-ui-string', key: 'shop_now' %} &rarr;</a>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
      {%- if shown == 0 -%}
        {%- for product in collections.all.products limit: 3 -%}
          {%- assign tag_key = 'featured_product_subheadline_' | append: forloop.index -%}
          <li class="lmk-pl__card">
            <a class="lmk-pl__link" href="{{ product.url }}">
              <div class="lmk-pl__media">
                {%- assign card_img = product.featured_image -%}
                {%- if card_img != blank -%}{%- if card_img contains 'http' or card_img contains '//' -%}<img src="{{ card_img }}" alt="{{ product.title | escape }}" loading="lazy">{%- else -%}<img src="{{ card_img | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}{%- endif -%}
              </div>
              {%- if product.type != blank -%}<p class="lmk-pl__type">{{ product.type }}</p>{%- endif -%}
              <h3 class="lmk-pl__title">{{ product.title }}</h3>
            </a>
            {%- if ht[tag_key] != blank -%}<p class="lmk-pl__tag">{{ ht[tag_key] }}</p>{%- endif -%}
            <p class="lmk-pl__price">{{ product.price | money }}{%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}</p>
            <div class="lmk-pl__buy">
              <div>
                
                <button class="lmk-pl__add" type="button"{% if product.available == false %} disabled{% endif %}>{%- if product.available == false -%}{% render 'snippets/kluck-ui-string', key: 'sold_out' %}{%- else -%}{% render 'snippets/kluck-ui-string', key: 'add_to_cart' %}{%- endif -%}</button>
              </div>
              <a class="lmk-pl__view" href="{{ product.url }}">{% render 'snippets/kluck-ui-string', key: 'shop_now' %} &rarr;</a>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>
<style>
  .lmk-pl { background: #F6F1EA; color: #2B2320; font-family: "Jost", sans-serif; padding: clamp(48px, 7vw, 96px) 0; }
  .lmk-pl *, .lmk-pl *::before, .lmk-pl *::after { box-sizing: border-box; }
  .lmk-pl__inner { width: min(1320px, calc(100% - 48px)); margin: 0 auto; }
  .lmk-pl__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  .lmk-pl__heading { margin: 0; font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: clamp(28px, 3vw, 38px); line-height: 1.15; }
  .lmk-pl__all { color: #2B2320; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid #B08D57; padding-bottom: 3px; }
  .lmk-pl__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 16px; }
  .lmk-pl__card { display: flex; flex-direction: column; gap: 4px; }
  .lmk-pl__link { color: inherit; text-decoration: none; display: block; }
  .lmk-pl__media { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: #E6DCCF; border-radius: 2px; }
  .lmk-pl__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 300ms ease; }
  .lmk-pl__link:hover .lmk-pl__media img { transform: scale(1.03); }
  .lmk-pl__type { margin: 12px 0 0; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: #6B5F58; }
  .lmk-pl__title { margin: 4px 0 2px; font-family: "Cormorant Garamond", serif; font-size: 21px; font-weight: 500; line-height: 1.2; }
  .lmk-pl__tag { margin: 0; font-size: 13px; color: #6B5F58; }
  .lmk-pl__price { margin: 4px 0 0; font-size: 14px; color: #6B5F58; }
  .lmk-pl__price s { margin-inline-start: 8px; }
  .lmk-pl__buy { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 10px; }
  .lmk-pl__buy form { margin: 0; }
  .lmk-pl__add, .lmk-pl__view { width: 100%; height: 40px; display: flex; align-items: center; justify-content: center; gap: .5em; padding: 0 8px; border-radius: 2px; font: 500 11px "Jost", sans-serif; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; text-decoration: none; cursor: pointer; transition: background-color 200ms ease, color 200ms ease; }
  .lmk-pl__add { border: 0; background: #E6DCCF; color: #2B2320; }
  .lmk-pl__add:hover { background: #775A2C; color: #F6F1EA; }
  .lmk-pl__view { background: transparent; color: #2B2320; box-shadow: inset 0 0 0 1px #B08D57; }
  .lmk-pl__view:hover { background: #775A2C; color: #F6F1EA; box-shadow: inset 0 0 0 1px #775A2C; }
  @media (max-width: 749px) {
    .lmk-pl__inner { width: calc(100% - 32px); }
    .lmk-pl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 12px; }
    .lmk-pl__buy { grid-template-columns: 1fr; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--lumen" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "Jost", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
