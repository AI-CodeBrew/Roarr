{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Jost:wght@400;500&display=swap">
{%- assign store_gen = shop.metafields.kluck_ai.store_generation.value -%}
{%- assign ht = store_gen.home_page.text -%}
{%- assign hi = store_gen.home_page.images -%}
{%- assign homeData = section.settings.homeData -%}
{%- if ht == blank and homeData.text != blank -%}{%- assign ht = homeData.text -%}{%- endif -%}
{%- if hi == blank and homeData.images != blank -%}{%- assign hi = homeData.images -%}{%- endif -%}
{%- assign eyebrow = ht.highlight_banner_section_subheading | default: 'After dark' -%}
{%- assign heading = ht.highlight_banner_section_heading | default: 'Glow, not glare' -%}
{%- assign text = ht.highlight_banner_section_description | default: 'Softly lit pieces for slow evenings. Warm, calm and made to be lived with.' -%}
{%- assign cta = section.settings.cta | default: 'Explore the collection' -%}
{%- assign image = hi.highlight_image | default: hi.banner_image_2 | default: section.settings.image -%}
<section class="lmk-split">
  <div class="lmk-split__media">{%- if image != blank -%}{%- if image contains 'http' or image contains '//' -%}<img src="{{ image }}" alt="{{ heading | escape }}" loading="lazy">{%- else -%}<img src="{{ image | image_url: width: 1600 }}" alt="{{ heading | escape }}" loading="lazy">{%- endif -%}{%- endif -%}</div>
  <div class="lmk-split__panel">
    <div class="lmk-split__inner">
      <p class="lmk-split__eyebrow">{{ eyebrow }}</p>
      <h2 class="lmk-split__heading">{{ heading }}</h2>
      <p class="lmk-split__text">{{ text }}</p>
      <a class="lmk-split__cta" href="{{ routes.all_products_collection_url | default: '/collections/all' }}">{{ cta }}<span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>
<style>
  .lmk-split { display: grid; grid-template-columns: 1fr 1fr; min-height: clamp(460px, 80vh, 760px); background: #1C1917; font-family: "Jost", sans-serif; }
  .lmk-split *, .lmk-split *::before, .lmk-split *::after { box-sizing: border-box; }
  .lmk-split__media { position: relative; overflow: hidden; background: #2B2320; }
  .lmk-split__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .lmk-split__panel { display: flex; align-items: center; padding: clamp(32px, 6vw, 88px); color: #EFE6DA; }
  .lmk-split__inner { max-width: 460px; display: grid; gap: 16px; }
  .lmk-split__eyebrow { margin: 0; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: #B08D57; }
  .lmk-split__heading { margin: 0; font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: clamp(32px, 3.6vw, 48px); line-height: 1.12; color: #F6F1EA; }
  .lmk-split__text { margin: 0; font-size: 15px; line-height: 1.7; color: #EFE6DA; opacity: .85; }
  .lmk-split__cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; width: fit-content; color: #EFE6DA; text-decoration: none; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; border-bottom: 1px solid rgb(239 230 218 / .4); padding-bottom: 4px; transition: border-color 200ms ease, color 200ms ease; }
  .lmk-split__cta:hover { border-color: #B08D57; color: #B08D57; }
  @media (max-width: 749px) {
    .lmk-split { grid-template-columns: 1fr; min-height: 0; }
    .lmk-split__media { aspect-ratio: 4 / 5; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--lumen" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "Jost", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
