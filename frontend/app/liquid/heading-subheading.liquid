{%- assign render_flag = shop.metafields.app.block_control.value -%}
{%- if render_flag == true -%}
  {%- liquid
    assign s = block.settings
    assign m = product.metafields.roarr
    assign color = m.color_schema.value | default: m.color_schema | default: '#a34e4e'

    assign opacity_val = s.background_opacity | default: 10 | divided_by: 100.0
    if s.show_background == false
      assign opacity = 0
    else
      assign opacity = opacity_val
    endif
    assign bg_color = s.background_color | default: '#ffffff'
    if s.use_metafields_bg and product != blank and m.color_schema != blank
      assign bg_color = m.color_schema.value | default: m.color_schema
    elsif s.use_metafields and product != blank and m.color_schema != blank
      assign bg_color = m.color_schema.value | default: m.color_schema
    endif

    assign heading_font = s.heading_font_family
    assign body_font = s.body_font_family
    assign icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>'
    if s.use_metafields
      assign heading_meta = product.metafields.roarr.high_impacting_product_heading
      assign heading_content = heading_meta.value | default: heading_meta | default: s.heading
      assign subheading_meta = product.metafields.roarr.high_impacting_product_subheading
      assign subheading_content = subheading_meta.value | default: subheading_meta | default: s.subheading
    else
      assign heading_content = s.heading
      assign subheading_content = s.subheading
    endif
  -%}

  <link rel="stylesheet" href="{{ 'typography.css' | asset_url }}" media="all">
  <link rel="stylesheet" href="{{ 'heading-subheading.css' | asset_url }}" media="all">
  <div
    id="hl-{{ block.id }}"
    class="hl-root app_blocks_class"
    style="--product-section-bg:{{ bg_color }};--product-section-opacity:{{ opacity }};--bg-color:{{ bg_color }};--bg-opacity:{{ opacity }};--container-width:{{ s.container_max_width | default: 1250 }}px;--bg-section:{{ color }};--bg-card:#fff;--border-color:#f0f0f0;--text-main:#111;--text-sub:#555;--highlights-wrapper-radius:{{ s.highlights_border_radius | default: 24 }}px;--marquee-speed:{{ s.marquee_speed | default: 20 }}s;--font-heading-family:{% if heading_font != blank and heading_font.family %}{{ heading_font.family }}, {{ heading_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %};--font-body-family:{% if body_font != blank and body_font.family %}{{ body_font.family }}, {{ body_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %};--body-size:{{ s.body_size | default: 16 }}px;--body-weight:{{ s.body_weight | default: 400 }};--h1-size:{{ s.h1_size | default: 48 }}px;--h1-weight:{{ s.h1_weight | default: 700 }};--h2-size:{{ s.h2_size | default: 36 }}px;--h2-weight:{{ s.h2_weight | default: 700 }};--h3-size:{{ s.h3_size | default: 30 }}px;--h3-weight:{{ s.h3_weight | default: 600 }};--h4-size:{{ s.h4_size | default: 24 }}px;--h4-weight:{{ s.h4_weight | default: 600 }};--h5-size:{{ s.h5_size | default: 20 }}px;--h5-weight:{{ s.h5_weight | default: 500 }};--h6-size:{{ s.h6_size | default: 16 }}px;--h6-weight:{{ s.h6_weight | default: 500 }};display:block;"
  >
    {%- if s.show_heading_subheading -%}
      <div class="tae-heading-subheading">
        {%- if heading_content != blank -%}
          <h2 class="tae-heading-subheading-heading tae-text-h2" style="color:{{ color }};">{{ heading_content }}</h2>
        {%- endif -%}
        {%- if subheading_content != blank -%}
          <div class="tae-heading-subheading-content tae-text-body">
            <p>{{ subheading_content }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.show_highlights -%}
      <div class="hl-section">
        <div class="hl-container">
          <div class="hl-header">
            <div class="hl-heading-wrap">
              <h2 class="tae-text-h2">
                {{ s.heading_start -}}
                {%- if s.heading_italic != blank %}
                  <em>{{ s.heading_italic }}</em>
                {%- endif %}
              </h2>
            </div>
          </div>
          <div class="hl-marquee-wrapper">
            <div class="hl-marquee-track">
              {%- capture cards -%}
          <div class="hl-card"><div class="hl-icon">{{ icon }}</div><h3 class="tae-text-h3">Natural Formula</h3><p class="tae-text-body">Crafted with pure ingredients.</p></div>
          <div class="hl-card"><div class="hl-icon">{{ icon }}</div><h3 class="tae-text-h3">Deep Hydration</h3><p class="tae-text-body">Locks in moisture for soft skin.</p></div>
          <div class="hl-card"><div class="hl-icon">{{ icon }}</div><h3 class="tae-text-h3">Visible Results</h3><p class="tae-text-body">Supports healthier-looking skin.</p></div>
          <div class="hl-card"><div class="hl-icon">{{ icon }}</div><h3 class="tae-text-h3">Daily Safe</h3><p class="tae-text-body">Gentle for everyday routine.</p></div>
        {%- endcapture -%}
              {{ cards -}}
              {{- cards }}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
