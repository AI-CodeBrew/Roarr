{%- capture kl_rtl_html -%}
{% render 'snippets/play-fonts' %}
{%- assign m = product.metafields.kluck_ai -%}
{%- assign heading = m.pillow_banner_heading.value | default: m.pillow_banner_heading | default: 'A brighter way to play, half off this week.' -%}
{%- assign sub = m.pillow_banner_subheading.value | default: m.pillow_banner_subheading | default: 'Use the code at checkout. It stacks with the sale price.' -%}
{%- assign code = m.promo_code.value | default: m.promo_code | default: 'BLACKFRIDAY' -%}
{%- assign image = m.feature_image.value | default: m.feature_image | default: 'https://cdn.shopify.com/s/files/1/0446/8228/1123/files/iwt-1c.png?v=1726197375' -%}
<section class="pk-promo">
  <div class="pk-promo-grid">
    <div>
      <h2>{{ heading }}</h2>
      <p>{{ sub }}</p>
      <div class="pk-code">{{ code }}</div>
    </div>
    <img src="{{ image }}" alt="">
  </div>
</section>
<style>
  .pk-promo { background: #E0F4E0; color: #6F2424; font-family: Poppins, sans-serif; }
  .pk-promo-grid { width: min(1100px, calc(100% - 48px)); margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; padding: 48px 0; }
  .pk-promo h2 { font-family: "Caveat Brush", cursive !important; font-weight: 400; font-size: 44px; line-height: 1.05; margin: 0 0 12px; color: #6F2424; }
  .pk-promo p { margin: 0; }
  .pk-code { margin-top: 18px; display: inline-block; background: #fff; border: 2px dashed #3F9D3E; color: #3F9D3E; border-radius: 999px; padding: 12px 22px; font-weight: 700; letter-spacing: 0.08em; }
  .pk-promo img { width: 100%; height: auto; object-fit: contain; border-radius: 24px; }
  @media (max-width: 800px) { .pk-promo-grid { grid-template-columns: 1fr; } .pk-promo h2 { font-size: 36px; } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--play" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: Poppins, "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Caveat Brush", "Lalezar", "Tajawal", cursive !important; line-height: 1.4 !important; font-weight: 400 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
