{% comment %}
  Product Section (Roarr Hero Block) - Two-panel layout with product media.
  Context: block, product, shop
{% endcomment %}
{% if shop.metafields.app.block_control.value %}
{% assign s = block.settings %}
{% assign use_metafields = s.use_metafields %}
{% assign m = product.metafields.kluck_ai %}
{% assign opacity_val = s.background_opacity | default: 10 | divided_by: 100.0 %}
{% if s.show_background == false %}
  {% assign opacity = 0 %}
{% else %}
  {% assign opacity = opacity_val %}
{% endif %}
{% assign bg_color = s.background_color | default: '#ffffff' %}
{% if s.use_metafields_bg and product != blank and m.color_schema != blank %}
  {% assign bg_color = m.color_schema.value | default: m.color_schema %}
{% elsif use_metafields and product != blank and m.color_schema != blank %}
  {% assign bg_color = m.color_schema.value | default: m.color_schema %}
{% endif %}

{% assign heading_font = s.heading_font_family %}
{% assign body_font = s.body_font_family %}

<link rel="stylesheet" href="{{ 'typography.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'product-section.css' | asset_url }}" media="all">

<div class="product-two-panel product-two-panel-{{ block.id | replace: '_', '-' }} app_blocks_class" style="--product-section-bg: {{ bg_color }}; --product-section-opacity: {{ opacity }}; --bg-color: {{ bg_color }}; --bg-opacity: {{ opacity }}; --container-width: {{ s.container_max_width | default: 1250 }}px; --font-heading-family: {% if heading_font != blank and heading_font.family %}{{ heading_font.family }}, {{ heading_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %}; --font-body-family: {% if body_font != blank and body_font.family %}{{ body_font.family }}, {{ body_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %}; --body-size: {{ s.body_size | default: 16 }}px; --body-weight: {{ s.body_weight | default: 400 }}; --h1-size: {{ s.h1_size | default: 48 }}px; --h1-weight: {{ s.h1_weight | default: 700 }}; --h2-size: {{ s.h2_size | default: 36 }}px; --h2-weight: {{ s.h2_weight | default: 700 }}; --h3-size: {{ s.h3_size | default: 30 }}px; --h3-weight: {{ s.h3_weight | default: 600 }}; --h4-size: {{ s.h4_size | default: 24 }}px; --h4-weight: {{ s.h4_weight | default: 600 }}; --h5-size: {{ s.h5_size | default: 20 }}px; --h5-weight: {{ s.h5_weight | default: 500 }}; --h6-size: {{ s.h6_size | default: 16 }}px; --h6-weight: {{ s.h6_weight | default: 500 }};">
  <div class="product-two-panel__inner">

    {% if s.show_media %}
      <div class="product-two-panel__left">
        {% if product.media.size > 0 %}
          <div class="product-two-panel__main-image" style="border-radius: {{ s.media_corner_radius }}px; overflow: hidden;">
            {% assign first_media = product.media.first %}
            <img id="main-product-image"
                 src="{{ first_media.preview_image | img_url: 'master' }}"
                 alt="{{ first_media.alt | default: 'Product' | escape }}"
                 style="border-radius: {{ s.media_corner_radius }}px;">
          </div>

          <div class="product-two-panel__thumbnails-wrapper">
            <button type="button" class="thumb-prev" aria-label="Previous">‹</button>
            <div class="product-two-panel__thumbnails">
              {% for media in product.media %}
                {% if media.media_type == 'image' or media.preview_image %}
                  <img class="product-two-panel__thumbnail"
                       src="{{ media.preview_image | img_url: '100x100' }}"
                       alt="{{ media.alt | default: 'Thumbnail' | escape }}"
                       data-full="{{ media.preview_image | img_url: 'master' }}"
                       style="border-radius: {{ s.media_corner_radius }}px;">
                {% endif %}
              {% endfor %}
            </div>
            <button type="button" class="thumb-next" aria-label="Next">›</button>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<script src="{{ 'product-section.js' | asset_url }}" defer></script>
{% endif %}
