{%- assign render_flag = shop.metafields.app.block_control.value -%}
{%- if render_flag == true -%}
  {%- liquid
    assign s = block.settings
    assign m = product.metafields.kluck_ai
    assign color_schema = m.color_schema.value | default: m.color_schema | default: '#A34E4E'

    assign opacity_val = s.background_opacity | default: 10 | divided_by: 100.0
    if s.show_background == false
      assign opacity = 0
    else
      assign opacity = opacity_val
    endif
    assign bg_color = s.background_color | default: '#ffffff'
    unless s.use_metafields_bg == false
      if s.use_metafields_bg and product != blank and m.color_schema != blank
        assign bg_color = m.color_schema.value | default: m.color_schema
      elsif s.use_metafields and product != blank and m.color_schema != blank
        assign bg_color = m.color_schema.value | default: m.color_schema
      endif
    endunless
    assign panel_color = color_schema
    if s.use_metafields_bg == false
      assign panel_color = bg_color
    endif

    assign heading_font = s.heading_font_family
    assign body_font = s.body_font_family

    assign pad_v_d = s.padding_vertical_desktop | default: 10
    assign pad_h_d = s.padding_horizontal_desktop | default: 10
    assign pad_v_m = s.padding_vertical_mobile | default: 20
    assign pad_h_m = s.padding_horizontal_mobile | default: 10

    assign img = m.product_impact_image.value | default: m.product_impact_image | default: s.image | default: m.product_impact_image | default: s.image
    # Heading Logic
    assign heading = s.heading
    if s.use_metafields
      assign heading = m.creative_sassy_product_heading.value | default: m.creative_sassy_product_heading | default: heading
    endif

    # Subheadings Logic (Loop 1-4)
    capture subheadings_html
      for i in (1..4)
        assign s_key_title = 'subheading_' | append: i
        assign s_key_desc = 'subheading_' | append: i | append: '_desc'

        assign title = s[s_key_title]
        assign desc = s[s_key_desc]

        if s.use_metafields
          assign m_key_title = 'creative_sassy_product_subheading_' | append: i
          assign m_key_desc = 'creative_sassy_product_subheading_' | append: i | append: '_description'
          assign title = m[m_key_title].value | default: m[m_key_title] | default: title
          assign desc = m[m_key_desc].value | default: m[m_key_desc] | default: desc
        endif

        if title != blank
          echo '<div class="tae-two-panel-item"><h4 class="tae-two-panel-item-heading">' | append: title | append: '</h4>'
          if desc != blank
            echo '<p class="tae-two-panel-item-desc">' | append: desc | append: '</p>'
          endif
          echo '</div>'
        endif
      endfor
    endcapture
  -%}

  <link rel="stylesheet" href="{{ 'typography.css' | asset_url }}" media="all">
  <link rel="stylesheet" href="{{ 'image-with-text.css' | asset_url }}" media="all">

  <div
    class="tae-two-panel tae-two-panel-{{ block.id | replace: '_', '-' | downcase }} {% if s.image_position == 'right' %}tae-two-panel--image-right{% endif %} app_blocks_class"
    style="--product-section-bg:{{ bg_color }}; --product-section-opacity:{{ opacity }}; --bg-color:{{ bg_color }}; --bg-opacity:{{ opacity }}; --container-width:{{ s.container_max_width | default: 1250 }}px; --image-with-text-bg-color: {{ panel_color }}; --image-with-text-radius: {{ s.container_radius | default: 0 }}px; --image-with-text-padding: {{ s.container_padding | default: 0 }}px; --section-padding-v-d: {{ pad_v_d }}px; --section-padding-h-d: {{ pad_h_d }}px; --section-padding-v-m: {{ pad_v_m }}px; --section-padding-h-m: {{ pad_h_m }}px; --font-heading-family:{% if heading_font != blank and heading_font.family %}{{ heading_font.family }}, {{ heading_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %}; --font-body-family:{% if body_font != blank and body_font.family %}{{ body_font.family }}, {{ body_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %}; --body-size:{{ s.body_size | default: 16 }}px; --body-weight:{{ s.body_weight | default: 400 }}; --h1-size:{{ s.h1_size | default: 48 }}px; --h1-weight:{{ s.h1_weight | default: 700 }}; --h2-size:{{ s.h2_size | default: 36 }}px; --h2-weight:{{ s.h2_weight | default: 700 }}; --h3-size:{{ s.h3_size | default: 30 }}px; --h3-weight:{{ s.h3_weight | default: 600 }}; --h4-size:{{ s.h4_size | default: 24 }}px; --h4-weight:{{ s.h4_weight | default: 600 }}; --h5-size:{{ s.h5_size | default: 20 }}px; --h5-weight:{{ s.h5_weight | default: 500 }}; --h6-size:{{ s.h6_size | default: 16 }}px; --h6-weight:{{ s.h6_weight | default: 500 }}; display: block;"
  >
    <div class="tae-two-panel-container">
      <div class="tae-two-panel-left">
        {% if img != blank %}
          <img
            src="{{ img | image_url: width: 1200 }}"
            srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1800 }} 1800w"
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ img.alt | default: heading }}"
            loading="lazy"
            width="1200"
            height="1200"
          >
        {% else %}
          {% render 'snippets/image-svg' %}
        {% endif %}
      </div>

      <div class="tae-two-panel-right">
        <div class="tae-two-panel-content">
          {% if heading != blank %}
            <h3 class="tae-two-panel-heading">{{ heading }}</h3>
          {% endif %}
          <div class="tae-two-panel-items">{{ subheadings_html }}</div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
