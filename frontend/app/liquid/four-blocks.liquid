{%- assign render_flag = shop.metafields.app.block_control.value -%}
{%- if render_flag == true -%}
  {%- liquid
    assign s = block.settings
    assign m = product.metafields.kluck_ai
    assign color = m.color_schema.value | default: m.color_schema | default: '#111'
    assign layout = s.layout | default: 'layout_1'
    assign align = s.text_align | default: 'center'

    assign opacity_val = s.background_opacity | default: 10 | divided_by: 100.0
    if s.show_background == false
      assign opacity = 0
    else
      assign opacity = opacity_val
    endif
    assign bg_color = s.background_color | default: '#ffffff'
    unless s.use_metafields_bg == false
      if s.use_metafields_bg and product != blank and m.color_schema != blank
        assign bg_color = m.color_schema.value | default: m.color_schema
      elsif s.use_metafields and product != blank and m.color_schema != blank
        assign bg_color = m.color_schema.value | default: m.color_schema
      endif
    endunless

    assign heading_font = s.heading_font_family
    assign body_font = s.body_font_family

    assign h_con = s.heading
    assign s_con = s.subheading
    if s.use_metafields
      assign h_con = m.four_blocks_heading | default: s.heading
      assign s_con = m.four_blocks_subheading | default: s.subheading
    endif
  -%}

  <link rel="stylesheet" href="{{ 'typography.css' | asset_url }}" media="all">
  <link rel="stylesheet" href="{{ 'four-blocks.css' | asset_url }}" media="all">
  <script src="{{ 'four-blocks.js' | asset_url }}" defer></script>
  <div
    class="tae-four-blocks tae-four-blocks-{{ block.id | replace: '_', '-' | downcase }}{% unless s.show_border %} tae-four-blocks--no-border{% endunless %} app_blocks_class"
    style="display:block;padding:20px;--product-section-bg:{{ bg_color }};--product-section-opacity:{{ opacity }};--bg-color:{{ bg_color }};--bg-opacity:{{ opacity }};--container-width:{{ s.container_max_width | default: 1250 }}px;--four-blocks-heading-text-color:{{ color }};--four-blocks-image-radius:{{ s.image_radius | default: 50 }}%;--font-heading-family:{% if heading_font != blank and heading_font.family %}{{ heading_font.family }}, {{ heading_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %};--font-body-family:{% if body_font != blank and body_font.family %}{{ body_font.family }}, {{ body_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %};--body-size:{{ s.body_size | default: 16 }}px;--body-weight:{{ s.body_weight | default: 400 }};--h1-size:{{ s.h1_size | default: 48 }}px;--h1-weight:{{ s.h1_weight | default: 700 }};--h2-size:{{ s.h2_size | default: 36 }}px;--h2-weight:{{ s.h2_weight | default: 700 }};--h3-size:{{ s.h3_size | default: 30 }}px;--h3-weight:{{ s.h3_weight | default: 600 }};--h4-size:{{ s.h4_size | default: 24 }}px;--h4-weight:{{ s.h4_weight | default: 600 }};--h5-size:{{ s.h5_size | default: 20 }}px;--h5-weight:{{ s.h5_weight | default: 500 }};--h6-size:{{ s.h6_size | default: 16 }}px;--h6-weight:{{ s.h6_weight | default: 500 }};"
  >
    {%- if h_con != blank or s_con != blank -%}
      <div class="tae-four-blocks-heading-wrapper">
        {%- if h_con != blank -%}
          <h3 class="tae-four-blocks-main-heading">{{ h_con }}</h3>
        {%- endif -%}
        {%- if s_con != blank -%}
          <div class="tae-four-blocks-main-subheading">
            <p>{{ s_con }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="tae-four-blocks-container">
      <div class="tae-four-blocks-carousel" data-carousel>
        <div class="tae-four-blocks-grid" data-track>
          {%- for i in (1..4) -%}
            {%- liquid
              assign ik = 'block_' | append: i | append: '_image'
              assign hk = 'block_' | append: i | append: '_heading'
              assign sk = 'block_' | append: i | append: '_subheading'
              assign mk = 'product_highlight_' | append: i
              assign image = m[mk] | default: m[mk] | default: s[ik]
              assign name = s[hk]
              assign desc = s[sk]
              if s.use_metafields
                assign nk = 'four_blocks_block_' | append: i | append: '_name'
                assign dk = 'four_blocks_block_' | append: i | append: '_desc'
                assign name = m[nk] | default: m[nk] | default: name
                assign desc = m[dk] | default: m[dk] | default: desc
              endif
            -%}
            {%- if image != blank or name != blank or desc != blank -%}
              <div class="tae-four-blocks-item tae-four-blocks-item--{{ layout | replace: '_', '-' }} tae-four-blocks-text-{{ align }}">
                <div class="tae-four-blocks-image-wrapper">
                  {%- if image != blank -%}
                    <img
                      src="{{ image | image_url: width: 200 }}"
                      srcset="{{ image | image_url: width: 100 }} 100w, {{ image | image_url: width: 200 }} 200w, {{ image | image_url: width: 300 }} 300w"
                      sizes="200px"
                      alt="{{ image.alt | default: name }}"
                      loading="lazy"
                      width="200"
                      height="200"
                      class="tae-four-blocks-image"
                    >
                  {%- else -%}
                    {% render 'snippets/image-svg' %}
                  {%- endif -%}
                </div>
                {%- if name != blank or desc != blank -%}
                  {%- if layout == 'layout_2' -%}<div class="tae-four-blocks-text-card">{%- endif -%}
                  {%- if name != blank -%}
                    <h5 class="tae-four-blocks-item-heading">{{ name }}</h5>
                  {%- endif -%}
                  {%- if desc != blank -%}
                    <p class="tae-four-blocks-item-subheading">{{ desc }}</p>
                  {%- endif -%}
                  {%- if layout == 'layout_2' -%}</div>{%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="tae-four-blocks-nav" aria-hidden="true">
          <button
            class="tae-four-blocks-nav-btn tae-four-blocks-nav-btn--prev"
            type="button"
            data-prev
            aria-label="Previous"
          >
            ‹
          </button>
          <button
            class="tae-four-blocks-nav-btn tae-four-blocks-nav-btn--next"
            type="button"
            data-next
            aria-label="Next"
          >
            ›
          </button>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
