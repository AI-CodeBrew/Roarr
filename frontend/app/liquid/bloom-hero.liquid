<script>
(function () {
  var root = document.getElementById("bl-hero");
  if (!root || root.dataset.blReady) return;
  root.dataset.blReady = "1";
  var sample = root.dataset.money || "";
  var mm = sample.match(/^(.*?)([0-9][0-9.,\u00a0\u202f' ]*[0-9])(.*)$/);
  var pre = mm ? mm[1] : "", suf = mm ? mm[3] : "", num = mm ? mm[2] : "1,234.56";
  var dm = num.match(/([.,])(\d{1,2})$/);
  var dsep = dm ? dm[1] : "", dlen = dm ? dm[2].length : 0;
  var tm = num.replace(dm ? dm[0] : "", "").match(/[^0-9]/);
  var tsep = tm ? tm[0] : "";
  function fmt(c) {
    var v = (c / 100).toFixed(dlen).split(".");
    return pre + v[0].replace(/\B(?=(\d{3})+(?!\d))/g, tsep) + (dlen ? dsep + v[1] : "") + suf;
  }
  var qty = 2, sub = !!root.querySelector('input[value="sub"]:checked');
  var variantEl = root.querySelector("[data-bl-variant]");
  function opt() { return variantEl && variantEl.tagName === "SELECT" ? variantEl.options[variantEl.selectedIndex] : variantEl; }
  function num2(v) { v = parseInt(v, 10); return isNaN(v) ? 0 : v; }
  function paint() {
    var o = opt(), unit = o ? num2(o.dataset.price) : num2(root.dataset.unit);
    var cmp = o ? num2(o.dataset.compare) : 0, sp = o ? num2(o.dataset.sub) : 0;
    var set = function (sel, txt) { var e = root.querySelector(sel); if (e) e.textContent = txt; };
    set("[data-bl-price]", fmt(unit));
    var c = root.querySelector("[data-bl-compare]"), s = root.querySelector("[data-bl-save]");
    if (c) { c.hidden = !(cmp > unit); c.textContent = cmp > unit ? fmt(cmp) : ""; }
    if (s) { s.hidden = !(cmp > unit); if (cmp > unit) s.textContent = s.dataset.label + " " + Math.round((cmp - unit) * 100 / cmp) + "%"; }
    set("[data-bl-once]", fmt(unit * qty));
    var useSub = sub && sp > 0;
    if (sp > 0) {
      set("[data-bl-sub]", fmt(sp * qty)); set("[data-bl-sub-unit]", fmt(sp));
      var sv = root.querySelector("[data-bl-sub-save]");
      if (sv) { sv.hidden = !(sp < unit); sv.textContent = (root.querySelector("[data-bl-save]") || sv).dataset.label + " " + Math.round((unit - sp) * 100 / unit) + "%"; }
    }
    set("[data-bl-total]", fmt((useSub ? sp : unit) * qty));
    set("[data-bl-dock-price]", fmt((useSub ? sp : unit) * qty));
    var ql = root.querySelector("[data-bl-qty-label]"); if (ql) ql.textContent = qty + " " + ql.dataset.short;
    var qi = root.querySelector("[data-bl-qty-input]"); if (qi) qi.value = qty;
    root.querySelectorAll("[data-bl-qty]").forEach(function (b) { var on = +b.dataset.blQty === qty; b.classList.toggle("is-on", on); b.setAttribute("aria-checked", on); });
    root.querySelectorAll("[data-bl-opt]").forEach(function (l) { l.classList.toggle("is-on", (l.dataset.blOpt === "sub") === sub); });
    var plan = root.querySelector("[data-bl-plan]"); if (plan) plan.disabled = !sub;
  }
  root.querySelectorAll("[data-bl-qty]").forEach(function (b) { b.addEventListener("click", function () { qty = +b.dataset.blQty; paint(); }); });
  root.querySelectorAll("[data-bl-opt]").forEach(function (l) { l.addEventListener("click", function () { sub = l.dataset.blOpt === "sub"; var r = l.querySelector("input"); if (r) r.checked = true; paint(); }); });
  if (variantEl && variantEl.tagName === "SELECT") variantEl.addEventListener("change", paint);
  root.querySelectorAll("[data-bl-tab]").forEach(function (t) {
    t.addEventListener("click", function () {
      root.querySelectorAll("[data-bl-tab]").forEach(function (x) { var on = x === t; x.classList.toggle("is-on", on); x.setAttribute("aria-selected", on); });
      root.querySelectorAll("[data-bl-pane]").forEach(function (p) { p.hidden = p.dataset.blPane !== t.dataset.blTab; });
    });
  });
  var main = root.querySelector("[data-bl-main]");
  root.querySelectorAll("button.bl-hero__thumb").forEach(function (t) {
    t.addEventListener("click", function () {
      if (!main) return;
      root.querySelectorAll("button.bl-hero__thumb").forEach(function (x) { x.classList.toggle("is-on", x === t); });
      main.classList.add("is-swap");
      setTimeout(function () { main.src = t.dataset.src; main.classList.remove("is-swap"); }, 180);
    });
  });
  var dock = root.querySelector("[data-bl-dock]"), cta = root.querySelector("[data-bl-cta]"), dockBtn = root.querySelector("[data-bl-dock-btn]");
  if (dock && cta && "IntersectionObserver" in window) {
    var setDock = function (on) { dock.classList.toggle("is-on", on); dock.setAttribute("aria-hidden", on ? "false" : "true"); if (dockBtn) dockBtn.tabIndex = on ? 0 : -1; };
    new IntersectionObserver(function (en) { setDock(!en[0].isIntersecting && en[0].boundingClientRect.top < 0); }).observe(cta);
    if (dockBtn) dockBtn.addEventListener("click", function () { cta.click(); });
  }
  paint();
})();
</script>
{%- endcapture -%}
