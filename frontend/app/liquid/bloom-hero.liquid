{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap">
{%- assign m = product.metafields.roarr -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign p1 = m.bloom_perk_1.value | default: m.bloom_perk_1 | default: 'Free Shipping' -%}
{%- assign p2 = m.bloom_perk_2.value | default: m.bloom_perk_2 | default: 'Fastest delivery' -%}
{%- assign p3 = m.bloom_perk_3.value | default: m.bloom_perk_3 | default: 'Full Refund Guarantee' -%}
{%- assign b1 = m.bloom_badge_1.value | default: m.bloom_badge_1 -%}
{%- assign b2 = m.bloom_badge_2.value | default: m.bloom_badge_2 -%}
{%- assign b3 = m.bloom_badge_3.value | default: m.bloom_badge_3 -%}
{%- assign b4 = m.bloom_badge_4.value | default: m.bloom_badge_4 -%}
{%- assign c1 = m.bloom_chip_1.value | default: m.bloom_chip_1 -%}
{%- assign c2 = m.bloom_chip_2.value | default: m.bloom_chip_2 -%}
{%- assign c3 = m.bloom_chip_3.value | default: m.bloom_chip_3 -%}
{%- assign c4 = m.bloom_chip_4.value | default: m.bloom_chip_4 -%}
{%- assign seal = m.bloom_seal_text.value | default: m.bloom_seal_text -%}
{%- assign tab_desc = m.bloom_tab_desc.value | default: m.bloom_tab_desc -%}
{%- assign tab_ben = m.bloom_tab_benefits.value | default: m.bloom_tab_benefits -%}
{%- assign tab_ing = m.bloom_tab_ingredients.value | default: m.bloom_tab_ingredients -%}
{%- assign tab_1 = m.bloom_tab_1_label.value | default: m.bloom_tab_1_label | default: 'Description' -%}
{%- assign tab_2 = m.bloom_tab_2_label.value | default: m.bloom_tab_2_label | default: 'Benefits' -%}
{%- assign tab_3 = m.bloom_tab_3_label.value | default: m.bloom_tab_3_label | default: 'Ingredients' -%}
{%- assign qty_head = m.bloom_qty_heading.value | default: m.bloom_qty_heading | default: 'Select your Quantity' -%}
{%- assign qty_unit = m.bloom_qty_unit.value | default: m.bloom_qty_unit | default: 'Package' -%}
{%- assign qty_short = m.bloom_qty_short.value | default: m.bloom_qty_short | default: 'Pack' -%}
{%- assign best = m.bloom_best_deal.value | default: m.bloom_best_deal | default: 'Best Deal' -%}
{%- assign once_t = m.bloom_onetime_title.value | default: m.bloom_onetime_title | default: 'One Time Purchase' -%}
{%- assign once_n = m.bloom_onetime_note.value | default: m.bloom_onetime_note | default: 'Received a single package' -%}
{%- assign sub_t = m.bloom_sub_title.value | default: m.bloom_sub_title | default: 'Flexible Subscription' -%}
{%- assign sub_from = m.bloom_sub_from.value | default: m.bloom_sub_from | default: 'Starting at' -%}
{%- assign sub_per = m.bloom_sub_per.value | default: m.bloom_sub_per | default: 'month' -%}
{%- assign save_lbl = m.bloom_save_label.value | default: m.bloom_save_label | default: 'Save' -%}
{%- assign low_t = m.bloom_low_stock.value | default: m.bloom_low_stock | default: 'Hurry Up! Low in stock' -%}
{%- assign g_bold = m.bloom_guarantee_bold.value | default: m.bloom_guarantee_bold -%}
{%- assign g_text = m.bloom_guarantee_text.value | default: m.bloom_guarantee_text -%}
{%- assign proof = m.bloom_proof_line.value | default: m.bloom_proof_line -%}
{%- assign proof_lbl = m.bloom_proof_label.value | default: m.bloom_proof_label | default: 'Positive Reviews' -%}
{%- assign av1 = m.bloom_avatar_1.value | default: m.bloom_avatar_1 -%}
{%- assign av2 = m.bloom_avatar_2.value | default: m.bloom_avatar_2 -%}
{%- assign av3 = m.bloom_avatar_3.value | default: m.bloom_avatar_3 -%}
{%- assign av4 = m.bloom_avatar_4.value | default: m.bloom_avatar_4 -%}
{%- assign i1 = m.product_image_1.value | default: m.product_image_1 -%}
{%- assign i2 = m.product_image_2.value | default: m.product_image_2 -%}
{%- assign i3 = m.product_image_3.value | default: m.product_image_3 -%}
{%- assign i4 = m.product_image_4.value | default: m.product_image_4 -%}
{%- assign i5 = m.product_image_5.value | default: m.product_image_5 -%}
{%- comment -%} Gallery pictures: real product media first, generated pictures when there is none. {%- endcomment -%}
{%- if product.media.size > 0 -%}
  {%- assign main_src = product.media.first.preview_image | default: product.media.first -%}
{%- else -%}
  {%- assign main_src = i1 -%}
{%- endif -%}
{%- assign seal_up = seal | upcase | split: ' ' -%}
{%- assign seal_top = seal_up.first -%}
{%- assign seal_bot = seal | upcase | remove_first: seal_top | strip -%}
{%- if seal_bot == blank -%}{%- assign seal_bot = seal_top -%}{%- assign seal_top = '' -%}{%- endif -%}
{%- assign has_desc = tab_desc -%}
{%- if has_desc == blank and product.description != blank -%}{%- assign has_desc = product.description | strip_html | truncatewords: 55 -%}{%- endif -%}
{%- assign unit_price = variant.price -%}
{%- assign tab_count = 0 -%}
{%- if has_desc != blank -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}
{%- if tab_ben != blank -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}
{%- if tab_ing != blank -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}
{%- assign rating = product.metafields.reviews.rating.value -%}
{%- assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count -%}
{%- assign rating_scale = rating.scale_max.value | default: rating.scale_max | default: 5 -%}
{%- assign rating_value = rating.rating.value | default: rating.rating | default: rating.value -%}
{%- assign rating_pct = 0 -%}
{%- if rating_value != blank -%}{%- assign rating_pct = rating_value | times: 100.0 | divided_by: rating_scale | round -%}{%- endif -%}
{%- assign save_pct = 0 -%}
{%- if product.compare_at_price > product.price -%}{%- assign save_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round -%}{%- endif -%}


{%- assign sub_price = unit_price | times: 90 | divided_by: 100 -%}
{%- assign sub_pct = 10 -%}

<section class="bloom bl-hero" id="bl-hero" data-money="{{ 123456 | money }}" data-unit="{{ unit_price }}">
  <div class="bl-wrap bl-hero__grid">
    <div class="bl-hero__media">
      <div class="bl-hero__panel">
        <ul class="bl-hero__rail" role="list">
        {%- if b1 != blank -%}<li><span class="bl-hero__badge"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span><span class="bl-hero__badge-t">{{ b1 }}</span></li>{%- endif -%}
        {%- if b2 != blank -%}<li><span class="bl-hero__badge"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19C5 10 10 5 20 4c0 10-5 15-14 15z"/><path d="M5 19c3-5 6-8 11-11"/></svg></span><span class="bl-hero__badge-t">{{ b2 }}</span></li>{%- endif -%}
        {%- if b3 != blank -%}<li><span class="bl-hero__badge"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c1 4 5 5 5 10a5 5 0 01-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 1-9z"/></svg></span><span class="bl-hero__badge-t">{{ b3 }}</span></li>{%- endif -%}
        {%- if b4 != blank -%}<li><span class="bl-hero__badge"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 01-12 0c0-4.5 6-11 6-11z"/></svg></span><span class="bl-hero__badge-t">{{ b4 }}</span></li>{%- endif -%}
        </ul>
        <div class="bl-hero__stage">
          {%- if main_src != blank -%}<img class="bl-fade" data-bl-main src="{{ main_src | image_url: width: 1400 }}" alt="{{ product.title | escape }}">{%- endif -%}
        </div>
        {%- if seal != blank -%}
        <div class="bl-hero__seal">
          <svg class="bl-seal" viewBox="0 0 100 100" aria-hidden="true">
            <defs><path id="bl-seal-top-h" d="M 16 50 A 34 34 0 0 1 84 50"/><path id="bl-seal-bot-h" d="M 11 50 A 39 39 0 0 0 89 50"/></defs>
            <circle cx="50" cy="50" r="47" fill="#fff" stroke="currentColor" stroke-width="1.6"/><circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="1"/>
            <text font-size="8.6" font-weight="700" letter-spacing="1.4" fill="currentColor"><textPath href="#bl-seal-top-h" startOffset="50%" text-anchor="middle">{{ seal_top }}</textPath></text>
            <text font-size="8.6" font-weight="700" letter-spacing="1.4" fill="currentColor"><textPath href="#bl-seal-bot-h" startOffset="50%" text-anchor="middle">{{ seal_bot }}</textPath></text>
            <g transform="translate(35 35) scale(1.25)" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M10.5 3v6.5L6.5 17a2 2 0 001.7 3h7.6a2 2 0 001.7-3l-4-7.500V3"/><path d="M8.500 14h7"/></g>
          </svg>
        </div>
        {%- endif -%}
      </div>
      <div class="bl-hero__thumbs">
        {%- for i in (1..5) -%}
          {%- if product.media.size > 0 -%}
            {%- assign t_idx = i | minus: 1 -%}{%- assign t_m = product.media[t_idx] -%}{%- assign t_src = t_m.preview_image | default: t_m -%}
          {%- else -%}
            {%- assign t_key = 'product_image_' | append: i -%}{%- assign t_src = m[t_key].value | default: m[t_key] -%}
          {%- endif -%}
          {%- if t_src != blank -%}
            <button type="button" class="bl-hero__thumb{% if i == 1 %} is-on{% endif %}" data-src="{{ t_src | image_url: width: 1400 }}" aria-label="{{ product.title | escape }} {{ i }}"><img src="{{ t_src | image_url: width: 240 }}" alt="" loading="lazy"></button>
          {%- else -%}
            <span class="bl-hero__thumb bl-hero__thumb--empty" aria-hidden="true"></span>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <ul class="bl-hero__chips" role="list">
        {%- if c1 != blank -%}<li><span class="bl-hero__chip-i"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 00-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0012 3z"/></svg></span><span>{{ c1 }}</span></li>{%- endif -%}
        {%- if c2 != blank -%}<li><span class="bl-hero__chip-i"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1"/></svg></span><span>{{ c2 }}</span></li>{%- endif -%}
        {%- if c3 != blank -%}<li><span class="bl-hero__chip-i"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L5 13h6l-1 9 8-11h-6l1-9z"/></svg></span><span>{{ c3 }}</span></li>{%- endif -%}
        {%- if c4 != blank -%}<li><span class="bl-hero__chip-i"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 14a4.5 4.5 0 008 0M9 9.5v.5M15 9.5v.5"/></svg></span><span>{{ c4 }}</span></li>{%- endif -%}
      </ul>
    </div>

    <div class="bl-hero__details">


      <p class="bl-hero__low"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c1 4 5 5 5 10a5 5 0 01-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 1-9z"/></svg><span>{{ low_t }}</span></p>

      {%- if rating_value != blank and rating_count != blank -%}
        <p class="bl-hero__rating"><span class="bl-hero__stars" style="--p:{{ rating_pct }}%" role="img" aria-label="{{ rating_value }} / {{ rating_scale }}">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span>{{ rating_count }} reviews</span></p>
      {%- endif -%}
      <h1 class="bl-hero__title bl-serif">{{ product.title }}</h1>
      <ul class="bl-hero__perks" role="list">
        {%- if p1 != blank -%}<li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><span>{{ p1 }}</span></li>{%- endif -%}
        {%- if p2 != blank -%}<li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="17" r="2.5"/><circle cx="18" cy="17" r="2.5"/><path d="M8.5 17H14l2-8h3M12 9h3"/></svg><span>{{ p2 }}</span></li>{%- endif -%}
        {%- if p3 != blank -%}<li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></svg><span>{{ p3 }}</span></li>{%- endif -%}
      </ul>
      <div class="bl-hero__pricebox">
        <strong class="bl-hero__price" data-bl-price>{{ unit_price | money }}</strong>
        <s class="bl-hero__compare" data-bl-compare{% unless product.compare_at_price > product.price %} hidden{% endunless %}>{%- if product.compare_at_price > product.price -%}{{ product.compare_at_price | money }}{%- endif -%}</s>
        <span class="bl-hero__save" data-bl-save data-label="{{ save_lbl | escape }}"{% if save_pct < 1 %} hidden{% endif %}>{{ save_lbl }} {{ save_pct }}%</span>
      </div>
      {%- if tab_count > 0 -%}
      <div class="bl-hero__tabs" role="tablist">
        {%- assign first_tab = true -%}
        {%- if has_desc != blank -%}<button type="button" role="tab" class="bl-hero__tab is-on" data-bl-tab="desc" aria-selected="true">{{ tab_1 }}</button>{%- assign first_tab = false -%}{%- endif -%}
        {%- if tab_ben != blank -%}<button type="button" role="tab" class="bl-hero__tab{% if first_tab %} is-on{% endif %}" data-bl-tab="ben" aria-selected="{{ first_tab }}">{{ tab_2 }}</button>{%- assign first_tab = false -%}{%- endif -%}
        {%- if tab_ing != blank -%}<button type="button" role="tab" class="bl-hero__tab{% if first_tab %} is-on{% endif %}" data-bl-tab="ing" aria-selected="{{ first_tab }}">{{ tab_3 }}</button>{%- endif -%}
      </div>
      <div class="bl-hero__panelbox">
        {%- assign first_tab = true -%}
        {%- if has_desc != blank -%}<p data-bl-pane="desc">{{ has_desc }}</p>{%- assign first_tab = false -%}{%- endif -%}
        {%- if tab_ben != blank -%}<p data-bl-pane="ben"{% unless first_tab %} hidden{% endunless %}>{{ tab_ben }}</p>{%- assign first_tab = false -%}{%- endif -%}
        {%- if tab_ing != blank -%}<p data-bl-pane="ing"{% unless first_tab %} hidden{% endunless %}>{{ tab_ing }}</p>{%- endif -%}
      </div>
      {%- endif -%}

      <div class="bl-hero__form">
        {%- if product.variants.size > 1 -%}
          <label class="bl-hero__label" for="bl-variant">{{ product.options | join: ' / ' }}</label>
          <div class="bl-select">
            <select id="bl-variant" name="id" data-bl-variant>
              {%- for v in product.variants -%}
                {%- assign v_sub = v.selling_plan_allocations.first.price -%}
                <option value="{{ v.id }}" data-price="{{ v.price }}" data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price }}{% endif %}" data-sub="{{ v_sub }}"{% if v.id == variant.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ variant.id }}" data-bl-variant data-price="{{ variant.price }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price }}{% endif %}" data-sub="{{ sub_price }}">
        {%- endif -%}

        <p class="bl-hero__qtyhead"><b>{{ qty_head }}</b> <span data-bl-qty-label data-short="{{ qty_short | escape }}">2 {{ qty_short }}</span></p>
        <input type="hidden" name="quantity" value="2" data-bl-qty-input>
        <div class="bl-hero__qty" role="radiogroup" aria-label="{{ qty_head | escape }}">
          <button type="button" class="bl-qty" data-bl-qty="1" role="radio" aria-checked="false"><span class="bl-qty__imgs"><img class="bl-fade" src="{{ main_src | image_url: width: 120 }}" alt="" loading="lazy"></span><span class="bl-qty__t">1 {{ qty_unit }}</span></button>
          <button type="button" class="bl-qty is-on" data-bl-qty="2" role="radio" aria-checked="true"><span class="bl-qty__tag">{{ best }}</span><span class="bl-qty__imgs"><img class="bl-fade" src="{{ main_src | image_url: width: 120 }}" alt="" loading="lazy"><img class="bl-fade" src="{{ main_src | image_url: width: 120 }}" alt="" loading="lazy"></span><span class="bl-qty__t">2 {{ qty_unit }}</span></button>
          <button type="button" class="bl-qty" data-bl-qty="3" role="radio" aria-checked="false"><span class="bl-qty__imgs"><img class="bl-fade" src="{{ main_src | image_url: width: 120 }}" alt="" loading="lazy"><img class="bl-fade" src="{{ main_src | image_url: width: 120 }}" alt="" loading="lazy"><img class="bl-fade" src="{{ main_src | image_url: width: 120 }}" alt="" loading="lazy"></span><span class="bl-qty__t">3 {{ qty_unit }}</span></button>
        </div>


        <div class="bl-opts">
          <label class="bl-opt{% if false %} is-on{% endif %}" data-bl-opt="once">
            <input class="bl-sr" type="radio" name="bl_purchase" value="once">
            <span class="bl-opt__radio" aria-hidden="true"></span>
            <span class="bl-opt__text"><b>{{ once_t }}</b><small>{{ once_n }}</small></span>
            <span class="bl-opt__price"><b data-bl-once>{{ unit_price | times: 2 | money }}</b></span>
          </label>
          <label class="bl-opt" data-bl-opt="sub">
            <input class="bl-sr" type="radio" name="bl_purchase" value="sub" checked>
            <span class="bl-opt__radio" aria-hidden="true"></span>
            <span class="bl-opt__text"><b>{{ sub_t }}</b><small>{{ sub_from }} <span data-bl-sub-unit>{{ sub_price | money }}</span>/{{ sub_per }}</small></span>
            <span class="bl-opt__price"><b data-bl-sub>{{ sub_price | times: 2 | money }}</b><small data-bl-sub-save{% if sub_pct < 1 %} hidden{% endif %}>{{ save_lbl }} {{ sub_pct }}%</small></span>
            <span class="bl-opt__select bl-select">

              <select name="selling_plan" data-bl-plan aria-label="{{ sub_t | escape }}"><option value="1">Deliver every month</option><option value="2">Deliver every 2 months</option></select>


            </span>
          </label>
        </div>


        <button class="bl-btn bl-hero__cta" type="button" data-bl-cta{% if variant.available == false %} disabled{% endif %}>
          {%- if variant.available != false -%}<span>{% render 'snippets/roarr-ui-string', key: 'add_to_cart' %}</span> - <span data-bl-total>{{ unit_price | times: 2 | money }}</span>{%- else -%}{% render 'snippets/roarr-ui-string', key: 'sold_out' %}{%- endif -%}
        </button>
      </div>
      {%- if g_bold != blank or g_text != blank -%}
      <p class="bl-hero__guarantee"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5l2.3 1.7 2.8-.1 1 2.7 2.3 1.7-.9 2.7.9 2.7-2.3 1.7-1 2.7-2.8-.1L12 21.5l-2.3-1.7-2.8.1-1-2.7-2.3-1.7.9-2.7-.9-2.7 2.3-1.7 1-2.7 2.8.1L12 2.5z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg><span><b>{{ g_bold }}</b> {{ g_text }}</span></p>
      {%- endif -%}
      {%- if proof != blank or rating_value != blank -%}
      <div class="bl-hero__proof">
        {%- if rating_value != blank -%}
          <span class="bl-hero__stars bl-hero__stars--c" style="--p:{{ rating_pct }}%" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          {%- if rating_count != blank -%}<a class="bl-hero__proof-link" href="#bl-reviews">({{ rating_count }} {{ proof_lbl }})</a>{%- endif -%}
        {%- endif -%}
        {%- if proof != blank -%}<p>&ldquo;{{ proof }}&rdquo;</p>{%- endif -%}
        {%- if av1 != blank or av2 != blank or av3 != blank or av4 != blank -%}
          <span class="bl-hero__avatars">
            {%- if av1 != blank -%}<img src="{{ av1 | image_url: width: 120 }}" alt="" loading="lazy">{%- endif -%}
            {%- if av2 != blank -%}<img src="{{ av2 | image_url: width: 120 }}" alt="" loading="lazy">{%- endif -%}
            {%- if av3 != blank -%}<img src="{{ av3 | image_url: width: 120 }}" alt="" loading="lazy">{%- endif -%}
            {%- if av4 != blank -%}<img src="{{ av4 | image_url: width: 120 }}" alt="" loading="lazy">{%- endif -%}
          </span>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </div>
  {%- capture mq_items -%}
