  .bl-hero__marquee { overflow: hidden; background: linear-gradient(90deg, #3D1229, #5A1A3C 50%, #3D1229); color: #FBD3E3; padding: 15px 0; }
  .bl-hero__mq-track { display: flex; width: max-content; animation: bl-mq 46s linear infinite; }
  .bl-hero__marquee:hover .bl-hero__mq-track { animation-play-state: paused; }
