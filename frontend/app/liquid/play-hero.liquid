{%- capture kl_rtl_html -%}
{% render 'snippets/play-fonts' %}
{%- assign m = product.metafields.kluck_ai -%}
{%- assign subtitle = m.product_subtitle.value | default: m.product_subtitle -%}
{%- assign img1 = m.product_image_1.value | default: m.product_image_1 -%}
{%- assign img2 = m.product_image_2.value | default: m.product_image_2 -%}
{%- assign img3 = m.product_image_3.value | default: m.product_image_3 -%}
{%- assign img4 = m.product_image_4.value | default: m.product_image_4 -%}
<section class="pk-hero-band">
  <div class="pk-hero-card">
    <div class="pk-hero">
      <div>
        <div class="pk-gallery">
          <span class="pk-badge">Save<br>50%</span>
          {%- if img1 != blank -%}<img class="pk-hero-photo" id="pk-hero-main" src="{{ img1 }}" alt="{{ product.title }}">{%- endif -%}
        </div>
        <div class="pk-thumbs">
          {%- if img1 != blank -%}<button type="button" class="pk-thumb is-on" data-src="{{ img1 }}" aria-label="Show image 1"><img src="{{ img1 }}" alt=""></button>{%- endif -%}
          {%- if img2 != blank -%}<button type="button" class="pk-thumb" data-src="{{ img2 }}" aria-label="Show image 2"><img src="{{ img2 }}" alt=""></button>{%- endif -%}
          {%- if img3 != blank -%}<button type="button" class="pk-thumb" data-src="{{ img3 }}" aria-label="Show image 3"><img src="{{ img3 }}" alt=""></button>{%- endif -%}
          {%- if img4 != blank -%}<button type="button" class="pk-thumb" data-src="{{ img4 }}" aria-label="Show image 4"><img src="{{ img4 }}" alt=""></button>{%- endif -%}
        </div>
      </div>
      <div>
        <p class="pk-kicker">Kids toys</p>
        <h1>{{ product.title }}</h1>
        <div class="pk-price">
          <strong>{{ product.price | money }}</strong>
          {%- if product.compare_at_price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
        </div>
        <div class="pk-variants">
          {%- for v in product.variants -%}
            {%- unless v.title == 'Default' or v.title == 'Default Title' -%}
              <span class="{% if forloop.first %}on{% endif %}">{{ v.title }}</span>
            {%- endunless -%}
          {%- endfor -%}
        </div>
        {% render 'bundle', product: product %}
        <div class="pk-buy">
          <div class="pk-qty">
            <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
            <b data-qty>1</b>
            <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
          </div>
          <button class="pk-atc" type="button">{% render 'snippets/kluck-ui-string', key: 'add_to_cart' %}</button>
        </div>
        {%- if subtitle != blank -%}<p class="pk-sub">{{ subtitle }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>
  .pk-hero-band { background: #FFFCF5 url("https://cdn.shopify.com/s/files/1/0446/8228/1123/files/product-bg.png?v=1726116403") center / cover no-repeat; padding: 72px 0; color: #6F2424; font-family: Poppins, sans-serif; overflow-x: clip; max-width: 100%; }
  .pk-hero-card { width: min(1100px, calc(100% - 48px)); margin: 0 auto; background: #fff; border: 1px solid #6F2424; border-radius: 20px; padding: 40px 48px; box-sizing: border-box; }
  .pk-hero { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 36px; align-items: center; }
  .pk-hero > * { min-width: 0; }
  .pk-gallery { position: relative; max-width: 100%; }
  .pk-hero-photo { width: 100%; max-width: 100%; height: auto; max-height: 420px; object-fit: contain; border-radius: 20px; }
  .pk-badge { position: absolute; top: 18px; inset-inline-start: 18px; width: 121px; height: 121px; display: grid; place-items: center; text-align: center; color: #fff; background: url("https://cdn.shopify.com/s/files/1/0446/8228/1123/files/sale-badge.png?v=1726541080") center / cover no-repeat; font-family: "Caveat Brush", cursive !important; font-size: 28px; line-height: 0.95; transform: rotate(-21deg); }
  .pk-thumbs { display: flex; gap: 10px; margin-top: 12px; min-width: 0; max-width: 100%; }
  .pk-thumb { flex: 1 1 0; min-width: 0; max-width: 72px; padding: 0; border: 2px solid transparent; border-radius: 14px; background: #fff; cursor: pointer; line-height: 0; }
  .pk-thumb.is-on { border-color: #6F2424; }
  .pk-thumb img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 12px; display: block; }
  .pk-kicker { letter-spacing: 0.08em; text-transform: uppercase; font-size: 12px; font-weight: 600; margin: 0 0 8px; }
  .pk-hero h1 { font-family: "Caveat Brush", cursive !important; font-weight: 400; font-size: 48px; line-height: 1.05; margin: 0; color: #6F2424; }
  .pk-price { display: flex; align-items: baseline; gap: 12px; margin: 16px 0; }
  .pk-price strong { font-size: 28px; }
  .pk-price s { color: #b08989; font-size: 18px; }
  .pk-variants { display: flex; gap: 8px; margin: 8px 0 18px; flex-wrap: wrap; }
  .pk-variants span { border: 1.5px solid #6F2424; border-radius: 999px; padding: 8px 14px; font-size: 13px; }
  .pk-variants span.on { background: #6F2424; color: #fff; }
  .pk-buy { display: flex; gap: 10px; align-items: center; min-width: 0; max-width: 100%; }
  .pk-qty { display: flex; align-items: center; flex: 0 0 auto; border: 1.5px solid #6F2424; border-radius: 999px; overflow: hidden; }
  .pk-qty button, .pk-qty b { width: 42px; height: 52px; display: grid; place-items: center; }
  .pk-qty button { border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; padding: 0; }
  .pk-atc { flex: 1 1 auto; min-width: 0; max-width: 100%; height: 52px; border: 0; border-radius: 999px; background: #6F2424; color: #fff; font: 600 16px Poppins, sans-serif; padding: 0 16px; }
  .pk-sub { margin: 16px 0 0; font-size: 14px; line-height: 1.5; }
  @media (max-width: 800px) {
    .pk-hero { grid-template-columns: 1fr; }
    .pk-hero-band { padding: 28px 0; }
    .pk-hero-card { width: calc(100% - 24px); padding: 16px 12px; }
    .pk-hero h1 { font-size: 42px; overflow-wrap: anywhere; }
    .pk-badge { width: 92px; height: 92px; top: 10px; inset-inline-start: 10px; font-size: 22px; }
  }
</style>
<script>
  (function () {
    var main = document.getElementById("pk-hero-main");
    document.querySelectorAll(".pk-thumb").forEach(function (button) {
      button.addEventListener("click", function (event) {
        event.stopPropagation();
        if (main && button.dataset.src) main.src = button.dataset.src;
        document.querySelectorAll(".pk-thumb").forEach(function (item) {
          item.classList.remove("is-on");
        });
        button.classList.add("is-on");
      });
    });
    document.querySelectorAll(".pk-qty").forEach(function (qty) {
      var label = qty.querySelector("[data-qty]");
      function setQty(next) {
        if (label) label.textContent = String(Math.max(1, next));
      }
      var minus = qty.querySelector("[data-qty-minus]");
      var plus = qty.querySelector("[data-qty-plus]");
      if (minus) {
        minus.addEventListener("click", function () {
          setQty((parseInt(label && label.textContent, 10) || 1) - 1);
        });
      }
      if (plus) {
        plus.addEventListener("click", function () {
          setQty((parseInt(label && label.textContent, 10) || 1) + 1);
        });
      }
    });
  })();
</script>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--play" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: Poppins, "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Caveat Brush", "Lalezar", "Tajawal", cursive !important; line-height: 1.4 !important; font-weight: 400 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
