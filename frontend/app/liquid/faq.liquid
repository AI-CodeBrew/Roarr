{%- assign render_flag = shop.metafields.app.block_control.value -%}
{%- if render_flag == true -%}
{%- liquid
  assign s = block.settings
  assign m = product.metafields.kluck_ai
  assign color_schema = m.color_schema.value | default: m.color_schema | default: '#A34E4E'

  assign opacity_val = s.background_opacity | default: 10 | divided_by: 100.0
  if s.show_background == false
    assign opacity = 0
  else
    assign opacity = opacity_val
  endif
  assign bg_color = s.background_color | default: '#ffffff'
  unless s.use_metafields_bg == false
    if s.use_metafields_bg and product != blank and m.color_schema != blank
      assign bg_color = m.color_schema.value | default: m.color_schema
    elsif s.use_metafields and product != blank and m.color_schema != blank
      assign bg_color = m.color_schema.value | default: m.color_schema
    endif
  endunless

  assign heading_font = s.heading_font_family
  assign body_font = s.body_font_family
-%}

<link rel="stylesheet" href="{{ 'faq.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'typography.css' | asset_url }}" media="all">

<div
  class="tae-faq tae-faq-{{ block.id | replace: '_', '-' | downcase }} app_blocks_class"
  style="display:block; --product-section-bg:{{ bg_color }}; --product-section-opacity:{{ opacity }}; --bg-color:{{ bg_color }}; --bg-opacity:{{ opacity }}; --container-width:{{ s.container_max_width | default: 1250 }}px; --faq-primary-color: {{ color_schema }}; --font-heading-family:{% if heading_font != blank and heading_font.family %}{{ heading_font.family }}, {{ heading_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %}; --font-body-family:{% if body_font != blank and body_font.family %}{{ body_font.family }}, {{ body_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %}; --body-size:{{ s.body_size | default: 16 }}px; --body-weight:{{ s.body_weight | default: 400 }}; --h1-size:{{ s.h1_size | default: 48 }}px; --h1-weight:{{ s.h1_weight | default: 700 }}; --h2-size:{{ s.h2_size | default: 36 }}px; --h2-weight:{{ s.h2_weight | default: 700 }}; --h3-size:{{ s.h3_size | default: 30 }}px; --h3-weight:{{ s.h3_weight | default: 600 }}; --h4-size:{{ s.h4_size | default: 24 }}px; --h4-weight:{{ s.h4_weight | default: 600 }}; --h5-size:{{ s.h5_size | default: 20 }}px; --h5-weight:{{ s.h5_weight | default: 500 }}; --h6-size:{{ s.h6_size | default: 16 }}px; --h6-weight:{{ s.h6_weight | default: 500 }};"
>
  <div class="tae-faq-header">
    <div class="tae-faq-subheading">Got questions?</div>
    <h3 class="tae-faq-heading">
      We've Got <span class="tae-faq-heading-highlight" style="color: {{ color_schema }};">Answers</span>
    </h3>
  </div>

  <div class="tae-faq-accordion">
    {%- for i in (1..5) -%}
      {%- liquid
        assign question_key = 'question_' | append: i
        assign answer_key = 'answer_' | append: i

        if s.use_metafields
          assign question_meta_key = 'faq_question_' | append: i
          assign answer_meta_key = 'faq_answer_' | append: i

          assign question_meta = product.metafields.kluck_ai[question_meta_key]
          assign answer_meta = product.metafields.kluck_ai[answer_meta_key]

          assign question = question_meta.value | default: question_meta | default: s[question_key]
          assign answer = answer_meta.value | default: answer_meta | default: s[answer_key]
        else
          assign question = s[question_key]
          assign answer = s[answer_key]
        endif
      -%}

      {%- if question != blank or answer != blank -%}
        <details class="tae-faq-item">
          <summary>
            <div class="tae-faq-item-header">
              <h5 class="tae-faq-question">{{ question }}</h5>
              <span class="tae-faq-icon">
                {% render 'snippets/accordion-plus-icon' %}
              </span>
            </div>
          </summary>
          <div class="tae-faq-answer rte">
            {{ answer }}
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- unless s.hide_kluck_credit -%}
    <div class="tae-faq-credit">
      Built using <a href="https://kluck.ai" target="_blank" rel="noopener noreferrer">kluck.ai</a>
    </div>
  {%- endunless -%}
</div>
{%- endif -%}
