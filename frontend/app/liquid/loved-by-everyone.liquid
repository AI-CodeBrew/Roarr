{%- assign render_flag = shop.metafields.app.block_control.value -%}
{%- if render_flag == true -%}
{%- liquid
  assign s = block.settings
  assign m = product.metafields.roarr
  assign opacity_val = s.background_opacity | default: 10 | divided_by: 100.0
  if s.show_background == false
    assign opacity = 0
  else
    assign opacity = opacity_val
  endif
  assign bg_color = s.background_color | default: '#ffffff'
  unless s.use_metafields_bg == false
    if s.use_metafields_bg and product != blank and m.color_schema != blank
      assign bg_color = m.color_schema.value | default: m.color_schema
    elsif product != blank and m.color_schema != blank
      assign bg_color = m.color_schema.value | default: m.color_schema
    endif
  endunless

  assign heading_font = s.heading_font_family
  assign body_font = s.body_font_family
-%}
<link rel="stylesheet" href="{{ 'typography.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'image-gallery.css' | asset_url }}" media="all">
<script src="{{ 'image-gallery.js' | asset_url }}" defer></script>

<div class="tae-image-gallery tae-image-gallery-{{ block.id | replace: '_', '-' | downcase }} app_blocks_class" style="display:block;--product-section-bg:{{ bg_color }};--product-section-opacity:{{ opacity }};--bg-color:{{ bg_color }};--bg-opacity:{{ opacity }};--container-width:{{ s.container_max_width | default: 1250 }}px;--font-heading-family:{% if heading_font != blank and heading_font.family %}{{ heading_font.family }}, {{ heading_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %};--font-body-family:{% if body_font != blank and body_font.family %}{{ body_font.family }}, {{ body_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %};--body-size:{{ s.body_size | default: 16 }}px;--body-weight:{{ s.body_weight | default: 400 }};--h1-size:{{ s.h1_size | default: 48 }}px;--h1-weight:{{ s.h1_weight | default: 700 }};--h2-size:{{ s.h2_size | default: 36 }}px;--h2-weight:{{ s.h2_weight | default: 700 }};--h3-size:{{ s.h3_size | default: 30 }}px;--h3-weight:{{ s.h3_weight | default: 600 }};--h4-size:{{ s.h4_size | default: 24 }}px;--h4-weight:{{ s.h4_weight | default: 600 }};--h5-size:{{ s.h5_size | default: 20 }}px;--h5-weight:{{ s.h5_weight | default: 500 }};--h6-size:{{ s.h6_size | default: 16 }}px;--h6-weight:{{ s.h6_weight | default: 500 }};">
  <div class="tae-image-gallery-container">

    {% if block.settings.heading != blank %}
      <div class="tae-image-gallery-heading">
        <h3>{{ block.settings.heading }}</h3>
      </div>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="tae-image-gallery-subheading">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    <div class="tae-image-gallery-carousel" data-carousel>
      <div class="tae-image-gallery-track" data-track>
        {% for i in (1..3) %}
          {%- liquid
            assign img_key = 'image_' | append: i
            assign img = blank
            assign meta_key = 'happy_customer_image_' | append: i
            assign img_meta = product.metafields.roarr[meta_key]
            if img_meta
              assign img = img_meta.value | default: img_meta
            endif
            if block.settings[img_key] != blank
              assign img = block.settings[img_key]
            endif
          -%}

          {% if img != blank %}
            <div class="tae-image-gallery-slide">
              <img
                src="{{ img | image_url: width: 600 }}"
                srcset="{{ img | image_url: width: 300 }} 300w,
                        {{ img | image_url: width: 600 }} 600w,
                        {{ img | image_url: width: 900 }} 900w"
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt="{{ img.alt | default: 'Gallery image ' | append: i }}"
                loading="lazy"
                width="600"
                height="600"
              >
            </div>
          {% else %}
            <div class="tae-image-gallery-slide">
              {% render 'snippets/image-svg' %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="tae-image-gallery-dots" data-dots></div>
    </div>
  </div>
</div>
{%- endif -%}
