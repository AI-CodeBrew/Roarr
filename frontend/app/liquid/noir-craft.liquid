{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Manrope:wght@400;500;600;700&display=swap">
{%- assign m = product.metafields.roarr -%}
{%- assign eyebrow = m.noir_craft_eyebrow.value | default: m.noir_craft_eyebrow | default: 'The craft' -%}
{%- assign heading = m.noir_craft_heading.value | default: m.noir_craft_heading | default: 'Every detail, considered' -%}
{%- assign text = m.noir_craft_text.value | default: m.noir_craft_text | default: 'Chosen materials, careful finishing and a design that earns its place in your day.' -%}
{%- assign c1 = m.noir_craft_1_title.value | default: m.noir_craft_1_title | default: 'Chosen materials' -%}
{%- assign c1t = m.noir_craft_1_text.value | default: m.noir_craft_1_text | default: 'Selected for how they look, feel and hold up to everyday use.' -%}
{%- assign c2 = m.noir_craft_2_title.value | default: m.noir_craft_2_title | default: 'Careful finish' -%}
{%- assign c2t = m.noir_craft_2_text.value | default: m.noir_craft_2_text | default: 'Every edge and surface is finished so it looks right up close.' -%}
{%- assign c3 = m.noir_craft_3_title.value | default: m.noir_craft_3_title | default: 'Made for use' -%}
{%- assign c3t = m.noir_craft_3_text.value | default: m.noir_craft_3_text | default: 'Designed around the way you will actually reach for it.' -%}
{%- assign i1 = m.product_highlight_1.value | default: m.product_highlight_1 | default: m.product_image_2.value | default: m.product_image_2 -%}
{%- assign i2 = m.product_highlight_2.value | default: m.product_highlight_2 | default: m.product_image_3.value | default: m.product_image_3 -%}
{%- assign i3 = m.product_highlight_3.value | default: m.product_highlight_3 | default: m.product_image_4.value | default: m.product_image_4 -%}
{%- if product.media.size > 0 -%}
  {%- if i1 == blank -%}{%- assign i1 = product.media.first.preview_image | default: product.media.first -%}{%- endif -%}
  {%- if i2 == blank -%}{%- assign i2 = product.media.last.preview_image | default: product.media.last -%}{%- endif -%}
  {%- if i3 == blank -%}{%- assign i3 = product.media.first.preview_image | default: product.media.first -%}{%- endif -%}
{%- endif -%}
<section class="noir nr-craft">
  <div class="nr-wrap">
    <header class="nr-craft__head" data-nr-reveal>
      <div class="nr-craft__title">
        <p class="nr-eyebrow">{{ eyebrow }}</p>
        <h2 class="nr-h nr-craft__heading">{%- assign heading_w = heading | split: ' ' -%}{%- if heading_w.size > 1 -%}{%- assign heading_w_n = heading_w.size | minus: 1 -%}{% for word in heading_w limit: heading_w_n %}{{ word }} {% endfor %}<em>{{ heading_w | last }}</em>{%- else -%}{{ heading }}{%- endif -%}</h2>
      </div>
      <p class="nr-craft__text">{{ text }}</p>
    </header>
    <ol class="nr-craft__grid" role="list">
      <li class="nr-craft__card nr-craft__card--1" data-nr-reveal>
        <figure class="nr-craft__img">{%- if i1 != blank -%}<img src="{{ i1 | image_url: width: 1100 }}" alt="{{ c1 | escape }}" loading="lazy">{%- endif -%}</figure>
        <div class="nr-craft__meta"><span class="nr-craft__num nr-serif">I</span><div><h3 class="nr-serif">{{ c1 }}</h3><p>{{ c1t }}</p></div></div>
      </li>
      <li class="nr-craft__card nr-craft__card--2" data-nr-reveal>
        <figure class="nr-craft__img">{%- if i2 != blank -%}<img src="{{ i2 | image_url: width: 1100 }}" alt="{{ c2 | escape }}" loading="lazy">{%- endif -%}</figure>
        <div class="nr-craft__meta"><span class="nr-craft__num nr-serif">II</span><div><h3 class="nr-serif">{{ c2 }}</h3><p>{{ c2t }}</p></div></div>
      </li>
      <li class="nr-craft__card nr-craft__card--3" data-nr-reveal>
        <figure class="nr-craft__img">{%- if i3 != blank -%}<img src="{{ i3 | image_url: width: 1100 }}" alt="{{ c3 | escape }}" loading="lazy">{%- endif -%}</figure>
        <div class="nr-craft__meta"><span class="nr-craft__num nr-serif">III</span><div><h3 class="nr-serif">{{ c3 }}</h3><p>{{ c3t }}</p></div></div>
      </li>
    </ol>
  </div>
</section>
<style>
  .noir { --nr-ink: #0B0A09; --nr-coal: #121110; --nr-char: #1A1714; --nr-line: rgb(201 169 110 / .18); --nr-line-2: rgb(242 236 226 / .09); --nr-gold: #C9A96E; --nr-gold-hi: #E9D5A6; --nr-gold-lo: #8A6B3C; --nr-gild: linear-gradient(120deg, #F1DEB0 0%, #C9A96E 40%, #A8864F 68%, #E4CB92 100%); --nr-ivory: #F3EDE3; --nr-paper: #EFE8DC; --nr-muted: #A0978A; --nr-serif: "Bodoni Moda", "Didot", serif; --nr-sans: "Manrope", system-ui, sans-serif; --nr-ease: cubic-bezier(.22, .8, .24, 1); --font-heading-family: "Bodoni Moda", serif; --font-body-family: "Manrope", sans-serif; position: relative; font-family: var(--nr-sans); -webkit-font-smoothing: antialiased; interpolate-size: allow-keywords; }
  :where(.noir) { background: var(--nr-ink); color: var(--nr-ivory); }
  .noir *, .noir *::before, .noir *::after { box-sizing: border-box; }
  :where(.noir) :is(p, li, a, span, strong, em, b, s, small, label, summary, td, th, button, figcaption) { font-size: inherit; line-height: inherit; color: inherit; letter-spacing: inherit; }
  .noir, .noir :is(p, li, a, span, label, button, input, select, option, summary, td, th, small, strong, em, b, s, div, figcaption) { font-family: var(--nr-sans) !important; }
  .noir :is(h1, h2, h3, h4, .nr-h *, .nr-serif, .nr-serif *) { font-family: var(--nr-serif) !important; }
  :where(.noir) :is(h1, h2, h3, h4, p, ul, ol, figure, blockquote) { margin: 0; padding: 0; }
  :where(.noir) :is(ul, ol) { list-style: none; }
  :where(.noir) img { display: block; max-width: 100%; }
  :where(.noir) .nr-wrap { width: min(1320px, calc(100% - 64px)); margin-inline: auto; }
  :where(.noir) .nr-eyebrow { display: flex; align-items: center; gap: 14px; font-size: 11px; font-weight: 600; line-height: 1.4; letter-spacing: .3em; text-transform: uppercase; color: var(--nr-gold); }
  :where(.noir) .nr-eyebrow::before { content: ""; flex: none; width: 34px; height: 1px; background: linear-gradient(90deg, transparent, currentColor); }
  :where(.noir) .nr-eyebrow--center { justify-content: center; }
  :where(.noir) .nr-eyebrow--center::after { content: ""; flex: none; width: 34px; height: 1px; background: linear-gradient(90deg, currentColor, transparent); }
  :where(.noir) .nr-h { font-weight: 400; line-height: 1.02; letter-spacing: -.015em; text-wrap: balance; }
  :where(.noir) .nr-h em { font-style: italic; color: var(--nr-gold-hi); }
  :where(.noir) .nr-btn { position: relative; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 56px; padding: 0 34px; border: 0; border-radius: 0; background: var(--nr-gild); background-size: 220% 100%; color: var(--nr-ink); font-size: 12px; font-weight: 700; line-height: 1; letter-spacing: .22em; text-transform: uppercase; text-decoration: none; cursor: pointer; box-shadow: 0 12px 32px -14px rgb(201 169 110 / .6); transition: background-position .7s var(--nr-ease), box-shadow .4s ease; }
  :where(.noir) .nr-btn::after { content: ""; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / .45) 50%, transparent 65%); transform: translateX(-120%); transition: transform 1s var(--nr-ease); pointer-events: none; }
  :where(.noir) .nr-btn:hover { background-position: 100% 0; box-shadow: 0 16px 40px -14px rgb(201 169 110 / .8); }
  :where(.noir) .nr-btn:hover::after { transform: translateX(120%); }
  :where(.noir) .nr-btn[disabled] { opacity: .45; cursor: not-allowed; box-shadow: none; }
  :where(.noir) .nr-btn svg { flex: none; width: 16px; height: 16px; transition: transform .4s var(--nr-ease); }
  :where(.noir) .nr-btn:hover svg { transform: translateX(4px); }
  :where(.noir) .nr-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .noir.nr-grain::before { content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none; opacity: .08; mix-blend-mode: overlay; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
  @keyframes nr-rise { from { opacity: 0; transform: translate3d(0, 34px, 0); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .noir [data-nr-reveal] { animation: nr-rise linear both; animation-timeline: view(); animation-range: entry 0% entry 75%; }
    }
  }
  @media (max-width: 749px) { :where(.noir) .nr-wrap { width: calc(100% - 32px); } }

  .nr-craft { background: var(--nr-ink); color: var(--nr-ivory); padding: clamp(80px, 10vw, 150px) 0 clamp(96px, 12vw, 190px); overflow: clip; }
  .nr-craft__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 400px); gap: 32px; align-items: end; margin-bottom: clamp(44px, 5vw, 80px); }
  .nr-craft__title { display: grid; gap: 18px; }
  .nr-craft__heading { font-size: clamp(40px, 5vw, 76px); }
  .nr-craft__text { padding-inline-start: 24px; border-inline-start: 1px solid var(--nr-line); font-size: 15px; line-height: 1.8; color: var(--nr-muted); }
  .nr-craft__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr); gap: clamp(20px, 2.6vw, 44px); align-items: start; }
  .nr-craft__card--2 { margin-top: clamp(48px, 7vw, 128px); }
  .nr-craft__card--3 { margin-top: clamp(24px, 3.5vw, 64px); }
  .nr-craft__img { position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: var(--nr-char); }
  .nr-craft__card--1 .nr-craft__img { aspect-ratio: 4 / 5; }
  .nr-craft__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--nr-ease); }
  .nr-craft__img::after { content: ""; position: absolute; inset: 14px; border: 1px solid rgb(233 213 166 / .35); opacity: 0; transform: scale(1.04); transition: opacity .6s ease, transform .9s var(--nr-ease); pointer-events: none; }
  .nr-craft__card:hover .nr-craft__img img { transform: scale(1.05); }
  .nr-craft__card:hover .nr-craft__img::after { opacity: 1; transform: none; }
  .nr-craft__meta { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 4px; padding-top: 24px; }
  .nr-craft__num { font-size: 32px; font-style: italic; line-height: 1; color: var(--nr-gold); }
  .nr-craft__meta h3 { display: inline; font-size: clamp(22px, 1.9vw, 28px); font-weight: 400; line-height: 1.25; background: linear-gradient(var(--nr-gold), var(--nr-gold)) 0 100% / 0 1px no-repeat; transition: background-size .6s var(--nr-ease); }
  .nr-craft__card:hover .nr-craft__meta h3 { background-size: 100% 1px; }
  .nr-craft__meta p { margin-top: 10px; font-size: 15px; line-height: 1.7; color: var(--nr-muted); }
  @media (max-width: 899px) {
    .nr-craft__head { grid-template-columns: 1fr; gap: 20px; }
    .nr-craft__grid { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: -16px; padding-inline: 16px; scrollbar-width: none; }
    .nr-craft__grid::-webkit-scrollbar { display: none; }
    .nr-craft__card { flex: 0 0 80%; scroll-snap-align: start; margin-top: 0; }
    .nr-craft__card .nr-craft__img, .nr-craft__card--1 .nr-craft__img { aspect-ratio: 4 / 5; }
    .nr-craft__meta { grid-template-columns: 44px minmax(0, 1fr); }
    .nr-craft__num { font-size: 26px; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--noir" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "Manrope", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Bodoni Moda", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) .nr-serif, .kl-rtl:is(#kl-rtl, *) .nr-serif * { font-family: "Bodoni Moda", "Amiri", "Noto Naskh Arabic", serif !important; }
  .kl-rtl:is(#kl-rtl, *) .nr-btn svg, .kl-rtl:is(#kl-rtl, *) .nr-hero__nav svg { transform: scaleX(-1); }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
