{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
{%- assign m = product.metafields.roarr -%}
{%- assign heading = m.frost_faq_heading.value | default: m.frost_faq_heading | default: 'Quick answers' -%}
{%- assign text = m.frost_faq_text.value | default: m.frost_faq_text | default: 'Still wondering about something? Our team replies within one working day.' -%}
{%- assign q1 = m.frost_faq_q_1.value | default: m.frost_faq_q_1 | default: 'How do I get started?' -%}
{%- assign a1 = m.frost_faq_a_1.value | default: m.frost_faq_a_1 | default: 'It is ready to use straight out of the box, with simple instructions included.' -%}
{%- assign q2 = m.frost_faq_q_2.value | default: m.frost_faq_q_2 | default: 'Will it suit me?' -%}
{%- assign a2 = m.frost_faq_a_2.value | default: m.frost_faq_a_2 | default: 'Full sizes and details are listed above. Unsure? Message us and we will help you choose.' -%}
{%- assign q3 = m.frost_faq_q_3.value | default: m.frost_faq_q_3 | default: 'How do I look after it?' -%}
{%- assign a3 = m.frost_faq_a_3.value | default: m.frost_faq_a_3 | default: 'A quick wipe keeps it looking new. Care details are included with your order.' -%}
{%- assign q4 = m.frost_faq_q_4.value | default: m.frost_faq_q_4 | default: 'What if it is not right?' -%}
{%- assign a4 = m.frost_faq_a_4.value | default: m.frost_faq_a_4 | default: 'Return it within 30 days for an exchange or a full refund. No awkward questions.' -%}
<section class="fr-faq">
  <div class="fr-wrap fr-faq__grid">
    <header class="fr-faq__intro">
      <p class="fr-label"><b>04</b>FAQ</p>
      <h2 class="fr-display">{{ heading }}</h2>
      <p class="fr-lead">{{ text }}</p>
    </header>
    <div class="fr-faq__list">
      <div class="fr-faq__card"><span class="fr-faq__num">01</span><div><h3>{{ q1 }}</h3><p>{{ a1 }}</p></div></div>
      <div class="fr-faq__card"><span class="fr-faq__num">02</span><div><h3>{{ q2 }}</h3><p>{{ a2 }}</p></div></div>
      <div class="fr-faq__card"><span class="fr-faq__num">03</span><div><h3>{{ q3 }}</h3><p>{{ a3 }}</p></div></div>
      <div class="fr-faq__card"><span class="fr-faq__num">04</span><div><h3>{{ q4 }}</h3><p>{{ a4 }}</p></div></div>
    </div>
  </div>
</section>
<style>
  .fr-faq { --fr-white: #FFFFFF; --fr-mist: #F3F6FA; --fr-ice: #E7EEFB; --fr-line: #E2E7EF; --fr-ink: #0B1324; --fr-muted: #586377; --fr-blue: #2F5BFF; --fr-blue-dark: #1C3CD6; --fr-blue-soft: #E8EEFF; --fr-night: #0A0F1E; --font-heading-family: "Plus Jakarta Sans", sans-serif; --font-body-family: "Plus Jakarta Sans", sans-serif; background: var(--fr-white); color: var(--fr-ink); font-family: "Plus Jakarta Sans", sans-serif; padding: clamp(64px, 9vw, 128px) 0; }
  .fr-faq *, .fr-faq *::before, .fr-faq *::after { box-sizing: border-box; }
  .fr-wrap { width: min(1240px, calc(100% - 48px)); margin: 0 auto; }
  .fr-intro { max-width: 760px; margin-bottom: clamp(36px, 5vw, 64px); }
  .fr-intro--center { margin-inline: auto; text-align: center; }
  .fr-intro--center .fr-label { justify-content: center; }
  .fr-label { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .01em; color: var(--fr-blue); }
  .fr-label b { display: inline-grid; place-items: center; min-width: 32px; height: 22px; padding: 0 8px; border-radius: 999px; background: var(--fr-blue-soft); color: var(--fr-blue); font-size: 11px; font-weight: 800; letter-spacing: .04em; }
  .fr-display { margin: 16px 0 0; font-weight: 800; font-size: clamp(38px, 5.4vw, 76px); line-height: 1; letter-spacing: -0.045em; color: var(--fr-ink); text-wrap: balance; }
  .fr-display .fr-grad, .fr-hero__title .fr-grad { font-size: inherit; font-weight: inherit; line-height: inherit; letter-spacing: inherit; background: linear-gradient(100deg, var(--fr-ink) 0%, var(--fr-ink) 30%, var(--fr-blue) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .fr-lead { margin: 18px 0 0; font-size: clamp(16px, 1.3vw, 18px); line-height: 1.6; color: var(--fr-muted); }
  @media (max-width: 749px) { .fr-wrap { width: calc(100% - 32px); } }
  .fr-faq__grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(36px, 6vw, 96px); align-items: start; }
  .fr-faq__intro { position: sticky; top: 32px; }
  .fr-faq .fr-display { font-size: clamp(36px, 4.4vw, 60px); }
  .fr-faq__list { display: grid; gap: 14px; }
  .fr-faq__card { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 20px; padding: 28px; border: 1px solid var(--fr-line); border-radius: 28px; background: linear-gradient(180deg, #FFFFFF 0%, var(--fr-mist) 100%); transition: border-color 250ms ease, box-shadow 250ms ease; }
  .fr-faq__card:hover { border-color: rgb(47 91 255 / .35); box-shadow: 0 18px 40px rgb(11 19 36 / .06); }
  .fr-faq__card .fr-faq__num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--fr-blue-soft); color: var(--fr-blue); font-size: 13px; font-weight: 800; }
  .fr-faq__card h3 { margin: 0 0 8px; font-size: 19px; font-weight: 800; line-height: 1.3; letter-spacing: -0.02em; }
  .fr-faq__card p { margin: 0; font-size: 15px; line-height: 1.65; color: var(--fr-muted); }
  @media (max-width: 849px) {
    .fr-faq__grid { grid-template-columns: 1fr; }
    .fr-faq__intro { position: static; }
  }
  @media (max-width: 479px) {
    .fr-faq__card { grid-template-columns: 1fr; gap: 14px; padding: 22px; }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--frost" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, dt, dd, blockquote, div) { font-family: "Plus Jakarta Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Plus Jakarta Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
