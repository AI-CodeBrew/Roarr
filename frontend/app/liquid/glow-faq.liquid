{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500&family=DM+Sans:wght@400;500;600&display=swap">
{%- assign m = product.metafields.kluck_ai -%}
{%- assign heading = m.faq_section_title.value | default: m.faq_section_title | default: 'Good to know' -%}
{%- assign q1 = m.faq_question_1.value | default: m.faq_question_1 -%}
{%- assign a1 = m.faq_answer_1.value | default: m.faq_answer_1 -%}
{%- assign q2 = m.faq_question_2.value | default: m.faq_question_2 -%}
{%- assign a2 = m.faq_answer_2.value | default: m.faq_answer_2 -%}
{%- assign q3 = m.faq_question_3.value | default: m.faq_question_3 -%}
{%- assign a3 = m.faq_answer_3.value | default: m.faq_answer_3 -%}
{%- assign q4 = m.faq_question_4.value | default: m.faq_question_4 -%}
{%- assign a4 = m.faq_answer_4.value | default: m.faq_answer_4 -%}
<section class="gl-faq">
  <p>FAQs</p>
  <h2>{{ heading }}</h2>
  <div class="gl-faq-list">
    {%- if q1 != blank -%}
      <details>
        <summary>{{ q1 }}</summary>
        {%- if a1 != blank -%}<p>{{ a1 }}</p>{%- endif -%}
      </details>
    {%- endif -%}
    {%- if q2 != blank -%}
      <details>
        <summary>{{ q2 }}</summary>
        {%- if a2 != blank -%}<p>{{ a2 }}</p>{%- endif -%}
      </details>
    {%- endif -%}
    {%- if q3 != blank -%}
      <details>
        <summary>{{ q3 }}</summary>
        {%- if a3 != blank -%}<p>{{ a3 }}</p>{%- endif -%}
      </details>
    {%- endif -%}
    {%- if q4 != blank -%}
      <details>
        <summary>{{ q4 }}</summary>
        {%- if a4 != blank -%}<p>{{ a4 }}</p>{%- endif -%}
      </details>
    {%- endif -%}
  </div>
</section>
<style>
  .gl-faq { background: #fff; color: #222; font-family: "DM Sans", sans-serif; padding: 56px 0 32px; text-align: center; }
  .gl-faq > p { margin: 0; letter-spacing: 0.18em; text-transform: uppercase; font-size: 12px; font-weight: 700; }
  .gl-faq h2 { font-family: "Cormorant Garamond", serif; font-weight: 500; font-style: italic; font-size: 52px; line-height: 1.1; margin: 10px auto 28px; }
  .gl-faq-list { width: min(760px, calc(100% - 48px)); margin: 0 auto; text-align: start; border-bottom: 1px solid #e4e0db; }
  .gl-faq details { border-top: 1px solid #e4e0db; }
  .gl-faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; font-size: 16px; font-weight: 500; outline: none; }
  .gl-faq summary::-webkit-details-marker { display: none; }
  .gl-faq summary::marker { content: none; }
  .gl-faq summary:after { content: ""; width: 8px; height: 8px; border-right: 1.5px solid #222; border-bottom: 1.5px solid #222; transform: rotate(45deg); flex: none; margin-inline-end: 4px; }
  .gl-faq details[open] summary:after { transform: rotate(-135deg); margin-top: 4px; }
  .gl-faq details p { margin: 0 0 18px; font-size: 15px; line-height: 1.6; color: #3a3a3a; max-width: 640px; }
  @media (max-width: 800px) { .gl-faq h2 { font-size: 40px; } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--glow" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: "DM Sans", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Cormorant Garamond", "Amiri", "Noto Naskh Arabic", serif !important; line-height: 1.5 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.kluck-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
