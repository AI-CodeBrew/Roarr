{%- assign render_flag = shop.metafields.app.block_control.value -%}
{%- if render_flag == true -%}
  {%- liquid
    assign s = block.settings
    assign m = product.metafields.roarr
    assign color_schema = m.color_schema.value | default: m.color_schema | default: '#A34E4E'

    assign opacity_val = s.background_opacity | default: 10 | divided_by: 100.0
    if s.show_background == false
      assign opacity = 0
    else
      assign opacity = opacity_val
    endif
    assign bg_color = s.background_color | default: '#ffffff'
    unless s.use_metafields_bg == false
      if s.use_metafields_bg and product != blank and m.color_schema != blank
        assign bg_color = m.color_schema.value | default: m.color_schema
      elsif s.use_metafields and product != blank and m.color_schema != blank
        assign bg_color = m.color_schema.value | default: m.color_schema
      endif
    endunless

    assign heading_font = s.heading_font_family
    assign body_font = s.body_font_family

    if s.use_metafields
      assign heading_content = product.metafields.roarr.stats_section_heading | default: s.heading
      assign point_1_heading = product.metafields.roarr.stats_section_point_1_heading | default: s.row1_title
      assign point_1_desc = product.metafields.roarr.stats_section_point_1_desc | default: s.row1_body
      assign point_2_heading = product.metafields.roarr.stats_section_point_2_heading | default: s.row2_title
      assign point_2_desc = product.metafields.roarr.stats_section_point_2_desc | default: s.row2_body
      assign point_3_heading = product.metafields.roarr.stats_section_point_3_heading | default: s.row3_title
      assign point_3_desc = product.metafields.roarr.stats_section_point_3_desc | default: s.row3_body
    else
      assign heading_content = s.heading
      assign point_1_heading = s.row1_title
      assign point_1_desc = s.row1_body
      assign point_2_heading = s.row2_title
      assign point_2_desc = s.row2_body
      assign point_3_heading = s.row3_title
      assign point_3_desc = s.row3_body
    endif
    assign image_content = blank
    if product.metafields.roarr.problem_solving_image
      assign image_meta = product.metafields.roarr.problem_solving_image
      assign image_content = image_meta | default: image_meta
    endif
    if s.image != blank
      assign image_content = s.image
    endif
    assign pad_v_d = s.padding_vertical_desktop | default: 10
    assign pad_h_d = s.padding_horizontal_desktop | default: 10
    assign pad_v_m = s.padding_vertical_mobile | default: 20
    assign pad_h_m = s.padding_horizontal_mobile | default: 10
  -%}

  <link rel="stylesheet" href="{{ 'typography.css' | asset_url }}" media="all">
  <link rel="stylesheet" href="{{ 'impact-stat.css' | asset_url }}" media="all">

  <div
    id="impact-{{ block.id }}"
    class="impact app_blocks_class"
    aria-label="Impact metrics"
    style="display:block; --product-section-bg:{{ bg_color }}; --product-section-opacity:{{ opacity }}; --bg-color:{{ bg_color }}; --bg-opacity:{{ opacity }}; --container-width:{{ s.container_max_width | default: 1250 }}px; --impact-primary-color: {{ color_schema }}; --section-padding-v-d: {{ pad_v_d }}px; --section-padding-h-d: {{ pad_h_d }}px; --section-padding-v-m: {{ pad_v_m }}px; --section-padding-h-m: {{ pad_h_m }}px; --font-heading-family:{% if heading_font != blank and heading_font.family %}{{ heading_font.family }}, {{ heading_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %}; --font-body-family:{% if body_font != blank and body_font.family %}{{ body_font.family }}, {{ body_font.fallback_families | default: 'sans-serif' }}{% else %}inherit{% endif %}; --body-size:{{ s.body_size | default: 16 }}px; --body-weight:{{ s.body_weight | default: 400 }}; --h1-size:{{ s.h1_size | default: 48 }}px; --h1-weight:{{ s.h1_weight | default: 700 }}; --h2-size:{{ s.h2_size | default: 36 }}px; --h2-weight:{{ s.h2_weight | default: 700 }}; --h3-size:{{ s.h3_size | default: 30 }}px; --h3-weight:{{ s.h3_weight | default: 600 }}; --h4-size:{{ s.h4_size | default: 24 }}px; --h4-weight:{{ s.h4_weight | default: 600 }}; --h5-size:{{ s.h5_size | default: 20 }}px; --h5-weight:{{ s.h5_weight | default: 500 }}; --h6-size:{{ s.h6_size | default: 16 }}px; --h6-weight:{{ s.h6_weight | default: 500 }};"
  >
    {% if heading_content != blank %}
      <div class="impact__heading-wrapper">
        <h3 class="impact__main-heading">{{ heading_content }}</h3>
      </div>
    {% endif %}
    <div class="impact__inner">
      <div class="impact__grid">
        <div class="impact__left">
          <div class="impact__media">
            {% if image_content != blank %}
              <img
                src="{{ image_content | image_url: width: 800 }}"
                srcset="
                  {{ image_content | image_url: width: 400 }} 400w,
                  {{ image_content | image_url: width: 800 }} 800w,
                  {{ image_content | image_url: width: 1200 }} 1200w
                "
                sizes="(max-width: 991px) 100vw, 42vw"
                alt="{{ image_content.alt | default: 'Impact image' }}"
                loading="lazy"
                width="800"
                height="600"
              >
            {% else %}
              {% render 'snippets/image-svg' %}
            {% endif %}
          </div>
        </div>

        <div class="impact__right" role="list">
          {% for i in (1..3) %}
            {% assign base = 'row' | append: i %}
            {% assign key_percent = base | append: '_percent' %}
            {% assign percent = s[key_percent] | default: 0 | at_least: 0 | at_most: 100 %}

            {% if i == 1 %}
              {% assign title = point_1_heading %}
              {% assign body = point_1_desc %}
            {% elsif i == 2 %}
              {% assign title = point_2_heading %}
              {% assign body = point_2_desc %}
            {% else %}
              {% assign title = point_3_heading %}
              {% assign body = point_3_desc %}
            {% endif %}

            {% if title != blank or body != blank %}
              <article role="listitem" class="impact__row">
                <div class="impact__dial" data-percent="{{ percent }}">
                  <svg class="impact__svg" viewBox="0 0 100 100" aria-hidden="true">
                    <circle class="impact__track" cx="50" cy="50" r="45"></circle>
                    <circle class="impact__progress" cx="50" cy="50" r="45"></circle>
                  </svg>
                  <div class="impact__center">
                    <h4 class="impact__dial-text">{{ percent }}</h4>
                  </div>
                </div>
                <div class="impact__text">
                  {% if title != blank %}
                    <h4 class="impact__row-title">{{ title }}</h4>
                  {% endif %}
                  {% if body != blank %}
                    <div class="impact__row-body rte">{{ body }}</div>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <script src="{{ 'impact-stat.js' | asset_url }}" defer></script>
{%- endif -%}
