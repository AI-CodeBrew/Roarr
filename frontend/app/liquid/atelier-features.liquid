    .at-feat__tabs::-webkit-scrollbar { display: none; }
    .at-feat__tab { flex: none; width: auto; scroll-snap-align: center; padding: 16px 22px 16px 0; border-bottom: 0; gap: 10px; white-space: nowrap; }
    .at-feat__tab.is-on { padding-inline-start: 0; }
    .at-feat__name { font-size: 22px; }
    .at-feat__ink { inset-block-start: auto; inset-block-end: 0; inset-inline-start: auto; left: 0; height: 2px; width: 0; }
  }
</style>
<script>
    (function () {
      if (window.__atMotion) return;
      window.__atMotion = true;
      var doc = document;
      var reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
      var fine = window.matchMedia && matchMedia("(hover: hover) and (pointer: fine)").matches;
      var pars = [];
      var queued = false;
      // Masked items start fully clipped, and a clipped element never counts as intersecting,
      // so those are watched through their parent.
      var io = "IntersectionObserver" in window ? new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
