  .at-feat__ink { position: absolute; inset-block-start: 0; inset-inline-start: 0; width: 2px; height: 0; background: var(--at-accent); opacity: 0; transition: transform .6s var(--at-ease), height .6s var(--at-ease), width .6s var(--at-ease), opacity .3s ease; pointer-events: none; z-index: 1; }
  .at-feat__ink.is-ready { opacity: 1; }
  .at-feat__panels { display: grid; }
  .at-feat__panel { grid-area: 1 / 1; display: grid; align-content: start; gap: 22px; opacity: 0; visibility: hidden; transform: translateY(14px); transition: opacity .6s var(--at-ease), transform .8s var(--at-ease), visibility 0s linear .6s; }
  .at-feat__panel.is-on { opacity: 1; visibility: visible; transform: none; transition-delay: .12s, .12s, 0s; }
  .at-feat__text { max-width: 28em; font-size: 16px; line-height: 1.85; color: var(--at-soft); }
