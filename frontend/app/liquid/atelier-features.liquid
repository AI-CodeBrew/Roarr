          var host = el.parentElement;
          if (!host.__atFor) { host.__atFor = []; io.observe(host); }
          host.__atFor.push(el);
        });
        doc.querySelectorAll("[data-at-par]").forEach(function (el) {
          if (el.__atp) return;
          el.__atp = 1;
          pars.push(el);
        });
        doc.querySelectorAll("[data-at-magnet]").forEach(magnet);
        doc.querySelectorAll("a[data-at-jump]").forEach(function (a) {
          if (a.__atj) return;
          a.__atj = 1;
          a.addEventListener("click", function (event) {
            var target = doc.getElementById((a.getAttribute("href") || "").slice(1));
            if (!target) return;
            event.preventDefault();
            target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
          });
        });
        frame();
      }
      window.addEventListener("scroll", frame, { passive: true });
      window.addEventListener("resize", frame);
      doc.addEventListener("shopify:section:load", scan);
      if (doc.readyState === "loading") doc.addEventListener("DOMContentLoaded", scan); else scan();
    })();
  (function () {
    var root = document.querySelector("[data-at-feat]");
    if (!root || root.__atf) return;
    root.__atf = 1;
    var tabs = [].slice.call(root.querySelectorAll("[data-at-tab]"));
    var slides = [].slice.call(root.querySelectorAll("[data-at-slide]"));
    var panels = [].slice.call(root.querySelectorAll("[data-at-panel]"));
    var ink = root.querySelector("[data-at-ink]");
    var list = root.querySelector("[data-at-tabs]");
    var counter = root.querySelector("[data-at-n]");
    var current = 0;
    function moveInk() {
      var tab = tabs[current];
      if (!ink || !tab) return;
      var row = getComputedStyle(list).flexDirection === "row";
      if (row) {
        ink.style.height = "2px";
        ink.style.width = tab.offsetWidth + "px";
        ink.style.transform = "translateX(" + tab.offsetLeft + "px)";
      } else {
        ink.style.width = "2px";
        ink.style.height = tab.offsetHeight + "px";
        ink.style.transform = "translateY(" + tab.offsetTop + "px)";
      }
      ink.classList.add("is-ready");
    }
    function select(i, focus) {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach(function (tab, n) {
        var on = n === current;
        tab.classList.toggle("is-on", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
      });
      slides.forEach(function (s, n) { s.classList.toggle("is-on", n === current); });
      panels.forEach(function (p, n) { p.classList.toggle("is-on", n === current); });
      if (counter) counter.textContent = "0" + (current + 1);
      moveInk();
      if (focus) tabs[current].focus();
      var tab = tabs[current];
      if (list.scrollWidth > list.clientWidth + 2) {
        list.scrollBy({ left: (tab.getBoundingClientRect().left + tab.offsetWidth / 2) - (list.getBoundingClientRect().left + list.clientWidth / 2), behavior: "smooth" });
      }
    }
    tabs.forEach(function (tab, n) {
      tab.addEventListener("click", function () { select(n); });
      tab.addEventListener("keydown", function (event) {
        var k = event.key;
        if (k === "ArrowDown" || k === "ArrowRight") { event.preventDefault(); select(current + 1, true); }
        else if (k === "ArrowUp" || k === "ArrowLeft") { event.preventDefault(); select(current - 1, true); }
        else if (k === "Home") { event.preventDefault(); select(0, true); }
        else if (k === "End") { event.preventDefault(); select(tabs.length - 1, true); }
      });
    });
    window.addEventListener("resize", moveInk);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(moveInk);
    window.addEventListener("load", moveInk);
    moveInk();
  })();
</script>
{%- endif -%}
{%- endcapture -%}
