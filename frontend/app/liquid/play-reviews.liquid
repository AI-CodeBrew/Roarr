{%- capture kl_rtl_html -%}
{% render 'snippets/play-fonts' %}
{%- assign m = product.metafields.roarr -%}
{%- capture ph_review_title -%}{% render 'snippets/roarr-ui-string', key: 'review_title' %}{%- endcapture -%}
{%- capture ph_review_body -%}{% render 'snippets/roarr-ui-string', key: 'review_body' %}{%- endcapture -%}
{%- capture ph_reviewer_name -%}{% render 'snippets/roarr-ui-string', key: 'reviewer_name' %}{%- endcapture -%}
<section class="pk-reviews">
  <div class="pk-reviews-wrap">
    <h2>Lovely Customers</h2>
    <div class="pk-cards">
      {%- assign t1 = m.review_title_1.value | default: m.review_title_1 | default: ph_review_title -%}
      {%- assign b1 = m.review_body_1.value | default: m.review_body_1 | default: ph_review_body -%}
      {%- assign n1 = m.review_name_1.value | default: m.review_name_1 | default: ph_reviewer_name -%}
      {%- assign t2 = m.review_title_2.value | default: m.review_title_2 | default: ph_review_title -%}
      {%- assign b2 = m.review_body_2.value | default: m.review_body_2 | default: ph_review_body -%}
      {%- assign n2 = m.review_name_2.value | default: m.review_name_2 | default: ph_reviewer_name -%}
      {%- assign t3 = m.review_title_3.value | default: m.review_title_3 | default: ph_review_title -%}
      {%- assign b3 = m.review_body_3.value | default: m.review_body_3 | default: ph_review_body -%}
      {%- assign n3 = m.review_name_3.value | default: m.review_name_3 | default: ph_reviewer_name -%}
      {%- assign t4 = m.review_title_4.value | default: m.review_title_4 | default: ph_review_title -%}
      {%- assign b4 = m.review_body_4.value | default: m.review_body_4 | default: ph_review_body -%}
      {%- assign n4 = m.review_name_4.value | default: m.review_name_4 | default: ph_reviewer_name -%}
      <div class="pk-card"><div class="pk-stars">★★★★★</div><h3>{{ t1 }}</h3><p>{{ b1 }}</p><b>{{ n1 }}</b></div>
      <div class="pk-card"><div class="pk-stars">★★★★★</div><h3>{{ t2 }}</h3><p>{{ b2 }}</p><b>{{ n2 }}</b></div>
      <div class="pk-card"><div class="pk-stars">★★★★★</div><h3>{{ t3 }}</h3><p>{{ b3 }}</p><b>{{ n3 }}</b></div>
      <div class="pk-card"><div class="pk-stars">★★★★★</div><h3>{{ t4 }}</h3><p>{{ b4 }}</p><b>{{ n4 }}</b></div>
    </div>
  </div>
</section>
<style>
  .pk-reviews { background: #FFFCF5 url("") center top / cover no-repeat; padding: 100px 0 70px; color: #6F2424; font-family: Poppins, sans-serif; }
  .pk-reviews-wrap { width: min(1100px, calc(100% - 48px)); margin: 0 auto; }
  .pk-reviews h2 { text-align: center; font-family: "Caveat Brush", cursive !important; font-weight: 400; font-size: 56px; line-height: 1; margin: 0; color: #6F2424; }
  .pk-cards { display: flex; gap: 16px; margin-top: 28px; }
  .pk-card { flex: 1 1 0; background: #fff; border: 1px solid #6F2424; border-radius: 20px; padding: 28px 22px 22px; }
  .pk-stars { color: #E0A106; letter-spacing: 2px; font-size: 14px; }
  .pk-card h3 { font-family: "Caveat Brush", cursive !important; font-weight: 400; font-size: 28px; margin: 8px 0; color: #6F2424; }
  .pk-card p { margin: 0 0 18px; font-size: 14px; line-height: 1.5; }
  .pk-card b { font-size: 13px; letter-spacing: 0.04em; }
  @media (max-width: 800px) { .pk-cards { flex-direction: column; } .pk-reviews h2 { font-size: 42px; } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--play" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: Poppins, "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Caveat Brush", "Lalezar", "Tajawal", cursive !important; line-height: 1.4 !important; font-weight: 400 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
