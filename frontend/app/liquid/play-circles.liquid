{%- capture kl_rtl_html -%}
{% render 'snippets/play-fonts' %}
{%- assign m = product.metafields.kluck_ai -%}
{%- assign i1 = m.happy_customer_image_1.value | default: m.happy_customer_image_1 | default: 'https://cdn.shopify.com/s/files/1/0446/8228/1123/files/c1.png?v=1726200609' -%}
{%- assign i2 = m.happy_customer_image_2.value | default: m.happy_customer_image_2 | default: 'https://cdn.shopify.com/s/files/1/0446/8228/1123/files/c2.png?v=1726200610' -%}
{%- assign i3 = m.happy_customer_image_3.value | default: m.happy_customer_image_3 | default: 'https://cdn.shopify.com/s/files/1/0446/8228/1123/files/c3.png?v=1726200609' -%}
{%- assign i4 = m.product_highlight_4.value | default: m.product_highlight_4 | default: 'https://cdn.shopify.com/s/files/1/0446/8228/1123/files/c4.png?v=1726200609' -%}
{%- assign c1 = m.circle_1.value | default: m.circle_1 | default: 'Pieces for the senses' -%}
{%- assign c2 = m.circle_2.value | default: m.circle_2 | default: 'For anytime, anywhere' -%}
{%- assign c3 = m.circle_3.value | default: m.circle_3 | default: 'Original die cut' -%}
{%- assign c4 = m.circle_4.value | default: m.circle_4 | default: 'Easy-to-see' -%}
<section class="pk-circles">
  <div><img src="{{ i1 }}" alt=""><h3>{{ c1 }}</h3></div>
  <div><img src="{{ i2 }}" alt=""><h3>{{ c2 }}</h3></div>
  <div><img src="{{ i3 }}" alt=""><h3>{{ c3 }}</h3></div>
  <div><img src="{{ i4 }}" alt=""><h3>{{ c4 }}</h3></div>
</section>
<style>
  .pk-circles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; text-align: center; padding: 36px 24px 56px; background: #FFFCF5; color: #6F2424; font-family: Poppins, sans-serif; }
  .pk-circles img { width: 120px; height: 120px; object-fit: cover; border-radius: 50%; margin: 0 auto 12px; }
  .pk-circles h3 { font-family: "Caveat Brush", cursive !important; font-weight: 400; font-size: 24px; margin: 0; color: #6F2424; }
  @media (max-width: 800px) { .pk-circles { grid-template-columns: 1fr 1fr; } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--play" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: Poppins, "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Caveat Brush", "Lalezar", "Tajawal", cursive !important; line-height: 1.4 !important; font-weight: 400 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
