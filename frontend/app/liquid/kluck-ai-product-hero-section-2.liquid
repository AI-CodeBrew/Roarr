{% assign product_metafield = product.metafields.kluck_ai %}
{% assign color_schema = product_metafield.color_schema.value | default: m.color_schema | default: '#A34E4E'%}


{%- style -%}
  /* --- FORCE LOAD FONTS --- */
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_subheading_font | font_face: font_display: 'swap' }}
  {{ settings.type_accent_font | font_face: font_display: 'swap' }}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .modern-product-{{ section.id }} {
    /* FONTS */
    --font-h: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-b: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-sub: {{ settings.type_subheading_font.family | default: settings.type_heading_font.family }}, sans-serif;
    --font-btn: {{ settings.type_accent_font.family | default: settings.type_body_font.family }}, sans-serif;

    /* LAYOUT & COLORS */
    --container-width: {{ section.settings.container_width }}px;
    --radius: {{ section.settings.corner_radius }}px;
    --accent-color: {{ section.settings.accent_color }};
    --image-bg: {{ section.settings.image_bg }};
    
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  /* --- GRID LAYOUT & STICKY BEHAVIOR --- */
  .modern-product__grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media screen and (min-width: 900px) {
    .modern-product__grid {
      display: grid;
      grid-template-columns: 55% 1fr;
      gap: 60px;
      align-items: start; 
    }
    
    .modern-product__media-col,
    .modern-product__info-col {
      position: sticky;
      top: 40px;
      height: fit-content;
    }
  }

  /* --- MEDIA GALLERY --- */
  .modern-product__gallery {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media screen and (min-width: 900px) {
    .modern-product__gallery {
      flex-direction: row;
    }
  }

  /* Thumbnails (Desktop Only) */
  .modern-product__thumbs {
    display: none; 
    flex-direction: row;
    gap: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .modern-product__thumbs::-webkit-scrollbar { display: none; }

  @media screen and (min-width: 900px) {
    .modern-product__gallery { gap: 24px; }
    .modern-product__thumbs { display: flex; flex-direction: column; width: 100px; gap: 16px; flex-shrink: 0; }
  }

  .modern-product__thumb {
    width: 100px; height: 100px; border-radius: 12px; overflow: hidden;
    cursor: pointer; border: 1px solid transparent; transition: all 0.3s ease;
    background-color: var(--image-bg); flex-shrink: 0; padding: 0; 
  }
  .modern-product__thumb.is-active { border-color: var(--color-foreground); }
  .modern-product__thumb img { width: 100%; height: 100%; object-fit: cover; }

  /* Main Slider Wrapper */
  .modern-product__main-image-wrapper {
    position: relative; flex-grow: 1; background-color: var(--image-bg);
    border-radius: var(--radius); overflow: hidden; aspect-ratio: 1 / 1; 
    display: flex; align-items: center; justify-content: center;
  }

  .modern-product__slider {
    display: flex; width: 100%; height: 100%; overflow-x: auto;
    scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth;
  }
  .modern-product__slider::-webkit-scrollbar { display: none; }

  .modern-product__slide {
    flex: 0 0 100%; width: 100%; height: 100%; scroll-snap-align: start; position: relative;
  }
  .modern-product__slide img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .modern-product__arrow {
    position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px;
    background: var(--color-background); border: 1px solid var(--color-border);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.05); transition: transform 0.3s ease; z-index: 2;
  }
  .modern-product__arrow:hover { transform: translateY(-50%) scale(1.05); }
  .modern-product__arrow--prev { left: 15px; }
  .modern-product__arrow--next { right: 15px; }
  .modern-product__arrow svg { width: 16px; height: 16px; stroke: var(--color-foreground); }

  /* --- PRODUCT INFO (RIGHT) --- */
  .modern-product__block { margin-bottom: {{ section.settings.block_spacing }}px; }
  .modern-product__block:last-child { margin-bottom: 0; }

  /* Badges */
  .modern-badge {
    font-family: var(--font-sub); display: inline-block; padding: 6px 12px;
    border-radius: 6px; font-size: 12px; font-weight: 700; margin-right: 8px; text-transform: uppercase;
  }

  /* Title & Price */
  .modern-product__title {
    font-family: var(--font-h); font-size: {{ section.settings.title_size }}px;
    color: var(--color-foreground-heading); margin: 0 0 5px 0; font-weight: 600; line-height: 1.1;
  }

  .modern-product__reviews {
    font-family: var(--font-b); display: flex; align-items: center; gap: 5px;
    font-size: 14px; color: var(--color-foreground-muted); margin-bottom: 5px;
  }
  .modern-product__reviews svg { width: 16px; height: 16px; color: #FFC107; fill: #FFC107; }

  .modern-product__price-wrap { display: flex; align-items: center; gap: 12px; margin-bottom: 5px; }
  .modern-product__price { font-family: var(--font-b); font-size: 24px; font-weight: 600; color: var(--accent-color); }
  .modern-product__compare-price { font-family: var(--font-b); font-size: 18px; color: var(--color-foreground-muted); text-decoration: line-through; }
  .modern-product__tax-note { font-family: var(--font-b); font-size: 13px; color: var(--color-foreground-muted); margin-bottom: 10px; }

  /* Description & Stock */
  .modern-product__desc { font-family: var(--font-b); font-size: 15px; color: var(--color-foreground-muted); line-height: 1.6; }

  .modern-product__stock {
    font-family: var(--font-b); display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; font-weight: 500; padding: 8px 14px !important; border-radius: 999px !important;
  }
  .modern-product__stock-dot { width: 8px !important; height: 8px !important; border-radius: 50% !important; flex-shrink: 0 !important; display: block !important; }

  /* PROMO BANNER */
  .modern-promo-banner {
    display: flex; align-items: flex-start; gap: 20px; padding: 16px; border-radius: 8px; position: relative;
  }
  .modern-promo-banner svg.promo-icon { width: 22px; height: 22px; flex-shrink: 0; }
  .modern-promo-banner__content { flex-grow: 1; }
  .modern-promo-banner__content h5 { font-family: var(--font-h); font-size: 14px; margin: 0 0 4px 0; font-weight: 700; }
  .modern-promo-banner__content p { font-family: var(--font-b); font-size: 13px; margin: 0; }
  .modern-promo-banner__content a { text-decoration: underline; font-weight: 600; }
  .modern-promo-banner__close { 
    position: absolute; top: 20px; right: 16px; background: none; border: none; padding: 0; cursor: pointer;
  }
  .modern-promo-banner__close svg { width: 16px; height: 16px; }

  /* VARIANTS */
  .modern-variant__header {
    display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px;
  }
  .modern-variant__label {
    font-family: var(--font-sub); font-size: 16px; font-weight: 600; color: var(--color-foreground);
  }
  .modern-variant__options { display: flex; flex-wrap: wrap; gap: 10px; }
  
  /* Size Chart Link & Modal */
  .modern-size-chart-btn {
    font-family: var(--font-h); font-size: 14px; font-weight: 600; text-decoration: underline; background: none; border: none; cursor: pointer; padding: 0; color: var(--color-foreground);
  }
  .modern-modal {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 999999;
    display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
  }
  .modern-modal.is-open { opacity: 1; pointer-events: auto; }
  .modern-modal__inner {
    background: var(--color-background); padding: 40px 20px 20px; border-radius: 12px; position: relative; max-width: 90vw; max-height: 90vh; overflow-y: auto; box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }
  .modern-modal__close {
    position: absolute; top: 10px; right: 15px; font-size: 24px; background: none; border: none; cursor: pointer; color: var(--color-foreground); font-family: sans-serif;
  }
  .modern-modal__img { max-width: 100%; height: auto; display: block; border-radius: 6px; }
  
  /* Size Pills (Circles) */
  .modern-variant__btn {
    font-family: var(--font-b) !important;
    width: 46px !important; height: 46px !important;
    border: 1px solid #E2E2E2 !important; border-radius: 50% !important;
    background: #FFFFFF !important; color: #000000 !important;
    cursor: pointer; font-size: 14px !important; font-weight: 500 !important;
    display: flex !important; align-items: center !important; justify-content: center !important; 
    transition: all 0.2s ease; padding: 0 !important;
  }
  .modern-variant__btn.is-active {
    background: #000000 !important; color: #FFFFFF !important; border-color: #000000 !important;
  }
  
  /* Color Swatches (Squares with inner gap) */
  .modern-variant__swatch {
    width: 38px; height: 38px; border-radius: 4px; border: 1px solid var(--color-border);
    cursor: pointer; padding: 0; background-position: center; background-size: cover;
    transition: all 0.2s ease; position: relative;
  }
  .modern-variant__swatch.is-active {
    border: 1px solid #000000; box-shadow: inset 0 0 0 3px #FFFFFF;
  }

  /* Buy Buttons & Quantity */
  .modern-buy__container { display: flex; flex-direction: column; gap: 12px; }
  .modern-buy__row-1 { display: flex; gap: 12px; }
  
  .modern-qty {
    display: flex; align-items: center; justify-content: space-between;
    width: 140px !important; height: 54px !important;
    border: 1px solid #E2E2E2 !important; border-radius: 999px !important;
    padding: 0 15px !important; background: #FFFFFF !important;
  }
  .modern-qty__btn {
    background: transparent !important; border: none !important; font-size: 20px !important; 
    cursor: pointer !important; color: #000000 !important; font-weight: 300 !important; 
    padding: 0 10px !important; display: flex !important; align-items: center !important; justify-content: center !important; box-shadow: none !important;
  }
  .modern-qty__input {
    width: 40px !important; text-align: center !important; border: none !important; 
    font-family: var(--font-b) !important; font-size: 16px !important; 
    background: transparent !important; font-weight: 500 !important; color: #000000 !important;
    padding: 0 !important; box-shadow: none !important; -moz-appearance: textfield !important; 
  }
  .modern-qty__input::-webkit-outer-spin-button, .modern-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .modern-btn {
    font-family: var(--font-btn) !important; flex-grow: 1; height: 54px !important; border-radius: 999px !important; 
    font-size: 16px !important; font-weight: 500 !important; cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: all 0.2s ease; border: none !important; width: 100%; letter-spacing: 0.3px !important; text-decoration: none !important;
  }
  
  /* Add To Cart Override */
  .modern-btn--add { background: #EFEFEF !important; color: #000000 !important; font-weight: 600 !important; }
  .modern-btn--add:hover:not(:disabled) { opacity: 0.85; }

  /* Dynamic Checkout override to protect from Dawn */
  .modern-buy__dynamic-checkout { margin-top: 0 !important; width: 100%; }
  .modern-buy__dynamic-checkout .shopify-payment-button { width: 100% !important; }
  .modern-buy__dynamic-checkout .shopify-payment-button__button--unbranded,
  .modern-buy__dynamic-checkout .shopify-payment-button__button--hidden,
  .modern-buy__dynamic-checkout .shopify-payment-button__button {
    font-family: var(--font-btn) !important; width: 100% !important; border-radius: 999px !important;
    height: 54px !important; min-height: 54px !important; font-size: 16px !important; font-weight: 600 !important;
    letter-spacing: 0.3px !important; border: none !important; transition: opacity 0.2s ease !important;
    background: {{ color_schema }} !important; color: #FFFFFF !important;
  }
  .modern-buy__dynamic-checkout .shopify-payment-button__button:hover { opacity: 0.85 !important; }
  .modern-buy__dynamic-checkout .shopify-payment-button__button::before,
  .modern-buy__dynamic-checkout .shopify-payment-button__button::after,
  .modern-buy__dynamic-checkout .shopify-payment-button__button--unbranded::after,
  .modern-buy__dynamic-checkout .shopify-payment-button__button--unbranded::before {
    display: none !important; box-shadow: none !important; border: none !important;
  }

  /* Trust & Utilities */
  .modern-trust { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; padding-top: 10px; }
  .modern-trust__item { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 500; color: var(--color-foreground); }
  .modern-trust__item svg { width: 18px; height: 18px; stroke: currentColor; }

  /* Accordion */
  .modern-accordion { border-top: 1px solid var(--color-border); }
  .modern-accordion:last-of-type { border-bottom: 1px solid var(--color-border); }
  .modern-accordion__btn {
    width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 20px 0;
    background: none; border: none; font-family: var(--font-h); font-size: 16px; font-weight: 600; color: var(--color-foreground-heading); cursor: pointer;
  }
  .modern-accordion__icon { font-size: 24px; font-weight: 300; transition: transform 0.3s ease; }
  .modern-accordion__content { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
  .modern-accordion__inner { padding-bottom: 20px; font-family: var(--font-b); font-size: 15px; color: var(--color-foreground-muted); line-height: 1.6; }
  .modern-accordion.is-open .modern-accordion__content { max-height: 600px; }
  .modern-accordion.is-open .modern-accordion__icon { transform: rotate(45deg); }
  
  /* Mobile Adjustments */
  @media screen and (max-width: 768px) {
    .modern-buy__row-1 { flex-direction: column; }
    .modern-qty { width: 100% !important; }
  }
{%- endstyle -%}

{%- assign product = section.settings.product | default: product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}" id="ModernProduct-{{ section.id }}">
  <div class="modern-product-{{ section.id }}">
    <div class="modern-product__grid">
      
      <!-- ================= LEFT: MEDIA GALLERY ================= -->
      <div class="modern-product__media-col">
        {%- if product != blank and product.media.size > 0 -%}
          <div class="modern-product__gallery">
            {%- if product.media.size > 1 -%}
              <div class="modern-product__thumbs">
                {%- for media in product.media -%}
                  <div class="modern-product__thumb {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}">
                    {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="modern-product__main-image-wrapper">
              {%- if product.media.size > 1 -%}
                <div class="modern-product__arrow modern-product__arrow--prev"><svg viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
              {%- endif -%}
              <div class="modern-product__slider" id="Slider-{{ section.id }}">
                {%- for media in product.media -%}
                  <div class="modern-product__slide" data-index="{{ forloop.index0 }}">
                     <img src="{{ media.preview_image | image_url: width: 1200 }}" alt="{{ media.alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                  </div>
                {%- endfor -%}
              </div>
              {%- if product.media.size > 1 -%}
                <div class="modern-product__arrow modern-product__arrow--next"><svg viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          <div class="modern-product__main-image-wrapper">{{ 'product-1' | placeholder_svg_tag: 'modern-product__main-image' }}</div>
        {%- endif -%}
      </div>

      <!-- ================= RIGHT: PRODUCT INFO ================= -->
      <div class="modern-product__info-col">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            
            {%- when 'badges' -%}
              <div class="modern-product__block" {{ block.shopify_attributes }}>
                {%- if block.settings.show_new -%}
                  <span class="modern-badge" style="background: {{ block.settings.new_bg }}; color: {{ block.settings.new_color }};">{{ block.settings.new_text }}</span>
                {%- endif -%}
                {%- if block.settings.show_sale and product.compare_at_price > product.price -%}
                  {%- assign saving = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                  <span class="modern-badge" style="background: var(--accent-color); color: #fff;">{{ block.settings.sale_text | replace: '[%]', saving | append: '%' }}</span>
                {%- endif -%}
              </div>

            {%- when 'title' -%}
              <div class="modern-product__block" {{ block.shopify_attributes }}>
                <h1 class="modern-product__title">{{ product.title | default: 'Example Product Title' }}</h1>
                {%- if block.settings.show_reviews -%}
                  <div class="modern-product__reviews">
                    <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <span>{{ block.settings.review_text }}</span>
                  </div>
                {%- endif -%}
              </div>

            {%- when 'price' -%}
              <div class="modern-product__block" {{ block.shopify_attributes }}>
                <div class="modern-product__price-wrap">
                  <span class="modern-product__price">{{ current_variant.price | default: 7900 | money }}</span>
                  {%- if current_variant.compare_at_price > current_variant.price -%}
                    <span class="modern-product__compare-price">{{ current_variant.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>
                <div class="modern-product__tax-note">Shipping calculated at checkout.</div>
              </div>

            {%- when 'promo_banner' -%}
              <div class="modern-product__block modern-promo-banner" id="Promo-{{ block.id }}" style="background-color: {{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
                <svg class="promo-icon" style="color: {{ block.settings.icon_color }};" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                <div class="modern-promo-banner__content">
                  <h5 style="color: {{ block.settings.text_color }};">{{ block.settings.heading }}</h5>
                  <p style="color: {{ block.settings.text_color }};">{{ block.settings.text }} 
                    {% if block.settings.link_url != blank %}
                      <a href="{{ block.settings.link_url }}" style="color: {{ block.settings.text_color }};">{{ block.settings.link_text }}</a>
                    {% endif %}
                  </p>
                </div>
                <button class="modern-promo-banner__close" onclick="document.getElementById('Promo-{{ block.id }}').style.display='none'">
                  <svg style="color: {{ block.settings.icon_color }};" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              </div>

            {%- when 'description' -%}
              <div class="modern-product__block" {{ block.shopify_attributes }}>
                <div class="modern-product__desc">
                  {{ product.description | strip_html | truncatewords: 30 | default: 'Elevate your everyday wardrobe with our carefully crafted items. Made with quality materials to ensure long-lasting comfort and style.' }}
                </div>
              </div>

            {%- when 'stock' -%}
              <div class="modern-product__block" {{ block.shopify_attributes }}>
                {%- assign bg_alpha = block.settings.stock_color | color_modify: 'alpha', 0.1 -%}
                <div class="modern-product__stock" style="background: {{ bg_alpha }}; color: {{ block.settings.stock_color }};">
                  <div class="modern-product__stock-dot" style="background: {{ block.settings.stock_color }};"></div>
                  <span>{{ block.settings.stock_text }}</span>
                </div>
              </div>

            {%- when 'variants' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="modern-product__block" {{ block.shopify_attributes }}>
                  {%- assign swatch_triggers = block.settings.swatch_trigger | downcase | split: ',' -%}
                  
                  {%- for option in product.options_with_values -%}
                    
                    {%- assign is_swatch = false -%}
                    {%- assign opt_name = option.name | downcase -%}
                    {%- if block.settings.enable_swatches -%}
                      {%- for trigger in swatch_triggers -%}
                        {%- assign stripped_trigger = trigger | strip -%}
                        {%- if opt_name contains stripped_trigger -%}
                          {%- assign is_swatch = true -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}

                    <div class="modern-variant__header">
                      <span class="modern-variant__label">{{ option.name }}: <span style="font-weight:400;">{{ option.selected_value }}</span></span>
                      
                      <!-- Size Chart Trigger Logic -->
                      {%- if opt_name contains 'size' and block.settings.size_chart_image != blank -%}
                        <button type="button" class="modern-size-chart-btn js-open-size-chart">Size Chart</button>
                      {%- endif -%}
                    </div>
                    
                    <div class="modern-variant__options" style="margin-bottom: 20px;">
                      {%- for value in option.values -%}
                        {%- if is_swatch -%}
                          {%- assign swatch_color = value | split: ' ' | last | handleize -%}
                          <button type="button" class="modern-variant__swatch {% if option.selected_value == value %}is-active{% endif %}" style="background-color: {{ swatch_color }};" title="{{ value }}" data-value="{{ value | escape }}"></button>
                        {%- else -%}
                          <button type="button" class="modern-variant__btn {% if option.selected_value == value %}is-active{% endif %}" data-value="{{ value | escape }}">
                            {{ value }}
                          </button>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                    
                  {%- endfor -%}

                  <!-- Size Chart Modal Pop-up -->
                  {%- if block.settings.size_chart_image != blank -%}
                    <div id="SizeChartModal-{{ section.id }}" class="modern-modal">
                      <div class="modern-modal__inner">
                        <button type="button" class="modern-modal__close js-close-size-chart">×</button>
                        <img src="{{ block.settings.size_chart_image | image_url: width: 800 }}" alt="Size Chart" class="modern-modal__img" loading="lazy">
                      </div>
                    </div>
                  {%- endif -%}

                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              {%- assign product_form_id = 'product-form-' | append: section.id -%}
              {%- assign can_add_to_cart = false -%}
              {%- if current_variant.available -%}
                {%- assign can_add_to_cart = true -%}
              {%- endif -%}
              <div class="modern-product__block modern-buy-block-{{ section.id }}" {{ block.shopify_attributes }}>
                <form id="{{ product_form_id }}" class="modern-buy__container form" method="post" action="/cart/add" novalidate data-type="add-to-cart-form">
                  <input type="hidden" name="id" value="{{ current_variant.id }}" class="product-variant-id" form="{{ product_form_id }}">
                  <div class="modern-buy__row-1">
                    <div class="modern-qty">
                      <button type="button" class="modern-qty__btn" onclick="this.nextElementSibling.stepDown()">−</button>
                      <input type="number" name="quantity" class="modern-qty__input" value="1" min="1" form="{{ product_form_id }}">
                      <button type="button" class="modern-qty__btn" onclick="this.previousElementSibling.stepUp()">+</button>
                    </div>
                    <button type="submit" name="add" class="modern-btn modern-btn--add" id="MainAddToCart-{{ section.id }}" {% if can_add_to_cart == false %}disabled{% endif %}>
                      <span>{%- if can_add_to_cart -%}{{ block.settings.add_to_cart_text }}{%- else -%}Sold out{%- endif -%}</span>
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="modern-buy__dynamic-checkout" style="margin-top: 10px;">
                      <button type="button" class="modern-btn modern-btn--add" style="opacity:0.9;">Buy it now</button>
                    </div>
                  {%- endif -%}
                </form>
              </div>

            {%- when 'trust_badges' -%}
              <div class="modern-product__block modern-trust" {{ block.shopify_attributes }}>
                <div class="modern-trust__item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                  {{ block.settings.trust_1 }}
                </div>
                <div class="modern-trust__item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {{ block.settings.trust_2 }}
                </div>
              </div>

            {%- when 'accordion' -%}
              <div class="modern-accordion" {{ block.shopify_attributes }}>
                <button type="button" class="modern-accordion__btn">
                  {{ block.settings.title }}
                  <span class="modern-accordion__icon">+</span>
                </button>
                <div class="modern-accordion__content">
                  <div class="modern-accordion__inner">{{ block.settings.content }}</div>
                </div>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

<!-- ================= JAVASCRIPT LOGIC ================= -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const section = document.getElementById('ModernProduct-{{ section.id }}');
    if (!section) return;

    // --- VARIANT SELECTION LOGIC ---
    const variantData = {{ product.variants | json }};
    const variantButtons = section.querySelectorAll('.modern-variant__btn, .modern-variant__swatch');
    const variantInput = section.querySelector('.product-variant-id');

    variantButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        const parentOptions = this.closest('.modern-variant__options');
        parentOptions.querySelectorAll('button').forEach(b => b.classList.remove('is-active'));
        this.classList.add('is-active');

        const selectedValues = Array.from(section.querySelectorAll('.modern-variant__options .is-active'))
                                    .map(b => b.getAttribute('data-value'));

        const matchedVariant = variantData.find(variant => {
          return variant.options.every((val, index) => val === selectedValues[index]);
        });

        if (matchedVariant && variantInput) {
          variantInput.value = matchedVariant.id;
          
          // Dispatch a change event so the theme's native cart drawer knows the variant changed!
          variantInput.dispatchEvent(new Event('change', { bubbles: true }));
          
          window.history.replaceState({}, '', '?variant=' + matchedVariant.id);
          
          // Correctly find and update the label name above the buttons
          const optionsContainer = this.closest('.modern-variant__options');
          if (optionsContainer && optionsContainer.previousElementSibling) {
            const labelSpan = optionsContainer.previousElementSibling.querySelector('.modern-variant__label span');
            if(labelSpan) labelSpan.textContent = this.getAttribute('data-value');
          }
        }
      });
    });

    // --- ACCORDION LOGIC ---
    const accordions = section.querySelectorAll('.modern-accordion__btn');
    accordions.forEach(acc => {
      acc.addEventListener('click', function() {
        const parent = this.parentElement;
        parent.classList.toggle('is-open');
      });
    });

    // --- SIZE CHART MODAL LOGIC ---
    const sizeChartBtn = section.querySelector('.js-open-size-chart');
    const sizeChartModal = section.querySelector('#SizeChartModal-{{ section.id }}');
    const sizeChartClose = section.querySelector('.js-close-size-chart');

    if(sizeChartBtn && sizeChartModal) {
      // Open modal
      sizeChartBtn.addEventListener('click', () => sizeChartModal.classList.add('is-open'));
      // Close modal on X
      if(sizeChartClose) sizeChartClose.addEventListener('click', () => sizeChartModal.classList.remove('is-open'));
      // Close modal on background click
      sizeChartModal.addEventListener('click', (e) => {
        if (e.target === sizeChartModal) sizeChartModal.classList.remove('is-open');
      });
    }

    // --- SLIDER & GALLERY LOGIC ---
    {% if product.media.size > 1 %}
      const slider = section.querySelector('#Slider-{{ section.id }}');
      const slides = section.querySelectorAll('.modern-product__slide');
      const thumbs = section.querySelectorAll('.modern-product__thumb');
      const prevBtn = section.querySelector('.modern-product__arrow--prev');
      const nextBtn = section.querySelector('.modern-product__arrow--next');
      
      if(prevBtn) prevBtn.addEventListener('click', () => slider.scrollBy({ left: -slider.offsetWidth, behavior: 'smooth' }));
      if(nextBtn) nextBtn.addEventListener('click', () => slider.scrollBy({ left: slider.offsetWidth, behavior: 'smooth' }));

      thumbs.forEach((thumb, index) => {
        thumb.addEventListener('click', () => {
          slider.scrollTo({ left: slides[index].offsetLeft, behavior: 'smooth' });
        });
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const index = Array.from(slides).indexOf(entry.target);
            thumbs.forEach(t => t.classList.remove('is-active'));
            if(thumbs[index]) {
              thumbs[index].classList.add('is-active');
              thumbs[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          }
        });
      }, { root: slider, threshold: 0.5 });

      slides.forEach(slide => observer.observe(slide));
    {% endif %}
  });
</script>