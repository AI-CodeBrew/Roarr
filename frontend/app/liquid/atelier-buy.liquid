{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">
<script>document.documentElement.classList.add("at-js");setTimeout(function(){if(!window.__atMotion)document.documentElement.classList.add("at-reveal-all")},3500);</script>
{%- assign m = product.metafields.roarr -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign form_id = 'at-form-' | append: section.id -%}
{%- assign subtitle = m.product_subtitle.value | default: m.product_subtitle -%}
{%- assign price_note = m.atelier_price_note.value | default: m.atelier_price_note -%}
{%- assign delivery = m.delivery_line.value | default: m.delivery_line -%}
{%- assign t1 = m.badge_text_1.value | default: m.badge_text_1 -%}
{%- assign t2 = m.badge_text_2.value | default: m.badge_text_2 -%}
{%- assign t3 = m.badge_text_3.value | default: m.badge_text_3 -%}
{%- assign a1_title = m.atelier_acc_1_title.value | default: m.atelier_acc_1_title | default: 'Details' -%}
{%- assign a1_body = m.atelier_acc_1_body.value | default: m.atelier_acc_1_body -%}
{%- assign a2_title = m.atelier_acc_2_title.value | default: m.atelier_acc_2_title | default: 'Shipping' -%}
{%- assign a2_body = m.atelier_acc_2_body.value | default: m.atelier_acc_2_body -%}
{%- assign a3_title = m.atelier_acc_3_title.value | default: m.atelier_acc_3_title | default: 'Returns & refunds' -%}
{%- assign a3_body = m.atelier_acc_3_body.value | default: m.atelier_acc_3_body -%}
{%- assign a4_title = m.atelier_acc_4_title.value | default: m.atelier_acc_4_title | default: 'Payment' -%}
{%- assign a4_body = m.atelier_acc_4_body.value | default: m.atelier_acc_4_body -%}
{%- assign txt_in = m.atelier_in_stock.value | default: m.atelier_in_stock | default: 'In stock' -%}
{%- assign txt_low = m.atelier_low_stock.value | default: m.atelier_low_stock | default: 'Only [n] left' -%}
{%- assign txt_added = m.atelier_added.value | default: m.atelier_added | default: 'Added to your bag' -%}
{%- assign txt_view = m.atelier_view_bag.value | default: m.atelier_view_bag | default: 'View bag' -%}
{%- assign txt_checkout = m.atelier_checkout.value | default: m.atelier_checkout | default: 'Checkout' -%}
{%- assign txt_reviews = m.atelier_reviews_label.value | default: m.atelier_reviews_label | default: 'reviews' -%}
{%- capture txt_add -%}{%- render 'snippets/roarr-ui-string', key: 'add_to_cart' -%}{%- endcapture -%}
{%- capture txt_sold -%}{%- render 'snippets/roarr-ui-string', key: 'sold_out' -%}{%- endcapture -%}
{%- assign rating = product.metafields.reviews.rating.value -%}
{%- assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count -%}
{%- assign shots = 0 -%}
{%- if product.media.size > 0 -%}
  {%- assign shots = product.media.size | at_most: 10 -%}
{%- else -%}
  {%- for i in (1..5) -%}
    {%- assign key = 'product_image_' | append: i -%}
    {%- assign probe = m[key].value | default: m[key] -%}
    {%- if probe != blank -%}{%- assign shots = shots | plus: 1 -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign dock_img = product.media.first.preview_image | default: product.media.first | default: m.product_image_1.value | default: m.product_image_1 -%}
{%- assign sold_out = false -%}
{%- if variant.available == false -%}{%- assign sold_out = true -%}{%- endif -%}
<section class="at at--paper at-buy" id="at-purchase" data-at-buy data-txt-in="{{ txt_in | escape }}" data-txt-low="{{ txt_low | escape }}" data-txt-sold="{{ txt_sold | strip | escape }}" data-txt-add="{{ txt_add | strip | escape }}" data-txt-added="{{ txt_added | escape }}" data-txt-view="{{ txt_view | escape }}" data-txt-checkout="{{ txt_checkout | escape }}">
  <div class="at-wrap at-buy__grid">
    <div class="at-gal" data-at-gal data-at-reveal="fade">
      <div class="at-gal__rail">
        {%- if shots > 1 -%}
        <ul class="at-gal__thumbs" role="list" data-at-thumbs>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media limit: 10 -%}
              {%- assign src = media.preview_image | default: media -%}
              <li><button type="button" class="at-gal__thumb{% if forloop.first %} is-on{% endif %}" data-at-thumb aria-label="{{ product.title | escape }} {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ src | image_url: width: 180 }}" alt="" width="90" height="100" loading="lazy" decoding="async"></button></li>
            {%- endfor -%}
          {%- else -%}
            {%- assign n = 0 -%}
            {%- for i in (1..5) -%}
              {%- assign key = 'product_image_' | append: i -%}
              {%- assign src = m[key].value | default: m[key] -%}
              {%- if src != blank -%}
                <li><button type="button" class="at-gal__thumb{% if n == 0 %} is-on{% endif %}" data-at-thumb aria-label="{{ product.title | escape }} {{ i }}" aria-current="{% if n == 0 %}true{% else %}false{% endif %}"><img src="{{ src | image_url: width: 180 }}" alt="" width="90" height="100" loading="lazy" decoding="async"></button></li>
                {%- assign n = n | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
        {%- endif -%}
      </div>
      <div class="at-gal__stage" data-at-stage>
        <ul class="at-gal__slides" role="list">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media limit: 10 -%}
              {%- assign src = media.preview_image | default: media -%}
              <li class="at-gal__slide{% if forloop.first %} is-on{% endif %}" data-at-slide data-zoom="{{ src | image_url: width: 2000 }}"><img src="{{ src | image_url: width: 1000 }}" srcset="{{ src | image_url: width: 600 }} 600w, {{ src | image_url: width: 1000 }} 1000w, {{ src | image_url: width: 1400 }} 1400w" sizes="(min-width: 990px) 50vw, 100vw" alt="{{ media.alt | default: product.title | escape }}" width="1000" height="1100"{% if forloop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async" draggable="false"></li>
            {%- endfor -%}
          {%- else -%}
            {%- assign n = 0 -%}
            {%- for i in (1..5) -%}
              {%- assign key = 'product_image_' | append: i -%}
              {%- assign src = m[key].value | default: m[key] -%}
              {%- if src != blank -%}
                <li class="at-gal__slide{% if n == 0 %} is-on{% endif %}" data-at-slide data-zoom="{{ src | image_url: width: 2000 }}"><img src="{{ src | image_url: width: 1000 }}" srcset="{{ src | image_url: width: 600 }} 600w, {{ src | image_url: width: 1000 }} 1000w, {{ src | image_url: width: 1400 }} 1400w" sizes="(min-width: 990px) 50vw, 100vw" alt="{{ src.alt | default: product.title | escape }}" width="1000" height="1100"{% if n == 0 %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async" draggable="false"></li>
                {%- assign n = n | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
        {%- if shots > 0 -%}
        <button type="button" class="at-gal__open" data-at-open aria-label="Open full-screen gallery"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg></button>
        {%- endif -%}
        {%- if shots > 1 -%}
        <button type="button" class="at-gal__arrow at-gal__arrow--prev" data-at-prev aria-label="Previous image"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" class="at-gal__arrow at-gal__arrow--next" data-at-next aria-label="Next image"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
        <p class="at-gal__count" aria-hidden="true"><b data-at-idx>01</b><i></i>{% if shots < 10 %}0{% endif %}{{ shots }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="at-buy__info" data-at-reveal="up" style="--d:.1s">
      {%- if product.type != blank or product.vendor != blank -%}<p class="at-eyebrow">{{ product.type | default: product.vendor }}</p>{%- endif -%}
      <h1 class="at-h at-buy__title">{{ product.title }}</h1>
      {%- if rating != blank and rating_count != blank -%}
        {%- assign scale = rating.scale_max.value | default: rating.scale_max | default: 5 -%}
        {%- assign rating_value = rating.rating.value | default: rating.rating -%}
        {%- assign pct = rating_value | times: 100.0 | divided_by: scale | round -%}
        <p class="at-rating"><span class="at-stars" style="--p:{{ pct }}%" role="img" aria-label="{{ rating_value }} / {{ scale }}">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span>{{ rating_value }}</span><span class="at-rating__n">{{ rating_count }} {{ txt_reviews }}</span></p>
      {%- endif -%}
      <p class="at-price">
        <span class="at-price__now" data-at-price>{{ variant.price | default: product.price | money }}</span>
        <s class="at-price__was" data-at-compare{% unless product.compare_at_price > product.price %} hidden{% endunless %}>{{ product.compare_at_price | money }}</s>
        <span class="at-save" data-at-save{% unless product.compare_at_price > product.price %} hidden{% endunless %}>{%- if product.compare_at_price > product.price -%}-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round }}%{%- endif -%}</span>
      </p>
      {%- if price_note != blank -%}<p class="at-buy__note">{{ price_note }}</p>{%- endif -%}
      {%- if subtitle != blank -%}<p class="at-buy__lede">{{ subtitle }}</p>{%- endif -%}

      <div id="{{ form_id }}" class="at-form">
        {%- if product.options_with_values.size > 0 and product.variants.size > 1 -%}
          <div class="at-opts">
            {%- for option in product.options_with_values -%}
              {%- assign opt_i = forloop.index0 -%}
              {%- assign selected = variant.options[opt_i] -%}
              <fieldset class="at-opt" data-at-opt>
                <legend>{{ option.name }}<span data-at-optval>{{ selected }}</span></legend>
                <div class="at-opt__vals">
                  {%- for value in option.values -%}
                    {%- assign vname = value.name | default: value -%}
                    {%- assign sw_color = value.swatch.color -%}
                    {%- assign sw_image = value.swatch.image -%}
                    <label class="at-opt__v{% if sw_color != blank or sw_image != blank %} at-opt__v--sw{% endif %}"{% if sw_image != blank %} style="--sw:url({{ sw_image | image_url: width: 90 }})"{% elsif sw_color != blank %} style="--sw:{{ sw_color }}"{% endif %}>
                      <input type="radio" name="at-o-{{ section.id }}-{{ opt_i }}" value="{{ vname | escape }}"{% if vname == selected %} checked{% endif %}>
                      <span>{{ vname }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
          <input type="hidden" name="id" value="{{ variant.id }}" data-at-id>
        {%- elsif product.variants.size > 1 -%}
          <div class="at-opts">
            <label class="at-opt__lbl" for="at-sel-{{ section.id }}">{{ product.options | join: ' / ' }}</label>
            <select class="at-select" id="at-sel-{{ section.id }}" name="id" data-at-id data-at-select>
              {%- for v in product.variants -%}
                <option value="{{ v.id }}"{% if v.id == variant.id %} selected{% endif %}{% if v.available == false %} disabled{% endif %}>{{ v.title }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ variant.id }}" data-at-id>
        {%- endif -%}

        <p class="at-stock" data-at-stock data-state="{% if sold_out %}out{% elsif variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 5 %}low{% else %}in{% endif %}" role="status"><i></i><span>{%- if sold_out -%}{{ txt_sold | strip }}{%- elsif variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 5 -%}{{ txt_low | replace: '[n]', variant.inventory_quantity }}{%- else -%}{{ txt_in }}{%- endif -%}</span></p>

        <div class="at-buy__row">
          <div class="at-qty">
            <button type="button" data-at-minus aria-label="Decrease quantity"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h10" stroke="currentColor" stroke-width="1.4"/></svg></button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity" data-at-qty>
            <button type="button" data-at-plus aria-label="Increase quantity"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h10M6 1v10" stroke="currentColor" stroke-width="1.4"/></svg></button>
          </div>
          <button class="at-btn at-btn--solid at-btn--atc" type="submit" data-at-atc{% if sold_out %} disabled{% endif %}><span class="at-btn__label" data-at-label>{%- if sold_out -%}{{ txt_sold | strip }}{%- else -%}{{ txt_add | strip }}{%- endif -%}</span></button>
        </div>
        <div class="at-checkout" data-at-checkout{% if sold_out %} hidden{% endif %}><button class="at-buynow" type="button">Buy it now</button></div>
        <p class="at-msg" role="alert" data-at-msg></p>
      </div>

      {%- if delivery != blank -%}
        <div class="at-note"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg><p>{{ delivery }}</p></div>
      {%- endif -%}
      {%- if t1 != blank or t2 != blank or t3 != blank -%}
        <ul class="at-trust" role="list">
          {%- if t1 != blank -%}<li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg><span>{{ t1 }}</span></li>{%- endif -%}
          {%- if t2 != blank -%}<li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 010 12h-3"/></svg><span>{{ t2 }}</span></li>{%- endif -%}
          {%- if t3 != blank -%}<li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="1"/><path d="M8 11V8a4 4 0 018 0v3"/></svg><span>{{ t3 }}</span></li>{%- endif -%}
        </ul>
      {%- endif -%}

      <div class="at-accs">
        {%- if product.description != blank or a1_body != blank -%}
          <details class="at-acc" open>
            <summary>{{ a1_title }}</summary>
            <div class="at-acc__body"><div class="at-acc__in">{%- if product.description != blank -%}{{ product.description }}{%- else -%}<p>{{ a1_body }}</p>{%- endif -%}</div></div>
          </details>
        {%- endif -%}
        {%- if a2_body != blank or shop.shipping_policy.url != blank -%}
          <details class="at-acc">
            <summary>{{ a2_title }}</summary>
            <div class="at-acc__body"><div class="at-acc__in">{%- if a2_body != blank -%}<p>{{ a2_body }}</p>{%- endif -%}{%- if shop.shipping_policy.url != blank -%}<p><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></p>{%- endif -%}</div></div>
          </details>
        {%- endif -%}
        {%- if a3_body != blank or shop.refund_policy.url != blank -%}
          <details class="at-acc">
            <summary>{{ a3_title }}</summary>
            <div class="at-acc__body"><div class="at-acc__in">{%- if a3_body != blank -%}<p>{{ a3_body }}</p>{%- endif -%}{%- if shop.refund_policy.url != blank -%}<p><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></p>{%- endif -%}</div></div>
          </details>
        {%- endif -%}
        {%- if a4_body != blank or shop.enabled_payment_types.size > 0 -%}
          <details class="at-acc">
            <summary>{{ a4_title }}</summary>
            <div class="at-acc__body"><div class="at-acc__in">
              {%- if a4_body != blank -%}<p>{{ a4_body }}</p>{%- endif -%}
              {%- if shop.enabled_payment_types.size > 0 -%}
                <ul class="at-pay" role="list" aria-label="{{ a4_title | escape }}">
                  {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'at-pay__icon' }}</li>{%- endfor -%}
                </ul>
              {%- endif -%}
            </div></div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="at-dock" data-at-dock aria-hidden="true">
    <div class="at-dock__in">
      {%- if dock_img != blank -%}<img class="at-dock__img" src="{{ dock_img | image_url: width: 120 }}" alt="" width="52" height="52">{%- endif -%}
      <div class="at-dock__info"><strong>{{ product.title }}</strong><span><em data-at-dock-var></em><span data-at-dock-price>{{ variant.price | default: product.price | money }}</span></span></div>
      <button class="at-btn at-btn--solid" type="submit" form="{{ form_id }}" tabindex="-1" data-at-dock-btn{% if sold_out %} disabled{% endif %}><span class="at-btn__label" data-at-dock-label>{%- if sold_out -%}{{ txt_sold | strip }}{%- else -%}{{ txt_add | strip }}{%- endif -%}</span></button>
    </div>
  </div>

  <dialog class="at-lb" data-at-lb aria-label="{{ product.title | escape }}">
    <button type="button" class="at-lb__close" data-at-lb-close aria-label="Close"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
    <button type="button" class="at-lb__nav at-lb__nav--prev" data-at-lb-prev aria-label="Previous image"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
    <button type="button" class="at-lb__nav at-lb__nav--next" data-at-lb-next aria-label="Next image"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
    <div class="at-lb__view" data-at-lb-view><img width="1600" height="1760" alt="" data-at-lb-img draggable="false"></div>
    <p class="at-lb__count"><b data-at-lb-idx>01</b><i></i>{% if shots < 10 %}0{% endif %}{{ shots }}</p>
  </dialog>

  <script type="application/json" data-at-variants>
  [
  {%- for v in product.variants -%}
    {%- assign mi = -1 -%}
    {%- if v.featured_media and product.media.size > 0 -%}
      {%- for md in product.media limit: 10 -%}{%- if md.id == v.featured_media.id -%}{%- assign mi = forloop.index0 -%}{%- endif -%}{%- endfor -%}
    {%- endif -%}
    {%- assign cap = 0 -%}
    {%- if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' -%}{%- assign cap = v.inventory_quantity -%}{%- endif -%}
    {"id":{{ v.id | json }},"title":{{ v.title | json }},"options":{{ v.options | json }},"available":{% if v.available == false %}false{% else %}true{% endif %},"price":{{ v.price | money | json }},"p":{{ v.price | default: 0 }},"cmp":{{ v.compare_at_price | default: 0 }},"cmpf":{{ v.compare_at_price | money | json }},"media":{{ mi }},"managed":{% if v.inventory_management == 'shopify' %}true{% else %}false{% endif %},"cap":{{ cap | default: 0 }}}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  ]
  </script>
  {%- if product.url != blank -%}<script type="application/ld+json">{{ product | structured_data }}</script>{%- endif -%}
</section>
<style>
  .at { --at-ink: #14110E; --at-ink-2: #1E1A16; --at-bone: #F2EDE4; --at-paper: #FBF9F5; --at-sand: #E8DFD0; --at-line: #DCD3C4; --at-muted: #6D645A; --at-soft: #A89E90; --at-accent: #B38B52; --at-serif: "Cormorant Garamond", "Iowan Old Style", "Times New Roman", serif; --at-sans: "Hanken Grotesk", -apple-system, "Segoe UI", sans-serif; --at-ease: cubic-bezier(.22, .8, .2, 1); --at-pad: clamp(20px, 4vw, 64px); --at-edge: max(var(--at-pad), calc((100vw - 1440px) / 2)); position: relative; font-family: var(--at-sans); font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  .at *, .at *::before, .at *::after { box-sizing: border-box; }
  :where(.at) :is(p, li, a, span, strong, em, b, s, small, cite, dt, dd, label, summary, blockquote, footer) { font-size: inherit; font-weight: inherit; line-height: inherit; color: inherit; }
  .at, .at :is(p, li, a, span, label, button, input, select, summary, dt, dd, cite, small, strong, em, b, s, blockquote, footer, div) { font-family: var(--at-sans) !important; }
  .at :is(h1, h2, h3, h4, .at-h, .at-h *, .at-hero__amount, .at-story__n, .at-story__sig, .at-feat__num, .at-feat__name, .at-feat__count, .at-feat__count *, .at-price__now, .at-gal__count, .at-gal__count *, .at-proof__quote p, .at-proof__score, .at-closing__price, .at-toast__n, .at-specs__n, .at-lb__count, .at-lb__count *, .at-card__title, .at-card__title *, .at-dock__info strong) { font-family: var(--at-serif) !important; }
  :where(.at) :is(h1, h2, h3, h4, p, figure, ul, ol, dl, dd, blockquote) { margin: 0; padding: 0; }
