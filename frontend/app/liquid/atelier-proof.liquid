{%- capture kl_rtl_html -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">
<script>document.documentElement.classList.add("at-js");setTimeout(function(){if(!window.__atMotion)document.documentElement.classList.add("at-reveal-all")},3500);</script>
{%- assign m = product.metafields.roarr -%}
{%- assign eyebrow = m.atelier_proof_eyebrow.value | default: m.atelier_proof_eyebrow | default: 'Made to be lived with' -%}
{%- assign quote = m.atelier_proof_quote.value | default: m.atelier_proof_quote -%}
{%- assign by = m.atelier_proof_by.value | default: m.atelier_proof_by -%}
{%- assign img = m.feature_image.value | default: m.feature_image -%}
{%- if img == blank and product.media.size > 4 -%}{%- assign img = product.media[4].preview_image | default: product.media[4] -%}{%- endif -%}
{%- assign rating = product.metafields.reviews.rating.value -%}
{%- assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count -%}
{%- assign trust_count = 0 -%}
{%- for i in (1..4) -%}
  {%- assign tkey = 'atelier_trust_' | append: i | append: '_title' -%}
  {%- assign tt = m[tkey].value | default: m[tkey] -%}
  {%- if tt != blank -%}{%- assign trust_count = trust_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if quote != blank or trust_count > 0 or section.blocks.size > 0 -%}
<section class="at at--dark at-proof" id="at-proof">
  {%- if quote != blank or rating != blank -%}
  <div class="at-wrap at-proof__top">
    <p class="at-eyebrow at-eyebrow--center" data-at-reveal="fade">{{ eyebrow }}</p>
    {%- if quote != blank -%}
      <blockquote class="at-proof__quote" data-at-reveal="up" style="--d:.08s">
        <p>{{ quote }}</p>
        {%- if by != blank -%}<footer>{{ by }}</footer>{%- endif -%}
      </blockquote>
    {%- endif -%}
    {%- if rating != blank and rating_count != blank -%}
      {%- assign scale = rating.scale_max.value | default: rating.scale_max | default: 5 -%}
      {%- assign rating_value = rating.rating.value | default: rating.rating -%}
      {%- assign pct = rating_value | times: 100.0 | divided_by: scale | round -%}
      <p class="at-proof__rating" data-at-reveal="up"><span class="at-proof__score">{{ rating_value }}</span><span class="at-proof__stars" style="--p:{{ pct }}%" role="img" aria-label="{{ rating_value }} / {{ scale }}">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span>{{ rating_count }}</span></p>
    {%- endif -%}
  </div>
  {%- endif -%}
  {%- if img != blank -%}
  <figure class="at-proof__band" data-at-reveal="mask">
    <div class="at-proof__par" data-at-par=".08"><img width="2000" height="860" src="{{ img | image_url: width: 1800 }}" srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 2200 }} 2200w" sizes="100vw" alt="{{ img.alt | default: product.title | escape }}" loading="lazy" decoding="async"></div>
  </figure>
  {%- endif -%}
  {%- if section.blocks.size > 0 or trust_count > 0 -%}
  <div class="at-wrap at-proof__low">
    {%- if section.blocks.size > 0 -%}
      <ul class="at-proof__voices" role="list">
        {%- for block in section.blocks -%}
          <li class="at-proof__voice" data-at-reveal="up" style="--d:{{ forloop.index0 | times: 0.1 }}s" {{ block.shopify_attributes }}>
            {%- if block.settings.quote != blank -%}<p>{{ block.settings.quote }}</p>{%- endif -%}
            <div class="at-proof__who">
              {%- if block.settings.photo != blank -%}<img class="at-proof__ava" src="{{ block.settings.photo | image_url: width: 160 }}" alt="{{ block.settings.author | escape }}" width="48" height="48" loading="lazy">{%- endif -%}
              {%- if block.settings.author != blank -%}<cite>{{ block.settings.author }}</cite>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if trust_count > 0 -%}
    <ul class="at-proof__trust" role="list">
      {%- assign icons = 'truck,return,shield,chat' | split: ',' -%}
      {%- for i in (1..4) -%}
        {%- assign tkey = 'atelier_trust_' | append: i | append: '_title' -%}
        {%- assign bkey = 'atelier_trust_' | append: i | append: '_text' -%}
        {%- assign tt = m[tkey].value | default: m[tkey] -%}
        {%- assign tb = m[bkey].value | default: m[bkey] -%}
        {%- if tt != blank -%}
          {%- assign icon = icons[forloop.index0] -%}
          <li data-at-reveal="up" style="--d:{{ forloop.index0 | times: 0.08 }}s">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- case icon -%}
                {%- when 'truck' -%}<path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/>
                {%- when 'return' -%}<path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 010 12h-3"/>
                {%- when 'shield' -%}<path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>
                {%- else -%}<path d="M4 5h16v11H9l-5 4z"/>
              {%- endcase -%}
            </svg>
            <h3>{{ tt }}</h3>
            {%- if tb != blank -%}<p>{{ tb }}</p>{%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
  {%- endif -%}
</section>
<style>
  .at { --at-ink: #14110E; --at-ink-2: #1E1A16; --at-bone: #F2EDE4; --at-paper: #FBF9F5; --at-sand: #E8DFD0; --at-line: #DCD3C4; --at-muted: #6D645A; --at-soft: #A89E90; --at-accent: #B38B52; --at-serif: "Cormorant Garamond", "Iowan Old Style", "Times New Roman", serif; --at-sans: "Hanken Grotesk", -apple-system, "Segoe UI", sans-serif; --at-ease: cubic-bezier(.22, .8, .2, 1); --at-pad: clamp(20px, 4vw, 64px); --at-edge: max(var(--at-pad), calc((100vw - 1440px) / 2)); position: relative; font-family: var(--at-sans); font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  .at *, .at *::before, .at *::after { box-sizing: border-box; }
  :where(.at) :is(p, li, a, span, strong, em, b, s, small, cite, dt, dd, label, summary, blockquote, footer) { font-size: inherit; font-weight: inherit; line-height: inherit; color: inherit; }
  .at, .at :is(p, li, a, span, label, button, input, select, summary, dt, dd, cite, small, strong, em, b, s, blockquote, footer, div) { font-family: var(--at-sans) !important; }
  .at :is(h1, h2, h3, h4, .at-h, .at-h *, .at-hero__amount, .at-story__n, .at-story__sig, .at-feat__num, .at-feat__name, .at-feat__count, .at-feat__count *, .at-price__now, .at-gal__count, .at-gal__count *, .at-proof__quote p, .at-proof__score, .at-closing__price, .at-toast__n, .at-specs__n, .at-lb__count, .at-lb__count *, .at-card__title, .at-card__title *, .at-dock__info strong) { font-family: var(--at-serif) !important; }
  :where(.at) :is(h1, h2, h3, h4, p, figure, ul, ol, dl, dd, blockquote) { margin: 0; padding: 0; }
  :where(.at) :is(ul, ol) { list-style: none; }
  :where(.at) img { display: block; max-width: 100%; }
  :where(.at) button { font: inherit; color: inherit; }
  :where(.at) a { color: inherit; }
  .at :focus-visible { outline: 2px solid var(--at-accent); outline-offset: 3px; }
  .at--dark { --at-fg: var(--at-bone); --at-bg: var(--at-ink); --at-inv-fg: var(--at-ink); --at-inv-bg: var(--at-bone); --at-rule: rgb(242 237 228 / .16); --at-sub: var(--at-soft); background: var(--at-ink); color: var(--at-bone); }
  .at--light, .at--paper, .at--sand { --at-fg: var(--at-ink); --at-inv-fg: var(--at-bone); --at-inv-bg: var(--at-ink); --at-rule: var(--at-line); --at-sub: var(--at-muted); color: var(--at-ink); }
  .at--light { --at-bg: var(--at-bone); background: var(--at-bone); }
  .at--paper { --at-bg: var(--at-paper); background: var(--at-paper); }
  .at--sand { --at-bg: var(--at-sand); --at-rule: #CFC3AF; background: var(--at-sand); }
  .at-wrap { width: min(1440px, calc(100% - var(--at-pad) * 2)); margin-inline: auto; }
  .at-eyebrow { display: flex; align-items: center; gap: 14px; font-size: 12px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--at-accent); }
  .at-eyebrow::before { content: ""; flex: none; width: 36px; height: 1px; background: currentColor; }
  .at-eyebrow--center { justify-content: center; }
  .at-eyebrow--center::after { content: ""; flex: none; width: 36px; height: 1px; background: currentColor; }
  .at-h { font-family: var(--at-serif); font-weight: 400; line-height: .98; letter-spacing: -.02em; text-wrap: balance; overflow-wrap: break-word; }
  .at-btn { position: relative; isolation: isolate; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 56px; padding: 0 38px; border: 1px solid var(--b, currentColor); background: var(--bg, transparent); color: var(--fg, inherit); font: 600 12px/1 var(--at-sans); letter-spacing: .18em; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: transform .45s var(--at-ease), color .35s ease, border-color .35s ease; }
  .at-btn::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--wipe, var(--at-accent)); transform: scaleY(0); transform-origin: 50% 100%; transition: transform .5s var(--at-ease); }
  .at-btn:hover::before, .at-btn:focus-visible::before { transform: scaleY(1); }
  .at-btn--solid { --bg: var(--at-inv-bg); --fg: var(--at-inv-fg); --b: var(--at-inv-bg); --wipe: var(--at-accent); }
  .at-btn--solid:hover, .at-btn--solid:focus-visible { color: var(--at-ink); border-color: var(--at-accent); }
  .at-btn--ghost { --b: currentColor; --wipe: var(--at-fg); }
  .at-btn--ghost:hover, .at-btn--ghost:focus-visible { color: var(--at-bg); }
  .at-btn[disabled] { opacity: .4; cursor: not-allowed; pointer-events: none; }
  .at-btn svg { flex: none; }
  .at-btn.is-loading .at-btn__label { opacity: 0; }
  .at-btn.is-loading::after { content: ""; position: absolute; width: 18px; height: 18px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: at-spin .7s linear infinite; }
  @keyframes at-spin { to { transform: rotate(360deg); } }
  .at-link { position: relative; display: inline-flex; align-items: center; gap: 10px; padding-block: 8px; font: 600 12px/1 var(--at-sans); letter-spacing: .18em; text-transform: uppercase; text-decoration: none; }
  .at-link::after { content: ""; position: absolute; inset: auto 0 2px 0; height: 1px; background: currentColor; transform-origin: 0 50%; transition: transform .5s var(--at-ease); }
  .at-link:hover::after { transform: scaleX(.3); }
  .at-w { display: inline-block; overflow: hidden; vertical-align: top; padding: 0 .04em .14em; margin: 0 -.04em -.14em; }
  .at-w > span { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    html.at-js:not(.at-reveal-all) [data-at-reveal] { transition: opacity .9s var(--at-ease) var(--d, 0s), transform 1.1s var(--at-ease) var(--d, 0s), clip-path 1.3s var(--at-ease) var(--d, 0s); }
    html.at-js:not(.at-reveal-all) [data-at-reveal="up"]:not(.is-in) { opacity: 0; transform: translate3d(0, 32px, 0); }
    html.at-js:not(.at-reveal-all) [data-at-reveal="fade"]:not(.is-in) { opacity: 0; }
    html.at-js:not(.at-reveal-all) [data-at-reveal="mask"] { clip-path: inset(0 0 0 0); }
    html.at-js:not(.at-reveal-all) [data-at-reveal="mask"]:not(.is-in) { clip-path: inset(0 0 100% 0); }
    html.at-js:not(.at-reveal-all) [data-at-reveal="mask"] img { transition: transform 1.8s var(--at-ease) var(--d, 0s); }
    html.at-js:not(.at-reveal-all) [data-at-reveal="mask"]:not(.is-in) img { transform: scale(1.22); }
    html.at-js:not(.at-reveal-all) [data-at-reveal="media"] img { transition: transform 2.2s var(--at-ease) var(--d, 0s), opacity 1.4s ease var(--d, 0s); }
    html.at-js:not(.at-reveal-all) [data-at-reveal="media"]:not(.is-in) img { opacity: 0; transform: scale(1.14); }
    html.at-js:not(.at-reveal-all) [data-at-reveal="split"] .at-w > span { transition: transform 1.1s var(--at-ease); }
    html.at-js:not(.at-reveal-all) [data-at-reveal="split"]:not(.is-in) .at-w > span { transform: translate3d(0, 115%, 0); }
  }
  .at-toast { position: fixed; inset-inline-end: 20px; bottom: 20px; z-index: 9999; display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 14px; align-items: center; width: min(380px, calc(100% - 32px)); padding: 14px; background: var(--at-paper); color: var(--at-ink); border: 1px solid var(--at-line); box-shadow: 0 24px 60px rgb(20 17 14 / .22); opacity: 0; visibility: hidden; transform: translateY(18px); transition: opacity .35s ease, transform .5s var(--at-ease), visibility 0s linear .5s; }
  .at-toast.is-on { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .at-toast img { width: 64px; height: 64px; object-fit: cover; background: var(--at-sand); }
  .at-toast__t { font: 600 11px/1.3 var(--at-sans); letter-spacing: .16em; text-transform: uppercase; color: var(--at-accent); }
  .at-toast__n { margin-top: 4px; font: 500 20px/1.15 var(--at-serif); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .at-toast__v { margin-top: 2px; font-size: 12px; color: var(--at-muted); }
  .at-toast__a { display: flex; gap: 18px; margin-top: 10px; }
  .at-toast__a a { font: 600 11px/1 var(--at-sans); letter-spacing: .16em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 3px; }
  @media (max-width: 749px) { .at-toast { inset-inline: 12px; bottom: 12px; width: auto; } }
  .at-proof { padding-block: clamp(88px, 11vw, 176px) clamp(64px, 8vw, 128px); overflow: hidden; }
  .at-proof__top { display: grid; justify-items: center; gap: clamp(28px, 3.4vw, 48px); text-align: center; margin-bottom: clamp(56px, 8vw, 120px); }
  .at-proof__quote { display: grid; justify-items: center; gap: 28px; max-width: 1080px; }
  .at-proof__quote p { font: italic 300 clamp(32px, 4.6vw, 78px)/1.08 var(--at-serif); letter-spacing: -.02em; text-wrap: balance; }
  .at-proof__quote footer { font: 600 11px/1 var(--at-sans); letter-spacing: .24em; text-transform: uppercase; color: var(--at-soft); }
  .at-proof__rating { display: flex; align-items: center; justify-content: center; gap: 14px; padding-top: 24px; font-size: 14px; color: var(--at-soft); }
  .at-proof__score { font: 400 34px/1 var(--at-serif); color: var(--at-bone); }
  .at-proof__stars { font-size: 15px; letter-spacing: 3px; line-height: 1; background: linear-gradient(90deg, var(--at-accent) var(--p, 0%), rgb(242 237 228 / .2) var(--p, 0%)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .at-proof__band { position: relative; margin: 0; width: 100%; height: clamp(300px, 46vw, 700px); overflow: hidden; background: var(--at-ink-2); }
  .at-proof__par { position: absolute; inset: -10% 0; will-change: transform; }
  .at-proof__par img { width: 100%; height: 100%; object-fit: cover; }
  .at-proof__low { display: grid; gap: clamp(48px, 6vw, 96px); margin-top: clamp(56px, 8vw, 112px); }
  .at-proof__voices { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: clamp(28px, 4vw, 64px); }
  .at-proof__voice { display: grid; align-content: space-between; gap: 22px; }
  .at-proof__voice p { font: 300 clamp(22px, 2vw, 30px)/1.3 var(--at-serif); }
  .at-proof__who { display: flex; align-items: center; gap: 14px; }
  .at-proof__ava { flex: none; width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
  .at-proof__voice cite { font: 600 11px/1 var(--at-sans); letter-spacing: .18em; text-transform: uppercase; font-style: normal; color: var(--at-soft); }
  .at-proof__trust { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--at-rule); }
  .at-proof__trust li { display: grid; align-content: start; gap: 12px; padding: 32px 28px 8px 0; }
  .at-proof__trust li + li { padding-inline-start: 28px; border-inline-start: 1px solid var(--at-rule); }
  .at-proof__trust svg { color: var(--at-accent); }
  .at-proof__trust h3 { font: 400 clamp(22px, 1.9vw, 28px)/1.15 var(--at-serif); }
  .at-proof__trust p { font-size: 14px; line-height: 1.7; color: var(--at-soft); }
  @media (max-width: 959px) {
    .at-proof__trust { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .at-proof__trust li:nth-child(odd) { padding-inline-start: 0; border-inline-start: 0; }
    .at-proof__trust li:nth-child(n + 3) { border-top: 1px solid var(--at-rule); }
  }
  @media (max-width: 539px) {
    .at-proof__band { height: 62vw; min-height: 260px; }
    .at-proof__trust { grid-template-columns: 1fr; }
    .at-proof__trust li, .at-proof__trust li + li { padding: 26px 0 8px; border-inline-start: 0; }
    .at-proof__trust li + li { border-top: 1px solid var(--at-rule); }
  }
</style>
<script>
    (function () {
      if (window.__atMotion) return;
      window.__atMotion = true;
      var doc = document;
      var reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
      var fine = window.matchMedia && matchMedia("(hover: hover) and (pointer: fine)").matches;
      var pars = [];
      var queued = false;
      // Masked items start fully clipped, and a clipped element never counts as intersecting,
      // so those are watched through their parent.
      var io = "IntersectionObserver" in window ? new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          (entry.target.__atFor || [entry.target]).forEach(function (el) { el.classList.add("is-in"); });
          io.unobserve(entry.target);
        });
      }, { threshold: 0.14, rootMargin: "0px 0px -5% 0px" }) : null;
      function split(el) {
        if (el.getAttribute("data-at-split") === "done") return;
        var text = el.textContent.replace(/\s+/g, " ").trim();
        el.setAttribute("aria-label", text);
        el.textContent = "";
        text.split(" ").forEach(function (word, i) {
          var box = doc.createElement("span");
          var inner = doc.createElement("span");
          box.className = "at-w";
          box.setAttribute("aria-hidden", "true");
          inner.textContent = word;
          inner.style.transitionDelay = (0.12 + i * 0.07) + "s";
          box.appendChild(inner);
          el.appendChild(box);
          el.appendChild(doc.createTextNode(" "));
        });
        el.setAttribute("data-at-split", "done");
      }
      function magnet(el) {
        if (el.__atm || reduce || !fine) return;
        el.__atm = 1;
        el.addEventListener("pointermove", function (event) {
          var r = el.getBoundingClientRect();
          el.style.transform = "translate(" + ((event.clientX - r.left - r.width / 2) * 0.18).toFixed(1) + "px," + ((event.clientY - r.top - r.height / 2) * 0.28).toFixed(1) + "px)";
        });
        el.addEventListener("pointerleave", function () { el.style.transform = ""; });
      }
      function frame() {
        if (queued || reduce) return;
        queued = true;
        window.requestAnimationFrame(function () {
          queued = false;
          var vh = window.innerHeight || 800;
          pars.forEach(function (el) {
            var box = el.parentElement.getBoundingClientRect();
            if (box.bottom < -120 || box.top > vh + 120) return;
            var p = Math.max(-1, Math.min(1, ((box.top + box.height / 2) - vh / 2) / vh));
            var speed = parseFloat(el.getAttribute("data-at-par")) || 0.08;
            el.style.transform = "translate3d(0," + (-p * speed * box.height).toFixed(1) + "px,0)";
          });
        });
      }
      function scan() {
        doc.querySelectorAll("[data-at-split]").forEach(split);
        doc.querySelectorAll("[data-at-reveal]").forEach(function (el) {
          if (el.__atr) return;
          el.__atr = 1;
          if (reduce || !io) { el.classList.add("is-in"); return; }
          if (el.getAttribute("data-at-reveal") !== "mask") { io.observe(el); return; }
          var host = el.parentElement;
          if (!host.__atFor) { host.__atFor = []; io.observe(host); }
          host.__atFor.push(el);
        });
        doc.querySelectorAll("[data-at-par]").forEach(function (el) {
          if (el.__atp) return;
          el.__atp = 1;
          pars.push(el);
        });
        doc.querySelectorAll("[data-at-magnet]").forEach(magnet);
        doc.querySelectorAll("a[data-at-jump]").forEach(function (a) {
          if (a.__atj) return;
          a.__atj = 1;
          a.addEventListener("click", function (event) {
            var target = doc.getElementById((a.getAttribute("href") || "").slice(1));
            if (!target) return;
            event.preventDefault();
            target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
          });
        });
        frame();
      }
      window.addEventListener("scroll", frame, { passive: true });
      window.addEventListener("resize", frame);
      doc.addEventListener("shopify:section:load", scan);
      if (doc.readyState === "loading") doc.addEventListener("DOMContentLoaded", scan); else scan();
    })();
</script>
{%- endif -%}
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--atelier" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&family=Noto+Naskh+Arabic:wght@400;500;600&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, s, td, th, dt, dd, blockquote, div) { font-family: "Hanken Grotesk", "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.85 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6, .at-h, .at-h *) { font-family: "Noto Naskh Arabic", "Tajawal", "Cormorant Garamond", serif !important; line-height: 1.4 !important; font-weight: 500 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
