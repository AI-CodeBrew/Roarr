{%- capture kl_rtl_html -%}
{% render 'snippets/play-fonts' %}
{%- assign m = product.metafields.roarr -%}
<section class="pk-ig">
  <div class="pk-ig-wrap">
    <h2>Instagram</h2>
    {%- assign i1 = m.product_image_1.value | default: m.product_image_1 -%}
    {%- assign i2 = m.product_image_2.value | default: m.product_image_2 -%}
    {%- assign i3 = m.product_image_3.value | default: m.product_image_3 -%}
    {%- assign i4 = m.product_image_4.value | default: m.product_image_4 -%}
    {%- assign i5 = m.product_image_5.value | default: m.product_image_5 -%}
    <div class="pk-ig-row">
      {%- if i1 != blank -%}<div class="pk-ig-cell"><img src="{{ i1 }}" alt=""></div>{%- endif -%}
      {%- if i2 != blank -%}<div class="pk-ig-cell"><img src="{{ i2 }}" alt=""></div>{%- endif -%}
      {%- if i3 != blank -%}<div class="pk-ig-cell"><img src="{{ i3 }}" alt=""></div>{%- endif -%}
      {%- if i4 != blank -%}<div class="pk-ig-cell"><img src="{{ i4 }}" alt=""></div>{%- endif -%}
      {%- if i5 != blank -%}<div class="pk-ig-cell"><img src="{{ i5 }}" alt=""></div>{%- endif -%}
    </div>
  </div>
</section>
<style>
  .pk-ig { background: #6F2424; color: #fff; padding: 36px 0 32px; font-family: Poppins, sans-serif; }
  .pk-ig-wrap { width: min(1100px, calc(100% - 48px)); margin: 0 auto; }
  .pk-ig h2 { font-family: "Caveat Brush", cursive !important; font-weight: 400; font-size: 48px; line-height: 1; color: #fff; margin: 0 0 18px; }
  .pk-ig-row { display: flex; gap: 12px; align-items: stretch; }
  .pk-ig-cell { flex: 1 1 0; min-width: 0; border-radius: 16px; overflow: hidden; background: #fff; }
  .pk-ig-cell img { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; display: block; }
  @media (max-width: 800px) {
    .pk-ig-row { flex-wrap: wrap; }
    .pk-ig-cell { flex: 1 1 calc(50% - 6px); }
  }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--play" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: Poppins, "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Caveat Brush", "Lalezar", "Tajawal", cursive !important; line-height: 1.4 !important; font-weight: 400 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
