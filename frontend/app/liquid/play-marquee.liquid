{%- capture kl_rtl_html -%}
{% render 'snippets/play-fonts' %}
{%- assign m = product.metafields.kluck_ai -%}
{%- assign t1 = m.marquee_text_1.value | default: m.marquee_text_1 | default: 'Sale 50% Off' -%}
{%- assign t2 = m.marquee_text_2.value | default: m.marquee_text_2 | default: 'Giving back 10%' -%}
{%- assign t3 = m.marquee_text_3.value | default: m.marquee_text_3 | default: 'Black Friday' -%}
<div class="pk-marquee">
  <div class="pk-track">
    {%- for half in (1..2) -%}
      <div class="pk-set">
        {%- for copy in (1..12) -%}
          <span>{{ t1 }}</span><img src="https://cdn.shopify.com/s/files/1/0446/8228/1123/files/cloud-2.png?v=1726123137" alt="">
          <span>{{ t2 }}</span><img src="https://cdn.shopify.com/s/files/1/0446/8228/1123/files/cloud-2.png?v=1726123137" alt="">
          <span>{{ t3 }}</span><img src="https://cdn.shopify.com/s/files/1/0446/8228/1123/files/cloud-2.png?v=1726123137" alt="">
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
<style>
  [data-liquid-section="play-marquee"] { display: block; width: 100%; max-width: none; margin: 0; padding: 0; overflow: hidden; }
  .pk-marquee { width: 100%; max-width: none; background: #FFC2D4; overflow: hidden; border-top: 1px solid #6F2424; border-bottom: 1px solid #6F2424; }
  .pk-track { display: flex; width: max-content; animation: pk-ticker 40s linear infinite; }
  .pk-set { display: flex; align-items: center; flex: none; }
  .pk-track span { font-family: "Caveat Brush", cursive !important; font-size: 28px; line-height: 1; color: #6F2424; padding: 10px 16px; white-space: nowrap; }
  .pk-track img { width: 22px; height: 22px; flex: none; }
  @keyframes pk-ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
</style>
{%- endcapture -%}
{%- comment -%} Auto RTL: any Arabic-script letter in the output flips this section to right-to-left. {%- endcomment -%}
{%- if kl_rtl_html contains 'ا' or kl_rtl_html contains 'ل' or kl_rtl_html contains 'ي' or kl_rtl_html contains 'ة' -%}
<div class="kl-rtl kl-rtl--play" dir="rtl" style="display: contents">{{ kl_rtl_html }}</div>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Tajawal:wght@400;500;700;800&display=swap">
<style>
  .kl-rtl:is(#kl-rtl, *), .kl-rtl:is(#kl-rtl, *) * { letter-spacing: 0 !important; font-style: normal !important; text-transform: none !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, span, a, button, summary, label, input, select, small, strong, em, b, td, th, blockquote, div) { font-family: Poppins, "Tajawal", "Noto Sans Arabic", sans-serif !important; }
  .kl-rtl:is(#kl-rtl, *) :is(p, li, summary, blockquote) { line-height: 1.8 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) { font-family: "Caveat Brush", "Lalezar", "Tajawal", cursive !important; line-height: 1.4 !important; font-weight: 400 !important; }
  .kl-rtl:is(#kl-rtl, *) :is(h1, h2, h3, h4, h5, h6) * { font-family: inherit !important; }
  .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee), .kl-rtl:is(#kl-rtl, *) :is(.roarr-play-marquee, .pk-marquee) * { direction: ltr; }
</style>
{%- else -%}
{{ kl_rtl_html }}
{%- endif -%}
