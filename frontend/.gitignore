.env
.env.*
!.env.example
!.env.sample

# ----------------------------
# Logs
# ----------------------------
logs/
**/logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------
