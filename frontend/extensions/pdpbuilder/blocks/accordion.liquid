{%- liquid
  unless shop.metafields.app.block_control.value
    break
  endunless

  assign s = block.settings
  assign m = product.metafields.kluck_ai
  assign limit = s.number_of_items | default: 4 | at_most: 4 | at_least: 1
-%}

<link rel="stylesheet" href="{{ 'typography.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'accordion.css' | asset_url }}" media="all">

<div class="app_blocks_class tae-accordion tae-accordion-{{ block.id | replace: '_', '-' | downcase }}{% if s.card_style %} tae-accordion--cards{% endif %}" style="display: none;">
  {%- for i in (1..limit) -%}
    {%- liquid
      assign h_key = 'heading_' | append: i
      assign c_key = 'content_' | append: i
      assign h = s[h_key]
      assign c = s[c_key]

      if s.use_metafields
        assign mh_key = 'product_question_' | append: i
        assign mc_key = mh_key | append: '_answer'
        assign h = m[mh_key].value | default: m[mh_key] | default: h
        assign c = m[mc_key].value | default: m[mc_key] | default: c
      endif
    -%}

    {%- if h != blank or c != blank -%}
      <details class="tae-accordion-item">
        <summary>
          <div class="tae-accordion-header">
            {% if s.show_tick_icon %}<span class="tae-accordion-tick-icon"><img src="{{ 'accordion-tick-icon.svg' | asset_url }}" width="16" height="16" alt="" loading="lazy"></span>{% endif %}
            <p class="tae-accordion-heading">{{ h }}</p>
            <span class="tae-accordion-plus-icon">{{ s.toggle_icon | default: '+' }}</span>
          </div>
        </summary>
        <div class="tae-accordion-body rte">{{ c }}</div>
      </details>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{"name":"Accordion","stylesheet":"typography.css","target":"section","settings":[{"type":"checkbox","id":"use_metafields","label":"Use Roarr metafields","default":true,"info":"When enabled, content will be pulled from product metafields created by Roarr."},{"type":"range","id":"number_of_items","label":"Number of items","min":1,"max":4,"step":1,"default":4},{"type":"checkbox","id":"show_tick_icon","label":"Show check mark icon","default":true},{"type":"text","id":"toggle_icon","label":"Toggle icon character","default":"+"},{"type":"checkbox","id":"card_style","label":"Make each item a card","default":false},{"type":"header","content":"Item 1"},{"type":"text","id":"heading_1","label":"Heading","default":"Enter your text!"},{"type":"richtext","id":"content_1","label":"Content","default":"<p>Enter your text!</p>"},{"type":"header","content":"Item 2"},{"type":"text","id":"heading_2","label":"Heading","default":"Enter your text!"},{"type":"richtext","id":"content_2","label":"Content","default":"<p>Enter your text!</p>"},{"type":"header","content":"Item 3"},{"type":"text","id":"heading_3","label":"Heading","default":"Enter your text!"},{"type":"richtext","id":"content_3","label":"Content","default":"<p>Enter your text!</p>"},{"type":"header","content":"Item 4"},{"type":"text","id":"heading_4","label":"Heading","default":"Enter your text!"},{"type":"richtext","id":"content_4","label":"Content","default":"<p>Enter your text!</p>"}]}
{% endschema %}