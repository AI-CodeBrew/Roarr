{%- liquid
  assign s = block.settings
  assign m = product.metafields.kluck_ai
  assign color = m.color_schema.value | default: m.color_schema | default: '#a34e4e'
  assign icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>'
  if s.use_metafields
    assign heading_meta = product.metafields.kluck_ai.high_impacting_product_heading
    assign heading_content = heading_meta.value | default: heading_meta | default: s.heading
    assign subheading_meta = product.metafields.kluck_ai.high_impacting_product_subheading
    assign subheading_content = subheading_meta.value | default: subheading_meta | default: s.subheading
  else
    assign heading_content = s.heading
    assign subheading_content = s.subheading
  endif
-%}
{%- if shop.metafields.app.block_control.value -%}
<link rel="stylesheet" href="{{ 'typography.css' | asset_url }}" media="all">
<link rel="stylesheet" href="{{ 'heading-subheading.css' | asset_url }}" media="all">
<div id="hl-{{ block.id }}" class="hl-root app_blocks_class" style="--bg-section:{{ color }};--bg-card:#fff;--border-color:#f0f0f0;--text-main:#111;--text-sub:#555;--highlights-wrapper-radius:{{ s.highlights_border_radius | default: 24 }}px;--marquee-speed:{{ s.marquee_speed | default: 20 }}s;display:none;">
  {%- if s.show_heading_subheading -%}
    <div class="tae-heading-subheading">
      {%- if heading_content != blank -%}<h2 class="tae-heading-subheading-heading tae-text-h2" style="color:{{ color }};">{{ heading_content }}</h2>{%- endif -%}
      {%- if subheading_content != blank -%}<div class="tae-heading-subheading-content tae-text-body"><p>{{ subheading_content }}</p></div>{%- endif -%}
    </div>
  {%- endif -%}
  {%- if s.show_highlights -%}
    <div class="hl-section"><div class="hl-container">
      <div class="hl-header"><div class="hl-heading-wrap"><h2 class="tae-text-h2">{{ s.heading_start }}{% if s.heading_italic != blank %} <em>{{ s.heading_italic }}</em>{% endif %}</h2></div></div>
      <div class="hl-marquee-wrapper"><div class="hl-marquee-track">
        {%- capture cards -%}
          <div class="hl-card"><div class="hl-icon">{{ icon }}</div><h3 class="tae-text-h3">Natural Formula</h3><p class="tae-text-body">Crafted with pure ingredients.</p></div>
          <div class="hl-card"><div class="hl-icon">{{ icon }}</div><h3 class="tae-text-h3">Deep Hydration</h3><p class="tae-text-body">Locks in moisture for soft skin.</p></div>
          <div class="hl-card"><div class="hl-icon">{{ icon }}</div><h3 class="tae-text-h3">Visible Results</h3><p class="tae-text-body">Supports healthier-looking skin.</p></div>
          <div class="hl-card"><div class="hl-icon">{{ icon }}</div><h3 class="tae-text-h3">Daily Safe</h3><p class="tae-text-body">Gentle for everyday routine.</p></div>
        {%- endcapture -%}
        {{ cards }}{{ cards }}
      </div></div>
    </div></div>
  {%- endif -%}
</div>
{%- endif -%}

{% schema %} { "name": "Heading Subheading", "target": "section", "settings": [ { "type": "checkbox", "id": "use_metafields", "label": "Use Roarr metafields", "default": true, "info": "When enabled, content will be pulled from product metafields created by Roarr. When disabled, you can manually enter text." }, { "type": "checkbox", "id": "show_heading_subheading", "label": "Show heading + subheading", "default": true }, { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by thousands" }, { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover why people trust our products." }, { "type": "checkbox", "id": "show_highlights", "label": "Show highlights", "default": false }, { "type": "header", "content": "Marquee Settings" }, { "type": "range", "id": "marquee_speed", "min": 10, "max": 60, "step": 1, "default": 20, "unit": "s", "label": "Speed" }, { "type": "range", "id": "highlights_border_radius", "label": "Radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 24 }, { "type": "header", "content": "Header Content" }, { "type": "text", "id": "heading_start", "label": "Heading Main", "default": "Harness nature's power with our" }, { "type": "text", "id": "heading_italic", "label": "Heading Italic", "default": "skincare." } ] } {% endschema %}