{%- liquid
  assign s=block.settings
  assign instance_id=block.id|replace:'_','-'
  assign form_id='buy-now-form-'|append:instance_id
  assign button_border_radius=s.button_border_radius|default:12
  assign quantity_border_radius=s.quantity_border_radius|default:12
  assign quantity_width=s.quantity_width|default:150
  assign quantity_style=s.quantity_style|default:'option1'
  assign button_height=s.button_height|default:48
  assign container_width=s.container_width|default:100
  assign show_add_to_cart=s.show_add_to_cart|default:false
  assign hide_quantity_selector=s.hide_quantity_selector|default:false
  if s.use_metafields != false
    assign color_schema=product.metafields.kluck_ai.color_schema.value|default:product.metafields.kluck_ai.color_schema|default:'#a34e4e'
  else
    assign color_schema=s.button_color|default:'#a34e4e'
  endif
  if product
  assign variant=product.selected_or_first_available_variant
  endif
  -%}
  {%- assign render_flag=shop.metafields.app.block_control.value -%}
  {%- if render_flag==true -%}
  <link rel="stylesheet" href="{{'typography.css'|asset_url}}" media="all">
  <link rel="stylesheet" href="{{'buy-now-button.css'|asset_url}}" media="all">
  <script src="{{'buy-now-button.js'|asset_url}}" defer></script>
  {%- assign alignment = s.alignment | default: 'center' -%}
  <div class="tae-buy-now-button tae-buy-now-button-{{instance_id}} tae-buy-now-button--align-{{alignment}} tae-buy-now-quantity-style-{{quantity_style}} app_blocks_class" style="--buy-now-container-width:{{ container_width }}%;--buy-now-button-gap:12px;--button-border-radius:{{button_border_radius}}px;--quantity-border-radius:{{quantity_border_radius}}px;--quantity-width:{{quantity_width}}px;--button-height:{{button_height}}px;--payment-button-color:{{color_schema}};display:none;">
  <div class="tae-buy-now-button-wrapper">
  {%- if product -%}
  {%- form 'product', product, id: form_id, class: 'tae-buy-now-form' -%}
  <input type="hidden" name="id" value="{{variant.id}}" data-variant-input-{{instance_id}}>
  <div class="tae-buy-now-button-container{% if show_add_to_cart %} tae-buy-now-button-container--stacked{% endif %}">
  {%- if show_add_to_cart -%}
  <div class="tae-buy-now-stacked-top">
  {%- endif -%}
  {%- unless hide_quantity_selector -%}
  <div class="tae-buy-now-quantity-wrapper">
  {%- if quantity_style == 'option1' -%}
  <div class="tae-buy-now-quantity-selector tae-buy-now-quantity-selector--style-1">
  <button type="button" class="tae-buy-now-quantity-btn tae-buy-now-quantity-minus" aria-label="Decrease quantity">−</button>
  <input type="number" name="quantity" class="tae-buy-now-quantity-input" value="1" min="1" aria-label="Quantity" data-quantity-input-{{instance_id}}>
  <button type="button" class="tae-buy-now-quantity-btn tae-buy-now-quantity-plus" aria-label="Increase quantity">+</button>
  </div>
  {%- elsif quantity_style == 'option2' -%}
  <div class="tae-buy-now-quantity-selector tae-buy-now-quantity-selector--style-2">
  <button type="button" class="tae-buy-now-quantity-btn tae-buy-now-quantity-minus" aria-label="Decrease quantity">−</button>
  <input type="number" name="quantity" class="tae-buy-now-quantity-input" value="1" min="1" aria-label="Quantity" data-quantity-input-{{instance_id}}>
  <button type="button" class="tae-buy-now-quantity-btn tae-buy-now-quantity-plus" aria-label="Increase quantity">+</button>
  </div>
  {%- elsif quantity_style == 'option3' -%}
  <div class="tae-buy-now-quantity-selector tae-buy-now-quantity-selector--style-3">
  <button type="button" class="tae-buy-now-quantity-btn tae-buy-now-quantity-minus" aria-label="Decrease quantity">−</button>
  <input type="number" name="quantity" class="tae-buy-now-quantity-input" value="1" min="1" aria-label="Quantity" data-quantity-input-{{instance_id}}>
  <button type="button" class="tae-buy-now-quantity-btn tae-buy-now-quantity-plus" aria-label="Increase quantity">+</button>
  </div>
  {%- endif -%}
  </div>
  {%- else -%}
  <input type="hidden" name="quantity" value="1">
  {%- endunless -%}
  {%- if show_add_to_cart -%}
  {%- if variant.available -%}
  <button type="submit" name="add" class="shopify-payment-button__button shopify-payment-button__button--unbranded tae-add-to-cart-submit" style="background-color:{{color_schema}};">
  <span class="tae-add-to-cart__label">{{ s.add_to_cart_text | default: 'Add to cart' }}</span><span class="tae-add-to-cart__loader" aria-hidden="true"><span class="tae-add-to-cart__spinner"></span></span>
  </button>
  {%- endif -%}
  </div>
  <div class="tae-payment-button-wrapper">
  {%- if variant.available -%} {{ form | payment_button }} {%- else -%}
  <button class="tae-buy-now-button-sold-out" disabled>Sold out</button>
  {%- endif -%}
  </div>
  {%- else -%}
  <div class="tae-payment-button-wrapper">
  {%- if variant.available -%}
  {{ form | payment_button }}
  {%- else -%}
  <button class="tae-buy-now-button-sold-out" disabled>Sold out</button>
  {%- endif -%}
  </div>
  {%- endif -%}
  </div>
  {%- endform -%}
  {%- else -%}
  <a class="tae-buy-now-button-btn" style="background-color:{{color_schema}};color:#ffffff;border-radius:var(--button-border-radius);width:100%;">{{s.button_text|default:'Buy Now'}}</a>
  {%- endif -%}
  </div>
  </div>
  {%- endif -%}
  {% schema %}
  {
    "name": "Buy Now Button",
    "target": "section",
    "settings": [
      { "type": "text", "id": "button_text", "label": "Button text", "default": "Buy Now" },
      { "type": "checkbox", "id": "show_add_to_cart", "label": "Show Add to cart button", "default": false },
      { "type": "text", "id": "add_to_cart_text", "label": "Add to cart button text", "default": "Add to cart" },
      { "type": "select", "id": "alignment", "label": "Alignment", "default": "center", "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]},
      { "type": "header", "content": "Layout" },
      { "type": "range", "id": "container_width", "label": "Container width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100, "info": "Width of the area containing quantity selector and button" },
      { "type": "header", "content": "Button Style" },
      { "type": "checkbox", "id": "use_metafields", "label": "Use Roarr metafields", "default": true, "info": "When enabled, color saved for this page by Roarr will be used. Disable this to use custom colors." },
      { "type": "color", "id": "button_color", "label": "Button color", "default": "#a34e4e" },
      { "type": "range", "id": "button_border_radius", "label": "Button border radius", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 12 },
      { "type": "range", "id": "button_height", "label": "Button and quantity selector height", "min": 35, "max": 80, "step": 1, "unit": "px", "default": 48 },
      { "type": "header", "content": "Quantity Selector" },
      { "type": "checkbox", "id": "hide_quantity_selector", "label": "Hide quantity selector", "default": false },
      { "type": "select", "id": "quantity_style", "label": "Quantity selector style", "default": "option1", "options": [
        { "value": "option1", "label": "Option 1" },
        { "value": "option2", "label": "Option 2" },
        { "value": "option3", "label": "Option 3" }
      ]},
      { "type": "range", "id": "quantity_border_radius", "label": "Quantity selector border radius", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 12 },
      { "type": "range", "id": "quantity_width", "label": "Quantity selector width", "min": 100, "max": 300, "step": 5, "unit": "px", "default": 150 }
    ]
  }
  {% endschema %}