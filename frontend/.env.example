# Shopify app (Partner Dashboard → App → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,read_products,write_themes,read_themes
SHOPIFY_APP_URL=http://localhost:3000

# Python API
PYTHON_API_URL=http://127.0.0.1:5001

# Supabase (Auth + Prisma Session table)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres?pgbouncer=true
